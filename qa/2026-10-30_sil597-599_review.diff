+    const future = new Date(Date.now() + 10 * 86_400_000).toISOString().slice(0, 10);
+    useCustomerStatementMock.mockReturnValue({
+      data: {
+        ...customerStatement,
+        unpaidTrips: [
+          { tripId: 1, date: '2026-10-24', issueTimestamp: '2026-10-24T00:00:00Z', outstanding: 3_000_000, note: '', originalDueDate: future, processingDueDate: future },
+        ],
+      },
+      isLoading: false, isFetching: false, error: null, refetch: vi.fn(),
+    });
+    renderAt('/debt/7');
+    expect(await screen.findByText('Còn nợ trong hạn')).toBeTruthy();
