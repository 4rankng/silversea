  .shipment-container-ledger__col--declaration { width: 6%; }
  .shipment-container-ledger__col--direction { width: 6%; }
  .shipment-container-ledger__col--shippingline { width: 8%; }
  .shipment-container-ledger__col--container { width: 10%; }
  .shipment-container-ledger__col--route { width: 7%; }
  .shipment-container-ledger__col--schedule { width: 7%; }
  .shipment-container-ledger__col--vehicle { width: 12%; }
  .shipment-container-ledger__col--notes { width: 7%; }
  .shipment-container-ledger__col--status { width: 8%; }
  .shipment-container-ledger__col--actions { width: 9%; }
