.shipment-container-ledger td.shipment-container-ledger__cell--select { padding-inline: 6px; text-align: center; vertical-align: middle; }
.shipment-container-ledger__lot-select { width: 16px; height: 16px; margin: 0; accent-color: var(--brand); cursor: pointer; }
