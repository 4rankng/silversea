  .shipment-container-ledger tbody > tr > *:last-child { min-width: 88px; }
  .shipment-container-ledger thead th:last-child { min-width: 88px; }
}
/* Card 111026111200 — copy giờ hẹn xuống các container của CÙNG lô chưa có
   lịch. `.shipment-container-ledger__copy` is the name base.css has reserved
   for this affordance since 20260918_3 (the global hover reset exempts it).
   Unlike the create-form and CUS overlays this one is a plain actions-column
   button that stays VISIBLE at rest: the ticket was \"the button does not
   exist\", and a hover-gated icon is exactly what those two surfaces already
   proved people fail to find. */
/* SIL-516 doctrine sweep (SIL-515 wrap-full): the copy label wraps instead of
   spilling past the 7% actions cell (\"Copy giờ hẹn\" is ~78px of nowrap text in
   a ~55px cell — it overhung the table's right edge wherever the actions
   column is last). The base.css hover exemption is unchanged. */
.shipment-container-ledger__copy { white-space: normal; }
/* The three action groups stack (the actions cell is the narrowest share, so
   side-by-side labels would shear mid-word at 1280). */
.shipment-container-ledger__cell--actions .shipment-container-ledger__multiline + .shipment-container-ledger__multiline { margin-top: 4px; }

/* Negating the scrollport's top padding (see --sticky-thead-top in tokens.css)
   keeps the header flush with the app-body edge so scrolled rows never peek
   through the gap between the topbar and this pinned header. */
/* Workboard-standard thead (docs/design-guidelines.md §\"Workboard table &
   summary rail\"): --ink-2 header text on surface-2 with a 1px --line-strong
   underline, 10×12 padding — computed-identical to the /shipments table
   (header case/tracking come from the shared table base, as on /shipments). */
.shipment-container-ledger thead th { position: sticky; top: var(--sticky-thead-top, -24px); z-index: 3; padding: 10px 12px; border-bottom: 1px solid var(--line-strong); background: var(--surface-2); color: var(--ink-2); font-size: var(--ops-table-header-size); font-weight: var(--ops-table-header-weight); line-height: var(--ops-table-header-line-height); text-align: left; word-break: keep-all; overflow-wrap: normal; white-space: normal; }
/* SIL-516 (horizontal overflow / TRẠNG THÁI cut at the right edge): the shared
   .table-sort-button is `white-space: nowrap` (FB-063's one-line law), so a
   long label (\"Khách hàng & lộ trình\", \"Thông số container\") stayed one line
   and overflowed its th — the neighbouring sticky th painted over the
   overflow (header text cut mid-phrase) and the LAST header's button escaped
   the table box (+3.6px region overflow; cut at the viewport edge wherever
   the table meets it). The ledger's own th contract is already `white-space:
   normal` (pinned: \"lets headings wrap instead of forcing horizontal scroll\"),
   and the newer header law is \"1 line OR an even 2-line wrap\" (card
   20260925_47, SIL-515 wrap-full doctrine) — so the sort button wraps at
   spaces here (keep-all: never mid-token) and balances across two lines.
   Shared table-sort.css is untouched. */
.shipment-container-ledger thead .table-sort-button { flex-wrap: wrap; white-space: normal; overflow-wrap: normal; word-break: keep-all; text-wrap: balance; }
.shipment-container-ledger tbody > tr > th,
.shipment-container-ledger tbody > tr > td { position: relative; min-width: 0; /* Row height is a floor, not a cap (workboard standard for multiline stacked-cell ledgers): 72px keeps sparse rows from reading as mostly empty space. Card-collapse modes below MUST reset it to auto (with the workboard's 76px min-height floor) — grid-display cells treat a definite height as a cap and clip. The floor also intentionally outranks __editable-cell's 1px height (workboard parity: rows keep their rhythm; the trigger fills the cell). */ height: 72px; padding: 10px 12px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); color: var(--ink); font-size: var(--ops-table-supporting-size); line-height: var(--ops-table-supporting-line-height); text-align: left; vertical-align: top; white-space: normal; overflow-wrap: anywhere; }
.shipment-container-ledger tbody > tr > :last-child { border-right: 0; }
.shipment-container-ledger tbody > tr:last-child > * { border-bottom: 0; }
.shipment-container-ledger tbody > tr:hover > * { background: var(--surface-2); }
/* A full-row amber fill stops reading as \"needs attention\" once missing-date
   rows dominate an unfiltered view — it reads as striping. Scope the tint to
   the schedule cell, where the \"Thiếu ngày vận chuyển\" chip explains it. */
.shipment-container-ledger tbody > tr.shipment-container-ledger__row--missing-date > td[data-label='Lịch trình'] { background: color-mix(in srgb, var(--warning-soft) 74%, var(--surface)); }
.shipment-container-ledger tbody > tr.shipment-container-ledger__row--missing-date:hover > td[data-label='Lịch trình'] { background: color-mix(in srgb, var(--warning-soft) 88%, var(--surface)); }

.shipment-container-ledger__multiline { display: flex; width: 100%; min-width: 0; flex-direction: column; align-items: flex-start; gap: 4px; }
.shipment-container-ledger__multiline > * { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
.shipment-container-ledger__multiline > strong,
.shipment-container-ledger__multiline:not(.shipment-container-ledger__notes) > span:not(.shipment-container-ledger__code):not(.shipment-container-ledger__combined):not(.shipment-container-ledger__plate):not(.shipment-container-ledger__dispatch-badge):not(.shipment-container-ledger__plate--missing):not(.shipment-container-ledger__schedule-gap):not(.shipment-container-ledger__row-warning),
.shipment-container-ledger__multiline > em,
.shipment-container-ledger__multiline > small { display: block; width: 100%; white-space: normal; word-break: break-word; }
.shipment-container-ledger__multiline > strong { font-size: var(--ops-table-primary-size); font-weight: var(--ops-table-primary-weight); line-height: var(--ops-table-primary-line-height); }
/* Container codes never wrap and never render bold (user ruling 2026-09-16):
   11-char ISO codes stay on one line at supporting size. */
.shipment-container-ledger td[data-label=\"Container\"] .shipment-container-ledger__multiline > strong { font-size: var(--text-caption-size); font-weight: 400; white-space: nowrap; }
.shipment-container-ledger__multiline > span { color: var(--ink-2); }
/* SIL-149 phase 2: the row expander is a phone-only affordance (the ≤520px
   block flips it on); desktop tables never render a control. */
.shipment-container-ledger__row-toggle { display: none; }
.shipment-container-ledger__multiline > em { color: var(--ink-3); font-style: italic; font-size: var(--ops-table-meta-size); line-height: var(--ops-table-meta-line-height); }
.shipment-container-ledger__multiline > .shipment-container-ledger__row-warning { display: inline-flex; width: fit-content; max-width: 100%; align-items: center; gap: 4px; margin-top: 2px; padding: 2px 8px; border-radius: 6px; background: var(--warning-soft); color: var(--warning-text); font-size: var(--text-caption-size); font-weight: var(--fw-bold); line-height: 1.5; white-space: nowrap; }
.shipment-container-ledger__row-warning svg { width: 12px; height: 12px; flex: 0 0 12px; }

/* Server-derived missing-field triage, compact form: one amber line — icon +
   \"Thiếu N thông tin\" disclosure — instead of the full label list, so an
   incomplete row keeps the workboard's compact height (the 11% status column
   wrapped a 13-label list to ~180px on incomplete lots). Expanding reveals
   every field as a jump-to-editor button; the list wraps at the same text
   size, nothing is shrunk or permanently hidden. */
.shipment-container-ledger__multiline > .shipment-container-ledger__row-warning.shipment-container-ledger__missing-fields { flex-wrap: wrap; white-space: normal; align-content: flex-start; }
/* SIL-583 QA round 3 (2026-10-30): the row's inline disclosure/edit links
   (\"Thiếu N thông tin ▾\", \"Sửa cước thu khách\", \"BKS Báo khách (Ảo) — sửa\",
   \"Sửa BKS thực\") measured 17px tall — under the WCAG 2.5.8 24px floor at
   every pointer. The links stack inside one cell a few px apart, so a 44px
   hit extension would overlap the neighbour link's own hit region (the
   ticket's no-overlap condition wins, the round-1 copy/badge precedent);
   the floor is the base min-height and the coarse-pointer band lifts the
   element itself to the 44px touch aim. */
.shipment-container-ledger__missing-fields-toggle {
  display: inline-block;
  min-height: 24px;
  box-sizing: border-box;
  border: 0; padding: 0; background: none; color: inherit; font: inherit; font-weight: inherit; cursor: pointer; text-align: left; text-decoration: underline dotted; text-underline-offset: 2px; }
.shipment-container-ledger__missing-fields-toggle:hover { text-decoration: underline solid; }
.shipment-container-ledger__missing-fields-list { display: flex; width: 100%; flex-wrap: wrap; gap: 3px; margin-top: 2px; min-width: 0; }
.shipment-container-ledger__missing-fields-item { border: 1px solid color-mix(in srgb, var(--warning) 45%, transparent); border-radius: 4px; padding: 1px 6px; background: var(--surface); color: var(--ink-2); font-size: var(--text-caption-size); font-weight: var(--fw-medium); line-height: 1.5; cursor: pointer; }
.shipment-container-ledger__missing-fields-item:hover:not(:disabled) { background: var(--warning-soft); color: var(--warning-text); }
.shipment-container-ledger__missing-fields-item:disabled { opacity: .55; cursor: default; }
.shipment-container-ledger__missing-fields-item--external { color: var(--ink-3); font-size: var(--text-caption-size); line-height: 1.5; }
.shipment-container-ledger__code { font-family: var(--font-data); letter-spacing: .01em; }
/* SIL-756 (Round 3): Container numbers (11-char ISO codes), declaration numbers,
   and Bill/Booking codes are single-token identifiers: single-line with
   nowrap + overflow-x: auto (scrollable cell, scrollbar when needed) + tooltip
   so they never break mid-string and all characters/digits are fully readable in-cell
   (e.g. 108590773650, QACU200050, TK1108R002). NO ellipsis truncation. */
.shipment-container-ledger td[data-label=\"Số tờ khai\"] .shipment-container-ledger__code,
.shipment-container-ledger td[data-label=\"Bill/Booking\"] .shipment-container-ledger__code,
.shipment-container-ledger td[data-label=\"Thông số container\"] .shipment-container-ledger__code {
  display: block;
  max-width: 100%;
  font-size: var(--text-caption-size);
  white-space: nowrap !important;
  overflow-x: auto !important;
  overflow-y: hidden !important;
  text-overflow: clip !important;
  overflow-wrap: normal !important;
  word-break: normal !important;
  scrollbar-width: thin;
}
.shipment-container-ledger td[data-label=\"Số tờ khai\"] .shipment-container-ledger__code::-webkit-scrollbar,
.shipment-container-ledger td[data-label=\"Bill/Booking\"] .shipment-container-ledger__code::-webkit-scrollbar,
.shipment-container-ledger td[data-label=\"Thông số container\"] .shipment-container-ledger__code::-webkit-scrollbar {
  height: 4px;
}
.shipment-container-ledger td[data-label=\"Số tờ khai\"] .shipment-container-ledger__code::-webkit-scrollbar-thumb,
.shipment-container-ledger td[data-label=\"Bill/Booking\"] .shipment-container-ledger__code::-webkit-scrollbar-thumb,
.shipment-container-ledger td[data-label=\"Thông số container\"] .shipment-container-ledger__code::-webkit-scrollbar-thumb {
  background: var(--line-2, #cbd5e1);
  border-radius: 2px;
}
/* SIL-516 doctrine sweep (SIL-515 wrap-full): the lot row's spec PHRASE
   (\"Lô hàng lẻ | Thu: Xe 10T | Trả: Xe 3.5T\") rides the same __code class but
   is sentence-like copy, not an identifier — the nowrap above kept it one
   131px unbreakable line in an 84px cell (it spilled 47px over Nâng / hạ).
   Phrases wrap at spaces and pipes; container NUMBERS keep the whole-token
   nowrap law above (QA-090: identifiers stay whole). */
.shipment-container-ledger td[data-label=\"Thông số container\"] .shipment-container-ledger__code--phrase {
  display: block;
  white-space: normal !important;
  overflow: visible !important;
  text-overflow: clip !important;
  overflow-wrap: break-word !important;
  word-break: normal !important;
}
/* Direction is structural classification, not a status: neutral token chip
   (surface-3/ink-2) matching the frozen overview's treatment — accent fills
   stay reserved for state signals. FB-113 v2: the chip moved into its own
   9% column, so it may wrap (\"CHƯA XÁC ĐỊNH\") instead of overflowing.
   SIL-484 (owner 25/10): the chip reads the table's DATA scale, not the
   caption scale — 12px (--text-data-size, the neighboring Bill/Tờ khai/
   Hãng tàu cells) at line-height 1.5 + the 2px block padding lands the
   pill at ~22px, inside the owner's 20-22px band. */
.shipment-container-ledger__direction { display: inline-flex; width: fit-content; max-width: 100%; padding: 2px 7px; border-radius: 6px; background: var(--surface-3); color: var(--ink-2); font-size: var(--text-data-size); line-height: 1.5; font-weight: var(--fw-semibold); letter-spacing: .04em; text-transform: uppercase; white-space: normal; }
.shipment-container-ledger__direction--unknown { color: var(--ink-3); }
.shipment-container-ledger__container-classification { color: var(--ink-2) !important; font-size: var(--text-caption-size); font-weight: var(--fw-medium); }
.shipment-container-ledger__combined { display: inline-flex; width: fit-content; padding: 2px 6px; border: 1px solid var(--line-2); border-radius: 4px; color: var(--ink-2) !important; font-size: var(--text-caption-size); font-weight: var(--fw-bold); }
/* Trạng thái is plain colored text, not a pill: the four dispatch states
   already read as a status signal via hue alone (matched to the exact tones
   the retired Badge/BadgeWithDot component used, so the palette didn't
   change — only the fill/ring/dot chrome was dropped) and a flat label
   costs far less column width than a chip. */
.shipment-container-ledger__dispatch-badge { display: inline-block; max-width: 100%; font-weight: var(--fw-semibold); font-size: var(--text-caption-size); line-height: 1.4; white-space: normal; }
.shipment-container-ledger__dispatch-badge--awaiting-vehicle { color: oklch(0.554 0.135 66.442); }
.shipment-container-ledger__dispatch-badge--planned { color: oklch(0.488 0.2172 264.052); }
.shipment-container-ledger__dispatch-badge--created { color: oklch(0.457 0.24 277.023); }
.shipment-container-ledger__dispatch-badge--in_transit { color: oklch(0.496 0.265 301.924); }
.shipment-container-ledger__dispatch-badge--completed { color: oklch(0.527 0.154 150.069); }

/* Last-column status cell now stacks the dispatch label with the
   missing-fields warning, so it aligns top like the other multi-line
   cells instead of centering a single line. */
.shipment-container-ledger__cell--status { display: table-cell; vertical-align: top; }
.shipment-container-ledger__missing { color: var(--ink-3); font-weight: var(--fw-regular); }

/* Notes are prose, not a headline value: they read at the shared note tier —
   the same one the /shipments list's note preview uses — so a note never
   outweighs the neighboring cells. Operational notes keep the list page's
   italic internal-note voice. */
.shipment-container-ledger__notes > strong,
.shipment-container-ledger__notes > span { font-size: var(--ops-table-note-size); font-weight: var(--ops-table-note-weight); line-height: var(--ops-table-note-line-height); }
.shipment-container-ledger__multiline.shipment-container-ledger__notes > :is(strong, span) { white-space: pre-wrap; }
.shipment-container-ledger__notes > span { color: var(--ink-3); font-style: normal; }

.shipment-container-ledger__route { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; align-items: center; }
/* The place name is this cell's headline value (same role as the customer
   name / doc number / container number in their columns), so it takes the
   shared primary tier instead of the smaller note-weight text it had drifted
   to — every column's headline now reads at one consistent size/weight. */
.shipment-container-ledger__route > span { display: grid; min-width: 0; gap: 2px; overflow-wrap: anywhere; font-size: var(--ops-table-primary-size); font-weight: var(--ops-table-primary-weight); line-height: var(--ops-table-primary-line-height); word-break: break-word; }
.shipment-container-ledger__route small { color: var(--ink-3); font-size: var(--text-caption-size); font-weight: var(--fw-semibold); text-transform: uppercase; }
.shipment-container-ledger__route i { justify-self: start; color: var(--ink-4); font-style: normal; transform: rotate(90deg); }
.shipment-container-ledger__schedule { font-family: var(--font-data); }
/* \"Thiếu ngày vận chuyển\" chip: the schedule column owns the date-gap signal
   (paired with the cell-scoped amber tint above), so the actionable state is
   where the eye already reads schedule information. */
.shipment-container-ledger__schedule-gap { width: fit-content; max-width: 100%; margin-bottom: 1px; color: var(--warning-text); font-family: var(--font-body); font-size: var(--text-caption-size); line-height: 1.4; white-space: normal; }
.shipment-container-ledger__schedule-gap svg { width: 12px; height: 12px; margin-right: 4px; }
.shipment-container-ledger__plate { display: inline-flex; width: fit-content; padding: 2px 5px; border: 1px solid var(--line-2); border-radius: 4px; background: var(--surface-2); color: var(--ink) !important; font-family: var(--font-data); font-weight: var(--fw-bold); letter-spacing: .03em; white-space: nowrap; }
.shipment-container-ledger__vehicle { gap: 4px; }
/* SIL-714 — the Cập nhật biển số affordance sits under the \"CUS sẽ bổ sung\"
   badge in the same multiline stack; width: fit-content keeps it compact. */
.shipment-container-ledger__plate-update { width: fit-content; }
.shipment-container-ledger__vehicle-pending { background: color-mix(in srgb, var(--warning-soft) 52%, var(--surface)) !important; }
.shipment-container-ledger tbody > tr:hover > .shipment-container-ledger__vehicle-pending { background: color-mix(in srgb, var(--warning-soft) 74%, var(--surface)) !important; }
/* Status chips below are UUI badges (Badge/BadgeWithDot warning): the badge
   component owns fill, ring, radius, and height; page CSS tunes type and
   containment only — never border, padding, or control geometry — so a chip
   can never read as a button. The explicit color is required: Tailwind's
   layered text utilities lose to the unlayered `__multiline > span` ink-2
   rule above (CSS Cascade 5), which would leave amber fills with gray text. */
.shipment-container-ledger__plate--missing { width: fit-content; max-width: 100%; color: var(--warning-text); font-size: var(--text-caption-size); line-height: 1.4; white-space: normal; }

.shipment-container-ledger__cell-stack { display: grid; min-width: 0; gap: 3px; }
.shipment-container-ledger__cell-stack > .shipment-container-ledger__cell-trigger + .shipment-container-ledger__cell-trigger { padding-top: 5px; border-top: 1px solid var(--line); }
.shipment-container-ledger__editable-cell { position: relative; height: 1px; padding: 0 !important; }
.shipment-container-ledger__editable-cell > .shipment-container-ledger__cell-editor { position: relative; height: 100%; }
.shipment-container-ledger__editable-cell > .shipment-container-ledger__cell-editor > .shipment-container-ledger__cell-trigger {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 100%;
  margin: 0;
  padding: 10px;
}
/* An open editor shares the cell with its trigger. The full-height click target
   above must yield or it inflates to the whole cell and pushes the editor past
   the bottom edge — off-screen wherever the editor sits in flow instead of
   floating, as it does in the stacked card layout. Keyed on the trigger's own
   expanded state so the invariant holds at every breakpoint, including ones
   added later. */
.shipment-container-ledger__editable-cell > .shipment-container-ledger__cell-editor > .shipment-container-ledger__cell-trigger--expanded {
  height: auto;
  min-height: 0;
}
.shipment-container-ledger__cell-trigger {
  display: block;
  width: calc(100% + 8px);
  min-width: 0;
  margin: -3px -4px;
  padding: 3px 4px;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: inherit;
  cursor: text;
  font: inherit;
  line-height: inherit;
  scroll-margin-top: 96px;
  text-align: left;
  touch-action: manipulation;
}
.shipment-container-ledger__cell-trigger:not(.shipment-container-ledger__cell-trigger--read-only):not([disabled]):hover,
.shipment-container-ledger__cell-trigger--expanded { background: color-mix(in srgb, var(--accent) 7%, transparent); }
.shipment-container-ledger__cell-trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: -1px; background: color-mix(in srgb, var(--accent) 8%, transparent); }
/* SIL-516: the trigger's -4px right margin + calc(100% + 8px) hit-area bleeds
   4px past the table's right edge when an editable cell is the row's LAST
   rendered column (every trailing column hidden) — the same right-edge
   overflow class as the sort button above. Keep the left expansion, contain
   the right. */
.shipment-container-ledger tbody > tr > :last-child .shipment-container-ledger__cell-trigger { width: calc(100% + 4px); margin-right: 0; }
.shipment-container-ledger__cell-trigger[disabled] { opacity: 1; cursor: default; }
.shipment-container-ledger__cell-trigger--read-only { cursor: default; }
.shipment-container-ledger__edit-purpose { position: absolute; width: 1px; height: 1px; overflow: hidden; margin: -1px; padding: 0; border: 0; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
.shipment-container-ledger__classification { display: flex; min-width: 0; flex-wrap: wrap; align-items: center; gap: 4px; color: var(--ink-2); }
.shipment-container-ledger__classification > span { min-width: 0; overflow-wrap: anywhere; }
.shipment-container-ledger__editing-cell { position: relative; z-index: var(--z-overlay, 200); overflow: visible !important; background: var(--surface-2) !important; }
.shipment-container-ledger__cell-editor { position: relative; min-width: 0; }
/* SIL-631: in-cell quick editors (BKS Ảo/Thực, cước thu khách) float out of
 * the row through the shared FloatingCellEditor (body portal). The trigger
 * stays mounted, dimmed and inert, so the row keeps its value while editing. */
.shipment-container-ledger__inline-edit-host { min-width: 0; }
.shipment-container-ledger__inline-edit-host.is-editing > * { opacity: 0.45; pointer-events: none; }
/* Card 20261009_3: the card chrome lives on the editor's own class so the
   ≤640px phone sheet (`--sheet`, portaled to body) reuses the exact same
   surface — one shared implementation, no duplicated card styling. */
.shipment-container-ledger__inline-editor {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10px;
  padding: 12px;
  border: 1px solid var(--line-strong);
  border-radius: 8px;
  background: var(--surface);
  box-shadow: none;
}
.shipment-container-ledger__cell-editor > .shipment-container-ledger__inline-editor {
  position: absolute;
  z-index: 4;
  top: calc(100% + 6px);
  left: -4px;
  width: min(420px, calc(100vw - 28px));
  min-width: 0;
}
.shipment-container-ledger__cell-editor[data-mode=\"vehicle\"] > .shipment-container-ledger__inline-editor,
.shipment-container-ledger__cell-editor[data-mode=\"notes\"] > .shipment-container-ledger__inline-editor { right: -4px; left: auto; }
.shipment-container-ledger__cell-editor[data-mode=\"schedule\"] > .shipment-container-ledger__inline-editor { right: -4px; left: auto; }
/* SIL-516: the BKS plate quick editor renders IN-FLOW inside the cell (it is
   not wrapped in .cell-editor), as a flex child of __multiline whose
   align-items: flex-start leaves it at fit-content — ~79px wide at the old 8%
   share, squeezing the combobox and shattering its helper into one character
   per line. The card fills the cell instead, so every child sizes to the real
   cell width. */
.shipment-container-ledger__multiline > .shipment-container-ledger__inline-editor { width: 100%; min-width: 0; }
.shipment-container-ledger__editor-heading { display: flex; min-width: 0; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; }
.shipment-container-ledger__editor-heading strong { color: var(--ink); font-size: var(--text-data-size); }
.shipment-container-ledger__editor-heading span { color: var(--ink-3); font-family: var(--font-data); font-size: var(--text-caption-size); }
.shipment-container-ledger__editor-grid { display: grid; grid-template-columns: minmax(0, 1fr); min-width: 0; gap: 9px; }
.shipment-container-ledger__editor-grid--schedule { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
/* SIL-661: the documents dialog («Chỉnh sửa chứng từ và hãng tàu») lays its
   fields in a 2-column desktop grid (Untitled UI user-settings-modal pattern,
   consulted): 5 fields = 3 full rows (2/2/1) — the 5th field (Số cont) owns
   the left cell of the last row while the right cell stays EMPTY grid space,
   never a fake filler. Any non-field child (hints, the tờ khai copy action,
   the ISO note) spans the whole row so it can never split a field pair.
   Below 768px the grid stacks to one column (mobile-first). */
.shipment-container-ledger__editor-grid--docs { gap: 16px; }
@media (min-width: 768px) {
  .shipment-container-ledger__editor-grid--docs { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .shipment-container-ledger__editor-grid--docs > :not(label) { grid-column: 1 / -1; }
}
.shipment-container-ledger__editor-grid > label { display: grid; min-width: 0; gap: 5px; }
.shipment-container-ledger__editor-grid > label > span,
.shipment-container-ledger__editor-grid [data-label] { color: var(--ink-3); font-size: var(--text-label-size); font-weight: var(--fw-bold); line-height: 1.3; }
.shipment-container-ledger__editor-grid input:not([data-uui-control] input),
.shipment-container-ledger__editor-grid select,
.shipment-container-ledger__editor-grid textarea,
.shipment-container-ledger__editor-grid .searchable-select__trigger { box-sizing: border-box; width: 100%; min-width: 0; height: var(--control-default-h); min-height: var(--control-default-h); border: 1px solid var(--line-strong); border-radius: 6px; background: var(--surface); box-shadow: none; color: var(--ink); font-size: var(--control-field-font-size); line-height: 1.35; }
.shipment-container-ledger__editor-grid input:not([data-uui-control] input),
.shipment-container-ledger__editor-grid select,
.shipment-container-ledger__editor-grid .searchable-select__trigger { padding: 5px 9px; }
.shipment-container-ledger__editor-grid textarea { height: auto; min-height: 72px; padding: 7px 9px; resize: vertical; }
.shipment-container-ledger__editor-grid input:not([data-uui-control] input):focus-visible,
.shipment-container-ledger__editor-grid select:focus-visible,
.shipment-container-ledger__editor-grid textarea:focus-visible,
.shipment-container-ledger__editor-grid .searchable-select__trigger:focus-visible { border-color: var(--accent); outline: 2px solid color-mix(in srgb, var(--accent) 22%, transparent); outline-offset: 1px; }
/* SIL-516: wrap law parity with __multiline > small (pinned word-break:
   break-word) — the plate editor's helper is the line \"BKS thực là biển số xe
   chạy thực tế của lô.\" and must read as horizontal word-wrap lines. As a
   full-width grid item it is never squeezed to min-content, so the td's
   inherited overflow-wrap: anywhere can no longer shatter it one character
   per line. */
.shipment-container-ledger__editor-grid > small { color: var(--ink-3); font-size: var(--text-caption-size); line-height: 1.4; overflow-wrap: break-word; word-break: break-word; white-space: normal; }
/* Card 261013200312: the per-cont tờ khai copy affordance sits under the
   number field, left-aligned like the other secondary row actions. */
.shipment-container-ledger__declaration-copy { display: flex; min-width: 0; }
.shipment-container-ledger__declaration-copy > button { justify-self: start; }
/* Card 261022095235b: live ISO 6346 hint under the container editor's số
   cont input — the same warning + one-tap correction the drawer's add row
   shows (card 191026100000), so a mistyped \"đổi số cont\" ends at a one-tap
   fix instead of a dead-end 400. */
.shipment-container-ledger__number-hint {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  color: var(--warning-text);
  font-size: var(--text-caption-size);
  font-weight: var(--fw-semibold, 600);
  line-height: 1.4;
}
.shipment-container-ledger__field--request > input,
.shipment-container-ledger__field--request > .searchable-select__trigger { border-color: var(--warning); }
.shipment-container-ledger__field--request > input:focus-visible,
.shipment-container-ledger__field--request > .searchable-select__trigger:focus-visible { border-color: var(--warning); outline-color: color-mix(in srgb, var(--warning) 22%, transparent); }
.shipment-container-ledger__request-notice { color: var(--warning-text); font-size: var(--text-caption-size); font-weight: var(--fw-semibold); line-height: 1.4; }
.shipment-container-ledger__request-reason { grid-column: 1 / -1; }
.shipment-container-ledger__request-reason textarea { min-height: 60px; }
.shipment-container-ledger__editor-footer { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 8px; margin-top: 2px; padding-top: 10px; border-top: 1px solid var(--line-2); }
/* SIL-516: margin-left auto keeps the action pair on the footer's trailing
   edge even when the footer's only other child is an inline error (or there
   is none at all — the plate editor's helper moved into the grid above), so
   \"Lưu/Hủy\" always sit cleanly inside the cell. Scoped to the ledger root:
   the accounting billing editor reuses __edit-actions under its own layout
   (.debit-billing-editor) and must not inherit this alignment. The base
   layout rule stays unscoped for the ≤640px sheet, which portals to body. */
.shipment-container-ledger__edit-actions { display: flex; flex: 0 0 auto; flex-wrap: nowrap; gap: 6px; }
.shipment-container-ledger .shipment-container-ledger__edit-actions { margin-left: auto; }
.shipment-container-ledger__edit-action { display: inline-flex; width: auto; min-width: 36px; height: 36px; min-height: 36px; padding-inline: 12px; font-size: var(--text-data-size); }
/* Disabled must read as a gray pill, not brand-green at half opacity: the
   base button's only disabled styling is disabled:opacity-50, which washes
   the green instead of neutralizing it against the white editor tray. Only
   the primary Save sits disabled at rest (dirty-gated); the secondary cancel
   disables mid-save only. Unlayered declarations override Tailwind's layered
   disabled/hover utilities, so reset opacity and flatten the shadow. */
.shipment-container-ledger__edit-action:disabled { background: var(--surface-2); color: var(--ink-3); box-shadow: none; opacity: 1; }
.shipment-container-ledger__edit-action:disabled [data-icon] { color: inherit; }
.shipment-container-ledger__keyboard-hint { min-width: 0; color: var(--ink-3); font-size: var(--text-caption-size); line-height: 1.35; white-space: nowrap; }
.shipment-container-ledger__edit-error { display: block; max-width: 100%; margin-top: 5px; color: var(--danger); font-size: var(--text-caption-size); line-height: 1.35; white-space: normal; overflow-wrap: anywhere; }
.shipment-container-ledger__request-success { display: block; max-width: 100%; margin-top: 5px; color: var(--success-text); font-size: var(--text-caption-size); font-weight: var(--fw-semibold); line-height: 1.35; white-space: normal; overflow-wrap: anywhere; }
.shipment-container-ledger__recovery { display: block; max-width: 100%; margin-top: 5px; color: var(--warning-text); font-size: var(--text-caption-size); font-weight: var(--fw-semibold); line-height: 1.35; white-space: normal; overflow-wrap: anywhere; }

/* Schedule editor adopts the customer appointment popover's design language
   (calendar-icon header, container badge, quick-date pills, side-by-side
   date/time, common-hour pills). Saving stays explicit — Lưu writes to the
   API — and the footer swaps the keyboard hint for the appointment-clearing
   link. Pills auto-complete the date+time pair like the customer popover. */
.shipment-container-ledger__schedule-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--line-2); }
.shipment-container-ledger__schedule-title { display: flex; min-width: 0; flex-wrap: wrap; align-items: center; gap: 5px; color: var(--ink); font-size: var(--text-data-size); }
.shipment-container-ledger__schedule-badge { color: var(--ink-3); font-family: var(--font-data); font-size: var(--text-caption-size); background: var(--surface-2); padding: 1px 6px; border-radius: 4px; }
/* SIL-251 (FB-009): the popover's copy-time affordance rides the title row —
   the house CopyCodeButton geometry, shrunk to the badge's scale. */
.shipment-container-ledger__schedule-copy { display: inline-grid; place-items: center; width: 22px; height: 22px; flex-shrink: 0; padding: 0; border: 0; border-radius: 4px; background: transparent; color: var(--ink-3); cursor: pointer; }
.shipment-container-ledger__schedule-copy:hover { background: var(--surface-2); color: var(--ink); }
.shipment-container-ledger__schedule-copy:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
.shipment-container-ledger__schedule-close { display: inline-grid; place-items: center; width: 22px; height: 22px; flex-shrink: 0; padding: 0; border: 0; border-radius: 4px; background: transparent; color: var(--ink-3); cursor: pointer; }
.shipment-container-ledger__schedule-close:hover { background: var(--surface-2); color: var(--ink); }
.shipment-container-ledger__schedule-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
.shipment-container-ledger__schedule-section { display: flex; align-items: center; gap: 4px; color: var(--ink-3); font-size: var(--text-caption-size); font-weight: var(--fw-semibold); text-transform: uppercase; letter-spacing: 0.03em; }
.shipment-container-ledger__schedule-pills,
.shipment-container-ledger__schedule-times { display: flex; gap: 4px; }
.shipment-container-ledger__schedule-pill { flex: 1; padding: 5px 6px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-2); color: var(--ink-2); font-family: inherit; font-size: var(--text-control-compact-size); font-weight: 500; text-align: center; cursor: pointer; transition: all 100ms; }
.shipment-container-ledger__schedule-pill:hover { background: var(--surface); border-color: var(--brand); color: var(--brand); }
.shipment-container-ledger__schedule-pill.is-active { background: var(--brand); border-color: var(--brand); color: var(--fg-inverse); font-weight: 600; }
.shipment-container-ledger__schedule-pill:focus-visible,
.shipment-container-ledger__schedule-time-pill:focus-visible,
.shipment-container-ledger__schedule-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
.shipment-container-ledger__schedule-time-pill { flex: 1; padding: 4px 2px; border: 1px solid var(--line); border-radius: 4px; background: transparent; color: var(--ink-2); font-family: inherit; font-size: var(--text-control-compact-size); text-align: center; cursor: pointer; transition: all 100ms; }
.shipment-container-ledger__schedule-time-pill:hover { background: var(--surface-2); color: var(--brand); }
.shipment-container-ledger__schedule-time-pill.is-active { background: var(--surface-2); border-color: var(--brand); color: var(--brand); font-weight: 600; }
.shipment-container-ledger__editor-grid--schedule > label > span { font-size: var(--text-label-size); text-transform: uppercase; letter-spacing: 0.03em; }
.shipment-container-ledger__schedule-clear { padding: 2px 4px; border: 0; background: transparent; color: var(--danger-text); font-family: inherit; font-size: var(--text-control-compact-size); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
.shipment-container-ledger__schedule-clear:hover { color: color-mix(in srgb, var(--danger-text) 80%, #000); }
.shipment-container-ledger__schedule-clear:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
/* Clear-plate affordance mirrors the schedule-clear link-button: danger tone,
   underline, focus ring — removals read consistently across the ledger. */
.shipment-container-ledger__plate-clear { display: block; }
.shipment-container-ledger__plate-clear button { padding: 2px 4px; border: 0; background: transparent; color: var(--danger-text); font-family: inherit; font-size: var(--text-control-compact-size); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
.shipment-container-ledger__plate-clear button:hover { color: color-mix(in srgb, var(--danger-text) 80%, #000); }
.shipment-container-ledger__plate-clear button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

.shipments-detail-skeleton { padding: 0 12px; }
.shipments-detail-skeleton__row { display: flex; gap: 12px; align-items: center; min-height: 72px; border-bottom: 1px solid var(--line); }
.shipments-detail-workspace > .empty-state { margin: 18px; }
.shipments-detail-workspace > .ds-pagination { padding: 12px 14px; border-top: 1px solid var(--line); }
.shipments-detail-workspace .ds-pagination__btn { background: var(--surface); box-shadow: none; }
.shipments-detail-workspace .ds-pagination__btn--active { background: var(--ink); color: var(--surface); }

@container shipments-detail (max-width: 1000px) {
  .shipment-container-ledger tbody { display: block; width: 100%; min-width: 0; }
  .shipment-container-ledger colgroup { display: none; }
  /* SIL-578: the card mode reads its column names from the cells' own
     data-label, and /shipments' card band already `display: none`s its thead
     (.cus-dashboard-table thead). The sr-only clip that stood here kept the
     thead's SORT BUTTONS alive — invisible but tabbable and clickable, seven
     .table-sort-button rects stacked at one origin — so the duplicated
     header's interactive layer is retired with the layout it duplicated. */
  .shipment-container-ledger thead { display: none; }
  .shipment-container-ledger tbody > tr { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; min-width: 0; border-bottom: 1px solid var(--line-2); }
  .shipment-container-ledger tbody > tr:last-child { border-bottom: 0; }
  .shipment-container-ledger tbody > tr > th,
  .shipment-container-ledger tbody > tr > td { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; min-width: 0; height: auto; min-height: 76px; overflow-wrap: anywhere; padding: 8px 10px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .shipment-container-ledger tbody > tr > :nth-child(3n) { border-right: 0; }
  .shipment-container-ledger tbody > tr > td.shipment-container-ledger__cell--status { grid-column: 1 / -1; border-right: 0; }
  .shipment-container-ledger tbody > tr > :last-child { border-bottom: 0; }
  .shipment-container-ledger tbody > tr > th::before,
  .shipment-container-ledger tbody > tr > td::before { min-width: 0; color: var(--ink-3); content: attr(data-label); font-size: var(--text-label-size); font-weight: var(--fw-bold); letter-spacing: .035em; line-height: 1.35; overflow-wrap: anywhere; text-transform: uppercase; white-space: normal; }
  .shipment-container-ledger tbody > tr > .shipment-container-ledger__editing-cell { grid-column: 1 / -1; }
  /* SIL-516: the BKS plate quick editor is not an `editing-cell` (it renders
     beside the cell's display content, without the trigger wrapper), but on
     card layouts its open cell needs the same full-row span — a half-row cell
     squeezed the combobox below its full-placeholder width even at 390px. */
  .shipment-container-ledger tbody > tr > .shipment-container-ledger__cell--plate-open { grid-column: 1 / -1; }
  .shipment-container-ledger tbody > tr > th.shipment-container-ledger__editable-cell,
  .shipment-container-ledger tbody > tr > td.shipment-container-ledger__editable-cell { height: auto; }
  .shipment-container-ledger tbody > tr > th.shipment-container-ledger__editable-cell::before,
  .shipment-container-ledger tbody > tr > td.shipment-container-ledger__editable-cell::before { display: none; }
  .shipment-container-ledger tbody > tr > .shipment-container-ledger__editable-cell > .shipment-container-ledger__cell-editor {
    position: static;
    inset: auto;
    display: block;
    grid-column: 1 / -1;
    height: auto;
  }
  .shipment-container-ledger__editable-cell > .shipment-container-ledger__cell-editor > .shipment-container-ledger__cell-trigger {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 8px;
    min-height: 68px;
    padding: 8px 10px;
    position: relative;
  }
  .shipment-container-ledger__editable-cell > .shipment-container-ledger__cell-editor > .shipment-container-ledger__cell-trigger::before {
    position: absolute;
    top: 8px;
    left: 10px;
    width: 88px;
    color: var(--ink-3);
    content: attr(data-cell-label);
    font-size: var(--text-label-size);
    font-weight: var(--fw-bold);
    letter-spacing: .035em;
    line-height: 1.35;
    overflow-wrap: anywhere;
    text-transform: uppercase;
  }
  .shipment-container-ledger__cell-trigger > :not(.shipment-container-ledger__edit-purpose) { grid-column: 2; }
  .shipment-container-ledger__cell-editor > .shipment-container-ledger__inline-editor { position: static; width: 100%; max-width: none; margin-top: 6px; }
  .shipment-container-ledger__cell-editor[data-mode=\"vehicle\"] > .shipment-container-ledger__inline-editor,
  .shipment-container-ledger__cell-editor[data-mode=\"notes\"] > .shipment-container-ledger__inline-editor,
  .shipment-container-ledger__cell-editor[data-mode=\"schedule\"] > .shipment-container-ledger__inline-editor { right: auto; left: auto; }
  .shipment-container-ledger__cell-trigger,
  .shipment-container-ledger__edit-action { min-height: 40px; }
  .shipment-container-ledger__edit-action { min-width: 40px; height: 40px; }
}

/* The page chrome is comfortable at tablet width, but a three-column ledger
   is not: document identifiers and route values need a two-column reading
   measure before the viewport reaches phone size. */
@container shipments-detail (max-width: 780px) {
  .shipment-container-ledger tbody > tr { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .shipment-container-ledger tbody > tr > :nth-child(3n) { border-right: 1px solid var(--line); }
  .shipment-container-ledger tbody > tr > :nth-child(even) { border-right: 0; }
  .shipment-container-ledger tbody > tr > td.shipment-container-ledger__cell--status { grid-column: 1 / -1; border-right: 0; }
  /* FB-113 v2: each documents cell carries its own short data-cell-label
     (Số Bill/Booking · Số tờ khai · Nhập/Xuất · Hãng tàu), so the generic
     attr(data-cell-label) label is already column-specific. */
}

@media (max-width: 760px) {
  .shipments-detail-page { gap: 10px; }
  .shipments-detail-workspace { border: 0; border-radius: 0; }
  .shipments-detail-workspace__header { padding: 0; }
  .shipments-detail-workspace .summary-rail { margin: 10px 0 0; }
  .shipment-container-ledger tbody > tr { grid-template-columns: repeat(2, minmax(0, 1fr)); border-bottom: 6px solid var(--surface-2); }
  .shipment-container-ledger tbody > tr > th,
  .shipment-container-ledger tbody > tr > td { grid-column: auto; grid-template-columns: minmax(0, 1fr); align-items: start; gap: 4px; height: auto; min-height: 76px; overflow-wrap: anywhere; padding: 8px 10px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .shipment-container-ledger tbody > tr > .shipment-container-ledger__editing-cell { grid-column: 1 / -1 !important; }
  .shipment-container-ledger tbody > tr > .shipment-container-ledger__cell--plate-open { grid-column: 1 / -1 !important; }
  .shipment-container-ledger tbody > tr > :nth-child(even) { border-right: 0; }
  .shipment-container-ledger tbody > tr > td.shipment-container-ledger__cell--status { grid-column: 1 / -1 !important; border-right: 0; }
  .shipment-container-ledger tbody > tr > :last-child { border-bottom: 0; }
  .shipment-container-ledger__route { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  .shipment-container-ledger__route i { transform: rotate(90deg); justify-self: start; }
  .shipment-container-ledger__cell-trigger { min-height: 44px; }
  .shipment-container-ledger__edit-action { min-width: var(--control-max-h); height: var(--control-max-h); min-height: var(--control-max-h); }
  .shipment-container-ledger__keyboard-hint { display: none; }
  .shipment-container-ledger__schedule-pill,
  .shipment-container-ledger__schedule-time-pill { min-height: var(--control-max-h); }
  .shipment-container-ledger__schedule-clear { display: inline-flex; align-items: center; min-height: var(--control-max-h); }
  .shipment-container-ledger__plate-clear button { display: inline-flex; align-items: center; min-height: var(--control-max-h); }
  .shipment-container-ledger__editor-footer { justify-content: flex-end; }
  .shipments-detail-error { margin-inline: 10px; }
  .shipments-detail-workspace > .ds-pagination { padding-inline: 12px; }
}

/* Phone records keep related values adjacent and give prose the full width.
   The editor expands across both columns without narrowing its controls. */
@media (max-width: 520px) {
  .shipment-container-ledger tbody > tr { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .shipment-container-ledger tbody > tr > th,
  .shipment-container-ledger tbody > tr > td {
    grid-template-columns: minmax(0, 1fr);
    grid-column: auto;
    min-height: 44px;
    align-content: start;
    padding: 8px 10px;
    border-right: 0;
  }
  /* FB-113 v2: full-width cells are chosen by identity (row header th) or
     class/label, not nth-child — the documents split changed the child
     indexes, and hidden columns shift them anyway. */
  .shipment-container-ledger tbody > tr > th,
  .shipment-container-ledger tbody > tr > td[data-label='Nâng / hạ'],
  .shipment-container-ledger tbody > tr > td[data-label='Ghi chú'],
  .shipment-container-ledger tbody > tr > td.shipment-container-ledger__cell--status {
    grid-column: 1 / -1;
  }
  .shipment-container-ledger__editable-cell > .shipment-container-ledger__cell-editor > .shipment-container-ledger__cell-trigger {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 4px;
    min-height: 44px;
    height: auto;
    padding: 8px 10px;
  }
  .shipment-container-ledger__editable-cell > .shipment-container-ledger__cell-editor > .shipment-container-ledger__cell-trigger::before {
    position: static;
    grid-column: 1;
    width: auto;
  }
  .shipment-container-ledger__cell-trigger > :not(.shipment-container-ledger__edit-purpose) { grid-column: 1; }
  .shipment-container-ledger__cell-editor[data-mode=\"identity\"] > .shipment-container-ledger__cell-trigger::before,
  .shipment-container-ledger__cell-editor[data-mode=\"route\"] > .shipment-container-ledger__cell-trigger::before { display: none; }
  /* FB-113 v2: each documents cell carries its own short data-cell-label
     (Số Bill/Booking · Số tờ khai · Nhập/Xuất · Hãng tàu), so the old
     \"CHỨNG TỪ\" shortening override is retired — the generic
     attr(data-cell-label) label is already column-specific. */
  .shipment-container-ledger__cell-editor[data-mode=\"container\"] > .shipment-container-ledger__cell-trigger::before { content: \"Container\"; }
  .shipment-container-ledger tbody > tr > .shipment-container-ledger__editing-cell {
    display: block;
    grid-column: 1 / -1 !important;
    padding: 0 0 8px !important;
  }
  .shipment-container-ledger__editing-cell::before { display: none; }
  .shipment-container-ledger__route { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 8px; }
  .shipment-container-ledger tbody > tr > .shipment-container-ledger__cell--status { display: block; }
  .shipment-container-ledger__cell--status::before { display: none; }
  .shipment-container-ledger__cell--status > .shipment-container-ledger__multiline { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 6px 12px; }

  /* Webchat consultation 2026-10-24 (Gemini + DeepSeek, both concurring):
     phone cards read as 8 repeated \"Chưa có…\" sentences around 2-3 real
     facts, and the same missing-date state printed three times per page.
     On phones the amber \"Thiếu N thông tin\" chip owns the gap list (its
     items jump straight into the editors), so per-cell placeholder
     sentences collapse to a muted dash. DOM/text is untouched — only the
     phone presentation hides it, and every trigger's accessible name still
     names its field. */
  .shipment-container-ledger td[data-label='Bill/Booking'] .shipment-container-ledger__missing,
  .shipment-container-ledger td[data-label='Số tờ khai'] .shipment-container-ledger__missing,
  .shipment-container-ledger td[data-label='Hãng tàu'] .shipment-container-ledger__missing,
  .shipment-container-ledger td[data-label='Nâng / hạ'] .shipment-container-ledger__missing,
  .shipment-container-ledger td[data-label='Lịch trình'] .shipment-container-ledger__schedule-gap { display: none; }
  /* The customer header needs !important: the global `.multiline > *` display
     law stacks eight classes via its :not() chain and would out-specify this
     hide on the only placeholders that sit as direct multiline children. */
  .shipment-container-ledger tbody > tr > th .shipment-container-ledger__multiline:has(> strong) > .shipment-container-ledger__missing { display: none !important; }
  .shipment-container-ledger td[data-label='Bill/Booking'] .shipment-container-ledger__code:has(> .shipment-container-ledger__missing)::after,
  .shipment-container-ledger td[data-label='Số tờ khai'] .shipment-container-ledger__code:has(> .shipment-container-ledger__missing)::after,
  .shipment-container-ledger td[data-label='Hãng tàu'] .shipment-container-ledger__multiline > span:has(> .shipment-container-ledger__missing)::after,
  .shipment-container-ledger td[data-label='Nâng / hạ'] .shipment-container-ledger__route:has(.shipment-container-ledger__missing)::after { content: '—'; color: var(--ink-3); }
  /* A missing appointment keeps the amber cell tint (attention cue) but stops
     shouting a bold placeholder + a second amber badge on top of it. */
  .shipment-container-ledger__schedule > strong:not(.ops-schedule__datetime) { font-weight: 400; color: var(--ink-2); }
  /* Customer name is the scan anchor: it outranked nothing at 12px. */
  .shipment-container-ledger tbody > tr > th .shipment-container-ledger__multiline > strong { font-size: 14px; font-weight: var(--fw-bold, 700); }

  /* Card anatomy instead of the 6px surface band: real elevation, rounded
     corners, and whitespace do the separation (consultation 3.2).
     SIL-516: width auto — the card-mode base rule sets width: 100% and these
     10px side margins would push the row 20px past the tbody (measured
     374px row + 20px margins in a 374px tbody at 390px — the row's right
     edge, and with it the TRẠNG THÁI cell, overflowed the table's box). */
  .shipment-container-ledger tbody > tr { width: auto; margin: 10px 10px 0; border: 1px solid var(--line-2); border-radius: 12px; overflow: hidden; box-shadow: 0 1px 2px color-mix(in srgb, var(--ink) 5%, transparent); }
  .shipment-container-ledger tbody > tr:last-child { margin-bottom: 10px; }

  /* SIL-149 phase 2 (tie-breaker 24/10, both consultants concurring): rows
     collapse the four LOW-frequency cells (Hãng tàu, Nhập/Xuất, 'Nâng / hạ',
     'Ghi chú') behind the th expander. The high-frequency edit lanes —
     lịch hẹn, phân xe, tờ khai — stay on the card face. The expander is the
     th trigger's SIBLING (never nested inside the react-aria button), and an
     editor opened from the missing-fields chip keeps rendering through the
     editing-cell override below even while its base cell is collapsed. */
  .shipment-container-ledger tbody > tr > th { position: relative; }
  .shipment-container-ledger tbody > tr > th .shipment-container-ledger__cell-trigger { padding-right: 52px; }
  .shipment-container-ledger__row-toggle {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .shipment-container-ledger__row-toggle svg { width: 20px; height: 20px; transition: transform 150ms ease; }
  .shipment-container-ledger__row-toggle[aria-expanded=\"true\"] svg { transform: rotate(180deg); }
  .shipment-container-ledger tbody > tr[data-expanded=\"false\"] > td[data-label='Hãng tàu'],
  .shipment-container-ledger tbody > tr[data-expanded=\"false\"] > td[data-label='Nhập/Xuất'],
  .shipment-container-ledger tbody > tr[data-expanded=\"false\"] > td[data-label='Nâng / hạ'],
  .shipment-container-ledger tbody > tr[data-expanded=\"false\"] > td[data-label='Ghi chú'] { display: none !important; }
  .shipment-container-ledger tbody > tr[data-expanded=\"false\"] > td.shipment-container-ledger__editing-cell { display: block !important; }

  /* SIL-150 (C-chrome, consultation 24/10): reclaim the phone top-of-page.
     The rail reads as one 40px scrollable strip instead of the 2×2 pairing,
     and the filter bar packs tight — the quick-range strip drops because the
     page passes the SAME ranges into the 'Bộ lọc' dialog. Control geometry
     stays with control-geometry.css: only gaps, padding, and visibility. */
  .shipments-detail-workspace .summary-rail { margin: 8px 10px 0; }
  .shipments-detail-workspace .summary-rail dl { display: flex; flex-direction: row; align-items: center; gap: 14px; height: 40px; margin: 0; overflow-x: auto; scrollbar-width: none; }
  .shipments-detail-workspace .summary-rail dl::-webkit-scrollbar { display: none; }
  .shipments-detail-workspace .summary-rail .summary-rail__item { flex: 0 0 auto; flex-direction: row; align-items: baseline; gap: 5px; padding: 0; border-right: 0; }
  .shipments-detail-workspace .summary-rail dt,
  .shipments-detail-workspace .summary-rail dd { white-space: nowrap; }
  /* Filter layout/gaps belong to FilterBar (card 20260927_152 law); the page
     only tightens the card padding and drops the quick-range strip (the
     'Bộ lọc' dialog carries the same ranges). */
  .shipments-detail-filters .filter-bar { padding: 8px; }
  .shipments-detail-filters .filter-bar__presets { display: none; }
  .shipments-detail-filters .filter-bar__search-cell { flex: 1 1 100%; }
}

/* Stack labels above values inside tablet record blocks. A fixed 96px label
   column otherwise leaves too little room for container and document codes. */
@container shipments-detail (min-width: 641px) and (max-width: 1000px) {
  .shipment-container-ledger__editable-cell > .shipment-container-ledger__cell-editor > .shipment-container-ledger__cell-trigger {
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
    align-content: start;
  }
  .shipment-container-ledger__editable-cell > .shipment-container-ledger__cell-editor > .shipment-container-ledger__cell-trigger::before {
    position: static;
    width: auto;
    grid-column: 1;
  }
  .shipment-container-ledger__cell-trigger > :not(.shipment-container-ledger__edit-purpose) { grid-column: 1; }
  .shipment-container-ledger tbody > tr > td[data-label=\"Ghi chú\"] {
    grid-column: 1 / -1;
    min-height: 0;
    border-right: 0;
  }
  .shipment-container-ledger__cell-editor[data-mode=\"notes\"] > .shipment-container-ledger__cell-trigger { min-height: 0; }
  .shipment-container-ledger tbody > tr > td[data-label=\"Trạng thái\"] {
    display: flex;
    align-items: center;
    gap: 6px 12px;
    min-height: 44px;
  }
  .shipment-container-ledger__cell--status > .shipment-container-ledger__multiline {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 12px;
  }
}

/* Native controls share the same boundary token as the md shared selector. */
@media (pointer: coarse) {
  .shipment-container-ledger__editor-grid input:not([data-uui-control] input),
  .shipment-container-ledger__editor-grid select,
  .shipment-container-ledger__editor-grid .searchable-select__trigger { height: var(--control-touch-h); min-height: var(--control-touch-h); }
}

/* Card 20260927_152: the \"Cột hiển thị\" filter-footer row (20260917_4) is
   deleted with the rest of the page-local filter layout. It had no consumer left
   in the TSX, and its declarations are exactly the family the card bans on a
   filter container (a flex row with its own wrap, alignment, gap and a
   `grid-column` span) — dead weight the next session would have read as a live
   width contract. */

/* Card 20261009_3 rework (2026-10-09): the phone tier zeroes the page's own
   trailing padding — the ≤640 shell band max(16px, env(safe-area-inset-bottom))
   is the single, counted-once trailing clearance (owner ruling: kill the
   double-counted bottom dead band). */
@media (max-width: 640px) {
  .shipments-detail-page { padding-bottom: 0; }
}

/* Card 20261009_3 — \"Chỉnh sửa khách hàng và lộ trình\" docks as a bottom
   sheet on phones (user iOS capture: the editor opened as an undocked card
   ~19% above the physical bottom). The editor is portaled to body at ≤640px
   (ShipmentContainerLedger) because the page's `container-type: inline-size`
   makes it the containing block for position:fixed descendants — an in-tree
   fixed sheet would anchor to the scrolling page box, not the viewport. The
   docked values mirror the house pattern (DispatchAllocationPopover ≤680px
   radius/height budget; SearchableSelect ≤640px backdrop). Every edit mode
   renders through the same InlineEditor element, so this one rule set is the
   shared implementation for all seven editors. */
@media (max-width: 640px) {
  .shipment-container-ledger__inline-editor--sheet {
    position: fixed;
    z-index: var(--z-popover, 400);
    top: auto;
    bottom: 0;
    left: 0;
    right: 0;
    width: auto;
    min-width: 0;
    max-width: none;
    margin: 0;
    border-inline: 0;
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    padding-bottom: max(16px, env(safe-area-inset-bottom, 0px));
    max-height: calc(100dvh - max(8px, env(safe-area-inset-top, 0px)));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .shipment-container-ledger__sheet-backdrop {
    position: fixed;
    z-index: calc(var(--z-popover, 400) - 1);
    inset: 0;
    background: rgba(12, 24, 17, 0.46);
  }

  /* The sheet lives outside #root .app, so the product-wide flat-surface
     reset must be restated on the portaled subtree. */
  .shipment-container-ledger__inline-editor--sheet,
  .shipment-container-ledger__inline-editor--sheet * {
    box-shadow: none;
    text-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
}
