  .shipment-container-ledger__col--direction { width: 7%; }
  .shipment-container-ledger__col--shippingline { width: 9%; }
  .shipment-container-ledger__col--container { width: 10%; }
  .shipment-container-ledger__col--route { width: 4%; }
  .shipment-container-ledger__col--schedule { width: 8%; }
  .shipment-container-ledger__col--vehicle { width: 12%; }
  .shipment-container-ledger__col--notes { width: 7%; }
  .shipment-container-ledger__col--status { width: 8%; }
  .shipment-container-ledger__col--actions { width: 9%; }
  .shipment-container-ledger__col--select { width: 3%; }
}
/* 761-1100px is desktop layout on auto sizing (card mode starts at 760px), so
