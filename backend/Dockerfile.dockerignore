# Backend image allowlist. Keep the root context so pnpm workspace links work,
# but send only files referenced by backend/Dockerfile.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json

!shared/
shared/*
!shared/package.json
!shared/tsconfig.json
!shared/fix-esm-imports.js
!shared/src/
!shared/src/**
shared/src/**/*.test.ts
shared/src/**/*.spec.ts

!backend/
backend/*
!backend/package.json
!backend/tsconfig.json
!backend/tsconfig.build.json
!backend/fix-esm-imports.js
!backend/drizzle.config.ts
!backend/drizzle/
backend/drizzle/*
!backend/drizzle/*.sql
!backend/drizzle/meta/
backend/drizzle/meta/*
!backend/drizzle/meta/_journal.json
!backend/src/
!backend/src/**
backend/src/tests/
backend/src/**/*.test.ts
backend/src/**/*.spec.ts

!frontend/
frontend/*
!frontend/public/
frontend/public/*
!frontend/public/fonts/
frontend/public/fonts/*
!frontend/public/fonts/BeVietnamPro-Regular.ttf
!frontend/public/fonts/BeVietnamPro-SemiBold.ttf
