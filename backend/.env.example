PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5441/silversea
# Two-checkout trap: THIS checkout (prod lane) talks to ss-prod-redis on 6391.
# The ss-main checkout uses 6392 — if you run both trees, each backend/.env must
# name its own container port, or session validation fails closed with 503s.
REDIS_URL=redis://localhost:6391
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads
NODE_ENV=development

# ── OCR provider ──────────────────────────────────────────────────────────
# OCR runs exclusively on OpenRouter (Qwen 2-tier chain: qwen3-vl-32b-instruct
# → qwen3.7-plus), matching vantaiphucloc. Enabled by the key being non-empty.
#
# ONLY the OpenRouter API key is read from here. The base URL
# (https://openrouter.ai/api/v1) and the model chain are hardcoded constants
# in backend/src/services/ocr.service.ts — change them in code, not here.
OPENROUTER_API_KEY=

# Map4D place search (api.map4d.vn) — the provider the Bách Khoa portal embeds.
# Powers place autocomplete + geocoding (replaces OpenStreetMap/Nominatim).
# The key alone authenticates (?key=); results cached ~3 months in Redis.
# Leave empty to disable (search/geocoding degrade to empty).
MAP4D_API_KEY=
MAP4D_API_URL=https://api.map4d.vn

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tingting.vip

# Driver-app spec (260827): the Ops field-operations paper-order handoff gate
# is temporarily bypassed (drivers can accept the instant a plate is
# assigned). Flip to true once the Ops module ships to restore the strict
# gate. OFF by default.
DRIVER_OPS_PAPER_ORDER_GATE_ENABLED=false
