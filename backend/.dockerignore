# Backend image allowlist. Keep the root context so pnpm workspace links work,
# but send only files referenced by backend/Dockerfile.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json

!shared/
shared/*
!shared/package.json
!shared/tsconfig.json
!shared/fix-esm-imports.js
!shared/src/
!shared/src/**
shared/src/**/*.test.ts
shared/src/**/*.spec.ts

!backend/
backend/*
!backend/package.json
!backend/tsconfig.json
!backend/tsconfig.build.json
!backend/fix-esm-imports.js
!backend/drizzle/
!backend/drizzle/**
backend/drizzle/**/*.md
!backend/src/
!backend/src/**
backend/src/**/*.test.ts
backend/src/**/*.spec.ts
backend/src/**/__tests__/
