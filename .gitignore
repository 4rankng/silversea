# Understand-Anything knowledge base: commit the graph (shared across team/agents),
# ignore transient scratch/intermediate dirs produced during analysis.
.ua/*
!.ua/config.json
!.ua/knowledge-graph.json
!.ua/meta.json
!.ua/fingerprints.json
!.ua/.understandignore
