#!/usr/bin/env bash
# Compile gate (incident 2026-09-05: a mid-refactor file with corrupted JSX
# reached main via a sweep commit and main did not compile for ~20 minutes).
# AGENTS.md already mandates "QA gates -> commit"; this makes the compile bar
# mechanical. Gate = the working tree must typecheck when staged files touch it.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
fe=0; be=0
while IFS= read -r f; do
  case "$f" in
    frontend/src/*.ts|frontend/src/*.tsx) fe=1 ;;
    backend/src/*.ts|backend/src/*.tsx) be=1 ;;
  esac
done < <(git -C "$root" diff --cached --name-only)

fail=0
if [ "$fe" -eq 1 ]; then
  echo "[pre-commit] typechecking frontend…"
  (cd "$root/frontend" && pnpm exec tsc --noEmit) || fail=1
  # Structure ratchet (incident 2026-09-08: allocation workstream landed two
  # api-client files over their frozen LOC ceilings because this hook only
  # typechecked). ~1s: the ratchet must gate mechanically, like the compile
  # bar above, not rely on a full-suite run catching it later.
  echo "[pre-commit] structure guard (LOC ceilings)…"
  (cd "$root/frontend" && pnpm vitest run src/tests/structure.guard.test.ts) || fail=1
fi
if [ "$be" -eq 1 ]; then
  echo "[pre-commit] typechecking backend…"
  (cd "$root/backend" && pnpm exec tsc --noEmit -p tsconfig.build.json) || fail=1
fi

if [ "$fail" -eq 1 ]; then
  echo "" >&2
  echo "✗ pre-commit typecheck FAILED — commit refused." >&2
  echo "  Fix the errors above. Escape hatch: git commit --no-verify" >&2
  echo "  (if you must bypass, say why in the commit body — a red main is worse)." >&2
  exit 1
fi
exit 0
# >>> code-review-graph pre-commit hook >>>
# Installed by code-review-graph. Remove this file to disable pre-commit graph checks.
if command -v code-review-graph >/dev/null 2>&1; then
    crg_hook_git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) || crg_hook_git_dir=""
    crg_hook_root=$(git rev-parse --show-toplevel 2>/dev/null) || crg_hook_root=""
    if [ -z "$crg_hook_git_dir" ] || [ -z "$crg_hook_root" ]; then
        echo "code-review-graph: skipping automatic checks; cannot determine the Git worktree." >&2
    elif [ -f "$crg_hook_git_dir/commondir" ] && [ "$CRG_HOOK_WORKTREES" != "1" ]; then
        # Only a linked worktree's git dir carries a commondir file (Git 2.5+),
        # so this needs no rev-parse options newer than --absolute-git-dir.
        echo "code-review-graph: skipping automatic checks in a linked worktree;" \
            "set CRG_HOOK_WORKTREES=1 to keep a graph for this worktree too." >&2
    else
        code-review-graph update --repo "$crg_hook_root" || true
        code-review-graph detect-changes --brief --repo "$crg_hook_root" || true
    fi
fi
# <<< code-review-graph pre-commit hook <<<
