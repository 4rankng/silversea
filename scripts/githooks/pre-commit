#!/usr/bin/env bash
# Compile gate (incident 2026-09-05: a mid-refactor file with corrupted JSX
# reached main via a sweep commit and main did not compile for ~20 minutes).
# AGENTS.md already mandates "QA gates -> commit"; this makes the compile bar
# mechanical. Gate = the working tree must typecheck when staged files touch it.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
fe=0; be=0; journal=0; be_tests=0
while IFS= read -r f; do
  case "$f" in
    frontend/src/*.ts|frontend/src/*.tsx) fe=1 ;;
    # Card 20260928_201: this arm must stay ABOVE the plain backend arm. A bash
    # `case` glob `*` matches `/`, so backend/src/*.ts already matches
    # backend/src/tests/**; this arm is first so test files also set be_tests.
    backend/src/tests/*|backend/src/*.test.ts|backend/src/*.spec.ts) be=1; be_tests=1 ;;
    backend/src/*.ts|backend/src/*.tsx) be=1 ;;
    backend/drizzle/meta/_journal.json) journal=1 ;;
  esac
done < <(git -C "$root" diff --cached --name-only)

fail=0
# Journal append-only law (card 20260924_25): any staged _journal.json change
# must be a pure trailing append. Renumber/delete/reorder of shipped entries
# is refused here — the 09-24 alarm class had no other tripwire. Lead-signed
# repairs carry the "Journal-Repair: signed-by <lead>" commit trailer.
if [ "$journal" -eq 1 ]; then
  echo "[pre-commit] journal append-only guard…"
  (cd "$root/backend" && node scripts/guard-journal-append-only.mjs) || fail=1
  # Coherence of whatever the append-only guard just let through: journal ↔ .sql
  # must stay a bijection and the ordering laws the runtime migrator keys on
  # (strictly increasing idx, non-decreasing `when`) must hold. The guard only
  # inspects the diff; this inspects the resulting tree. ~0.1s.
  #
  # Card 20260928_188: the guard's remedy line used to tell operators to run
  # `node scripts/check-migration-trio.mjs`, which had never existed. It exists
  # now and runs here, so the advice is mechanical instead of optional.
  echo "[pre-commit] migration trio coherence…"
  (cd "$root" && node scripts/check-migration-trio.mjs) || fail=1
fi
if [ "$fe" -eq 1 ]; then
  echo "[pre-commit] typechecking frontend…"
  # --incremental false: the 2026-09-30 miss. The project is `incremental: true`
  # against a persistent .tsbuildinfo, so a file whose recorded version had not
  # moved was not re-checked — 29 unresolvable import specifiers (a rewrite that
  # pointed src/pages/* at ../../lib/format, i.e. outside src) committed green
  # and the first thing to catch them was the docker image build. A full check
  # per commit is exactly what this bar is for; --no-verify remains the
  # documented escape hatch for when it is too slow.
  (cd "$root/frontend" && pnpm exec tsc --noEmit --incremental false) || fail=1
  # Structure ratchet (incident 2026-09-08: allocation workstream landed two
  # api-client files over their frozen LOC ceilings because this hook only
  # typechecked). ~0.1s as a plain node script (card 20261003_308): the
  # ratchet must gate mechanically, like the compile bar above, not rely on a
  # full-suite run catching it later. The vitest boot it replaced held
  # .git/index.lock for ~11s+ per commit and caused both 03-10 stale locks.
  echo "[pre-commit] structure guard (LOC ceilings)…"
  (cd "$root/frontend" && node scripts/check-structure.mjs) || fail=1
  # Design-drift ratchet (operator 2026-09-27: "UI UX are all random piecemeals
  # per page"). ~0.2s, no browser: counts raw hex / off-ladder radii / raw
  # shadows / raw z-index / untokenized transitions / distinct breakpoints in
  # page CSS and refuses any increase over the committed baseline. Cleaning up
  # is free; adding a raw value must be deliberate.
  echo "[pre-commit] design drift ratchet…"
  (cd "$root/frontend" && node scripts/check-design-drift.mjs) || fail=1
fi
if [ "$be" -eq 1 ]; then
  if [ "$be_tests" -eq 1 ]; then
    # Card 20260928_201: tsconfig.build.json EXCLUDES src/tests, so every
    # backend test file was invisible to this hook — 4 real type errors reached
    # two landings with a green hook. tsconfig.json is a strict superset (the
    # build config only adds `exclude`), so one run covers build AND tests; the
    # cheaper build-only run is kept for the no-test-files case.
    echo "[pre-commit] typechecking backend (incl. tests)…"
    (cd "$root/backend" && pnpm exec tsc --noEmit) || fail=1
  else
    echo "[pre-commit] typechecking backend…"
    (cd "$root/backend" && pnpm exec tsc --noEmit -p tsconfig.build.json) || fail=1
  fi
fi

if [ "$fail" -eq 1 ]; then
  echo "" >&2
  echo "✗ pre-commit typecheck FAILED — commit refused." >&2
  echo "  Fix the errors above. Escape hatch: git commit --no-verify" >&2
  echo "  (if you must bypass, say why in the commit body — a red main is worse)." >&2
  exit 1
fi

# The graph block below used to sit after the `exit 0` this gate ended with, so
# it never ran in this repo (the 2026-09-30 audit found it dead). It is kept
# reachable and last: it only runs on a commit the gates above accepted, and its
# own `|| true` guards mean it can never block one.
# >>> code-review-graph pre-commit hook >>>
# Installed by code-review-graph. Remove this file to disable pre-commit graph checks.
if command -v code-review-graph >/dev/null 2>&1; then
    crg_hook_git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) || crg_hook_git_dir=""
    crg_hook_root=$(git rev-parse --show-toplevel 2>/dev/null) || crg_hook_root=""
    if [ -z "$crg_hook_git_dir" ] || [ -z "$crg_hook_root" ]; then
        echo "code-review-graph: skipping automatic checks; cannot determine the Git worktree." >&2
    elif [ -f "$crg_hook_git_dir/commondir" ] && [ "$CRG_HOOK_WORKTREES" != "1" ]; then
        # Only a linked worktree's git dir carries a commondir file (Git 2.5+),
        # so this needs no rev-parse options newer than --absolute-git-dir.
        echo "code-review-graph: skipping automatic checks in a linked worktree;" \
            "set CRG_HOOK_WORKTREES=1 to keep a graph for this worktree too." >&2
    else
        code-review-graph update --repo "$crg_hook_root" || true
        code-review-graph detect-changes --brief --repo "$crg_hook_root" || true
    fi
fi
# <<< code-review-graph pre-commit hook <<<

exit 0
