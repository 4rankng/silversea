{
  "$schema": "https://cdn-zcode.z.ai/schemas/config.json",
  "hooks": {
    "enabled": true,
    "events": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/.zcode/hooks/understand-staleness.sh\"",
              "timeout": 10,
              "statusMessage": "Checking knowledge-base freshness"
            }
          ]
        }
      ]
    }
  }
}
