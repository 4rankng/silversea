{
  "name": "@tingting/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:strict": "tsc -b && node scripts/check-size.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "size-check": "node scripts/check-size.mjs",
    "generate:brand": "node scripts/generate-transting-brand-assets.mjs",
    "check:ui": "node scripts/check-ui-contract.mjs && node scripts/check-brand-contract.mjs",
    "check:brand": "node scripts/check-brand-contract.mjs",
    "lint": "eslint .",
    "uui:login": "npx --yes untitledui@0.1.63 login",
    "uui:search": "npx --yes untitledui@0.1.63 search --lib-version 8",
    "uui:add:base": "npx --yes untitledui@0.1.63 add --dir . --path components/untitled-ui --type base --lib-version 8",
    "uui:add:application": "npx --yes untitledui@0.1.63 add --dir . --path components/untitled-ui --type application --lib-version 8",
    "uui:add:foundations": "npx --yes untitledui@0.1.63 add --dir . --path components/untitled-ui --type foundations --lib-version 8"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-select": "^2.3.0",
    "@react-types/shared": "^3.36.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tingting/shared": "workspace:*",
    "@untitledui/icons": "^0.0.22",
    "animejs": "^4.4.1",
    "driver.js": "^1.6.0",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "react-stately": "^3.49.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.19",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "daisyui": "^5.6.18",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
