/* ============================================================================
 * DebtListPage — Bento Grid Layout
 * TingTing AR Receivables · Vantai design system
 * ========================================================================== */

/* Breadcrumb trail — consistent with TripListPage / detail pages. */
.debt-list-page__crumbs {
  margin: 2px 0 10px;
  color: var(--ink-3);
  font-size: 12px;
}
.debt-list-page__crumbs ul { gap: 4px; }

/* ════════════════════════════════════════════════════════════════════════════
 *  ZONE 1 — Hero KPI Row (page-specific overrides on shared HeroKpiRow.css)
 * ════════════════════════════════════════════════════════════════════════════ */

/* Debt page: smaller gap, bottom margin */
.debt-hero-row {
  gap: 14px;
  margin-bottom: 14px;
}

/* Debt page: hero card uses horizontal layout (flex row) instead of column */
.debt-hero {
  position: relative;
  display: block;
  min-height: 160px;
  padding: 16px 18px;
  border-radius: 16px;
  border: 1px solid var(--line, rgba(0, 0, 0, 0.08));
  overflow: hidden;
}

.debt-hero__content {
  position: relative;
  z-index: 1;
  max-width: none;
  min-width: 0;
}

.debt-hero__amount {
  display: flex;
  align-items: baseline;
  gap: 6px;
  line-height: 1.35;
}

.debt-hero__amount > span,
.debt-aging-card__amount > span {
  line-height: 1.35;
}

.debt-hero__currency {
  font-size: var(--fs-xs);
  line-height: 1.35;
  font-weight: 600;
  opacity: 0.6;
}

.debt-hero__art {
  position: absolute;
  right: 14px;
  bottom: 8px;
  z-index: 0;
  width: 176px;
  height: 104px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0.5;
}

.debt-hero__art::before {
  content: "";
  position: absolute;
  inset: 4px 6px 2px 2px;
  border-radius: 22px;
  background:
    radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0) 58%),
    linear-gradient(150deg, rgba(0, 177, 79, 0.12), rgba(0, 177, 79, 0.01));
  border: 1px solid rgba(0, 177, 79, 0.08);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
}

.debt-hero__illustration {
  position: relative;
  z-index: 1;
  width: 144px;
  height: 94px;
  object-fit: contain;
  filter: saturate(0.92) drop-shadow(0 10px 18px rgba(15, 23, 42, 0.08));
}

/* Debt page: watermark tints for danger/warning mini KPIs */
.hero-kpi-mini.debt-kpi-mini--danger { --stat-rail: var(--danger); }
.hero-kpi-mini.debt-kpi-mini--warning { --stat-rail: var(--warning); }
.debt-kpi-mini--danger .hero-kpi-mini__watermark { color: rgba(227, 36, 52, 0.14); }
.debt-kpi-mini--warning .hero-kpi-mini__watermark { color: rgba(217, 119, 6, 0.14); }

/* Debt page: colored values for danger/warning mini KPIs */
.debt-kpi-mini--danger .hero-kpi-mini__value {
  color: var(--danger);
}

.debt-kpi-mini--warning .hero-kpi-mini__value {
  color: var(--warning-text);
}

.debt-kpi-mini__asset {
  right: 12px;
  bottom: 8px;
}

.debt-kpi-mini__asset img {
  display: block;
  width: 38px;
  height: 38px;
  object-fit: contain;
  opacity: 0.94;
  filter: drop-shadow(0 4px 10px rgba(15, 23, 42, 0.10));
}

/* Debt page: smaller gap in stack */
.debt-kpi-stack {
  gap: 14px;
}

/* ════════════════════════════════════════════════════════════════════════════
 *  ZONE 2 — Aging Distribution Grid (4 equal glass cards)
 * ════════════════════════════════════════════════════════════════════════════ */

.debt-aging-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 14px;
}

.debt-aging-card {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 18px 20px;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 18px;
  position: relative;
  box-shadow: 0 1px 2px rgba(9, 9, 11, 0.04);
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  color: inherit;
  transition:
    transform 0.15s var(--ease),
    box-shadow 0.15s var(--ease),
    border-color 0.2s var(--ease);
}

.debt-aging-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(9, 9, 11, 0.07);
}

.debt-aging-card.is-active {
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 2px 8px rgba(9, 9, 11, 0.06);
}

/* Status strip — 3×20px centered indicator, NOT full-height border */
.debt-aging-card.is-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 20px;
  border-radius: 0 2px 2px 0;
  background: var(--bucket-color, var(--accent));
}

.debt-aging-card__header {
  display: flex;
  align-items: center;
  gap: 7px;
}

.debt-aging__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.debt-aging__dot--ok     { background: var(--accent); }
.debt-aging__dot--warn   { background: var(--warning); }
.debt-aging__dot--deep   { background: var(--warning-deep); }
.debt-aging__dot--danger { background: var(--danger); }

.debt-aging-card__label {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-3);
}

.debt-aging-card__amount {
  display: flex;
  align-items: baseline;
  gap: 4px;
  font-family: var(--font-display);
  font-size: 22px;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.25;
  color: var(--ink);
}

.debt-aging-card__unit {
  font-size: 14px;
  line-height: 1.35;
  font-weight: 500;
  color: var(--ink-3);
}

.debt-aging-card__count {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: var(--ink-3);
}

.debt-aging-card__bar-track {
  height: 4px;
  background: var(--surface-3);
  border-radius: 2px;
  overflow: hidden;
  margin-top: 4px;
}

.debt-aging-card__bar-fill {
  height: 100%;
  border-radius: 2px;
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

/* ════════════════════════════════════════════════════════════════════════════
 *  ZONE 3 — Data Card (full-width glass card)
 * ════════════════════════════════════════════════════════════════════════════ */

.debt-data-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 18px;
  padding: 18px 20px;
  box-shadow: 0 1px 2px rgba(9, 9, 11, 0.04);
}

/* ── Filter bar inside data card ── */

.debt-filter-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
  flex-wrap: wrap;
  padding: 10px 12px;
  border: 1px solid rgba(15, 23, 42, 0.06);
  border-radius: 16px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(245, 248, 246, 0.92)),
    rgba(255, 255, 255, 0.82);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
}

.debt-filter-pills {
  display: flex;
  align-items: center;
  gap: 8px;
}

.debt-filter-bar .filter-pill {
  padding: 8px 14px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(243, 246, 244, 0.96));
  border-color: rgba(15, 23, 42, 0.08);
  color: var(--ink-2);
  box-shadow: 0 6px 16px rgba(15, 23, 42, 0.05);
}

.debt-filter-bar .filter-pill:hover {
  background: linear-gradient(180deg, #ffffff, #f6faf7);
  border-color: rgba(0, 177, 79, 0.18);
  color: var(--ink);
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.07);
}

.debt-filter-bar .filter-pill.is-active {
  background: linear-gradient(180deg, #18211d, #0f1613);
  border-color: #101814;
  color: #f7fbf8;
  box-shadow: 0 10px 24px rgba(16, 24, 20, 0.18);
}

.debt-filter-bar .filter-pill__count {
  background: rgba(15, 23, 42, 0.08);
  color: var(--ink-2);
}

.debt-filter-bar .filter-pill.is-active .filter-pill__count {
  background: rgba(255, 255, 255, 0.16);
  color: #f7fbf8;
}

.debt-filter-spacer {
  flex: 1;
  min-width: 0;
}

.debt-filter-search {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 44px;
  flex: 1 1 320px;
  background: linear-gradient(180deg, #ffffff, #f4f7f5);
  border: 1px solid rgba(15, 23, 42, 0.10);
  border-radius: 12px;
  min-width: 180px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85), 0 4px 14px rgba(15, 23, 42, 0.04);
  transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
}

.debt-filter-search:focus-within {
  background: #ffffff;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

.debt-filter-search svg {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  color: color-mix(in srgb, var(--ink-3) 78%, var(--accent) 22%);
  pointer-events: none;
  flex-shrink: 0;
}

.debt-filter-search input {
  width: 100%;
  padding: 0 10px 0 32px;
  background: transparent;
  border: none;
  outline: none;
  font-size: var(--fs-xs);
  color: var(--ink);
  font-weight: 500;
  min-height: 44px;
}

.debt-filter-search input::placeholder {
  color: color-mix(in srgb, var(--ink-3) 84%, white);
  opacity: 1;
}

.debt-list-table {
  table-layout: fixed;
}

.debt-list-table thead th:nth-child(1) {
  width: 46%;
}

.debt-list-table thead th:nth-child(2),
.debt-list-table thead th:nth-child(3) {
  width: 16%;
}

.debt-list-table thead th:nth-child(4) {
  width: 12%;
}

.debt-list-table__customer {
  white-space: normal;
}

.debt-list-table__customer-main {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  font-weight: 600;
  color: var(--fg-1);
}

.debt-list-table__customer-name {
  min-width: 0;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
  line-height: 1.35;
}

/* ════════════════════════════════════════════════════════════════════════════
 *  Mobile overrides (≤640px)
 * ════════════════════════════════════════════════════════════════════════════ */

@media (max-width: 768px) {
  /* Hero row: 2-col with hero spanning full width */
  .debt-list-page .hero-kpi-row {
    grid-template-columns: 1fr 1fr;
  }
  .debt-list-page .hero-kpi-card.debt-hero {
    grid-column: 1 / -1;
    min-height: 148px;
    padding: 16px 18px;
  }
  .debt-hero__art {
    right: 12px;
    bottom: 8px;
    width: 160px;
    height: 96px;
  }
  .debt-hero__illustration {
    width: 128px;
    height: 84px;
  }
  /* Mini KPIs: side by side on tablet */
  .debt-list-page .hero-kpi-stack.debt-kpi-stack {
    flex-direction: row;
    grid-column: 1 / -1;
  }
  .debt-list-page .hero-kpi-mini {
    flex: 1;
  }
  /* Aging: 2x2 grid */
  .debt-aging-grid {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
}

@media (max-width: 640px) {
  /* Hero row: single column, everything stacked */
  .debt-list-page .hero-kpi-row.debt-hero-row {
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .debt-list-page .hero-kpi-card.debt-hero {
    grid-column: auto;
    min-height: 136px;
    padding: 16px;
    gap: 10px;
  }
  .debt-list-page .hero-kpi-card__amount.debt-hero__amount {
    font-size: 24px;
  }
  .debt-hero__art {
    right: 10px;
    bottom: 8px;
    width: 144px;
    height: 88px;
  }
  .debt-hero__art::before {
    inset: 4px 6px 2px 2px;
  }
  .debt-hero__illustration {
    width: 118px;
    height: 78px;
  }
  .debt-list-page .hero-kpi-stack.debt-kpi-stack {
    flex-direction: row;
    grid-column: auto;
    gap: 10px;
  }

  /* Aging: 2x2 compact */
  .debt-aging-grid {
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .debt-aging-card {
    padding: 12px 14px;
    border-radius: 14px;
  }
  .debt-aging-card__amount {
    font-size: 17px;
  }

  /* Data card compact */
  .debt-data-card {
    border-radius: 14px;
    padding: 12px 14px;
  }

  /* Filter bar mobile */
  .debt-filter-bar {
    gap: 6px;
    padding: 8px;
  }
  .debt-filter-pills {
    flex-wrap: wrap;
    gap: 6px;
  }
  .debt-filter-search {
    width: 100%;
    min-width: 0;
    max-width: none;
    order: 99;
  }

  /* Mobile card amount styling */
  .debt-list-page .m-card .debt-list-page__amount {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0;
  }
}

/* ════════════════════════════════════════════════════════════════════════════
 *  Narrow phone (≤420px) — ultra-compact
 * ════════════════════════════════════════════════════════════════════════════ */

@media (max-width: 420px) {
  .debt-list-page .hero-kpi-card__amount.debt-hero__amount {
    font-size: 22px;
  }
  .debt-hero__art {
    width: 132px;
    height: 82px;
  }
  .debt-hero__illustration {
    width: 108px;
    height: 72px;
  }
  .debt-list-page .hero-kpi-mini {
    padding: 10px 12px;
    gap: 10px;
  }
  .debt-list-page .hero-kpi-mini__value {
    font-size: 16px;
  }
  .debt-kpi-mini__asset img {
    width: 30px;
    height: 30px;
  }
  .debt-aging-card__amount {
    font-size: 15px;
  }
}

/* ════════════════════════════════════════════════════════════════════════════
 *  Loading state — centered spinner + label
 * ════════════════════════════════════════════════════════════════════════════ */
.debt-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 56px 24px;
  color: var(--ink-3, #5e6b76);
  font-size: var(--fs-sm);
}
.debt-loading__spin {
  color: var(--accent, #00b14f);
  animation: debt-loading-spin 0.9s linear infinite;
}
@keyframes debt-loading-spin {
  to { transform: rotate(360deg); }
}
@media (prefers-reduced-motion: reduce) {
  .debt-loading__spin {
    animation: none;
  }
}
</file>

