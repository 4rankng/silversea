.advance-workspace__views a {
  min-width: 0;
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 8px 16px;
  color: var(--ink-2);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  text-align: center;
  text-decoration: none;
}

.advance-workspace__views a + a {
  border-left: 1px solid var(--line);
}

.advance-workspace__views a:hover {
  background: var(--surface-2);
  color: var(--ink);
}

.advance-workspace__views a.is-active {
  background: var(--accent-soft);
  color: var(--accent);
