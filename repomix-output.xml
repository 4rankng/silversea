describe('O01 two-way dispatch pairing routes', () => {
  test('ADMIN can create a valid pair and duplicate pairing is rejected', async () => {
    const firstSeed: TripAuthoritySeed = {
      plannedStartAt: '2026-07-27T08:00:00',
