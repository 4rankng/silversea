                          className="btn btn--secondary btn--sm"
                          disabled={postPeriodMutation.isPending || lifecycle.version == null}
                          onClick={() => {
                            if (lifecycle.version == null) return;
                            postPeriodMutation.mutate(
                              { expectedVersion: lifecycle.version },
                              {
                                onSuccess: () => {
