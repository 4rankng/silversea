<file path="frontend/src/components/shared/Banner.css">
/* nepo-banner — persistent page-top banner.
 * Sticky by default, spans page width, dismissible, optional per-key memory.
 * Pure NEPO tokens. No daisyUI .d-alert — sticky + full-bleed needs bespoke layout.
 * -------------------------------------------------------------------------- */

.nepo-banner {
  width: 100%;
  box-sizing: border-box;
  z-index: var(--z-sticky);
  font-family: var(--font-body);
  font-size: var(--fs-sm);
  line-height: var(--lh-snug);
  border: 1px solid transparent;
  border-radius: var(--r-lg);
}

.nepo-banner--sticky {
  position: sticky;
  top: 12px;
}

.nepo-banner__inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  grid-template-areas: "content action close";
  align-items: center;
  column-gap: 12px;
  row-gap: 8px;
  padding: 12px 14px;
  max-width: 100%;
}

.nepo-banner__content {
  grid-area: content;
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.nepo-banner__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: 0.9;
}

.nepo-banner__message {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.nepo-banner__message a {
  text-decoration: underline;
  text-underline-offset: 2px;
  opacity: 0.85;
}
.nepo-banner__message a:hover {
  opacity: 1;
}

.nepo-banner__action {
  grid-area: action;
  justify-self: end;
}

.nepo-banner__close {
  grid-area: close;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--control-h);
  height: var(--control-h);
  border: 0;
  background: transparent;
  color: inherit;
  opacity: 0.7;
  cursor: pointer;
  border-radius: var(--r-sm);
  transition: opacity var(--t-fast), background var(--t-fast);
  padding: 0;
}
.nepo-banner__close:hover {
  opacity: 1;
  background: color-mix(in srgb, currentColor 10%, transparent);
}
.nepo-banner__close:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
  opacity: 1;
}

/* ─── Variants — each uses NEPO semantic token pair (fill + on-fill text) ── */

.nepo-banner--info {
  background: var(--info-soft);
  color: var(--info-text);
  border-color: color-mix(in srgb, var(--info) 24%, transparent);
}
.nepo-banner--info .nepo-banner__icon { color: var(--info-text); }

.nepo-banner--success {
  background: var(--success-soft);
  color: var(--success-text);
  border-color: color-mix(in srgb, var(--success) 24%, transparent);
}
.nepo-banner--success .nepo-banner__icon { color: var(--success-text); }

.nepo-banner--warning {
  background: var(--warning-soft);
  color: var(--warning-text);
  border-color: color-mix(in srgb, var(--warning) 28%, transparent);
}
.nepo-banner--warning .nepo-banner__icon { color: var(--warning-text); }

.nepo-banner--danger {
  background: var(--danger-soft);
  color: var(--danger-text);
  border-color: color-mix(in srgb, var(--danger) 24%, transparent);
}
.nepo-banner--danger .nepo-banner__icon { color: var(--danger-text); }

/* ─── Mobile — compact two-row alert with controls in stable grid areas ─── */
@media (max-width: 640px) {
  .nepo-banner__inner {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "content close"
      "action action";
    align-items: start;
    padding: 10px 12px;
    column-gap: 8px;
    row-gap: 8px;
  }

  .nepo-banner__content {
    align-items: flex-start;
  }

  .nepo-banner__action {
    justify-self: start;
    padding-left: 28px;
  }

  .nepo-banner__close {
    min-width: 44px;
    min-height: 44px;
    margin: -8px -8px -8px 0;
  }
}
</file>

