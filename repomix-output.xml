async function withMockedNow<T>(
  context: TestContext,
  isoDateTime: string,
  run: () => Promise<T>,
): Promise<T> {
  context.mock.timers.enable({
    apis: ['Date'],
    now: new Date(isoDateTime),
  });
  try {
    return await run();
  } finally {
    context.mock.timers.reset();
  }
}

