}).strict();

export const PROFITABILITY_DIMENSIONS = [
  'CUSTOMER',
  'ROUTE',
  'TRUCK',
  'DISPATCHER',
  'SALESPERSON',
  'MONTH',
  'YEAR',
  'CONTAINER',
