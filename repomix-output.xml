	                            </button>
	                          )}
	                        </>
	                      )}
	                    </div>
	                    <SalaryConfirmationGovernanceList
	                      items={activeSalaryConfirmationActions}
	                      checkingActionId={
	                        checkConfirmMutation.variables?.actionId
	                        ?? checkUnconfirmMutation.variables?.actionId
	                        ?? null
	                      }
	                      approvingActionId={
	                        approveConfirmMutation.variables?.actionId
