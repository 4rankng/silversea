    assert.equal(directUpdate.data.version, dispatched.version + 1);

    const staleApply = await testFetch(`/${shipment.id}/change-requests/${requestId}/review`, {
      method: 'POST',
      token: managerToken,
      body: { resolution: 'APPLIED' },
    });
