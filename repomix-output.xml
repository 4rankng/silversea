/* ── Responsive overrides (from responsive.css decomposition) ── */
@media (max-width: 640px) {
  /* ── Debt detail page ── */
  .dd-header { grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 12px; }
  .dd-avatar { display: none; }
