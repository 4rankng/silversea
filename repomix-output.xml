  test('throws 404 on missing document', async () => {
    await assert.rejects(
      () => getDebitNoteForRender(99_999_999),
      (err: unknown) => err instanceof Error && 'statusCode' in err && (err as { statusCode: number }).statusCode === 404,
    );
