      type: 'insight_card',
      title: 'T',
      summary: 'S',
      widgets: [{
        type: 'kpi_grid',
        items: [{ label: 'X', value: 100, format: 'number' }],
      }],
    };
    assert.ok(agentResponseSchema.safeParse(response).success);
  });
});
