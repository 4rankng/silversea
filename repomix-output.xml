/* ---- Collapsed-rail tooltip ------------------------------------------------
 * Portal-rendered (see Sidebar.tsx) so it escapes the sidebar's overflow:hidden
 * and the nav's overflow scroll. Shown only in icon-only (collapsed) mode, where
 * the item labels are hidden and the native title attribute is too slow/unstyled.
 */
.rail-tooltip {
