}

function Kpi({
  label,
  value,
  meta,
  icon: Icon,
  loading,
  unavailable,
  tone = 'neutral',
}: {
  label: string;
  value: string;
  meta: string;
  icon: LucideIcon;
  loading: boolean;
  unavailable?: boolean;
  tone?: 'neutral' | 'positive' | 'danger';
}) {
  return (
    <article className={`accounting-kpi accounting-kpi--${tone}`} aria-busy={loading}>
