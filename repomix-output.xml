/* Document-template editor layout: nav + live preview + focused inspector. */
.debit-editor-page {
  background: var(--bg);
}

.debit-editor-topbar {
  position: static;
  z-index: auto;
  background: #fff;
  backdrop-filter: none;
}

.debit-editor-workspace {
  grid-template-columns: minmax(220px, 300px) minmax(0, 1fr);
  grid-template-areas:
    "nav inspector"
    "preview preview";
  gap: 18px;
  max-width: 1680px;
  margin: 0 auto;
  align-items: start;
}

.debit-editor-side-nav {
  grid-area: nav;
  position: static;
  display: grid;
  gap: 10px;
}

.debit-editor-side-nav button {
  position: relative;
  min-width: 0;
  display: grid;
  grid-template-columns: 24px minmax(0, 1fr);
  gap: 2px 10px;
  min-height: 58px;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.92);
  color: var(--ink-2);
  text-align: left;
  cursor: pointer;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
}

.debit-editor-side-nav button::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: var(--status-strip-width);
  height: var(--status-strip-height);
  border-radius: var(--status-strip-radius);
  background: transparent;
  transform: translateY(-50%);
}

.debit-editor-side-nav button:hover,
.debit-editor-side-nav button:focus-visible {
  border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
  color: var(--ink);
  outline: none;
}

.debit-editor-side-nav button.is-active {
  border-color: color-mix(in srgb, var(--accent) 34%, var(--line));
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
}

.debit-editor-side-nav button.is-active::before {
  background: var(--accent);
}

.debit-editor-side-nav svg {
  grid-row: span 2;
  align-self: center;
  color: currentColor;
  stroke-width: 1.8;
  width: 20px;
  height: 20px;
}

.debit-editor-side-nav span {
  min-width: 0;
  font-size: 14px;
  font-weight: 850;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.debit-editor-side-nav small {
  min-width: 0;
  color: var(--ink-2);
  font-size: var(--fs-xs);
  font-weight: 700;
  line-height: 1.35;
}

.debit-editor-preview-pane,
.debit-editor-inspector {
  min-width: 0;
}

.debit-editor-preview {
  position: static;
  order: initial;
  width: 100%;
  min-width: 0;
}

.debit-editor-preview__sheet {
  width: 100%;
  min-width: 0;
  border-radius: 10px;
  box-shadow: var(--sh);
}

.debit-editor-inspector {
  grid-area: inspector;
  position: static;
  display: grid;
  gap: 0;
  width: 100%;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: none;
  backdrop-filter: blur(12px) saturate(140%);
}

.debit-editor-inspector .debit-editor-settings,
.debit-editor-inspector .debit-editor-settings--issuer,
.debit-editor-inspector .debit-editor-settings--footer {
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  grid-template-areas: none;
  gap: 16px 20px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.debit-editor-inspector .debit-editor-settings--issuer {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-areas:
    "issuer-name issuer-name"
    "issuer-tax issuer-rep"
    "issuer-address issuer-address"
    "issuer-position issuer-account"
    "issuer-bank issuer-bank";
}

.debit-editor-inspector .debit-editor-settings--issuer .debit-editor-field {
  min-height: 82px;
}

@media (max-width: 620px) {
  .debit-editor-inspector .debit-editor-settings--issuer {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "issuer-name"
      "issuer-tax"
      "issuer-address"
      "issuer-rep"
      "issuer-position"
      "issuer-account"
      "issuer-bank";
  }
}

.debit-editor-inspector .debit-editor-settings--footer {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-areas:
    "group group"
    "left-label left-name"
    "right-label right-name"
    "terms terms";
}

.debit-editor-inspector .debit-editor-settings--footer .debit-editor-field:nth-child(1) {
  grid-area: group;
}

.debit-editor-inspector .debit-editor-settings--footer .debit-editor-field:nth-child(2) {
  grid-area: left-label;
}

.debit-editor-inspector .debit-editor-settings--footer .debit-editor-field:nth-child(3) {
  grid-area: left-name;
}

.debit-editor-inspector .debit-editor-settings--footer .debit-editor-field:nth-child(4) {
  grid-area: right-label;
}

.debit-editor-inspector .debit-editor-settings--footer .debit-editor-field:nth-child(5) {
  grid-area: right-name;
}

.debit-editor-inspector .debit-editor-settings--footer .debit-editor-field:nth-child(6) {
  grid-area: terms;
}

.debit-editor-inspector .debit-editor-field {
  gap: 7px;
}

.debit-editor-inspector .debit-editor-field > span {
  color: var(--ink-2);
  font-size: 12px;
  font-weight: 700;
  line-height: 1.2;
}

.debit-editor-inspector .debit-editor-settings .debit-editor-inline-textarea,
.debit-editor-inspector .debit-editor-settings .debit-editor-inline-input,
.debit-editor-inspector .debit-editor-settings .debit-editor-inline-select {
  height: 40px;
  min-height: 40px;
  padding: 0 12px;
  border: 1px solid var(--line-2);
  border-radius: 10px;
  background: #fff;
  box-shadow: none;
  color: #111827;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.25;
}

.debit-editor-inspector .debit-editor-settings .debit-editor-inline-select {
  padding-right: 34px;
}

.debit-editor-inspector .debit-editor-color {
  grid-template-columns: 42px minmax(0, 1fr);
  align-items: center;
  gap: 10px;
}

.debit-editor-inspector .debit-editor-color input[type='color'] {
  width: 40px;
  height: 40px;
  border-radius: 10px;
}

.debit-editor-inspector .debit-editor-check {
  width: fit-content;
  min-height: 40px;
  align-self: end;
  color: var(--ink-2);
  font-size: 13px;
  font-weight: 750;
}

.debit-editor-inspector .debit-editor-table-wrap {
  border-radius: 8px;
  box-shadow: none;
}

.debit-editor-inspector .debit-editor-column-designer {
  grid-template-columns: minmax(0, 1fr);
  padding: 10px;
}

.debit-editor-inspector .debit-editor-column-inspector {
  grid-template-columns: minmax(0, 1fr);
}

.debit-editor-inspector .debit-editor-variable-grid {
  max-height: 260px;
  overflow: auto;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.debit-editor-column-inspector__header {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
}

.debit-editor-column-inspector__actions {
  display: flex;
  align-items: center;
