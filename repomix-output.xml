.advance-workspace {
  width: 100%;
  min-width: 0;
}

.advance-workspace__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
}

.advance-workspace__heading .page-header {
  min-width: 0;
  margin-bottom: 18px;
}

.advance-workspace__governance-link {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
