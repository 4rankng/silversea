/* ============================================================================
 * P&L Report Table
 * ========================================================================== */
.pnl-table {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 18px;
  overflow: hidden;
}
.pnl-row {
  display: grid;
  grid-template-columns: 1fr 160px 160px 120px;
  align-items: center;
  padding: 12px 22px;
  border-bottom: 1px solid var(--line);
  gap: 16px;
}
@media (max-width: 1023px) {
  .pnl-row { grid-template-columns: 1fr 120px; }
  .pnl-row__yoy, .pnl-row__pct { display: none; }
  .pnl-row--final .pnl-row__amount { font-size: var(--fs-sm); }
}
.pnl-row:last-child { border-bottom: none; }
.pnl-row--section {
  background: var(--surface-2);
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--ink);
  text-transform: uppercase;
  font-size: var(--fs-2xs);
  letter-spacing: 0.08em;
}
.pnl-row--subtotal { background: var(--surface-2); border-top: 1px solid var(--line); font-weight: 600; }
.pnl-row--final {
  background: var(--accent-soft);
  border-top: 2px solid var(--accent);
  border-bottom: 2px solid var(--accent);
}
.pnl-row__label { font-size: var(--fs-sm); color: var(--ink); }
.pnl-row__label-sub { font-size: var(--fs-2xs); color: var(--ink-3); font-family: var(--font-mono); margin-top: 2px; }
.pnl-row__amount { font-family: var(--font-mono); font-weight: 500; font-size: var(--fs-sm); text-align: right; color: var(--ink); }
.pnl-row--subtotal .pnl-row__amount { font-weight: 600; font-size: var(--fs-sm); letter-spacing: 0; }
.pnl-row--final .pnl-row__amount {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-xl);
  letter-spacing: 0;
  color: var(--accent);
}
.pnl-row__yoy { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-3); text-align: right; }
.pnl-row__pct { text-align: right; font-family: var(--font-mono); font-size: var(--fs-xs); font-weight: 600; }
.pnl-row__pct--up { color: var(--accent); }
.pnl-row__pct--down { color: var(--danger); }

.pnl-head {
  display: grid;
  grid-template-columns: 1fr 160px 160px 120px;
  align-items: center;
  padding: 14px 22px;
  background: var(--ink);
  color: var(--fg-on-brand);
  gap: 16px;
  font-family: var(--font-mono);
  font-size: var(--fs-2xs);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 600;
}
@media (max-width: 1023px) {
  .pnl-head { grid-template-columns: 1fr 120px; }
  .pnl-head .pnl-head__yoy, .pnl-head .pnl-head__pct { display: none; }
}
.pnl-head__amount, .pnl-head__yoy, .pnl-head__pct { text-align: right; }

/* ============================================================================
 * KPI Hero Strip
 * ========================================================================== */
.pnl-kpi-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 20px;
}
@media (max-width: 1023px) {
  .pnl-kpi-strip { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 420px) {
  .pnl-kpi-strip { grid-template-columns: 1fr 1fr; gap: 8px; }
}

.pnl-kpi {
  position: relative;
  overflow: hidden;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 14px 16px;
}
.pnl-kpi__label {
  font-size: var(--fs-2xs);
  font-weight: 600;
  color: var(--fg-3);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 6px;
}
.pnl-kpi__value {
  font-size: var(--fs-xl);
  font-weight: 700;
  font-family: var(--font-mono);
  letter-spacing: 0;
  color: var(--fg-1);
  line-height: 1.25;
  margin-bottom: 4px;
  white-space: nowrap;
}
@media (max-width: 1100px) {
  .pnl-kpi__value { font-size: var(--fs-md); line-height: 1.25; }
}
.pnl-kpi__unit {
  font-size: var(--fs-xs);
  line-height: 1.25;
  font-weight: 500;
  margin-left: 2px;
  color: var(--fg-2);
}
.pnl-kpi__delta {
  font-size: var(--fs-2xs);
  font-weight: 600;
  font-family: var(--font-mono);
  padding-right: 42px;
}
.pnl-kpi__asset {
  position: absolute;
  right: 10px;
  bottom: 8px;
  width: 54px;
  height: 54px;
  object-fit: contain;
  opacity: 0.16;
  pointer-events: none;
}
.pnl-kpi__delta--up   { color: var(--success, #10b981); }
.pnl-kpi__delta--down { color: var(--danger,  #ef4444); }
.pnl-kpi__delta--neutral { color: var(--fg-3); font-weight: 400; }

.pnl-kpi--profit .pnl-kpi__value { color: var(--success, #10b981); }
.pnl-kpi--net    .pnl-kpi__value { color: var(--brand,   #22c55e); }

@media (max-width: 640px) {
  .finance-page .finance-charts-row {
    flex-direction: column;
  }
  .finance-page .finance-charts-row > .panel {
    flex: 1 1 auto;
    min-width: 0;
  }
  .finance-page .finance-revenue-chart {
    height: 260px;
  }
  .finance-page .finance-chart-xlabel {
    display: none;
  }
}
@media (max-width: 420px) {
  .finance-page .finance-revenue-svg text {
    font-size: var(--fs-2xs);
  }
  .finance-page .finance-charts-row > .panel {
    padding: 12px 14px;
  }
}

/* ── Responsive overrides (from responsive.css decomposition) ── */
@media (max-width: 640px) {
  /* ── Finance page ── */
  .finance-page .charts-row { flex-direction: column; }
  .finance-page .panel { width: 100%; min-width: 0; }
  .finance-page .panel, .pnl-row { min-width: 0; }
  .pnl-row { padding-left: 14px; padding-right: 14px; }
  .profit-layout { grid-template-columns: 1fr; }
  .dash-grid { grid-template-columns: 1fr; }
} /* end 640px */

/* ============================================================================
 * Per-truck mobile cards
 * ========================================================================== */
.truck-card-list {
  display: flex;
  flex-direction: column;
}
.truck-card {
  padding: 14px 18px;
  border-bottom: 1px solid var(--line);
}
.truck-card--expanded { background: var(--surface-2); }
.truck-card:last-child { border-bottom: none; }
.truck-card__toggle {
  display: block;
  width: 100%;
  padding: 0;
  border: 0;
  color: inherit;
  background: transparent;
  text-align: left;
  cursor: pointer;
}
.truck-card__toggle:focus-visible,
.truck-row-toggle:focus-visible,
.truck-trip-link:focus-visible {
  outline: 2px solid var(--brand);
  outline-offset: 3px;
  border-radius: 4px;
}
.truck-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.truck-card__plate {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: var(--fs-sm);
  color: var(--ink);
  letter-spacing: 0;
}
.truck-card__profit {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: var(--fs-sm);
  letter-spacing: 0;
}
.truck-card__profit--up { color: var(--brand); }
.truck-card__profit--down { color: var(--danger); }
.truck-card__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px 12px;
  margin-bottom: 10px;
}
.truck-card__stat-label {
  display: block;
  font-size: var(--fs-2xs);
  color: var(--ink-3);
  margin-bottom: 1px;
}
.truck-card__stat-value {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink);
}
.truck-card__bar-track {
  height: 4px;
  border-radius: 2px;
  background: var(--border);
  overflow: hidden;
  margin-bottom: 6px;
}
.truck-card__bar-fill {
  height: 100%;
  border-radius: 2px;
  transition: width 0.3s ease;
}
.truck-card__bar-fill--up { background: var(--brand); }
.truck-card__bar-fill--down { background: var(--danger); }
.truck-card__margin {
  font-size: var(--fs-2xs);
  font-family: var(--font-mono);
  color: var(--ink-3);
  font-weight: 500;
}

.truck-expand-icon {
  flex: 0 0 auto;
  transition: transform 160ms ease;
}
[aria-expanded='true'] .truck-expand-icon { transform: rotate(180deg); }

.truck-row-toggle {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 44px;
  padding: 0;
  border: 0;
  color: inherit;
  background: transparent;
  font: inherit;
  cursor: pointer;
}
.truck-row-toggle__hint {
  color: var(--fg-3);
  font-family: var(--font-sans);
  font-size: var(--fs-2xs);
  font-style: normal;
  font-weight: 500;
  opacity: 0;
  transition: opacity 120ms ease;
}
.truck-summary-row:hover .truck-row-toggle__hint,
.truck-summary-row.is-expanded .truck-row-toggle__hint,
.truck-row-toggle:focus-visible .truck-row-toggle__hint { opacity: 1; }
.truck-summary-row.is-expanded > td { background: var(--surface-2); }

.truck-details-row > td {
  padding: 0 !important;
  background: color-mix(in srgb, var(--brand) 3%, var(--surface));
  border-bottom: 1px solid var(--line-2);
}
.truck-details-panel { padding: 14px 18px 16px; }
.truck-details-panel__intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 10px;
  color: var(--fg-3);
  font-size: var(--fs-2xs);
}
.truck-details-panel__intro strong { color: var(--fg-1); }
.truck-trip-table-wrap {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
}
.truck-trip-table { min-width: 1050px; }
.truck-trip-table thead th {
  padding: 9px 10px;
  background: var(--surface-2);
  color: var(--fg-3);
  font-size: 10px;
  letter-spacing: 0.04em;
}
.truck-trip-table tbody td {
  padding: 10px;
  font-size: var(--fs-xs);
  vertical-align: middle;
}
.truck-trip-table tbody tr:last-child td { border-bottom: 0; }
.truck-trip-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--brand);
  font-family: var(--font-mono);
  font-weight: 700;
  text-decoration: none;
}
.truck-trip-link:hover { text-decoration: underline; }
.truck-trip-route {
  max-width: 240px;
  margin-top: 3px;
  color: var(--fg-3);
  font-size: 10px;
  white-space: normal;
}
.cost-check {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  width: max-content;
  padding: 3px 7px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
}
.cost-check--ok { color: var(--success); background: var(--success-soft); }
.cost-check--warning { color: var(--warning, #b45309); background: var(--warning-soft, #fef3c7); }
.truck-maintenance-note {
  position: relative;
  margin-top: 10px;
  padding: 9px 11px;
  border-radius: 5px;
  background: var(--surface-2);
  color: var(--fg-2);
  font-size: var(--fs-xs);
}
.truck-maintenance-note::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: var(--status-strip-width);
  height: var(--status-strip-height);
  border-radius: var(--status-strip-radius);
  background: var(--brand);
  pointer-events: none;
}
.truck-maintenance-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6px;
  margin-top: 8px;
}
.truck-maintenance-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-width: 0;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface);
  color: var(--fg-1);
  text-decoration: none;
}
.truck-maintenance-item:hover { border-color: var(--brand); background: var(--surface-2); }
.truck-maintenance-item__main { min-width: 0; }
.truck-maintenance-item__main strong { display: block; font-size: var(--fs-xs); }
.truck-maintenance-item__main small {
  display: block;
  overflow: hidden;
  margin-top: 2px;
  color: var(--fg-3);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.truck-maintenance-item__amount {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  flex: 0 0 auto;
  color: var(--fg-1);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 700;
}

.truck-mobile-details {
  margin: 14px -18px -14px;
  border-top: 1px solid var(--line);
}
.truck-trip-card { padding: 13px 18px; border-bottom: 1px solid var(--line); background: var(--surface); }
.truck-trip-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
  color: var(--fg-3);
  font-size: 10px;
}
.truck-trip-card__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px 12px;
}
.truck-trip-amount span {
  display: block;
  margin-bottom: 2px;
  color: var(--fg-3);
  font-size: 10px;
}
.truck-trip-amount strong {
  color: var(--fg-1);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
}
.truck-trip-amount--emphasized strong { color: var(--brand); }
.truck-mobile-details .truck-maintenance-details { margin: 10px 18px 14px; }
.truck-mobile-details .truck-maintenance-list { grid-template-columns: 1fr; }
@media (max-width: 900px) {
  .truck-maintenance-list { grid-template-columns: 1fr; }
}

/* ============================================================================
 * Finance Chart Polish
 * ========================================================================== */

/* Revenue area chart — path entrance */
.finance-revenue-svg path {
  transition: opacity 0.3s ease;
}
.finance-revenue-svg circle {
  transition: r 0.15s ease, filter 0.15s ease;
}
.finance-revenue-svg circle:hover {
  r: 6;
}

/* Donut segment hover */
.finance-cost-donut svg path {
  transition: opacity 0.15s ease;
}
.finance-cost-donut svg:hover path {
  opacity: 0.7;
}
.finance-cost-donut svg:hover path:hover {
  opacity: 1;
}

/* Top truck bar hover */
.finance-top-trucks svg rect {
  transition: opacity 0.15s ease;
}
.finance-top-trucks svg rect:hover {
  opacity: 1;
  filter: brightness(1.1);
}

/* Chart panel header */
.finance-chart-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 12px;
}

/* Legend items */
.finance-chart-legend {
  display: flex;
  gap: 14px;
  font-size: var(--fs-xs);
  color: var(--ink-2);
}
.finance-chart-legend__item {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
.finance-chart-legend__dot {
  width: 10px;
  height: 10px;
  border-radius: 2px;
  display: inline-block;
}

/* ============================================================================
 * Dashboard Card Styles (copied from DashboardPage.css)
 * ========================================================================== */
.dash-wf {
  --wf-bg: #EFF2F0;
  --wf-card: #FFFFFF;
  --wf-border: #E5E9E7;
  --wf-border-2: #DCE2DF;
  --wf-ink: #0E1F16;
  --wf-ink-2: #56655C;
  --wf-ink-3: #8A988F;
  --wf-green: #005A2D;
  --wf-green-700: #0A6E3A;
  --wf-green-500: #16A34A;
  --wf-green-soft: #E7F2EC;
  --wf-blue: #2563EB;
  --wf-blue-soft: #E8EFFD;
  --wf-amber: #C2780B;
  --wf-amber-soft: #FBF1DE;
  --wf-red: #C7372F;
  --wf-shadow: none;
  --wf-shadow-hover: none;
  --wf-radius: 14px;
  display: flex;
  flex-direction: column;
}

.dash-wf .wf-card {
  background: var(--wf-card);
  border: 1px solid var(--wf-border);
  border-radius: var(--wf-radius);
  box-shadow: var(--wf-shadow);
  overflow: hidden;
  min-width: 0;
  position: relative;
  transition: background 160ms ease, border-color 160ms ease;
}
.dash-wf .wf-card:hover {
  border-color: var(--wf-border-2);
}

.dash-wf .wf-card-h { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 16px 0; }
.dash-wf .wf-card-h .ttl { font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0; color: var(--wf-ink); }
.dash-wf .wf-card-h .sub { font-size: var(--fs-2xs); color: var(--wf-ink-3); margin-top: 2px; }

.dash-wf .wf-legend {
  display: flex;
  gap: 20px;
  padding: 12px 14px 10px;
  border-bottom: 1px solid var(--wf-line, #EEF1EF);
  background: var(--wf-bg, #F8FAF9);
  border-radius: 8px 8px 0 0;
}
.dash-wf .wf-legend .li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-sm);
  color: var(--wf-ink);
  font-weight: 600;
}
.dash-wf .wf-legend .sw {
  width: 22px;
  height: 4px;
  border-radius: 2px;
  display: inline-block;
}

.dash-wf .wf-chart { display: flex; flex-direction: column; }
.dash-wf .wf-chart .body { padding: 8px 8px 6px; flex: 1; min-height: 0; display: flex; flex-direction: column; }
.dash-wf .wf-chart .body svg { display: block; width: 100%; height: 100%; }

.dash-wf svg {
  width: 16px !important;
  height: 16px !important;
  max-width: 16px !important;
  max-height: 16px !important;
  display: inline-block;
  vertical-align: middle;
  flex-shrink: 0;
}
.dash-wf .wf-chart .body svg {
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  max-height: none !important;
  display: block;
}

/* ── Chart day/month toggle ── */
.dash-wf .wf-chart-toggle {
  display: inline-flex;
  border: 1px solid var(--wf-border-2);
  border-radius: 8px;
  overflow: hidden;
  background: var(--wf-card);
}
.dash-wf .wf-chart-toggle__btn {
  min-height: 45px;
  padding: 8px 14px;
  font-family: var(--font-body);
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--wf-ink-3);
  background: transparent;
  border: none;
  cursor: pointer;
  transition: background 120ms ease, color 120ms ease;
  line-height: 1.4;
  min-height: 45px;
}
.dash-wf .wf-chart-toggle__btn:hover {
  color: var(--wf-ink);
  background: var(--wf-bg);
}
.dash-wf .wf-chart-toggle__btn.is-active {
  color: var(--fg-on-brand);
  background: var(--wf-green);
}
</file>

<file path="frontend/src/pages/FleetPage.css">
/* ─── FleetPage — single-page fleet dashboard ─── */

.fleet-page {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.fleet-page .kpi {
  min-height: 112px;
  padding: 16px 18px;
  background:
    radial-gradient(96px 64px at 96% 42%, color-mix(in srgb, var(--stat-rail) 8%, transparent), transparent 76%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(250, 252, 251, 0.94));
  border-color: rgba(203, 211, 206, 0.82);
}

.fleet-page .kpi-grid {
  gap: 12px 14px;
  margin-bottom: 18px;
}

.fleet-page .kpi__top {
  margin-bottom: 8px;
}

.fleet-page .kpi__label {
  color: var(--ink-2);
  letter-spacing: 0.05em;
}

.fleet-page .kpi__value {
  font-size: var(--fs-xl);
  font-weight: 700;
  margin-bottom: 8px;
}

.fleet-page .kpi__watermark {
  right: 18px;
  bottom: 14px;
  width: 64px;
  height: 64px;
  opacity: 0.055;
  color: var(--stat-rail);
}

.fleet-page .kpi__watermark svg {
  width: 64px;
  height: 64px;
  stroke-width: 1.7;
}

.fleet-page .kpi__watermark img {
  width: 64px;
  height: 64px;
}

.fleet-page .kpi--warn .kpi__watermark,
.fleet-page .kpi--success .kpi__watermark,
.fleet-page .kpi--accent .kpi__watermark,
.fleet-page .kpi--info .kpi__watermark,
.fleet-page .kpi--danger .kpi__watermark {
  opacity: 0.06;
  color: var(--stat-rail);
}

.fleet-page .fleet-kpi-meta {
  min-width: 0;
}

/* Two-column layout for trucks + trailers */
.fleet-page .fleet-two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

/* Card header with icon + count pill */
.fleet-page .fleet-card-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--line);
}

.fleet-page .fleet-card-lead {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.fleet-page .fleet-card-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: linear-gradient(180deg, var(--accent-soft), #DDF7E8);
  color: var(--accent-2);
  display: grid;
  place-items: center;
  border: 1px solid rgba(0, 177, 79, 0.22);
  box-shadow: 0 8px 18px -12px rgba(0, 90, 45, 0.45);
  flex-shrink: 0;
}

.fleet-page .fleet-card-icon.alt {
  background: linear-gradient(180deg, var(--surface-3), var(--surface-2));
  color: var(--ink-2);
  border-color: var(--line-2);
}

.fleet-page .fleet-card-title {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 8px;
}

.fleet-page .count-pill {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--surface-3);
  color: var(--ink-2);
}

.fleet-page .fleet-card-sub {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  margin-top: 1px;
}

.fleet-page .fleet-card-tools {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Plate tag prefix (VN / RM) */
.fleet-page .fleet-plate {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: var(--fs-sm);
  color: var(--ink);
}

.fleet-page .fleet-plate-tag {
  background: var(--ink);
  color: var(--fg-on-brand);
  padding: 3px 6px;
  border-radius: 4px;
  font-size: var(--fs-xs);
  letter-spacing: 0.5px;
  margin-right: 6px;
}

/* Driver avatar icon */
.fleet-page .fleet-avatar {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--accent-soft);
  color: var(--accent);
  border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
  flex-shrink: 0;
}

.fleet-page .fleet-assigned {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.fleet-page .fleet-assigned .name {
  font-weight: 600;
  color: var(--ink);
  font-size: var(--fs-sm);
}

.fleet-page .fleet-unassigned {
  color: var(--ink-3);
  font-style: italic;
  font-size: var(--fs-xs);
}

/* Trailer type chip */
.fleet-page .fleet-type-chip {
  display: inline-flex;
  align-items: center;
  padding: 3px 9px;
  border-radius: 6px;
  background: var(--surface-3);
  border: 1px solid var(--line);
  color: var(--ink-2);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.5px;
}

.fleet-page .fleet-type-chip.ft40 {
  background: linear-gradient(180deg, #EFF6FF, #E6F0FF);
  color: var(--info);
  border-color: #DBEAFE;
}

.fleet-page .fleet-type-chip.ft20 {
  background: linear-gradient(180deg, var(--accent-soft), #DDF7E8);
  color: var(--accent-2);
  border-color: rgba(0, 177, 79, 0.15);
}

/* Truck+trailer pair display */
.fleet-page .fleet-pair {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: var(--ink-2);
  padding: 3px 8px;
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: 6px;
}

.fleet-page .fleet-pair .arrow {
  color: var(--ink-3);
}

/* Direct tire-management affordance in the truck list. This keeps lốp visible
   without making it compete with primary create/edit actions. */
.fleet-page .fleet-tire-link,
.fleet-detail .fleet-tire-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  width: fit-content;
  min-height: 44px;
  padding: 6px 11px 6px 7px;
  border: 1px solid rgba(0, 177, 79, 0.18);
  border-radius: 8px;
  background: rgba(230, 247, 237, 0.65);
  color: var(--accent-2);
  font-size: var(--fs-xs);
  font-weight: 700;
  text-decoration: none;
  transition: background 140ms var(--ease), border-color 140ms var(--ease), color 140ms var(--ease), transform 140ms var(--ease);
}

.fleet-page .fleet-tire-link:hover,
.fleet-detail .fleet-tire-link:hover {
  border-color: rgba(0, 177, 79, 0.34);
  background: rgba(221, 247, 232, 0.95);
  color: var(--accent);
  transform: translateY(-1px);
}

.fleet-page .fleet-tire-link__count,
.fleet-detail .fleet-tire-link__count {
  display: grid;
  min-width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 6px;
  background: var(--surface);
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 800;
  box-shadow: inset 0 0 0 1px rgba(203, 211, 206, 0.8);
}

.fleet-page .fleet-tire-link--empty,
.fleet-detail .fleet-tire-link--empty {
  border-color: var(--line);
  background: var(--surface-2);
  color: var(--ink-3);
}

/* Phone display */
.fleet-page .fleet-phone {
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  color: var(--ink-2);
  letter-spacing: 0.3px;
}

/* Salary display */
.fleet-page .fleet-salary {
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  color: var(--ink);
  font-weight: 600;
}

.fleet-page .fleet-salary .unit {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  font-weight: 500;
  margin-left: 3px;
}

.fleet-page .fleet-salary.empty {
  color: var(--ink-3);
  font-weight: 500;
}

/* Mini search in drivers card */
.fleet-page .fleet-mini-search {
  position: relative;
  width: 220px;
}

.fleet-page .fleet-mini-search input {
  width: 100%;
  min-height: 44px;
  padding: 10px 10px 10px 32px;
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: 7px;
  font-family: inherit;
  font-size: var(--fs-xs);
  line-height: 1.35;
  color: var(--ink);
}

.fleet-page .fleet-mini-search input:focus {
  outline: none;
  border-color: var(--accent);
  background: var(--surface);
}

.fleet-page .fleet-mini-search svg {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--ink-3);
}

/* Table footer legend */
.fleet-page .fleet-legend {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
}

.fleet-page .fleet-status-legend {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.fleet-page .fleet-legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-xs);
  color: var(--ink-3);
}

.fleet-page .fleet-legend-swatch {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

/* ─── Inline edit row ─────────────────────────────────────────────────────── */

/* Pin the STT (#) column to a compact width. .tt-table uses table-layout: fixed,
   so without an explicit width the first numeric column gets ~1/N of the table
   (way too wide for a 1–3 digit index). 56px holds up to 3 digits comfortably. */
.fleet-page .tt-table th.num:first-child,
.fleet-page .tt-table td.num:first-child {
  width: 56px;
  text-align: center;
}

.fleet-page .tt-table td.fleet-status-cell {
  position: relative;
}

.fleet-page .tt-table td.fleet-status-cell > span:first-child {
  left: 0;
}

.fleet-page .m-card {
  position: relative;
  overflow: hidden;
}

.fleet-page .fleet-driver-card {
  padding: 16px 18px 16px 22px;
  touch-action: manipulation;
}

.fleet-page .fleet-driver-card:focus-visible {
  z-index: 1;
  outline: 2px solid var(--accent);
  outline-offset: -3px;
}

.fleet-page .fleet-driver-card__identity {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
  margin-bottom: 12px;
}

.fleet-page .fleet-driver-card__identity-copy {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.fleet-page .fleet-driver-card__name {
  overflow-wrap: anywhere;
  color: var(--ink);
  font-size: var(--fs-md);
  font-weight: 700;
  line-height: 1.3;
}

.fleet-page .fleet-driver-card__phone {
  color: var(--ink-3);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  line-height: 1.4;
}

.fleet-page .fleet-driver-card .fleet-avatar {
  width: 36px;
  height: 36px;
  border-radius: 11px;
  color: var(--accent-2);
}

.fleet-page .fleet-driver-card .m-card__row {
  min-height: 24px;
  margin-top: 2px;
}

.fleet-page .fleet-driver-card .m-card__row-value {
  text-align: right;
  white-space: nowrap;
}

.fleet-page .fleet-edit-row td {
  background: var(--surface-2);
  border-top: 1px solid var(--accent);
  border-bottom: 1px solid var(--accent);
  padding-top: 8px;
  padding-bottom: 8px;
}

.fleet-page .fleet-edit-row td:first-child {
  border-radius: 0;
}

.fleet-page .fleet-edit-row td:last-child {
  border-right: 1px solid var(--accent);
}

/* compact inputs inside the edit row */
.fleet-page .fleet-edit-row .input--sm {
  padding: 5px 8px;
  font-size: var(--fs-sm);
  height: 32px;
  width: 100%;
}

/* trailer plate + type side-by-side */
.fleet-page .fleet-edit-pair {
  display: flex;
  gap: 6px;
  align-items: center;
}

.fleet-page .fleet-edit-pair .input--sm:first-child {
  flex: 1;
  min-width: 0;
}

.fleet-page .fleet-edit-select-sm {
  width: 72px;
  flex-shrink: 0;
}

/* save / cancel buttons in the actions cell */
.fleet-page .fleet-edit-actions {
  display: flex;
  gap: 6px;
  align-items: center;
  white-space: nowrap;
}

/* Responsive */
/* Stack trucks/trailers panels earlier — at 2-column on viewports under
   ~1400px the embedded tables become narrow enough that the "Trạng thái"
   and "Thao tác" columns clip off the right edge (table-scroll's
   overflow-x: auto fires but users miss the hidden columns). */
@media (max-width: 1100px) {
  .fleet-page .fleet-two-col {
    grid-template-columns: 1fr;
  }
}

/* Action row at bottom of each mobile m-card (trucks/trailers/drivers).
   On desktop renders inline buttons aligned to the right. The class
   replaces inline `style={{ display: 'flex' ... }}` so a mobile media
   query can hide it without inline-style fighting back. */
.fleet-page .fleet-card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 6px;
  margin-top: 8px;
}

/* ─── Fleet detail modal ────────────────────────────────────────────────────
   The shared Modal is portaled outside .fleet-page, so modal-specific fleet
   styles must be scoped by .fleet-detail instead of nesting under .fleet-page. */
.fleet-detail {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.fleet-detail__hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px;
  padding: 16px;
  border: 1px solid rgba(203, 211, 206, 0.86);
  border-radius: 12px;
  background:
    radial-gradient(140px 80px at 100% 0%, rgba(0, 177, 79, 0.09), transparent 72%),
    linear-gradient(180deg, rgba(250, 252, 251, 0.98), rgba(246, 249, 247, 0.9));
}

.fleet-detail__identity,
.fleet-detail__status,
.fleet-detail__item {
  min-width: 0;
}

.fleet-detail__label {
  margin-bottom: 7px;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.05em;
  line-height: 1.2;
  text-transform: uppercase;
}

.fleet-detail__primary {
  color: var(--ink);
  font-size: var(--fs-lg);
  font-weight: 750;
  line-height: 1.25;
}

.fleet-detail__status {
  justify-self: end;
  text-align: right;
}

.fleet-detail__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.fleet-detail__item {
  padding: 13px 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface-2);
}

.fleet-detail__item--wide {
  grid-column: 1 / -1;
}

.fleet-detail__value {
  color: var(--ink);
  font-size: var(--fs-sm);
  line-height: 1.45;
}

.fleet-detail .fleet-plate {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: inherit;
  font-weight: 750;
}

.fleet-detail .fleet-plate-tag {
  margin-right: 7px;
  padding: 3px 6px;
  border-radius: 4px;
  background: var(--ink);
  color: var(--fg-on-brand);
  font-size: var(--fs-xs);
  letter-spacing: 0.5px;
  line-height: 1.25;
}

.fleet-detail .fleet-pair,
.fleet-detail .fleet-assigned {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  gap: 8px;
}

.fleet-detail .fleet-pair {
  flex-wrap: wrap;
}

.fleet-detail .fleet-assigned .name {
  color: var(--ink);
  font-weight: 650;
}

.fleet-detail .fleet-unassigned {
  color: var(--ink-3);
  font-size: var(--fs-sm);
  font-style: italic;
}

.fleet-detail .fleet-avatar {
  display: grid;
  flex: 0 0 auto;
  width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
}

.fleet-detail .fleet-type-chip {
  display: inline-flex;
  align-items: center;
  padding: 3px 9px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--surface-3);
  color: var(--ink-2);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.5px;
}

.fleet-detail .fleet-type-chip.ft40 {
  background: linear-gradient(180deg, #EFF6FF, #E6F0FF);
  border-color: #DBEAFE;
  color: var(--info);
}

.fleet-detail .fleet-type-chip.ft20 {
  background: linear-gradient(180deg, var(--accent-soft), #DDF7E8);
  border-color: rgba(0, 177, 79, 0.15);
  color: var(--accent-2);
}

.fleet-tire-detail {
  display: grid;
  gap: 9px;
  width: 100%;
}

.fleet-tire-detail__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  color: var(--ink-2);
  font-size: var(--fs-xs);
}

.fleet-tire-detail__head strong {
  color: var(--ink);
  font-family: var(--font-mono);
}

.fleet-tire-detail__list {
  display: grid;
  gap: 7px;
}

.fleet-tire-detail__row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  min-height: 42px;
  padding: 8px 10px;
  border: 1px solid rgba(203, 211, 206, 0.72);
  border-radius: 8px;
  background: var(--surface);
}

.fleet-tire-detail__main {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.fleet-tire-detail__serial {
  overflow: hidden;
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fleet-tire-detail__position {
  overflow: hidden;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fleet-tire-detail__meta {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 7px;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  white-space: nowrap;
}

.fleet-detail-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10px;
  width: 100%;
}

/* ─── Fleet form modals ─────────────────────────────────────────────────────
   The form modals are also portaled, so these classes intentionally are not
   nested under .fleet-page. */
.fleet-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fleet-form__section {
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface-2);
}

.fleet-form__section--identity {
  border-color: rgba(203, 211, 206, 0.9);
  background:
    radial-gradient(160px 96px at 100% 0%, rgba(0, 177, 79, 0.08), transparent 72%),
    linear-gradient(180deg, rgba(250, 252, 251, 0.98), rgba(247, 250, 248, 0.92));
}

.fleet-form__section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.fleet-form__section-head h4 {
  margin: 0;
  color: var(--ink);
  font-size: var(--fs-sm);
  font-weight: 750;
  line-height: 1.2;
}

.fleet-form__section-head p {
  margin: 4px 0 0;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  line-height: 1.45;
}

.fleet-form__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.fleet-form__grid--truck {
  grid-template-columns: minmax(220px, 1.35fr) minmax(180px, 1fr) minmax(140px, 0.8fr);
}

.fleet-form__field {
  margin: 0;
  min-width: 0;
}

.fleet-form__field--wide {
  grid-column: span 2;
}

.fleet-form__grid--truck .fleet-form__field--wide {
  grid-column: auto;
}

.fleet-form__field label,
.truck-alert-field__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 7px;
  color: var(--ink-2);
  font-size: var(--fs-xs);
  font-weight: 700;
  line-height: 1.25;
}

.fleet-form__field label span {
  color: var(--danger);
}

.fleet-form__inline {
  display: flex;
  align-items: center;
  gap: 8px;
}

.fleet-form__interval {
  flex: 0 0 130px;
}

.fleet-form__note {
  padding: 11px 13px;
  border: 1px solid rgba(203, 211, 206, 0.82);
  border-radius: 10px;
  background: rgba(247, 250, 248, 0.88);
  color: var(--ink-3);
  font-size: var(--fs-xs);
  line-height: 1.5;
}

.fleet-form-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10px;
  width: 100%;
}

@media (max-width: 640px) {
  .fleet-page {
    gap: 14px;
  }

  .fleet-page .kpi-grid {
    gap: 8px;
    margin-bottom: 10px;
  }

  .fleet-page .kpi {
    min-height: 76px;
    padding: 12px 14px;
    border-radius: 14px;
  }

  .fleet-page .kpi__top {
    margin-bottom: 6px;
  }

  .fleet-page .kpi__label {
    font-size: var(--fs-xs);
    letter-spacing: 0.045em;
    line-height: 1.35;
  }

  .fleet-page .kpi__value {
    font-size: 24px;
    margin-bottom: 6px;
  }

  .fleet-page .kpi__value-unit {
    font-size: 13px;
  }

  .fleet-page .kpi__meta {
    font-size: var(--fs-xs);
    gap: 4px 6px !important;
    line-height: 1.35;
    align-items: center;
  }

  .fleet-page .fleet-kpi-meta {
    display: flex !important;
    flex-wrap: nowrap;
    width: 100%;
  }

  .fleet-page .fleet-kpi-meta > span {
    min-width: 0;
  }

  .fleet-page .fleet-kpi-meta__good,
  .fleet-page .fleet-kpi-meta__warn,
  .fleet-page .fleet-kpi-meta__mono {
    white-space: nowrap;
    font-weight: 650 !important;
  }

  .fleet-page .fleet-kpi-dot {
    width: 5px !important;
    height: 5px !important;
    align-self: center;
  }

  .fleet-page .fleet-kpi-meta__sep {
    flex: 0 0 auto;
  }

  .fleet-page .page-actions .btn {
    min-height: 44px;
    padding-inline: 14px;
    border-radius: 12px;
  }

  .fleet-page .kpi__watermark {
    right: 12px;
    bottom: 10px;
    width: 42px;
    height: 42px;
    opacity: 0.045;
  }

  .fleet-page .kpi__watermark svg {
    width: 42px;
    height: 42px;
  }

  .fleet-page .fleet-mini-search {
    width: 140px;
  }
  .fleet-page .fleet-card-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .fleet-page .fleet-card-tools {
    width: 100%;
    flex-wrap: wrap;
  }
  .fleet-page .fleet-mini-search {
    width: 100%;
    flex: 1;
  }

  /* ── Pass 13 mobile tweaks (2026-06-02) ── */

  /* Hide the per-card Sửa/Xem/Xóa action row on phone — tapping the
     whole card opens the DetailModal which already has Edit + Delete
     in its footer. Saves ~46px per card across 17 cards (~780px scroll). */
  .fleet-page .fleet-card-actions {
    display: none;
  }

  .fleet-page .m-card__row .fleet-tire-link {
    margin-left: auto;
  }
  /* Shrink the panel-head icon for the 3 fleet panels (trucks / trailers /
     drivers) — matches the penalty-page mobile sizing. */
  .fleet-page .fleet-card-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
  }
  .fleet-page .fleet-card-lead {
    gap: 10px;
  }

  .fleet-detail__hero {
    grid-template-columns: 1fr;
    align-items: start;
    padding: 14px;
  }

  .fleet-detail__status {
    justify-self: start;
    text-align: left;
  }

  .fleet-detail__grid {
    grid-template-columns: 1fr;
  }

  .fleet-tire-detail__head,
  .fleet-tire-detail__row,
  .fleet-tire-detail__meta {
    align-items: flex-start;
    grid-template-columns: 1fr;
    justify-content: flex-start;
    white-space: normal;
  }

  .fleet-detail-actions .btn {
    flex: 1 1 0;
    justify-content: center;
  }
}

/* ── Responsive overrides (from responsive.css decomposition) ── */
@media (max-width: 420px) {
  .fleet-page .fleet-two-col { grid-template-columns: 1fr; }
} /* end 420px */

/* ── N5 / A12: truck compliance & service date alert badges ──────────────────
   Shown inside TruckFormModal next to each date field. Scoped by the
   truck-alert-* class prefix (unique to this feature) so they don't leak;
   the modal renders in a portal outside .fleet-page, so a class scope is
   used instead of nesting under .fleet-page.
   Colors reuse --danger / --warning / their -soft variants (tokens.css). */
.truck-alert-fields {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}
@media (max-width: 640px) {
  .truck-alert-fields {
    grid-template-columns: 1fr;
  }
}
.truck-alert-field__label {
  margin-bottom: 7px;
}
.truck-alert-badge {
  font-size: var(--fs-xs);
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 999px;
  line-height: 1.4;
  white-space: nowrap;
}
.truck-alert-badge--overdue {
  background: var(--danger-soft);
  color: var(--danger);
}
.truck-alert-badge--due {
  background: var(--warning-soft);
  color: var(--warning);
}

.truck-alert-field {
  margin: 0;
  min-width: 0;
}

.truck-alert-field--wide {
  grid-column: 1 / -1;
}

@media (max-width: 760px) {
  .fleet-form__grid,
  .fleet-form__grid--truck,
  .truck-alert-fields {
    grid-template-columns: 1fr;
  }

  .fleet-form__field--wide,
  .fleet-form__grid--truck .fleet-form__field--wide,
  .truck-alert-field--wide {
    grid-column: auto;
  }
}

@media (max-width: 640px) {
  .fleet-form__section {
    padding: 12px;
  }

  .fleet-form__inline {
    align-items: stretch;
    flex-direction: column;
  }

  .fleet-form__interval {
    flex-basis: auto;
  }

  .fleet-form-actions .btn {
    flex: 1 1 0;
    justify-content: center;
  }
}
