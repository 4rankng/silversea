/* ============================================================================
 * Config sub-page scoped polish — shared elegance pass (2026-06-03)
 *
 * All rules under .cfg-page so changes only affect /config/* surfaces.
 * Tightens table density (sparse single-line rows) and unifies the toolbar,
 * empty state, and inline meta pill treatment across CrudTable-based pages.
 * ========================================================================== */

/* ── Table density: sparse config rows don't need 24px vertical td padding ── */
.cfg-page .tt-table thead th {
  padding: 13px 18px;
  font-size: var(--fs-xs);
  letter-spacing: 0.06em;
  font-weight: 600;
  color: var(--ink-3);
}
.cfg-page .tt-table tbody td {
  padding: 14px 18px;
  vertical-align: middle;
}
.cfg-page .tt-table tbody td.num { font-variant-numeric: tabular-nums; }

/* Subtle row hover — keep readable density */
.cfg-page .tt-table tbody tr:hover { background: rgba(0, 177, 79, 0.035); }

/* ── Toolbar refinement: tighter, no border separation under it ── */
.cfg-page .toolbar {
  padding: 14px 20px 6px;
  align-items: center;
  gap: 12px;
  min-height: 52px;
}
.cfg-page .toolbar > div:first-child:empty { display: none; }

/* Inline meta summary that lives in the toolbar (replaces ad-hoc inline styles) */
.cfg-page__summary {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  letter-spacing: 0;
}
.cfg-page__summary strong {
  color: var(--ink);
  font-weight: 600;
}
.cfg-page__summary-sep {
  color: var(--line-2);
  margin: 0 2px;
}

/* ── Active-row pill: HIỆN TẠI, MẶC ĐỊNH, etc. — uniform compact treatment ── */
.cfg-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 26px;
  padding: 4px 9px;
  margin-left: 8px;
  border-radius: 999px;
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  line-height: 1.4;
  white-space: nowrap;
}
.cfg-pill--success { background: var(--accent-soft); color: var(--accent-ink); }
.cfg-pill--warn    { background: rgba(245, 158, 11, 0.12); color: var(--warning-text); }
.cfg-pill--neutral { background: var(--surface-3); color: var(--ink-2); }

/* Empty state uses the shared <EmptyState> (design-system); the page-scoped
   .cfg-empty* rules were retired during CTA unification. (.cfg-empty-row in
   the responsive rules below is distinct and still used.) */

/* ── Header back arrow — soften & match dashboard back affordance ── */
.cfg-page .page-header__back-btn,
.cfg-page .page-header [aria-label*="quay" i] {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-3);
  background: transparent;
  border: 1px solid transparent;
  transition: background 120ms var(--ease), color 120ms var(--ease);
}
.cfg-page .page-header__back-btn:hover,
.cfg-page .page-header [aria-label*="quay" i]:hover {
  background: var(--surface-3);
  color: var(--ink);
}

/* ── First-row entrance: subtle stagger so the table feels alive on load ── */
.cfg-page .tt-table tbody tr {
  animation: cfgRowFade 240ms var(--ease) both;
}
.cfg-page .tt-table tbody tr:nth-child(1) { animation-delay: 0ms; }
.cfg-page .tt-table tbody tr:nth-child(2) { animation-delay: 30ms; }
.cfg-page .tt-table tbody tr:nth-child(3) { animation-delay: 55ms; }
.cfg-page .tt-table tbody tr:nth-child(4) { animation-delay: 75ms; }
.cfg-page .tt-table tbody tr:nth-child(5) { animation-delay: 90ms; }
.cfg-page .tt-table tbody tr:nth-child(n+6) { animation-delay: 100ms; }
@keyframes cfgRowFade {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .cfg-page .tt-table tbody tr { animation: none; }
}

/* ── Form layout utilities (used by FuelConfig, TripExpense, etc.) ── */
.cfg-page .field > label,
.cfg-page label.cfg-field__label {
  display: block;
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 6px;
  letter-spacing: 0;
}
.cfg-page .cfg-field-hint {
  font-size: var(--fs-2xs);
  color: var(--ink-3);
  margin-top: 5px;
  line-height: 1.45;
}
.cfg-page .cfg-field-hint--warn { color: var(--warning-text); }
.cfg-page .cfg-field-hint--danger { color: var(--danger); }
.cfg-page .cfg-field-hint strong { color: var(--ink); font-weight: 600; }

.cfg-page .cfg-section {
  padding-top: 20px;
  margin-top: 8px;
  border-top: 1px solid var(--line);
}
.cfg-page .cfg-section__heading {
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--ink);
  margin: 0 0 14px;
  letter-spacing: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}
.cfg-page .cfg-section__heading-pill {
  font-family: var(--font-mono, ui-monospace, monospace);
  font-size: var(--fs-2xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 2px 7px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent);
}

.cfg-page .cfg-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 16px;
}
@media (max-width: 820px) {
  .cfg-page .cfg-form-grid { grid-template-columns: 1fr; gap: 12px; }
}

.cfg-page .cfg-form-actions {
  margin-top: 18px;
  display: flex;
  align-items: center;
  gap: 12px;
}

/* ── Company info singleton ─────────────────────────────────────────────── */
.cfg-page--company-info .company-info-layout {
  display: grid;
  grid-template-columns: minmax(420px, 1fr) minmax(360px, 0.8fr);
  gap: 20px;
  align-items: start;
}

.cfg-page--company-info .company-info-form {
  min-width: 0;
}

.cfg-page--company-info .company-info-preview {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface);
  overflow: clip;
  min-width: 0;
}

.cfg-page--company-info .company-info-preview-row {
  display: grid;
  grid-template-columns: minmax(120px, 0.34fr) minmax(0, 1fr);
  gap: 16px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--line);
