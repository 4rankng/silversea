function addDays(dateStr: string, delta: number): string {
  const [year, month, day] = dateStr.split('-').map(Number);
  const value = new Date(Date.UTC(year, month - 1, day + delta, 12, 0, 0));
  return value.toISOString().slice(0, 10);
}

