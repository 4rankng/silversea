import React, { useEffect, useRef } from 'react';
import type { SearchItem, SearchItemType } from '../data/searchRegistry';
import { EmptyIllustration } from './shared';
import { AssetIcon } from './AssetIcon';

interface Props {
  items: SearchItem[];
  query: string;
  activeIndex: number;
  onSelect: (item: SearchItem) => void;
  onHover: (index: number) => void;
}

const GROUP_LABELS: Record<SearchItemType, string> = {
  page: 'TRANG',
  config: 'CẤU HÌNH',
  action: 'THAO TÁC',
};

function highlightText(text: string, query: string): React.ReactNode {
  const lowerQ = query.toLowerCase().trim();
  if (!lowerQ) return text;
  const idx = text.toLowerCase().indexOf(lowerQ);
  if (idx === -1) return text;
  return (
    <>
      {text.slice(0, idx)}
      <mark style={{ background: 'transparent', color: 'var(--accent, #818cf8)', fontWeight: 700 }}>
        {text.slice(idx, idx + lowerQ.length)}
      </mark>
      {text.slice(idx + lowerQ.length)}
    </>
  );
}

export function SearchDropdown({ items, query, activeIndex, onSelect, onHover }: Props) {
  const itemRefs = useRef<(HTMLButtonElement | null)[]>([]);

  useEffect(() => {
    itemRefs.current[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }, [activeIndex]);

  if (items.length === 0) {
    return (
      <div style={dropdownStyle}>
        <div style={{ padding: '24px 16px', textAlign: 'center', color: 'var(--fg-3)', fontSize: 14, lineHeight: 1.45 }}>
          <EmptyIllustration name="empty-search" width={118} height={96} style={{ margin: '0 auto 8px', display: 'block' }} />
          <div>Không có kết quả</div>
        </div>
      </div>
    );
  }

  const itemsWithIndex = items.map((item, flatIdx) => ({ item, flatIdx }));
  const typeOrder: SearchItemType[] = ['page', 'config', 'action'];
  const groups = typeOrder
    .map(type => ({
      type,
      label: GROUP_LABELS[type],
      entries: itemsWithIndex.filter(({ item }) => item.type === type),
    }))
    .filter(g => g.entries.length > 0);

  return (
    <div style={dropdownStyle}>
      {groups.map(group => (
        <div key={group.type}>
          <div style={groupHeaderStyle}>{group.label}</div>
          {group.entries.map(({ item, flatIdx }) => {
            const isActive = flatIdx === activeIndex;
            return (
              <button
                key={`${item.type}-${item.id}`}
                ref={el => { itemRefs.current[flatIdx] = el; }}
                style={{
                  ...itemStyle,
                  background: isActive ? 'var(--bg-3, rgba(255,255,255,0.07))' : 'transparent',
                }}
                onMouseEnter={() => onHover(flatIdx)}
                onClick={() => onSelect(item)}
              >
                <span style={{ flexShrink: 0, width: 20, height: 20, display: 'inline-flex', alignItems: 'center', justifyContent: 'center' }}>
                  <AssetIcon name={item.iconName} size={18} />
                </span>
                <div style={{ minWidth: 0, flex: 1 }}>
                  <div style={{ fontSize: 14, fontWeight: 600, color: 'var(--fg-1)', lineHeight: 1.35 }}>
                    {highlightText(item.label, query)}
                  </div>
                  {item.description && (
                    <div style={{
                      fontSize: 12.5,
                      lineHeight: 1.35,
                      color: 'var(--fg-3)',
                      marginTop: 2,
                      overflow: 'hidden',
                      textOverflow: 'ellipsis',
                      display: '-webkit-box',
                      WebkitLineClamp: 2,
                      WebkitBoxOrient: 'vertical',
                    }}>
                      {item.description}
                    </div>
                  )}
                </div>
              </button>
            );
          })}
        </div>
      ))}
    </div>
  );
}

const dropdownStyle: React.CSSProperties = {
  position: 'absolute',
  top: 'calc(100% + 6px)',
  left: 0,
  minWidth: 340,
  maxWidth: 480,
  maxHeight: 360,
  overflowY: 'auto',
  background: 'var(--bg-1)',
  border: '1px solid var(--line)',
  borderRadius: 12,
  boxShadow: '0 8px 32px rgba(0,0,0,0.28)',
  zIndex: 999,
  padding: '8px',
};

const groupHeaderStyle: React.CSSProperties = {
  fontSize: 12,
  lineHeight: 1.35,
  fontWeight: 700,
  letterSpacing: '0.1em',
  textTransform: 'uppercase',
  color: 'var(--fg-3)',
  padding: '10px 10px 6px',
};

const itemStyle: React.CSSProperties = {
  display: 'flex',
  alignItems: 'center',
  gap: 10,
  width: '100%',
  minHeight: 44,
  padding: '10px 12px',
  border: 'none',
  borderRadius: 7,
  cursor: 'pointer',
  textAlign: 'left',
  transition: 'background 80ms',
};
</file>

<file path="frontend/src/components/Table.css">
/* ============================================================================
 * Table — TingTing
 * Extracted from UI.css during architecture refactoring (Phase 4)
 * ========================================================================== */
.table-wrap {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  overflow: hidden;
}
.table-wrap--standalone {
  border-radius: 12px;
}
.table-scroll {
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-color: rgba(0, 90, 45, 0.25) transparent;
  scrollbar-width: thin;
  overscroll-behavior-x: contain;
  min-height: 180px; /* Prevent clipping of dropdown menus in short tables */
}
.table-scroll::-webkit-scrollbar { height: 8px; }
.table-scroll::-webkit-scrollbar-thumb {
  background: rgba(0, 90, 45, 0.22);
  border-radius: 999px;
}

/* Ancillary-fees grid: Loại phí · Gốc · Báo khách · Báo nợ · Chứng từ
   · Trạng thái. Status cell hosts the pill + the inline hover-revealed
   approve/reject icons.
   `min-width: 720px` keeps money cells wide enough to fit "1.350.000 ₫"
   without ellipsis; the .table-scroll wrapper provides horizontal
   scrolling on narrow containers. */
.ancillary-fees__table { min-width: 720px; table-layout: fixed; width: 100%; }
.ancillary-fees__table thead th { padding: 8px 6px; font-size: var(--fs-xs); }
.ancillary-fees__table thead th {
  background: var(--surface-2);
  color: var(--ink-2);
  border-bottom: 1px solid var(--line-2);
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.ancillary-fees__table tbody tr {
  transition: background 120ms var(--ease);
}
.ancillary-fees__table tbody tr:hover {
  background: color-mix(in srgb, var(--accent-soft) 38%, white);
}
.ancillary-fees__table tbody td { padding: 8px 6px; font-size: var(--fs-xs); vertical-align: top; }
.ancillary-fees__table tbody td.num { font-size: var(--fs-xs); }
.ancillary-fees__table thead th:nth-child(1) { width: 30%; }   /* Loại phí */
.ancillary-fees__table thead th:nth-child(2) { width: 14%; }   /* Gốc */
.ancillary-fees__table thead th:nth-child(3) { width: 14%; }   /* Báo khách */
.ancillary-fees__table thead th:nth-child(4) { width: 13%; }   /* Báo nợ */
.ancillary-fees__table thead th:nth-child(5) { width: 17%; }   /* Chứng từ */
.ancillary-fees__table thead th:nth-child(6) { width: 12%; background: var(--surface-2); }   /* Trạng thái */

/* Clip long text in body cells so numbers/labels never bleed into the
   next column. Col 1 keeps the natural wrap (it stacks name + container). */
.ancillary-fees__table tbody td {
  overflow: visible;
  overflow-wrap: anywhere;
}
.ancillary-fees__table tbody td.num {
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
}

.ancillary-fees__table tfoot td:nth-child(6) {
  background: var(--surface-2);
}

/* Decision cell: status pill + hover action icons */
.fee-decision-cell {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  white-space: nowrap;
}
.fee-action-container {
  position: relative;
  display: inline-flex;
}

.fee-action-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  border-radius: 6px;
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--ink-2);
  cursor: pointer;
  padding: 0;
  transition: background 120ms, color 120ms, border-color 120ms;
  opacity: 0;
}

/* Reveal on row hover — keyboard focus also reveals for accessibility. */
.ancillary-fees__table tbody tr:hover .fee-action-trigger,
.ancillary-fees__table tbody tr:focus-within .fee-action-trigger,
.fee-action-container .fee-action-trigger:focus,
.fee-action-container:focus-within .fee-action-trigger {
  opacity: 1;
}

.fee-action-trigger.is-active {
  opacity: 1;
  background: var(--bg-3);
  border-color: var(--ink-3);
  color: var(--ink);
}

.fee-action-trigger:hover:not(:disabled) {
  background: var(--bg-2);
  color: var(--ink);
  border-color: var(--ink-3);
}

.fee-action-dropdown {
  position: absolute;
  right: 0;
  top: 100%;
  margin-top: 4px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 8px;
  z-index: 60;
  min-width: 120px;
  overflow: hidden;
  padding: 4px 0;
  display: flex;
  flex-direction: column;
}

.fee-action-dropdown__item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  min-height: 44px;
  padding: 10px 12px;
  border: none;
  background: transparent;
  cursor: pointer;
  font-family: var(--font-display);
  font-size: 14px;
  line-height: 1.35;
  color: var(--fg-1);
  text-align: left;
  transition: background 120ms;
}

.fee-action-dropdown__item:hover:not(:disabled) {
  background: var(--bg-2);
}

.fee-action-dropdown__item svg {
  flex-shrink: 0;
}

/* Total row */
.ancillary-fees__table tfoot tr {
  border-top: 2px solid var(--line-2);
  background: var(--surface-2);
}
.ancillary-fees__table tfoot td {
  padding: 10px 5px;
  font-weight: 700;
  font-size: var(--fs-xs);
  /* Match body .num cells: clip long totals so they
     never bleed into the next column on narrow viewports. */
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
}

/* Dashed "Thêm phí" row */
.ancillary-fees__add-row td {
  border: 1.5px dashed var(--line-2);
  border-radius: 6px;
  padding: 8px 12px;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  cursor: pointer;
  text-align: center;
  transition: border-color 120ms ease, color 120ms ease;
}
.ancillary-fees__add-row:hover td {
  border-color: var(--accent);
  color: var(--accent-2);
  background: var(--accent-soft);
}

/* Responsive: hide low-priority columns on narrow viewports */
/* Tablet & Small Desktop (≤ 1200px): hide the 'Chứng từ' column to fit the remaining space */
@media (max-width: 1200px) {
  .ancillary-fees__table { min-width: 600px; }
