      Array.from({ length: 11 }, async (_value, index) => {
        const customer = await mkCustomer();
        const trip = await mkTrip(customer.id, route.id, cargo.id, `2026-07-${String(index + 1).padStart(2, '0')}`);
        await mkRevenue({
