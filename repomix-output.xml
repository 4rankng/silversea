}

.advance-workspace__section-heading {
  margin-bottom: 14px;
}

.advance-workspace__section-heading h2 {
  margin: 0;
  color: var(--ink);
  font-size: var(--fs-lg);
  line-height: var(--lh-tight);
}

.advance-workspace__section-heading p {
  margin: 5px 0 0;
  color: var(--ink-3);
  font-size: var(--fs-sm);
}

/* The workspace supplies the hierarchy. Keep the operational surfaces flat. */
.advance-workspace .adv-panel,
.advance-workspace .as-panel,
.advance-workspace .adv-kpi,
.advance-workspace .as-kpi {
