/* ── Desktop: routes-table layout ────────────────────────────────────
   Uses table-layout: fixed + explicit widths so the first column
   ("Tuyến đường") doesn't over-expand to 600+px (it has unbreakable
   city names like "Hải Phòng - Tân Vũ - Thượng Bằng La, Lào Cai")
   and leave 300px+ of whitespace on the right of the card. */
.routes-table { min-width: 980px; table-layout: fixed; width: 100%; }
.routes-table thead th:nth-child(1) { width: 38%; }   /* Tuyến đường */
.routes-table thead th:nth-child(2) { width: 7%;  }   /* KM */
.routes-table thead th:nth-child(3) { width: 11%; }   /* Loại */
.routes-table thead th:nth-child(4) { width: 11%; }   /* Trạm thu phí */
.routes-table thead th:nth-child(5) { width: 8%;  }   /* Tiền KH */
.routes-table thead th:nth-child(6) { width: 9%;  }   /* Chuẩn 20ft */
.routes-table thead th:nth-child(7) { width: 9%;  }   /* Chuẩn 40ft */
.routes-table thead th:nth-child(8) { width: 7%;  }   /* Sử dụng 06/26 */
/* Keep content inside its assigned column. The previous `overflow: visible`
   let long route names draw on top of the type badge and numeric columns. */
.routes-table tbody td { overflow: hidden; }
.routes-table tbody td:nth-child(1) {
  white-space: normal;
  overflow-wrap: anywhere;
}
.routes-table tbody td:nth-child(1) .row-strong {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.routes-table tbody td:nth-child(n+2) {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Responsive overrides (from responsive.css decomposition) ── */
@media (max-width: 820px) {
  /* ── Routes config page — Mobile Pass 1 (2026-06-02) ──
     - Cards replace the cramped 8-col table
     - First cell becomes the headline (no redundant "TUYẾN ĐƯỜNG:" prefix)
     - Other cells become inline chips with light bg
     - Watermarks hidden on KPI tiles to free up space */
  .routes-config-grid { grid-template-columns: 1fr; gap: 12px; }
  .routes-config-grid > .sticky-card { display: none; }

  /* Container — disable horizontal scroll since rows are vertical cards */
  .routes-config-page .table-wrap { background: transparent; border: none; box-shadow: none; }
  .routes-config-page .table-scroll { overflow-x: visible; }
  .routes-config-page .table-scroll::after { display: none; }

  /* Drop table layout entirely on mobile so the row widths follow the viewport
     instead of the sum of column widths (table layout sized rows to ~900px). */
  .routes-table { display: block; width: 100%; min-width: 0; }
  .routes-table thead { display: none; }
  .routes-table tbody { display: flex; flex-direction: column; gap: 10px; width: 100%; }

  .routes-table tbody tr {
    display: block;
    width: 100%;
    background: var(--bg-1, #fff);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 16px;
    transition: background 160ms var(--ease, ease), border-color 160ms var(--ease, ease);
  }
  .routes-table tbody tr:hover {
    border-color: var(--brand, var(--primary));
  }

  /* Data cells — inline chips. Defined FIRST so the more-specific
     :first-child rule below can override display:inline-flex. */
  .routes-table tbody td[data-label] {
    display: inline-flex; align-items: center;
    gap: 4px; padding: 4px 8px;
    margin: 3px 6px 3px 0;
    font-size: var(--fs-xs);
    color: var(--fg-2, var(--ink-2));
    background: var(--bg-2, rgba(15, 23, 42, 0.04));
    border-radius: 8px;
    white-space: nowrap;
  }
  .routes-table tbody td[data-label]::before {
    content: attr(data-label) ":";
    font-size: var(--fs-2xs);
    font-weight: 600;
    color: var(--fg-3, var(--ink-3));
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .routes-table tbody td[data-label].num {
    font-variant-numeric: tabular-nums;
  }

  /* First cell (route name) is the card headline.
     td:first-child[data-label] has higher specificity than td[data-label]
     AND comes later, so it wins on both counts. */
  .routes-table tbody td:first-child[data-label] {
    display: block;
    padding: 0 0 10px 0;
    margin: 0 0 10px 0;
    border: none;
    border-bottom: 1px solid var(--line-2, rgba(15, 23, 42, 0.06));
    border-radius: 0;
    background: transparent;
    width: 100%;
    white-space: normal;
  }
  .routes-table tbody td:first-child[data-label]::before {
    content: none;
  }
  .routes-table tbody td:first-child[data-label] .row-strong {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--fg-1, var(--ink));
    word-break: keep-all;
    overflow-wrap: anywhere;
    display: block;
  }
  .routes-table tbody td:first-child[data-label] .row-meta {
    font-size: var(--fs-xs);
    color: var(--fg-3, var(--ink-3));
    margin-top: 4px;
    line-height: 1.4;
  }

  /* Keep KPI watermark icons visible on mobile, but quiet enough not to crowd values. */
  .routes-config-page .kpi {
    overflow: hidden;
    padding-right: 54px;
  }
  .routes-config-page .kpi__watermark {
    display: flex;
    right: 10px;
    bottom: 9px;
    width: 38px;
    height: 38px;
    opacity: 0.055;
    color: var(--stat-rail, var(--accent));
  }
  .routes-config-page .kpi__watermark svg {
    width: 38px;
    height: 38px;
    stroke-width: 1.65;
  }

  /* "Popular route" KPI value can be a long Vietnamese city name */
  .routes-config-page .kpi__value { word-break: keep-all; overflow-wrap: anywhere; }

  /* Table footer — compact */
  .routes-config-page .table-foot { padding: 8px 4px; font-size: var(--fs-xs); }
} /* end 640px */

/* ── Application settings feature switches ───────────────────────────────── */
.cfg-toggle {
  position: relative;
  width: 46px;
  height: 26px;
  border: none;
  border-radius: 999px;
  background: #cbd5e1;
  cursor: inherit;
  padding: 0;
  transition: background 0.2s ease;
  flex-shrink: 0;
}
.cfg-toggle.is-on {
  background: #16a34a;
}
.cfg-toggle-knob {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid rgba(16, 24, 20, 0.18);
  transition: transform 0.2s ease;
}
.cfg-toggle.is-on .cfg-toggle-knob {
  transform: translateX(20px);
}
.cfg-panel-action-icon {
  color: #94a3b8;
}

.cfg-feature {
  margin-top: 0;
  padding: 0;
}

.cfg-feature + .cfg-feature {
  margin-top: 0;
}

.cfg-feature__button {
  width: 100%;
  min-height: 76px;
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr) 46px;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  color: inherit;
  background: transparent;
  border: 0;
  text-align: left;
  cursor: pointer;
}

.cfg-feature__button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 4px;
  border-radius: 8px;
}

.cfg-feature__button:disabled {
  cursor: not-allowed;
  opacity: 0.62;
}

.cfg-feature__icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--line));
  border-radius: 8px;
  color: var(--accent-2);
  background: var(--accent-soft);
}

.cfg-feature__copy {
  min-width: 0;
  display: grid;
  gap: 3px;
}

.cfg-feature__label {
  color: var(--ink);
  font-size: var(--fs-sm);
  font-weight: 700;
}

.cfg-feature__description {
  color: var(--ink-2);
  font-size: var(--fs-xs);
  line-height: 1.45;
}

.cfg-feature__state {
  color: var(--ink-3);
  font-family: var(--font-mono);
  font-size: var(--fs-2xs);
