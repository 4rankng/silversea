}

.debit-editor-preview-pane {
  grid-area: preview;
  position: relative;
  display: grid;
  gap: 14px;
  justify-items: stretch;
}

.debit-editor-canvas-frame {
  width: 100%;
  min-width: 0;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: var(--sh);
