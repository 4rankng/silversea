  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}

.shipment-pod-review__title-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.shipment-pod-review__meta {
  margin: 4px 0 0;
  color: var(--fg-3);
  font-size: 13px;
}

.shipment-pod-review__meta-pill,
.shipment-pod-review__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
}

.shipment-pod-review__meta-pill {
  background: var(--bg-1, #fff);
  border: 1px solid var(--border-2, #e5e7eb);
  color: var(--fg-2);
}

.shipment-pod-review__meta-pill--muted {
  background: #ecfccb;
  border-color: #bef264;
  color: #3f6212;
}

.shipment-pod-review__badge--draft {
  background: #e5e7eb;
  color: #374151;
}

.shipment-pod-review__badge--submitted {
  background: #dbeafe;
  color: #1d4ed8;
}

.shipment-pod-review__badge--accepted {
  background: #dcfce7;
  color: #166534;
}

.shipment-pod-review__badge--rejected {
  background: #fee2e2;
  color: #b91c1c;
}

.shipment-pod-review__submission-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  color: var(--fg-3);
  font-size: 12px;
}

.shipment-pod-review__files {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 10px;
}

.shipment-pod-review__file {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-height: 52px;
  width: 100%;
  border: 1px solid var(--border-2, #e5e7eb);
  border-radius: 10px;
  background: var(--bg-1, #fff);
  padding: 12px;
  text-align: left;
  color: inherit;
  cursor: pointer;
}

.shipment-pod-review__file strong {
  display: block;
  font-size: 13px;
}

.shipment-pod-review__file-meta {
  margin-top: 4px;
  color: var(--fg-3);
  font-size: 12px;
  overflow-wrap: anywhere;
}

.shipment-pod-review__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.shipment-pod-review__action {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.shipment-pod-review__alert {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 10px;
  font-size: 13px;
  border: 1px solid #fecaca;
  background: #fff7ed;
  color: #9a3412;
}

.shipment-pod-review__alert--warning {
  border-color: #fed7aa;
  background: #fff7ed;
  color: #9a3412;
}

.shipment-pod-review__alert--danger {
  border-color: #fecaca;
  background: #fef2f2;
  color: #b91c1c;
}

.shipment-pod-review__alert--success {
  border-color: #bbf7d0;
  background: #f0fdf4;
  color: #166534;
}

.shipment-pod-review__cancel-form {
  display: grid;
  gap: 14px;
}

.shipment-pod-review__cancel-summary {
  display: grid;
  gap: 4px;
  padding: 12px;
  border: 1px solid var(--border-2, #e5e7eb);
  border-radius: 10px;
  background: var(--bg-2, #f9fafb);
  font-size: 13px;
  color: var(--fg-2);
}

.shipment-pod-review__cancel-summary strong {
  color: var(--fg-1);
}

.shipment-pod-review__cancel-options {
  display: grid;
  gap: 10px;
  border: 0;
  margin: 0;
  padding: 0;
}

.shipment-pod-review__cancel-options legend,
.shipment-pod-review__cancel-reason > span {
  font-size: 13px;
  font-weight: 600;
  color: var(--fg-1);
  margin-bottom: 6px;
}

.shipment-pod-review__cancel-option {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 10px;
  align-items: flex-start;
  padding: 12px;
  border: 1px solid var(--border-2, #e5e7eb);
  border-radius: 10px;
  background: var(--bg-2, #f9fafb);
  cursor: pointer;
}

.shipment-pod-review__cancel-option strong {
  display: block;
  font-size: 13px;
  color: var(--fg-1);
}

.shipment-pod-review__cancel-option small {
  display: block;
  margin-top: 2px;
  color: var(--fg-3);
  font-size: 12px;
}

.shipment-pod-review__cancel-option input {
  margin-top: 2px;
}

.shipment-pod-review__cancel-reason {
  display: grid;
  gap: 6px;
}

/* Status dot — palette mirrors ShipmentsPage pill variants. */
.shipment-detail__dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4px;
}

.shipment-detail__dot--draft   { background: #6B7280; }
.shipment-detail__dot--info    { background: #3B82F6; }
.shipment-detail__dot--success { background: #10B981; }
.shipment-detail__dot--muted   { background: #1E293B; }
.shipment-detail__dot--danger  { background: #EF4444; }

@media (max-width: 640px) {
  .shipment-detail__operate {
    min-height: 44px;
    width: 100%;
    justify-content: center;
  }

  .shipment-detail {
    padding: 12px;
  }
  .shipment-detail__table {
    font-size: 12px;
  }
  .shipment-detail__table th,
  .shipment-detail__table td {
    padding: 6px 8px;
  }

  .shipment-pod-review__item-head {
    flex-direction: column;
  }

  .shipment-pod-review__actions > * {
    width: 100%;
    justify-content: center;
  }
}
