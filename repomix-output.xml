after(async () => {
  server.closeAllConnections();
  await new Promise<void>((resolve, reject) => {
    server.close((error) => (error ? reject(error) : resolve()));
  });
  // Drain any in-flight fire-and-forget audit writes (audit middleware persists
  // the audit row before `res.end()` resolves, but the persist promise is still
  // settling when teardown begins). Without this drain those writes hold pooled
  // connections and the cleanup deletes below starve the pool intermittently.
  await new Promise((resolve) => setImmediate(resolve));
  await new Promise((resolve) => setTimeout(resolve, 50));
  if (idempotencyKeys.length > 0) {
    await db.delete(s.idempotencyKeys)
      .where(inArray(s.idempotencyKeys.idempotencyKey, idempotencyKeys));
  }
  if (tripIds.length > 0) {
    await db.delete(s.tripGpsCaptureJobs).where(inArray(s.tripGpsCaptureJobs.tripId, tripIds));
    await db.delete(s.notifications).where(and(
