  }

  .credit-override-queue__facts,
  .credit-override-queue__money-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .credit-override-queue__decision-buttons,
  .credit-override-queue__decision-buttons .credit-override-queue__button,
  .credit-override-queue__decision-box > .credit-override-queue__button {
    width: 100%;
  }

  .credit-override-queue__state.is-empty {
