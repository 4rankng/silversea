/* ============================================================================
 * Login page — split operations gateway, composed from Untitled UI patterns.
 * ========================================================================== */
.login-page {
  --login-navy: #071d32;
  --login-navy-soft: #0e3552;
  --login-signal: #46e58a;
  min-height: 100vh;
  min-height: 100dvh;
  background: #e8eeeb;
  padding: 16px;
}

.login-shell {
  display: grid;
  grid-template-columns: minmax(480px, 47%) minmax(0, 53%);
  width: 100%;
  min-height: calc(100vh - 32px);
  min-height: calc(100dvh - 32px);
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--line-2) 88%, transparent);
  border-radius: 20px;
  background: var(--surface);
}

.login-auth-panel {
  display: grid;
  grid-template-rows: auto 1fr auto;
  min-width: 0;
  background:
    linear-gradient(90deg, rgba(0, 90, 45, 0.025) 1px, transparent 1px),
    linear-gradient(rgba(0, 90, 45, 0.025) 1px, transparent 1px),
    var(--surface);
  background-size: 48px 48px;
}

.login-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  min-height: 86px;
  padding: 18px clamp(28px, 4vw, 60px);
  border-bottom: 1px solid var(--line);
}

.login-brand {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12px;
}

.login-brand__logo {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  flex: 0 0 46px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
}

.login-brand__logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.login-brand__copy {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.login-brand__copy strong {
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 800;
  line-height: 1.25;
}

.login-brand__copy > span {
  overflow: hidden;
  color: var(--ink-3);
  font-size: 11px;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-security {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  flex: 0 0 auto;
  color: var(--success-text);
  font-size: 12px;
  font-weight: 700;
}

.login-form-wrap {
  display: grid;
  place-items: center;
  padding: 52px clamp(28px, 6vw, 88px);
}

.login-form {
