/* ============================================================================
 * Panel — TingTing
 * Extracted from UI.css during architecture refactoring (Phase 4)
 * ========================================================================== */
.panel {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r);
  overflow: hidden;
  transition: border-color 150ms var(--ease), background 150ms var(--ease);
}
.panel--solid {
  background: var(--surface);
  border-color: var(--line);
}
.panel[role="button"]:hover,
.panel--clickable:hover {
  border-color: var(--line-strong);
  background: var(--surface-2);
}
.panel[role="button"]:focus-visible,
.panel--clickable:focus-visible {
  outline: 2px solid color-mix(in srgb, var(--accent) 72%, white);
  outline-offset: 2px;
}
.panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 22px 14px;
  border-bottom: 1px solid var(--line);
  background: var(--surface);
  gap: 12px;
}
.panel__title {
  font-family: var(--font-display);
  font-size: var(--fs-md);
  font-weight: 600;
  letter-spacing: 0;
  color: var(--ink);
  margin: 0;
}
.panel__subtitle {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  margin-top: 2px;
  line-height: 1.45;
}
.panel__body {
  padding: 18px 22px 22px;
}
.panel__body--flush { padding: 0 !important; }

/* Legacy card-shell — match panel styling for visual consistency */
.card-shell {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r);
  overflow: hidden;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid var(--line);
}
.card-header h3 {
  margin: 0;
  font-family: var(--font-display);
  font-size: var(--fs-md);
  font-weight: 600;
  letter-spacing: 0;
  color: var(--ink);
}
.card-header p { margin: 3px 0 0; font-size: var(--fs-xs); color: var(--ink-3); }

/* subsection-card — a soft-bordered block used INSIDE a panel for grouping
   related fields. Has a left accent bar + eyebrow title. */
.subsection-card {
  position: relative;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface-2);
  padding: 14px 16px;
  margin-top: 8px;
}
/* Callout accents use the canonical 3×20px status strip (::before), never a
   full-height colored left border. Each variant sets its --strip + soft fill. */
.subsection-card--accent { background: var(--accent-soft);  --strip: var(--accent); }
.subsection-card--info   { background: var(--info-soft);    --strip: var(--info); }
.subsection-card--warn   { background: var(--warning-soft); --strip: var(--warning); }
.subsection-card--danger { background: var(--danger-soft);  --strip: var(--danger); }
.subsection-card--accent::before,
.subsection-card--info::before,
.subsection-card--warn::before,
.subsection-card--danger::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: var(--status-strip-width);
  height: var(--status-strip-height);
  border-radius: var(--status-strip-radius);
  background: var(--strip);
  pointer-events: none;
}
.subsection-card__title {
  font-size: var(--fs-2xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: var(--tracking-eyebrow);
  color: var(--ink-2);
  margin: 0 0 8px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.subsection-card__title svg { width: 13px; height: 13px; }

/* ============================================================================
 * Mobile Grouped Card — iOS settings-style list pattern
 *
 * Usage:
 *   <div class="m-group">
 *     <div class="m-group__card">…</div>
 *     <div class="m-group__card">…</div>
 *   </div>
 *
 * The parent page should set background: var(--surface-2) to show the gray
 * inset that makes the white cards "pop". Use .m-group__card--accent-* for
 * a coloured left-border status variant.
 * ========================================================================== */
.m-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 0 12px;
}

.m-group__card {
  position: relative;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: none;
  width: 100%;
}

@media (max-width: 640px) {
  .panel,
  .card-shell {
    border-radius: 14px;
  }

  .panel__head,
  .card-header {
    padding: 14px 16px 12px;
    align-items: flex-start;
  }

  .panel__body {
    padding: 16px;
  }

  .panel__title,
  .card-header h3 {
    font-size: var(--fs-sm);
    line-height: 1.35;
  }

  .subsection-card {
    padding: 13px 14px;
  }
}

/* Section header row inside a grouped card */
.m-group__head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 11px 16px 8px;
  border-bottom: 1px solid var(--line-3);
}

.m-group__head-title {
  font-size: var(--fs-xs);
  line-height: 1.35;
  font-weight: 700;
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* Content area */
.m-group__body {
  padding: 10px 16px 14px;
}

/* Categorical accent variants — canonical 3×20px status strip, semantic tokens. */
.m-group__card--accent-blue   { --strip: var(--info); }
.m-group__card--accent-green  { --strip: var(--accent); }
.m-group__card--accent-amber  { --strip: var(--warning); }
.m-group__card--accent-accent { --strip: var(--accent); }
.m-group__card--accent-red    { --strip: var(--danger); }
.m-group__card[class~="m-group__card"][class*="m-group__card--accent-"]::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: var(--status-strip-width);
  height: var(--status-strip-height);
  border-radius: var(--status-strip-radius);
  background: var(--strip, var(--accent));
  pointer-events: none;
}
</file>

<file path="frontend/src/components/PhotoViewer.css">
/* ============================================================================
 * PhotoViewer — full-screen lightbox with zoom/pan/navigation
 * Scoped with .pv- prefix, uses app design tokens from tokens.css
 * ========================================================================== */

.pv-overlay {
  position: fixed;
  inset: 0;
  z-index: var(--z-modal);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pv-fade-in 0.2s var(--ease) forwards;
  user-select: none;
  -webkit-user-select: none;
  touch-action: none;
}

@keyframes pv-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* --- Backdrop --- */
.pv-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.88);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

/* --- Top bar --- */
.pv-topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background: linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, transparent 100%);
}

.pv-counter {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: var(--tracking-wide);
  min-width: 52px;
}

.pv-actions {
  display: flex;
  align-items: center;
  gap: 2px;
}

.pv-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  border: none;
  border-radius: var(--r-sm);
  background: transparent;
  color: rgba(255, 255, 255, 0.75);
  cursor: pointer;
  transition: background 120ms var(--ease), color 120ms var(--ease);
}

.pv-btn:hover {
  background: rgba(255, 255, 255, 0.12);
  color: var(--fg-on-brand);
}

.pv-btn:disabled {
  opacity: 0.3;
  cursor: default;
}

.pv-btn--close:hover {
  background: rgba(227, 36, 52, 0.25);
  color: var(--danger);
}

.pv-zoom-label {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: rgba(255, 255, 255, 0.5);
  min-width: 38px;
  text-align: center;
  pointer-events: none;
}

.pv-divider {
  width: 1px;
  height: 20px;
  background: rgba(255, 255, 255, 0.15);
  margin: 0 6px;
}

/* --- Stage (image area) --- */
.pv-stage {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  padding: 56px 0 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  touch-action: none;
}

.pv-image {
  max-width: 92vw;
  max-height: calc(100vh - 96px);
  object-fit: contain;
  transform-origin: center center;
  will-change: transform;
  pointer-events: none;
}

/* --- Navigation arrows --- */
.pv-nav {
  position: absolute;
  top: 50%;
  z-index: 2;
  transform: translateY(-50%);
  width: 48px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: var(--r);
  background: rgba(0, 0, 0, 0.35);
  color: rgba(255, 255, 255, 0.75);
  cursor: pointer;
  transition: background 150ms var(--ease), color 150ms var(--ease),
              transform 150ms var(--ease);
}

.pv-nav:hover {
  background: rgba(0, 0, 0, 0.6);
  color: var(--fg-on-brand);
  transform: translateY(-50%) scale(1.05);
}

.pv-nav:active {
  transform: translateY(-50%) scale(0.97);
}

.pv-nav--prev { left: 16px; }
.pv-nav--next { right: 16px; }

/* --- Mobile adjustments --- */
@media (max-width: 640px) {
  .pv-overlay {
    background: #080a09;
  }

  .pv-backdrop {
    background: rgba(0, 0, 0, 0.94);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .pv-topbar {
    padding: max(10px, env(safe-area-inset-top)) 10px 8px;
    min-height: calc(48px + env(safe-area-inset-top));
    background: linear-gradient(to bottom, rgba(0,0,0,0.72), rgba(0,0,0,0.18) 74%, transparent);
  }

  .pv-btn {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255,255,255,0.9);
  }

  .pv-actions {
    gap: 5px;
  }

  .pv-counter {
    min-width: 42px;
    padding-left: 2px;
    font-size: 13px;
    color: rgba(255,255,255,0.86);
  }

  .pv-zoom-label {
    display: none;
  }

  .pv-divider,
  .pv-actions .pv-btn[title^="Đặt"] {
    display: none;
  }

  .pv-stage {
    padding: calc(54px + env(safe-area-inset-top)) 0 max(18px, env(safe-area-inset-bottom));
  }

  .pv-nav {
    width: 42px;
    height: 56px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.38);
  }

  .pv-nav--prev { left: 6px; }
  .pv-nav--next { right: 6px; }

  .pv-image {
    max-width: 100vw;
    max-height: calc(100dvh - 82px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  }
}
