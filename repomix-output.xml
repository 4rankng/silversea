    assert.equal(leakJob?.status, DURABLE_EFFECT_STATUS.SUCCEEDED);
    assert.equal(await storageService.exists(leakedStorageKey), false);

    const durableOwnerStorageKey = `${scopePrefix}/orphan/company-logo.txt`;
