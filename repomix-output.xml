  ) : null,
  Btn: ({
    children,
    disabled,
    onClick,
  }: {
    children: ReactNode;
    disabled?: boolean;
    onClick?: () => void;
  }) => (
    <button type="button" disabled={disabled} onClick={onClick}>
      {children}
    </button>
  ),
  FormGroup: ({
    label,
    children,
    error,
  }: {
    label: string;
    children: ReactNode;
    error?: string;
  }) => (
    <label>
      <span>{label}</span>
      {children}
      {error && <span>{error}</span>}
