function buildPhotoForm(
  buffer = imageBuffer,
  type = 'CONTAINER',
  filename = 'photo.jpg',
  mimeType = 'image/jpeg',
): FormData {
  const form = new FormData();
  form.set('file', new Blob([new Uint8Array(buffer)], { type: mimeType }), filename);
  form.set('trip_id', String(tripId));
  form.set('type', type);
