  line-height: 1.35;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.debit-editor-column-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
