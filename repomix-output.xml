.ttp-position-row::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 3px;
  height: 20px;
  border-radius: 0 2px 2px 0;
  background: var(--accent, #00B14F);
  transform: translateY(-50%);
}

.ttp-position-row--read {
  grid-template-columns: minmax(0, 1fr) auto;
}

.ttp-position-row--editing {
  grid-template-columns: minmax(0, 1fr) auto;
  background: color-mix(in srgb, var(--accent-soft, #E6F7EE) 48%, white);
  border-color: color-mix(in srgb, var(--accent, #00B14F) 22%, var(--line, #EAECEF));
}

.ttp-position-name {
  min-width: 0;
  display: grid;
  gap: 2px;
}

.ttp-position-select {
  min-width: 0;
  display: grid;
  gap: 2px;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: left;
}

.ttp-position-select:not(:disabled) {
  cursor: pointer;
}

.ttp-position-select:disabled {
  cursor: default;
}

.ttp-position-select:not(:disabled):hover span {
  color: var(--accent-ink, #004D22);
}

.ttp-position-name span {
  color: var(--ink, var(--fg-1));
  font-size: 13.5px;
  font-weight: 750;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ttp-position-name small {
  color: var(--ink-2, var(--fg-2));
  font-size: var(--fs-xs);
  font-weight: 550;
  line-height: 1.35;
}

.ttp-position-empty {
  min-height: 142px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 22px;
  border: 1px dashed var(--line-2, var(--border-2));
  border-radius: 14px;
  background:
    radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--accent, #00B14F) 9%, transparent), transparent 46%),
    var(--surface, #fff);
  text-align: center;
}

.ttp-position-empty-icon {
  width: 40px;
  height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid color-mix(in srgb, var(--accent, #00B14F) 22%, white);
  border-radius: 12px;
  background: var(--accent-soft, #E6F7EE);
  color: var(--accent, #00B14F);
}

.ttp-position-empty strong {
  display: block;
  color: var(--ink, var(--fg-1));
  font-size: 14px;
  font-weight: 750;
  line-height: 1.35;
}

.ttp-position-empty span {
  display: block;
  color: var(--ink-3, var(--fg-3));
  font-size: 12px;
  line-height: 1.45;
}

@media (max-width: 1180px) {
  .ttp-add {
    grid-template-columns: minmax(190px, 1.2fr) repeat(2, minmax(140px, 0.9fr));
  }

  .ttp-add-submit {
    grid-column: 1 / -1;
  }
}

@media (max-width: 760px) {
  .ttp {
    max-width: none;
  }

  .ttp-header {
    margin-bottom: 12px;
  }

  .ttp-header > div:first-child {
    min-width: 0;
  }

  .ttp-header h1 {
    font-size: 20px;
  }

  .ttp-section-head {
    flex-direction: column;
    align-items: stretch;
  }

  .ttp-tool-btn {
    align-self: flex-start;
  }

  .ttp-legend {
    justify-content: flex-start;
  }

  .ttp-workbench {
    gap: 12px;
  }

  .ttp-spares,
  .ttp-disposed {
    margin-top: 12px;
  }

  .ttp-panel--table {
    order: 1;
  }

  .ttp-panel--form {
    order: 2;
  }

  .ttp-add {
    grid-template-columns: 1fr;
  }

  .ttp-field--serial,
  .ttp-add-submit {
    grid-column: auto;
  }

  .ttp-empty {
    min-height: 144px;
  }

  .ttp-table-wrap {
    overflow-x: visible;
  }

  .ttp-table-wrap:focus-visible {
    box-shadow: none;
  }

  .ttp-table,
  .ttp-table thead,
  .ttp-table tbody,
  .ttp-table tr,
  .ttp-table th,
  .ttp-table td {
    display: block;
  }

  .ttp-table {
    width: 100%;
    min-width: 0;
  }

  .ttp-table colgroup,
  .ttp-table thead {
    display: none;
  }

  .ttp-table tbody tr {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border-1);
  }

  .ttp-table tbody tr:last-child {
    border-bottom: none;
  }

  .ttp-table tbody td {
    display: grid;
    grid-template-columns: minmax(92px, 36%) minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding: 7px 0;
    border-bottom: none;
  }

  .ttp-table tbody td::before {
    content: attr(data-label);
    color: var(--fg-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.35;
  }

  .ttp-row-actions {
    position: static;
    z-index: auto;
    display: flex;
    justify-content: flex-start;
    text-align: left;
    padding: 7px 0;
    background: transparent;
    box-shadow: none;
  }

  .ttp-table tbody td.ttp-row-actions::before {
    display: none;
  }

  .ttp-icon-actions {
    justify-content: flex-start;
  }

  .ttp-dialog-overlay {
    align-items: flex-end;
    padding: 12px;
  }

  .ttp-dialog {
    max-height: min(720px, calc(100dvh - 24px));
    border-radius: 16px;
  }

  .ttp-dialog--positions {
    min-height: 0;
  }

  .ttp-edit-form {
    grid-template-columns: 1fr;
  }

  .ttp-position-manager {
    padding: 14px;
  }

  .ttp-position-create {
    grid-template-columns: 1fr;
  }

  .ttp-position-row,
  .ttp-position-row--read {
    grid-template-columns: minmax(0, 1fr) 76px;
    gap: 8px;
    min-height: 70px;
    padding: 12px 10px 12px 15px;
  }

  .ttp-position-row--editing {
    grid-template-columns: 1fr;
  }

  .ttp-position-row > .ttp-icon-actions {
    justify-self: end;
    align-self: center;
    justify-content: flex-end;
  }

  .ttp-position-row--editing > .ttp-icon-actions {
    justify-self: start;
    justify-content: flex-start;
  }

  .ttp-position-name span,
  .ttp-position-name small {
    white-space: normal;
  }

  .ttp-position-list {
    max-height: none;
  }
}

/* ─── Disposed (thanh lý) section ─────────────────────────────────────────── */
.ttp-disposed {
  background: var(--bg-2, #f8f9fa);
}

.ttp-table--disposed tbody td {
  color: var(--fg-3);
}

.ttp-row-disposed .ttp-serial {
  color: var(--fg-2);
}

/* ─── Unmount / dispose dialog ────────────────────────────────────────────── */
.ttp-dialog--unmount {
  width: min(480px, 100%);
}

.ttp-unmount-options {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 18px 20px 4px;
}

.ttp-unmount-choice {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 14px;
  border: 1px solid var(--border-2);
  border-radius: 12px;
  background: var(--bg-1, #fff);
  cursor: pointer;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.ttp-unmount-choice.is-active {
  border-color: rgba(0, 177, 79, 0.45);
  background: rgba(0, 177, 79, 0.06);
}

.ttp-unmount-choice input[type='radio'] {
  margin-top: 3px;
  accent-color: #00B14F;
}

.ttp-unmount-choice__main {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.ttp-unmount-choice__main strong {
  color: var(--ink, var(--fg-1));
  font-size: 14px;
  font-weight: 650;
}

.ttp-unmount-choice__main small {
  color: var(--fg-3);
  font-size: 12px;
}

.ttp-unmount-reason {
  padding: 4px 20px 0;
}

.ttp-unmount-reason-custom {
  margin-top: 8px;
}
