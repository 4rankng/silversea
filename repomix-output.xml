  tollsAddition: 0,
  tollsStations: 0,
  tollPerStation: 55000,
  hasReturnCargo: false,
  returnCargoBonus: 300000,
  revenue: 10800000,   // 10,000,000 ex-VAT at 8%
  driverSalary: 800000,
