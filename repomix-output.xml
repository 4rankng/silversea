  .accounting-workflows { grid-template-columns: 1fr; }
  .accounting-workflow,
  .accounting-workflow:nth-child(odd),
  .accounting-workflow:nth-last-child(-n + 2) { border-right: 0; border-bottom: 1px solid var(--border-1); }
  .accounting-workflow:last-child { border-bottom: 0; }
  .accounting-workflow { grid-template-columns: 42px minmax(0, 1fr) 20px; min-height: 92px; padding: 14px; }
  .accounting-workflow__metric { grid-column: 2; white-space: normal; }
  .accounting-workflow__arrow { grid-column: 3; grid-row: 1 / span 2; }
  .accounting-register__header { align-items: stretch; flex-direction: column; padding: 14px; }
  .accounting-transport-card dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .accounting-register__footer { align-items: stretch; flex-direction: column; padding: 12px 14px; }
  .accounting-register__footer > div { justify-content: space-between; }
  .accounting-selection { align-items: stretch; flex-wrap: wrap; padding: 12px 14px; }
  .accounting-selection > div { flex-basis: 100%; }
  .accounting-selection button,
  .accounting-selection a { justify-content: center; flex: 1; }
  .accounting-period input,
  .accounting-register__search input,
  .accounting-register__filters select { font-size: 16px; }
}

@media (max-width: 360px) {
  .accounting-period__fields { grid-template-columns: 1fr; }
  .accounting-workflow { grid-template-columns: 38px minmax(0, 1fr) 18px; gap: 10px; }
  .accounting-workflow__icon { width: 38px; height: 38px; }
  .accounting-tabs { width: 100%; }
  .accounting-tabs a { flex: 1; min-width: 0; justify-content: center; padding: 0 8px; }
  .accounting-transport-card dl { grid-template-columns: 1fr; }
}
