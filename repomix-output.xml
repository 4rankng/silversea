@tc("TC-M01-04-01", roles=["ADMIN"], url="/trips/:id",
    title="M01-04-01 Trip detail profit section renders (needs seed trip)")
def tc_m01_04_01(ctx: VisualTestContext):
    trip_id = _first_trip_id()
