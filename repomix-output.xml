/* ============================================================================
 * Topbar
 * ========================================================================== */
.topbar {
  height: var(--topbar-h);
  padding: 0 24px;
  display: flex;
  align-items: center;
  gap: 14px;
  background: var(--surface);
  border-bottom: 1px solid var(--line);
  position: relative;
  z-index: var(--z-sticky, 100);
  flex-shrink: 0;
  opacity: 0; /* starts hidden for anime.js entrance */
  transition: transform 220ms var(--ease), opacity 220ms var(--ease), margin-top 220ms var(--ease);
}

.topbar > * {
  min-width: 0;
}

.topbar--driver {
  position: relative;
  z-index: var(--z-sticky, 100);
  justify-content: flex-start;
  background: var(--surface);
  border-bottom: 1px solid var(--line);
  padding: 10px 16px;
  height: auto;
  gap: 12px;
}

.topbar__left-driver {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  min-width: 0;
}

.topbar__welcome {
  display: flex;
  flex-direction: column;
  line-height: 1.35;
  min-width: 0;
}

.topbar__welcome .greeting {
  font-size: var(--fs-xs);
  line-height: 1.35;
  color: var(--ink-3);
  white-space: nowrap;
}

.topbar__welcome .name {
  font-size: 15px;
  line-height: 1.35;
  font-weight: 700;
  color: var(--ink);
  white-space: nowrap;
  overflow: visible;
}

.topbar__center-driver {
  display: flex;
  align-items: center;
  flex: 1 1 auto;
  justify-content: flex-end;
  min-width: 0;
  margin-left: auto;
}

/* MonthNavigator trigger + popover */
.topbar-date {
  position: relative;
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}

.topbar-date__trigger {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  height: 44px;
  padding: 0 13px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--ink);
  font-size: var(--fs-sm);
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  white-space: nowrap;
  box-shadow: none;
  transition: background 120ms var(--ease), border-color 120ms var(--ease), color 120ms var(--ease);
}
.topbar-date__trigger:hover {
  background: var(--surface-2);
  border-color: var(--line-strong);
}
.topbar-date.is-open .topbar-date__trigger {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent-ink);
}
.topbar-date__icon {
  color: var(--ink-2);
  flex-shrink: 0;
}
.topbar-date.is-open .topbar-date__icon {
  color: var(--accent);
}
.topbar-date__body {
  display: flex;
  flex-direction: column;
  gap: 1px;
  text-align: left;
}
.topbar-date__label {
  font-variant-numeric: tabular-nums;
  line-height: 1.35;
}
.topbar-date__period {
  font-size: var(--fs-xs);
  font-family: var(--font-mono);
  color: var(--ink-3);
  font-weight: 600;
  line-height: 1.35;
}
.topbar-date__caret {
  color: var(--ink-3);
  flex-shrink: 0;
  transition: transform 200ms var(--ease);
}
.topbar-date.is-open .topbar-date__caret {
  transform: rotate(180deg);
  color: var(--accent);
}

.month-picker {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  z-index: var(--z-popover, 50);
  width: 336px;
  max-width: min(336px, calc(100vw - 24px));
  background: var(--surface);
  border: 1px solid var(--line-2);
  border-radius: var(--r);
  padding: 14px;
  animation: month-picker-in 160ms var(--ease);
}
@keyframes month-picker-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.month-picker__title {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 2px 4px 12px;
}
.month-picker__title span {
  color: var(--ink);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0;
}
.month-picker__title small {
  color: var(--ink-3);
  font-size: var(--fs-xs);
  line-height: 1.35;
  font-weight: 600;
}
.month-picker__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px;
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: 14px;
  margin-bottom: 10px;
}
.month-picker__year {
  font-size: 13px;
  font-weight: 800;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}
.month-picker__year-nav {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--control-h);
  height: var(--control-h);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--ink-2);
  cursor: pointer;
  padding: 0;
  transition: background 120ms var(--ease), border-color 120ms var(--ease), color 120ms var(--ease);
}
.month-picker__year-nav:hover {
  background: #ffffff;
  border-color: rgba(0, 90, 45, 0.25);
  color: var(--ink);
}
.month-picker__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}
.month-picker__cell {
  min-height: 54px;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  color: var(--ink);
  font-family: inherit;
  cursor: pointer;
  font-variant-numeric: tabular-nums;
  transition: background 120ms var(--ease), border-color 120ms var(--ease), color 120ms var(--ease);
}
.month-picker__cell-code {
  color: var(--ink);
  font-size: 14px;
  font-weight: 850;
  line-height: 1.25;
}
.month-picker__cell-name {
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 700;
  line-height: 1.3;
}
.month-picker__cell:hover {
  background: #ffffff;
  border-color: rgba(0, 90, 45, 0.22);
}
.month-picker__cell.is-current {
  background: rgba(232, 241, 236, 0.78);
  border-color: rgba(0, 90, 45, 0.28);
  color: var(--accent);
}
.month-picker__cell.is-current .month-picker__cell-code {
  color: var(--accent);
}
.month-picker__cell.is-current:hover {
  background: rgba(232, 241, 236, 0.96);
}
.month-picker__cell.is-selected {
  background: var(--accent-2);
  color: var(--fg-on-brand);
  border-color: rgba(0, 90, 45, 0.92);
}
.month-picker__cell.is-selected .month-picker__cell-code,
.month-picker__cell.is-selected .month-picker__cell-name {
  color: var(--fg-on-brand);
}
.month-picker__cell.is-selected:hover {
  background: var(--accent-ink);
}
.month-picker__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 10px;
  padding: 10px 2px 0;
  border-top: 1px solid rgba(224, 231, 226, 0.9);
}
.month-picker__today {
  background: rgba(0, 90, 45, 0.08);
  border: 1px solid rgba(0, 90, 45, 0.14);
  color: var(--accent);
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  padding: 7px 10px;
  border-radius: 999px;
  font-family: inherit;
  transition: background 120ms var(--ease), border-color 120ms var(--ease);
}
.month-picker__today:hover {
  background: rgba(0, 90, 45, 0.12);
  border-color: rgba(0, 90, 45, 0.24);
}
.month-picker__hint {
  min-width: 0;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 650;
  text-align: right;
  line-height: 1.35;
}

.topbar--driver .icon-btn {
  background: transparent;
  border: none;
  color: var(--ink-2);
}

.topbar--driver .icon-btn:hover {
  background: var(--surface-3);
  color: var(--ink);
}

@media (max-width: 640px) {
  .month-picker {
    width: min(304px, calc(100vw - 28px));
  }

  .month-picker__cell {
    min-height: 48px;
  }

  .month-picker__cell-code {
    font-size: 13px;
  }

  .month-picker__cell-name {
    font-size: var(--fs-xs);
  }
}

@media (max-width: 380px) {
  .month-picker {
    width: min(286px, calc(100vw - 20px));
    right: -8px;
    padding: 12px;
  }

  .month-picker__grid {
    gap: 6px;
  }

  .month-picker__cell {
    min-height: 46px;
    border-radius: 12px;
  }

  .month-picker__cell-name {
    display: none;
  }
}

.topbar-divider { width: 1px; height: 20px; background: var(--line); margin: 0 6px; }

