    const staleReject = await testFetch(`/${shipment.id}/change-requests/${requestId}/review`, {
      method: 'POST',
      token: managerToken,
      body: { resolution: 'REJECTED' },
    });
    assert.equal(staleReject.status, 200);
    assert.equal(staleReject.data.resolution, 'REJECTED');
