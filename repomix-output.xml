}
.audit-list-panel .table-hover tbody tr:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: -2px;
}
.audit-list-panel .table-hover tbody tr.is-selected {
  background: var(--accent-soft);
  box-shadow: inset 3px 0 0 var(--accent);
}
.audit-row-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  min-width: 0;
}
.audit-row-content__preview {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: var(--fw-medium);
  opacity: 0;
  transform: translateX(4px);
  transition: opacity var(--t-fast), transform var(--t-fast), color var(--t-fast);
}
.audit-list-panel .table-hover tbody tr:hover .audit-row-content__preview,
.audit-list-panel .table-hover tbody tr:focus-visible .audit-row-content__preview {
  color: var(--accent-2);
  opacity: 1;
  transform: translateX(0);
}

.audit-detail-modal {
  background: transparent;
}
.audit-detail-modal::backdrop {
  background: rgba(16, 21, 19, 0.42);
  backdrop-filter: blur(2px);
}
.audit-detail-modal .audit-detail-modal__box {
  width: min(580px, calc(100vw - 24px));
  max-width: none;
  height: 100dvh;
  max-height: 100dvh;
  padding: 0;
  border-radius: var(--radius-lg) 0 0 var(--radius-lg);
  background: var(--surface);
  color: var(--ink);
  box-shadow: var(--sh-drawer);
  overflow: hidden;
}
.audit-detail-modal__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding: 22px 24px 18px;
  border-bottom: 1px solid var(--line);
  background: var(--surface-2);
}
.audit-detail-modal__eyebrow {
  display: block;
  margin-bottom: 4px;
  color: var(--accent-2);
  font-size: var(--fs-2xs);
  font-weight: var(--fw-bold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.audit-detail-modal__header h2 {
  margin: 0;
  color: var(--ink);
  font-size: var(--fs-xl);
  line-height: var(--lh-tight);
}
.audit-detail-modal__header p {
  margin: 6px 0 0;
  color: var(--ink-3);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
}
.audit-detail-modal__body {
  height: calc(100dvh - 104px);
  padding: 22px 24px 40px;
  overflow-y: auto;
  overscroll-behavior: contain;
}

/* ── Avatar ring color ── */
.avatar-ring {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--fg-on-brand);
  flex-shrink: 0;
}
.avatar-ring--1 { background: #7c3aed; }
.avatar-ring--2 { background: var(--accent); }
.avatar-ring--3 { background: var(--info); }
.avatar-ring--4 { background: var(--warning); }
.avatar-ring--5 { background: var(--danger); }

/* ── Audit-log message (desktop = ellipsis, mobile = wraps) ── */
.audit-log__msg {
  font-size: var(--fs-xs);
  color: var(--ink-2);
  line-height: 1.4;
  overflow: visible;
  overflow-wrap: anywhere;
  white-space: normal;
  max-width: 100%;
}

/* ── Compact screens (≤820px): table → vertical card list ──
 *
 * The desktop table is unscannable on phone because the Nội dung column
 * (the action label + message — the actually useful content) is behind
 * a horizontal scroll. Reshape each row into a 2-row card:
 *   row 1: relative time chip · user avatar + name
 *   row 2: action label + full message (wraps)
 * ========================================================================== */
@media (max-width: 820px) {
  .audit-log-page .kpi__watermark { display: none; }
  .audit-log-page .kpi { overflow: hidden; }

  .audit-log-page .table-scroll { overflow-x: visible; }
  .audit-log-page .table-scroll::after { display: none; }

  .audit-log-page table.table-hover { display: block; min-width: 0; }
  .audit-log-page table.table-hover thead { display: none; }
  .audit-log-page table.table-hover tbody {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px 12px 4px;
  }
  .audit-log-page table.table-hover tr {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "time user"
      "content content";
    gap: 6px 10px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    align-items: center;
  }
  .audit-log-page table.table-hover td {
    display: block;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .audit-log-page table.table-hover td:nth-child(1) { display: none; }      /* hide # */
  .audit-log-page table.table-hover td:nth-child(2) { grid-area: time; white-space: nowrap; }
  .audit-log-page table.table-hover td:nth-child(3) {
    grid-area: user;
    overflow: visible;
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .audit-log-page table.table-hover td:nth-child(4) {
    grid-area: content;
    padding-top: 8px;
    border-top: 1px solid var(--line);
    min-width: 0;
  }
  .audit-log-page .audit-log__msg {
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }
  .audit-list-panel__intro {
    align-items: flex-start;
    padding: 14px 16px;
  }
  .audit-list-panel__intro p { max-width: 240px; }
  .audit-row-content { gap: 8px; }
  .audit-row-content__preview {
    width: 36px;
    height: 36px;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--surface-3);
    opacity: 1;
    transform: none;
  }
  .audit-row-content__preview span { display: none; }
  .audit-detail-modal { place-items: end center; }
  .audit-detail-modal .audit-detail-modal__box {
    width: 100vw;
    height: min(88dvh, 760px);
    max-height: 88dvh;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .audit-detail-modal__header { padding: 18px 18px 14px; }
  .audit-detail-modal__body {
    height: calc(min(88dvh, 760px) - 94px);
    padding: 18px 18px 32px;
  }
  /* Empty / loading / "đang tải thêm…" rows: single column, centered */
  .audit-log-page table.table-hover tr:has(td[colspan]) {
    display: block;
    text-align: center;
    border: 0;
    background: transparent;
    padding: 0;
  }
}
