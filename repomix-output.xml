}

.login-intro {
  margin-bottom: 34px;
}

.login-eyebrow {
  margin: 0 0 12px;
  color: var(--accent-2);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.login-form h1 {
  margin: 0;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: clamp(32px, 3.2vw, 44px);
  font-weight: 800;
  letter-spacing: -0.035em;
  line-height: 1.12;
}

.login-subtitle {
  max-width: 36ch;
  margin: 13px 0 0;
  color: var(--ink-3);
  font-size: 15px;
  line-height: 1.65;
}

.login-form .field {
  min-width: 0;
  margin-bottom: 20px;
}

.login-form label {
  display: block;
  margin-bottom: 8px;
  color: var(--ink-2);
  font-size: 13px;
  font-weight: 700;
  line-height: 1.45;
}

.login-form .input-icon {
  min-height: 52px;
}

.login-form .input-icon > svg {
  left: 16px;
  width: 18px;
  height: 18px;
}

.login-form .input {
  width: 100%;
  min-width: 0;
  height: 52px;
  min-height: 52px;
  padding-left: 46px;
  border-color: var(--line-2);
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.94);
  font-size: 15px;
}

.login-form .input-icon:focus-within > svg {
  color: var(--accent-2);
}

.login-form .input::placeholder {
  color: #8a938e;
}

.login-form .input[aria-invalid="true"] {
  border-color: color-mix(in srgb, var(--danger) 65%, var(--line-2));
}

.login-form .input-icon:has(.password-toggle) .input {
  padding-right: 52px;
}

.password-toggle {
  position: absolute;
  top: 50%;
  right: 4px;
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  padding: 0;
  transform: translateY(-50%);
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: var(--ink-3);
  cursor: pointer;
  transition: background var(--t-fast), color var(--t-fast);
}

.password-toggle:hover {
  background: var(--surface-3);
  color: var(--ink);
}

.password-toggle:focus-visible {
  outline: 2px solid var(--accent-2);
  outline-offset: 0;
}

.login-error,
.login-session-notice {
  margin-bottom: 18px;
  padding: 11px 13px;
  border: 1px solid transparent;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.5;
}

.login-error {
  border-color: color-mix(in srgb, var(--danger) 25%, transparent);
  background: var(--danger-soft);
  color: var(--danger-text);
}

.login-session-notice {
  border-color: color-mix(in srgb, var(--warning) 28%, transparent);
  background: var(--warning-soft);
  color: var(--warning-text);
}

.login-submit {
  width: 100%;
  height: 52px;
  margin-top: 4px;
  border-radius: 11px;
  font-size: 15px;
  font-weight: 750;
}

.login-submit svg {
  transition: transform var(--t-normal);
}

.login-submit:hover svg {
  transform: translateX(3px);
}

.login-help {
  margin: 17px 0 0;
  color: var(--ink-3);
  font-size: 12px;
  line-height: 1.55;
  text-align: center;
}

.login-footer {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 20px clamp(28px, 4vw, 60px);
  border-top: 1px solid var(--line);
  color: var(--ink-3);
  font-size: 11px;
  font-weight: 600;
}

.login-visual {
  position: relative;
  min-width: 0;
  overflow: hidden;
  isolation: isolate;
  background: var(--login-navy);
}

.login-visual__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 50%;
  z-index: -2;
  animation: login-image-reveal 900ms var(--ease-drawer) both;
}

.login-visual__veil {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(180deg, rgba(3, 18, 34, 0.08) 16%, rgba(3, 18, 34, 0.28) 50%, rgba(3, 18, 34, 0.94) 100%),
    linear-gradient(90deg, rgba(3, 18, 34, 0.3), transparent 45%);
}

.login-visual__content {
  position: absolute;
  right: clamp(32px, 5vw, 76px);
  bottom: clamp(34px, 6vh, 72px);
  left: clamp(32px, 5vw, 76px);
  color: #fff;
  animation: login-copy-reveal 650ms 160ms var(--ease-drawer) both;
}

.login-visual__eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 0 0 16px;
  color: rgba(255, 255, 255, 0.82);
  font-size: 12px;
  font-weight: 750;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.login-status-dot {
  width: 8px;
  height: 8px;
  border: 2px solid rgba(255, 255, 255, 0.58);
  border-radius: 50%;
  background: var(--login-signal);
}

.login-visual h2 {
  max-width: 720px;
  margin: 0;
  color: #fff;
  font-family: var(--font-display);
  font-size: clamp(34px, 4vw, 62px);
  font-weight: 750;
  letter-spacing: -0.045em;
  line-height: 1.08;
  text-wrap: balance;
}

.login-visual__content > p:not(.login-visual__eyebrow) {
  max-width: 610px;
  margin: 20px 0 0;
  color: rgba(255, 255, 255, 0.76);
  font-size: 15px;
  line-height: 1.65;
}

.login-capabilities {
  display: flex;
  flex-wrap: wrap;
  gap: 9px 22px;
  margin: 28px 0 0;
  padding: 22px 0 0;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  list-style: none;
}

.login-capabilities li {
  position: relative;
  padding-left: 14px;
  color: rgba(255, 255, 255, 0.86);
  font-size: 12px;
  font-weight: 650;
}

.login-capabilities li::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 5px;
  height: 5px;
  transform: translateY(-50%) rotate(45deg);
  background: var(--login-signal);
}

@keyframes login-image-reveal {
  from {
    opacity: 0.65;
    transform: scale(1.035);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes login-copy-reveal {
  from {
    opacity: 0;
    transform: translateY(18px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 1100px) {
  .login-shell {
    grid-template-columns: minmax(430px, 56%) minmax(0, 44%);
  }

  .login-topbar {
    padding-inline: 34px;
  }

  .login-security {
    display: none;
  }

  .login-form-wrap {
    padding-inline: 48px;
  }

  .login-visual h2 {
    font-size: clamp(32px, 4.5vw, 48px);
  }

  .login-capabilities {
    display: grid;
    gap: 10px;
  }
}

@media (max-width: 900px) {
  .login-page {
    padding: 0;
    background: var(--surface);
  }

  .login-shell {
    display: flex;
    min-height: 100vh;
    min-height: 100dvh;
    flex-direction: column-reverse;
    border: 0;
    border-radius: 0;
  }

  .login-auth-panel {
    z-index: 1;
    min-height: calc(100dvh - 196px);
    border-radius: 22px 22px 0 0;
    margin-top: -22px;
  }

  .login-topbar {
    min-height: 76px;
    padding: 14px 20px;
  }

  .login-brand__logo {
    width: 42px;
    height: 42px;
    flex-basis: 42px;
  }

  .login-brand__copy > span {
    max-width: 210px;
  }

  .login-form-wrap {
    place-items: start center;
    padding: 28px 22px 26px;
  }

  .login-form {
    width: min(100%, 430px);
  }

  .login-intro {
    margin-bottom: 27px;
  }

  .login-form h1 {
    font-size: 32px;
  }

  .login-subtitle {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.55;
  }

  .login-form .field {
    margin-bottom: 17px;
  }

  .login-form .input {
    height: 50px;
    min-height: 50px;
    font-size: 16px;
  }

  .login-submit {
    height: 50px;
  }

  .login-footer {
    justify-content: center;
    padding: 16px 20px calc(16px + env(safe-area-inset-bottom));
    text-align: center;
  }

  .login-visual {
    min-height: 218px;
  }

  .login-visual__image {
    object-position: 50% 45%;
  }

  .login-visual__veil {
    background: linear-gradient(180deg, rgba(3, 18, 34, 0.1), rgba(3, 18, 34, 0.66));
  }

  .login-visual__content {
    right: 22px;
    bottom: 43px;
    left: 22px;
  }

  .login-visual__eyebrow {
    margin-bottom: 8px;
    font-size: 10px;
  }

  .login-visual h2 {
    max-width: 420px;
    font-size: clamp(22px, 7vw, 30px);
    letter-spacing: -0.03em;
  }

  .login-visual__content > p:not(.login-visual__eyebrow),
  .login-capabilities {
    display: none;
  }
}

@media (max-width: 390px) {
  .login-brand__copy > span {
    display: none;
  }

  .login-form-wrap {
    padding-inline: 18px;
  }

  .login-footer {
    flex-wrap: wrap;
  }
}

@media (max-height: 740px) and (max-width: 900px) {
  .login-visual {
    min-height: 164px;
  }

  .login-visual__content {
    bottom: 34px;
  }

  .login-visual h2 {
    font-size: 23px;
  }

  .login-auth-panel {
    min-height: calc(100dvh - 142px);
  }

  .login-intro {
    margin-bottom: 22px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .login-visual__image,
  .login-visual__content {
    animation: none;
  }

  .login-submit svg {
    transition: none;
  }
}
