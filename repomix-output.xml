}

.ttp-position-create-copy span {
  color: var(--ink-3, var(--fg-3));
  font-size: 12px;
  line-height: 1.45;
}

.ttp-position-control--name {
  min-width: 220px;
}

.ttp-position-control {
  min-width: 0;
  display: grid;
  gap: 5px;
}

.ttp-position-control span {
  color: var(--ink-2, var(--fg-2));
  font-size: var(--fs-xs);
  font-weight: 750;
  letter-spacing: 0.04em;
  line-height: 1.35;
  text-transform: uppercase;
}

.ttp-position-control .input {
  height: 38px;
  border-color: var(--line-2, var(--border-2));
  border-radius: 9px;
  background: var(--surface, #fff);
  font-size: 12.5px;
}

.ttp-position-add-btn {
  min-height: 38px;
  align-self: end;
  justify-content: center;
  gap: 6px;
  padding: 0 14px;
  border-radius: 9px;
  font-size: 12.5px;
  white-space: nowrap;
}

.ttp-position-error {
  grid-column: 1 / -1;
  padding: 9px 11px;
  border: 1px solid color-mix(in srgb, var(--danger, #DC2626) 20%, white);
  border-radius: 9px;
  background: var(--danger-soft, #FEF2F2);
  color: var(--danger-text, #991B1B);
  font-size: 12px;
  font-weight: 650;
  line-height: 1.35;
}

.ttp-position-list {
  min-height: 0;
  display: grid;
  align-content: start;
  gap: 9px;
  max-height: min(360px, 42vh);
  overflow: auto;
  padding: 1px 2px 4px 0;
}

.ttp-position-row {
  position: relative;
  min-height: 54px;
  display: grid;
  gap: 10px;
  align-items: center;
  padding: 10px 12px 10px 15px;
  border: 1px solid var(--line, var(--border-1));
  border-radius: 12px;
  background: var(--surface, #fff);
  box-shadow: 0 1px 2px rgba(9, 9, 11, 0.03);
