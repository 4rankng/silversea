<file path="deploy/vantai/Makefile">
# ──────────────────────────────────────────────────────────────────────────────
# TingTing — Deploy to vantai.tingting.vip (demo server)
#
# Usage:
#   make deploy             Deploy both backend + frontend
#   make deploy-backend     Deploy backend only (+ migrations)
#   make deploy-frontend    Deploy frontend only
#   make adminer-on         Enable Adminer DB GUI
#   make adminer-off        Disable Adminer
#   make prune              Remove unused Docker images
#
# Prerequisites:
#   - Images already pushed: cd backend && make push && cd ../frontend && make push
#   - SSH access to root@vantai.tingting.vip
# ──────────────────────────────────────────────────────────────────────────────

PROD_SERVER := vantai.tingting.vip
DEPLOY_PATH := /opt/vantai
COMPOSE     := docker compose -f deploy/docker-compose.prod.yml

.PHONY: deploy deploy-backend deploy-frontend adminer-on adminer-off prune

## deploy: Deploy both backend and frontend
deploy: deploy-backend deploy-frontend

## deploy-backend: Pull latest backend image, restart, run migrations
deploy-backend:
	@echo "=== Deploying backend to $(PROD_SERVER) ==="
	ssh root@$(PROD_SERVER) "cd $(DEPLOY_PATH) && $(COMPOSE) pull backend"
	ssh root@$(PROD_SERVER) "cd $(DEPLOY_PATH) && $(COMPOSE) up -d --force-recreate --no-deps backend"
	@echo "Running migrations..."
	ssh root@$(PROD_SERVER) "cd $(DEPLOY_PATH) && $(COMPOSE) exec -T backend npx drizzle-kit migrate"
	ssh root@$(PROD_SERVER) "docker image prune -f"
	@echo "Backend deployed ✓"

## deploy-frontend: Pull latest frontend image and restart
deploy-frontend:
	@echo "=== Deploying frontend to $(PROD_SERVER) ==="
	ssh root@$(PROD_SERVER) "cd $(DEPLOY_PATH) && $(COMPOSE) pull frontend"
	ssh root@$(PROD_SERVER) "cd $(DEPLOY_PATH) && $(COMPOSE) up -d --force-recreate --no-deps frontend"
	ssh root@$(PROD_SERVER) "docker image prune -f"
	@echo "Frontend deployed ✓"

## adminer-on: Enable Adminer DB GUI
adminer-on:
	ssh root@$(PROD_SERVER) "cd $(DEPLOY_PATH) && $(COMPOSE) --profile adminer up -d adminer"
	@echo "Adminer: https://$(PROD_SERVER)/adminer/"

## adminer-off: Disable Adminer
adminer-off:
	ssh root@$(PROD_SERVER) "cd $(DEPLOY_PATH) && $(COMPOSE) --profile adminer stop adminer"
	@echo "Adminer disabled"

## prune: Remove unused Docker images
prune:
	ssh root@$(PROD_SERVER) "docker image prune -f"
</file>

<file path="deploy/nginx-frontend.conf">
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript
               image/svg+xml;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Static assets — long cache (Vite hashes filenames)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
</file>

<file path="deploy/nginx-host-vantai.conf">
# ── vantai.tingting.vip (demo server) — host nginx config ─────────────────────
# Live file: /etc/nginx/sites-available/vantai (symlinked from sites-enabled/vantai).
# SSL block + `listen 443` lines are managed by Certbot — do not hand-edit those.
#
# To update the server config:
#   1. Edit this file, then push it to the server:
#        scp deploy/nginx-host-vantai.conf root@vantai.tingting.vip:/etc/nginx/sites-available/vantai
#   2. Validate + reload:
#        ssh root@vantai.tingting.vip 'nginx -t && systemctl reload nginx'
#
# The `/socket.io/` block MUST sit above `location /` so the assistant
# (/agent namespace, path /socket.io) polling handshake + WebSocket upgrade
# reach the backend (3090) instead of the frontend SPA. Without it the
# public `/socket.io/` endpoint returns index.html and the assistant never
# connects.

server {
    server_name vantai.tingting.vip;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /uploads/ {
        alias /opt/vantai/data/uploads/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /api/ {
        proxy_pass         http://127.0.0.1:3090;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
        client_max_body_size 20m;
    }

    location /adminer/ {
        proxy_pass         http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # socket.io — assistant transport (/agent namespace, path /socket.io).
    # Sits above `location /` so the polling handshake + WebSocket upgrade
    # reach the backend (3090) instead of the frontend SPA. 300s keeps
    # long multi-tool MiniMax turns alive.
    location /socket.io/ {
        proxy_pass         http://127.0.0.1:3090;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/vantai.tingting.vip/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/vantai.tingting.vip/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = vantai.tingting.vip) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name vantai.tingting.vip;
    return 404; # managed by Certbot


}
</file>

