/* ── Debit-note template list ───────────────────────────────────────────── */
.debit-template-list-shell {
  width: 100%;
  margin-top: 8px;
}

.debit-template-list {
  display: grid;
  gap: 10px;
}

.debit-template-card {
  position: relative;
  min-height: 78px;
  display: grid;
  grid-template-columns: 7px 46px minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px;
  padding: 12px 14px 12px 0;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  overflow: hidden;
}

.debit-template-card--clickable {
  cursor: pointer;
  transition: background 160ms var(--ease, ease), border-color 160ms var(--ease, ease);
}

.debit-template-card--clickable:hover {
  border-color: color-mix(in srgb, var(--accent) 28%, var(--line));
  background: var(--surface-2);
}

.debit-template-card--clickable:focus-visible {
  outline: 2px solid color-mix(in srgb, var(--accent) 70%, white);
  outline-offset: 3px;
}

.debit-template-card__stripe {
  align-self: stretch;
  min-height: 54px;
}

.debit-template-card__icon {
  width: 42px;
  height: 42px;
  border: 1px solid rgba(0, 105, 56, 0.14);
  border-radius: 8px;
  display: grid;
  place-items: center;
  background: #fff;
}

.debit-template-card__main {
  min-width: 0;
  display: grid;
  gap: 5px;
}

.debit-template-card__title {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.debit-template-card__title strong {
  min-width: 0;
  color: var(--ink);
  font-size: 15px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.debit-template-card__meta {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  color: var(--ink-3);
  font-size: 12px;
  font-weight: 650;
}

.debit-template-card__meta span + span::before {
  content: '';
  display: inline-block;
  width: 4px;
  height: 4px;
  margin: 0 8px 2px 0;
  border-radius: 999px;
  background: var(--line-strong, #cfd8d3);
}

.debit-template-card__actions {
  display: flex;
  align-items: center;
  gap: 6px;
}

.debit-template-list-empty {
  width: 100%;
  min-height: clamp(360px, 36vh, 520px);
  display: grid;
  place-items: center;
  align-content: center;
  justify-items: center;
  gap: 10px;
  padding: clamp(28px, 4vw, 56px) 24px;
  text-align: center;
  color: var(--ink);
  border: 1px dashed color-mix(in srgb, var(--accent) 26%, var(--line-2));
  border-radius: 14px;
  background: color-mix(in srgb, var(--accent-soft) 30%, transparent);
}

.debit-template-list-empty--loading {
  gap: 12px;
}

.debit-template-list-empty__image {
  width: clamp(150px, 18vw, 230px);
  aspect-ratio: 1;
  object-fit: contain;
  margin-bottom: 2px;
}

.debit-template-list-empty__copy {
  display: grid;
  gap: 5px;
  max-width: 340px;
}

.debit-template-list-empty__copy strong,
.debit-template-list-empty > strong {
  font-size: 17px;
  line-height: 1.35;
  color: var(--ink);
}

.debit-template-list-empty__copy span {
  font-size: 13px;
  line-height: 1.5;
  color: var(--ink-3);
}

@media (max-width: 720px) {
  .debit-template-list-shell {
    width: 100%;
  }

  .debit-template-card {
    grid-template-columns: 7px minmax(0, 1fr);
  }

  .debit-template-card__icon {
    display: none;
  }

  .debit-template-card__actions {
    grid-column: 2;
    justify-content: flex-start;
  }

  .debit-template-list-empty {
    min-height: 340px;
    padding: 32px 18px;
  }

  .debit-template-list-empty__image {
    width: clamp(142px, 42vw, 190px);
  }
}

