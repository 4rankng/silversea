<file path="frontend/src/pages/trip-list/responsive.css">
/* ── Responsive collapses ─────────────────────────────────────────────── */
@media (max-width: 1100px) {
  .trip-list-page .metrics { grid-template-columns: 1fr 1fr; }
  .trip-list-page .metric.featured { grid-column: 1 / -1; grid-row: auto; }
}

@media (max-width: 1680px) {
  .trip-list-page.quick-edit-mode .table-card {
    background: transparent;
    border: none;
    border-radius: 0;
    overflow: visible;
    box-shadow: none;
  }
  .trip-list-page.quick-edit-mode .table-hint,
  .trip-list-page.quick-edit-mode .table-scroll-wrapper,
  .trip-list-page.quick-edit-mode .table-head,
  .trip-list-page.quick-edit-mode .table-row {
    display: none;
  }
  .trip-list-page.quick-edit-mode .trip-mobile-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .trip-list-page.quick-edit-mode .trip-mcard {
    margin-bottom: 0;
  }
}

@media (max-width: 1023px) {
  .trip-list-page .table-head,
  .trip-list-page .table-row {
    /* 7 visible cols: trip | truck | route | consumption | revenue | gross profit | status */
    grid-template-columns: minmax(180px, 1.4fr) 116px minmax(160px, 1.2fr) 92px 100px 100px 90px;
    min-width: unset;
    gap: 10px;
  }
  .trip-list-page.quick-edit-mode .table-head,
  .trip-list-page.quick-edit-mode .table-row {
    min-width: 1280px;
  }
  .trip-list-page.quick-edit-mode .table-scroll-body {
    overflow-x: auto;
  }
  .trip-list-page .table-head .col-container,
  .trip-list-page .table-row .col-container,
  .trip-list-page .table-head .col-road,
  .trip-list-page .table-row .col-road,
  .trip-list-page .table-head .col-total-cost,
  .trip-list-page .table-row .col-total-cost { display: none; }
}

@media (max-width: 1180px) {
  .trip-list-page .table-card {
    background: transparent;
    border: none;
    border-radius: 0;
    overflow: visible;
    box-shadow: none;
  }
  .trip-list-page .table-hint,
  .trip-list-page .table-scroll-wrapper,
  .trip-list-page .table-head,
  .trip-list-page .table-row {
    display: none;
  }
  .trip-list-page .trip-mobile-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .trip-list-page .trip-mcard {
    margin-bottom: 0;
    min-width: 0;
  }
  .trip-list-page .table-foot {
    margin-top: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .trip-list-page .quick-edit-toolbar {
    align-items: stretch;
    flex-direction: column;
  }
  .trip-list-page .quick-edit-toolbar__main {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
  }
  .trip-list-page .quick-edit-toolbar__main .btn {
    justify-content: center;
    min-width: 0;
  }
  .trip-list-page .quick-edit-message {
    text-align: left;
  }
}

@media (max-width: 640px) {
  .trip-list-page .hero { padding: 20px; }
  .trip-list-page .hero-h1 { font-size: var(--fs-xl); }
  .trip-list-page .hero-top { flex-direction: column; gap: 14px; }
  .trip-list-page .hero-actions { width: 100%; }
  .trip-list-page .hero-actions .btn { flex: 1; justify-content: center; }
  .trip-list-page .metrics { grid-template-columns: 1fr 1fr; }
  .trip-list-page .metric.featured { grid-column: 1 / -1; grid-row: auto; }
  .trip-list-page .filters-row-top { flex-direction: column; align-items: stretch; }
  .trip-list-page .filters-search { width: 100%; }
  .trip-list-page .filters-row-bottom { flex-wrap: wrap; }
  .trip-list-page .trip-mobile-list {
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .trip-list-page.quick-edit-mode .trip-mobile-list {
    grid-template-columns: 1fr;
  }
  .trip-list-page .quick-edit-toolbar__main {
    grid-template-columns: 1fr;
  }
  .trip-list-page .quick-edit-toolbar__main .btn {
    min-height: 44px;
  }
  .trip-list-page .table-foot {
    align-items: stretch;
    flex-direction: column;
    gap: 10px;
  }
  .trip-list-page .pagination {
    justify-content: center;
    overflow-x: auto;
    padding-bottom: 2px;
  }

  /* Desktop table is hidden and mobile cards shown by the (max-width: 1180px)
     block above, which already covers this narrower breakpoint. */
  .trip-list-page .infinite-sentinel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    margin-top: 10px;
  }
}

/* ── Responsive overrides (from responsive.css decomposition) ── */
@media (max-width: 640px) {
  /* ── Trip list page — Mobile Pass 2 (2026-06-02) ──
     Tightens above-the-fold density and adds a scroll affordance to the
     horizontally-scrollable status-tab strip (was previously cutting "Đang chạy"
     off the right edge with no swipe hint). */
  .trip-list-page .hero { padding: 14px 14px 12px; }
  .trip-list-page .hero-top { flex-direction: column; gap: 10px; align-items: flex-start; }
  .trip-list-page .hero-h1 { font-size: var(--fs-xl); line-height: 1.25; }
  .trip-list-page .hero-sub { font-size: var(--fs-xs); }
  .trip-list-page .hero-actions { width: 100%; flex-wrap: wrap; }
  .trip-list-page .hero-actions .btn { flex: 1 1 auto; justify-content: center; min-height: 44px; }

  .trip-list-page .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    overflow: visible;
  }
  .trip-list-page .metric {
    padding: 9px 10px;
    min-width: 0;
  }
  .trip-list-page .metric-label {
    font-size: var(--fs-xs);
    /* Force single-line so cards align on the 2-col grid. Long labels like
       "Tổng KM tháng này" used to wrap to 2 lines, throwing off the rhythm. */
    white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
  }
  /* "Tổng giá trị lệnh (tất cả trạng thái)" — drop the parenthetical on phones,
     it doesn't fit and the metric-delta line below repeats the same info. */
  .trip-list-page .metric-label > span { display: none; }
  .trip-list-page .metric-value { font-size: var(--fs-md); }
  .trip-list-page .metric-value .metric-unit { margin-left: 2px; }
  .trip-list-page .metric-delta { font-size: var(--fs-xs); line-height: 1.3; }
  .trip-list-page .metric.featured {
    grid-column: 1 / -1;
    grid-row: auto;
  }
  .trip-list-page .metric:not(.featured) {
    display: none;
  }
  .trip-list-page .metric.featured .metric-value {
    display: inline-block;
    margin-right: 10px;
  }
  .trip-list-page .metric.featured .breakdown-legend { gap: 6px 10px; font-size: var(--fs-xs); }

  .trip-list-page .stats-strip { grid-template-columns: 1fr 1fr; gap: 10px; }
  .trip-list-page .section-head { flex-direction: column; align-items: stretch; gap: 10px; padding: 14px 16px; }

  /* Keep status choices on one scannable row; touch users can swipe for more. */
  .trip-list-page .status-tabs {
    overflow-x: auto;
    flex-wrap: nowrap;
    padding-bottom: 4px;
    position: relative;
  }
  .trip-list-page .status-tabs::-webkit-scrollbar { display: none; }
  .trip-list-page .status-tabs .stab-pill {
    padding: 6px 10px;
    font-size: var(--fs-xs);
    gap: 6px;
  }
  .trip-list-page .status-tabs .stab-pill .stab-count {
    font-size: var(--fs-xs);
    padding: 1px 6px;
  }
  /* Right-edge fade — sits inside the scroll container so it pins to the
     visible right edge regardless of scroll position. */
  .trip-list-page .filters-row-top {
    position: relative;
    padding-right: 0;
  }
  .trip-list-page .filters-row-top::after {
    content: none;
  }
  .trip-list-page .hero-actions {
    display: grid;
    grid-template-columns: 44px 44px minmax(0, 1fr);
  }
  .trip-list-page .hero-actions .btn {
    min-width: 0;
    width: 100%;
    padding-inline: 0;
  }
  .trip-list-page .hero-actions .hero-action--add {
    padding-inline: 14px;
  }
  .trip-list-page .hero-action--quick .hero-action-label,
  .trip-list-page .hero-action--export .hero-action-label {
    display: none;
  }
  .trip-list-page .filters-card {
    padding: 12px;
  }
  .trip-list-page .filters-divider {
    margin: 10px 0;
  }
  .trip-list-page .filters-row-bottom {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .trip-list-page .filters-row-bottom .filters-search,
  .trip-list-page .filters-search-hint {
    grid-column: 1 / -1;
  }
} /* end 640px */

/* ── Responsive overrides (from responsive.css decomposition) ── */
@media (max-width: 640px) {
  /* ── TripListPage: larger filter pill tap targets, breakdown bar fix ── */
  .trip-list-page .filter-pill {
    height: auto;
    min-height: 48px;
    padding: 8px 12px;
    font-size: var(--fs-xs);
    align-items: center;
  }
  .trip-list-page .filter-pill .filter-lbl-wrap {
    gap: 3px;
    line-height: 1.35;
  }
  .trip-list-page .filter-pill .filter-lbl-cap {
    line-height: 1.35;
  }
  .trip-list-page .filter-pill select {
    min-height: 44px;
    line-height: 1.35;
  }
  .trip-list-page .breakdown-bar {
    height: 6px;
    border-radius: 99px;
  }
  .trip-list-page .breakdown-legend {
    gap: 4px 8px;
    font-size: var(--fs-xs);
  }
} /* end 640px */

/* ── Responsive overrides (from responsive.css decomposition) ── */
@media (max-width: 420px) {
  .trip-list-page .stats-strip { grid-template-columns: 1fr; }
} /* end 420px */
</file>

<file path="frontend/src/pages/trip-list/table-extras.css">
/* ── Footer pagination ────────────────────────────────────────────────── */
.trip-list-page .table-foot {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 16px;
  border-top: 1px solid var(--line);
  font-size: var(--fs-sm); color: var(--ink-3);
  gap: 16px;
  flex-wrap: wrap;
}
.trip-list-page .page-info { display: flex; align-items: center; gap: 6px; }
.trip-list-page .page-info b { color: var(--ink); font-weight: 700; }
.trip-list-page .pagination { display: flex; align-items: center; gap: 6px; }
.trip-list-page .page-btn {
  min-width: 44px; min-height: 44px;
  padding: 0 8px;
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--surface);
  border: 1px solid var(--tbl-line-strong);
  border-radius: 8px;
  font-size: var(--fs-xs); font-weight: 600; line-height: 1.35;
  color: var(--ink-2);
  cursor: pointer;
  font-family: var(--font-body);
  transition: border-color 120ms ease, color 120ms ease, background 120ms ease;
}
.trip-list-page .page-btn:hover:not(:disabled):not(.active) { border-color: var(--ink-2); color: var(--ink); }
.trip-list-page .page-btn.active { background: var(--tbl-green-700); color: var(--fg-on-brand); border-color: var(--tbl-green-700); font-weight: 600; }
.trip-list-page .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

.trip-list-page .ps-select {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: var(--fs-xs); color: var(--ink-3);
}
.trip-list-page .ps-select select {
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 3px 6px;
  font-size: var(--fs-xs);
  background: var(--surface);
  font-family: var(--font-body);
  color: var(--ink-2);
  cursor: pointer;
}

/* ── Empty + loading states ───────────────────────────────────────────── */
.trip-list-page .table-empty {
  padding: 56px 20px;
  text-align: center;
  color: var(--ink-3);
  font-size: var(--fs-sm);
}

/* ── Container merged cell (type + number in one column) ─────────── */
.trip-list-page .container-merged-cell {
  min-width: 0;
}
.trip-list-page .container-numbers-list {
  display: flex;
  flex-direction: column;
  gap: 1px;
  font-size: var(--fs-xs);
  font-family: var(--font-mono);
  color: var(--ink-2);
  margin-top: 2px;
}
.trip-list-page .container-numbers-list span {
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
}
.trip-list-page .container-numbers-more {
  color: var(--ink-3);
  font-size: var(--fs-xs);
}

/* ── Route KM inline ──────────────────────────────────────────────── */
.trip-list-page .route-km-inline {
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 500;
}

/* ── Column-specific sizing ────────────────────────────────────────── */
.trip-list-page .col-truck,
.trip-list-page .col-route,
.trip-list-page .col-consumption {
  min-width: 0;
}
.trip-list-page .col-consumption {
  min-width: 116px;
}
.trip-list-page .col-revenue {
  min-width: 100px;
}

/* ── Sticky status column ─────────────────────────────────────────── */
.trip-list-page .col-status {
  position: sticky;
  right: 0;
  background: var(--surface);
  z-index: 2;
  border-left: 1px solid var(--line);
  transition: background 150ms ease;
}
.trip-list-page .table-row:hover .col-status {
  background: var(--tbl-green-050);
}
.trip-list-page .table-head .col-status {
  position: sticky;
  right: 0;
  background: var(--surface-2);
  z-index: 11;
  border-left: 1px solid var(--line);
}

/* ── Infinite scroll sentinel ─────────────────────────────────────────── */
.trip-list-page .infinite-sentinel {
  padding: 16px 20px;
  text-align: center;
  border-top: 1px solid var(--line);
}
.trip-list-page .infinite-loading {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--ink-3);
  font-size: var(--fs-sm);
}
.trip-list-page .infinite-end {
  font-size: var(--fs-xs);
  color: var(--ink-3);
}
.trip-list-page .infinite-end b { color: var(--ink); }
.trip-list-page .spin {
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
</file>

<file path="frontend/src/pages/trip-list/table.css">
/* ── Table card (desktop) ─────────────────────────────────────────────── */
/* Subtle hint that rows are clickable. Sits right above the table card,
   aligned to the right edge so it reads like a tip chip rather than
   a banner. Same color family as the search-hint chip. */
.trip-list-page .table-hint {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0 0 10px auto;     /* push to right */
  padding: 5px 11px;
  font-size: var(--fs-xs);
  font-weight: 500;
  color: var(--ink-3);
  background: rgba(255, 255, 255, 0.62);
  border: 1px solid rgba(203, 211, 206, 0.72);
  border-radius: 999px;
  max-width: 100%;
  letter-spacing: 0;
  user-select: none;
  width: fit-content;
}
.trip-list-page .table-hint svg {
  color: var(--tbl-green-600);
  flex: none;
}
.trip-list-page .table-hint b {
  color: var(--ink-2);
  font-weight: 700;
  margin-right: 2px;
}
.trip-list-page .table-hint > span:first-of-type {
  min-width: 0;
  overflow-wrap: anywhere;
}
.trip-list-page .table-hint .table-legend {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px 12px;
  min-width: 0;
}
.trip-list-page .table-hint .legend-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}
/* Hide on the narrowest viewports where horizontal real-estate is tight */
@media (max-width: 640px) {
  .trip-list-page .table-hint { display: none; }
}
.trip-list-page .table-card {
  background: var(--surface);
  border: 1px solid rgba(203, 211, 206, 0.9);
  border-radius: var(--r);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
/* Scroll wrapper — holds buttons + scrollable body. */
.trip-list-page .table-scroll-wrapper {
  position: relative;
}
/* Scroll body — horizontal scroll, vertical grows with content */
.trip-list-page .table-scroll-body {
  overflow-x: auto;
  overflow-y: visible;
  scrollbar-width: thin;
  scrollbar-color: var(--line-3) transparent;
  overscroll-behavior-x: contain;
}
.trip-list-page .table-scroll-body::-webkit-scrollbar { width: 0; height: 6px; }
.trip-list-page .table-scroll-body::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 3px; }
.trip-list-page .table-scroll-body::-webkit-scrollbar-thumb:hover { background: var(--line-3); }
.trip-list-page .table-scroll-body::-webkit-scrollbar-track { background: transparent; }
/* Grid: trip | truck | route+km | container | tiêu hao | tiền đường | doanh thu | tổng CP | LN gộp | status */
.trip-list-page .table-head {
  display: grid;
  grid-template-columns: minmax(200px, 1.3fr) 124px minmax(250px, 1.45fr) minmax(92px, 0.6fr) 116px 116px 112px 112px 104px 104px;
  padding: 14px 16px;
  gap: 10px;
  background: var(--surface-2);
  border-bottom: 2px solid var(--line-2);
  width: 100%;
  min-width: 1460px;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 10;
}
.trip-list-page .table-head > div {
  font-family: var(--font-sans);
  font-size: var(--fs-xs); letter-spacing: 0.05em;
  color: var(--ink-2); font-weight: 700;
  text-transform: uppercase;
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
}
.trip-list-page .right { text-align: right; justify-self: end; }
.trip-list-page .center { text-align: center; justify-self: center; }

.trip-list-page .table-row {
  display: grid;
  grid-template-columns: minmax(200px, 1.3fr) 124px minmax(250px, 1.45fr) minmax(92px, 0.6fr) 116px 116px 112px 112px 104px 104px;
  padding: 14px 16px;
  gap: 10px;
  align-items: center;
  border-bottom: 1px solid var(--line);
  transition: background 150ms ease;
  cursor: pointer;
  width: 100%;
  min-width: 1460px;
  min-height: 60px;
  background: var(--surface);
  position: relative;
}
.trip-list-page.quick-edit-mode .table-head,
.trip-list-page.quick-edit-mode .table-row {
  grid-template-columns: 38px minmax(190px, 1.25fr) 90px minmax(160px, 1.35fr) minmax(80px, 0.6fr) 110px 118px 118px 118px 110px 110px 110px;
  min-width: 1280px;
}
.trip-list-page .table-row::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: var(--status-strip-width);
  height: var(--status-strip-height);
  border-radius: var(--status-strip-radius);
  background: linear-gradient(to bottom, var(--strip-top) 50%, var(--strip-bottom) 50%);
}
.trip-list-page .table-row:hover {
  background: var(--tbl-green-050);
}
/* Hover chevron — sits inside the sticky status cell so it stays visible
   regardless of horizontal scroll. Hidden at rest; fades in + slides on
   row hover and keyboard focus. */
.trip-list-page .table-row__chev {
  flex: 0 0 auto;
  color: var(--tbl-green-600);
  opacity: 0;
  transform: translateX(-3px);
  transition: opacity 140ms ease, transform 140ms ease;
  pointer-events: none;
}
.trip-list-page .table-row:hover .table-row__chev,
.trip-list-page .table-row:focus-visible .table-row__chev {
  opacity: 1;
  transform: translateX(0);
}
/* Keyboard focus ring */
.trip-list-page .table-row:focus-visible {
  outline: 2px solid var(--tbl-green-600);
  outline-offset: -2px;
  background: var(--tbl-green-050);
}
.trip-list-page .table-row:last-of-type { border-bottom: none; }
.trip-list-page .table-row > div {
  line-height: 1.4;
  min-width: 0;                   /* allow children to truncate */
}

.trip-list-page .cb {
  width: 18px; height: 18px;
  border: 1.6px solid var(--tbl-line-strong);
  border-radius: 5px;
  background: var(--surface);
  cursor: pointer;
  display: grid; place-items: center;
  transition: border-color 120ms ease, background 120ms ease;
}
.trip-list-page .cb:hover { border-color: var(--tbl-green-600); }
.trip-list-page .cb.checked { background: var(--ink); border-color: var(--ink); }
.trip-list-page .cb.checked::after {
  content: ''; width: 4px; height: 7px;
  border: solid var(--fg-on-brand);
  border-width: 0 1.5px 1.5px 0;
  transform: rotate(45deg) translate(-1px, -1px);
}

.trip-list-page .trip-col {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}
.trip-list-page .trip-col__link {
  min-width: 0;
  width: 100%;
  min-height: 44px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.trip-list-page .trip-copy-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-height: 44px;
  max-width: 100%;
  padding: 6px 10px;
  border: 1px solid color-mix(in srgb, var(--tbl-green-600) 22%, var(--line));
  border-radius: 7px;
  background: color-mix(in srgb, var(--tbl-green-050) 70%, var(--surface));
  color: var(--tbl-green-700);
  font-size: var(--fs-xs);
  line-height: 1.35;
  font-weight: 700;
  letter-spacing: 0;
  cursor: pointer;
  white-space: nowrap;
  transition: background 120ms ease, border-color 120ms ease, color 120ms ease, opacity 120ms ease, transform 120ms ease;
}
.trip-list-page .table-row .trip-copy-btn {
  opacity: 0;
  pointer-events: none;
  transform: translateY(-2px);
}
.trip-list-page .table-row:hover .trip-copy-btn,
.trip-list-page .table-row:focus-within .trip-copy-btn,
.trip-list-page .table-row .trip-copy-btn:focus-visible,
.trip-list-page .table-row .trip-copy-btn.is-copying {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}
.trip-list-page .trip-copy-btn svg {
  flex: none;
}
.trip-list-page .trip-copy-btn:hover:not(:disabled) {
  border-color: var(--tbl-green-600);
  background: var(--tbl-green-050);
  color: var(--tbl-green-800);
}
.trip-list-page .trip-copy-btn:disabled {
  cursor: wait;
  opacity: 0.66;
}
/* Lead with trip code (the canonical identifier); customer name follows in
   a less-loud second line. Single-line truncation with tooltip on hover. */
.trip-list-page .trip-name {
  font-size: var(--fs-sm); font-weight: 700; line-height: 1.35;
  color: var(--ink);
  display: flex; align-items: center; gap: 5px;
  white-space: nowrap;
  overflow: hidden;
}
.trip-list-page .trip-date {
  font-size: var(--fs-xs); font-weight: 500;
  color: var(--ink-3);
  flex-shrink: 0;
}
.trip-list-page .trip-customer {
  font-size: var(--fs-xs); color: var(--ink-2);
  margin-top: 3px;
  font-weight: 500;
  line-height: 1.35;
  word-break: break-word;
}
/* Keep old .trip-meta for any remaining uses */
.trip-list-page .trip-meta {
  font-size: var(--fs-xs); color: var(--ink-3);
  margin-top: 2px;
  display: flex; align-items: center; gap: 6px;
}
.trip-list-page .trip-id {
  font-family: var(--font-mono);
  font-weight: 500;
  color: var(--ink-3);
}
.trip-list-page .trip-meta-sep { color: var(--ink-3); opacity: 0.6; }

/* ── Missing data indicator badges in trip column ────────────────────── */
.trip-list-page .trip-missing-row {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 4px;
}
.trip-list-page .missing-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  border-radius: 4px;
  background: var(--tbl-amber-100);
  color: var(--tbl-amber-700);
  cursor: help;
  flex-shrink: 0;
}

/* License plate — styled block like actual vehicle plates */
.trip-list-page .plate {
  font-family: var(--font-mono);
  font-weight: 600; font-size: var(--fs-xs);
  color: var(--ink);
  background: var(--surface-2);
  padding: 4px 10px;
  border: 1px solid var(--line-2);
  border-radius: 6px;
  letter-spacing: 0.02em;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-feature-settings: "tnum";
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}
.trip-list-page .plate::before {
  content: "";
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--accent);
}
.trip-list-page .plate.idle {
  color: var(--ink-3);
  background: var(--surface-3);
  border-color: var(--line);
}
.trip-list-page .plate.idle::before {
  background: var(--ink-3);
  opacity: 0.5;
  box-shadow: none;
}

/* Route column — two-row stacked layout */
.trip-list-page .route-cell-flex {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
  width: 100%;
}
.trip-list-page .route-origin-row {
  display: flex;
  align-items: center;
  gap: 4px;
}
.trip-list-page .route-origin {
  font-size: var(--fs-xs);
  font-weight: 500;
  color: var(--ink-3);
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
}
.trip-list-page .route-origin-row { min-width: 0; }
.trip-list-page .route-arrow-right {
  display: inline-flex;
  align-items: center;
  color: var(--tbl-green-600);
  flex-shrink: 0;
}
.trip-list-page .route-destination {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
}
.trip-list-page .route-tags-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 3px;
}

/* KM shown inline after destination — styles defined near bottom of file */

/* Merged container cell — styles defined near bottom of file */

.trip-list-page .container-tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 700;
  background: var(--surface-3);
  color: var(--ink-2);
  padding: 3px 8px;
  border-radius: 6px;
  border: 1px solid var(--line-2);
  line-height: 1.35;
}
.trip-list-page .container-tag.multiplier {
  background: var(--brand-soft);
  color: var(--brand-hover);
  border-color: rgba(0, 177, 79, 0.2);
}

.trip-list-page .km-empty { font-size: var(--fs-sm); color: var(--ink-3); opacity: 0.6; text-align: right; }

.trip-list-page .cons-cell { min-width: 0; }
.trip-list-page .cons-main {
  font-family: var(--font-mono);
  font-weight: 600; font-size: var(--fs-sm);
  display: flex; align-items: center; gap: 6px;
  color: var(--ink);
}
.trip-list-page .cons-rate {
  font-size: var(--fs-xs);
  color: var(--ink-2);
  margin-top: 3px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 1px 6px;
  border-radius: 4px;
  background: var(--surface-2);
}
.trip-list-page .cons-rate.warn {
  color: var(--danger-text);
  background: var(--danger-soft);
  font-weight: 600;
}
.trip-list-page .cons-rate.warn::before {
  content: ''; width: 5px; height: 5px;
  background: var(--danger); border-radius: 50%;
}
.trip-list-page .cons-rate.ok {
  color: var(--success-text);
  background: var(--success-soft);
  font-weight: 600;
}
.trip-list-page .cons-rate.ok::before {
  content: ''; width: 5px; height: 5px;
  background: var(--success); border-radius: 50%;
}
.trip-list-page .cons-rate-val {
  font-size: var(--fs-xs);
  color: var(--fg-2);
  font-weight: 500;
  font-family: var(--font-mono);
  white-space: nowrap;
  line-height: 1.35;
}
.trip-list-page .cons-empty {
  font-size: var(--fs-xs); color: var(--ink-3); opacity: 0.7;
  font-style: italic;
}
.trip-list-page .cons-empty .empty-icon {
