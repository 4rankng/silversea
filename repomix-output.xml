  }
  const driver = await getDriverByUserId(getUser(req).userId);
  const idempotencyKey = req.header('Idempotency-Key') as string | undefined;
  const { cost, replayed } = await recordIncidentalCost(
    tripId,
    driver.id,
    parsed.data,
    getUser(req).userId,
    idempotencyKey,
