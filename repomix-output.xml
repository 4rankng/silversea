      }), null);
    }
  });

  it('does not report months where the retired divisor already equaled 26', () => {
    assert.equal(identifyLegacyTripSalary({
      status: 'COMPLETED',
      carrierType: 'OWN',
      departureDate: '2026-06-10',
      baseSalary: 10_000_000,
      tripWageDays: 1,
      storedDriverSalary: 384_615,
    }), null);
  });
});
