/* Direct-edit canvas mode. */
.debit-editor-history-actions {
  display: inline-flex;
  align-items: center;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface);
}

.debit-editor-history-actions .btn {
