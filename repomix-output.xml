    gap: 10px;
  }

  .ci-photo-lane__media,
  .ci-photo-empty,
  .ci-photo-slot {
    width: 64px;
    height: 54px;
  }

  .ci-photo-lane__capture {
    min-width: 96px;
  }

  .input.ci-input-sm {
    font-size: 16px;
  }

  .ci-editor__footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@container (max-width: 420px) {
  .ci-photo-lane {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .ci-photo-lane__copy {
    grid-column: 1 / -1;
  }

  .ci-photo-lane__media {
    justify-self: start;
  }

  .ci-photo-lane__capture {
    justify-self: end;
  }
}
