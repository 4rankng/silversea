/* ── Q01: Credit-limit warning card ─────────────────────────────────── */
/* Surfaces creditLimit + threshold on /customers/:id so the accountant
   sees 80% (warning) / 100% (exceeded) badges per the accepted Q01 rule. */
.dd-credit-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 18px;
  padding: 12px 16px;
  margin: 12px 0 4px;
  border-radius: 10px;
  border: 1px solid var(--border-2, #e5e7eb);
