  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24px;
}

.settlement-detail__header-left h1 {
  font-size: var(--fs-xl);
  font-weight: 700;
  margin: 0 0 4px;
  color: var(--ink);
}

.settlement-detail__header-left p {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  margin: 0;
}

.settlement-detail__header-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

/* ─── Info Grid ─── */
.settlement-detail__info {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.settlement-detail__info-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.settlement-detail__info-label {
  font-size: var(--fs-2xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--ink-3);
}

.settlement-detail__info-value {
