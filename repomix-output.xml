<file path="frontend/src/pages/salary-attendance/salary-summary.css">
/* ─── Salary Summary Card (Right sidebar) ─── */
.salary-page-layout__sidebar {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.salary-summary-area {
  /* wrapper */
}

/* Light premium card — matches app-wide hero treatment */
.salary-summary-dark {
  background:
    linear-gradient(135deg, rgba(0, 90, 45, 0.08), rgba(255, 255, 255, 0) 42%),
    var(--surface);
  color: var(--ink);
  border-radius: 16px;
  padding: 22px 22px 20px;
  border: 1px solid var(--line);
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 16px 34px -30px rgba(0, 90, 45, 0.48);
  position: relative;
  overflow: hidden;
}

/* Subtle accent glow — top right */
.salary-summary-dark::before {
  content: none;
}

.salary-summary-dark__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  position: relative;
  margin-bottom: 10px;
}

.salary-summary-dark__label {
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: var(--accent-ink);
  margin: 0;
  line-height: 1.35;
  position: relative;
}

.salary-summary-dark__status {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 3px 8px;
  background: var(--warning-soft);
  color: var(--warning-text);
  border: 1px solid rgba(245, 166, 35, 0.24);
  font-size: var(--fs-xs);
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
}

.salary-summary-dark__status.is-confirmed {
  background: var(--accent-soft);
  color: var(--accent-ink);
  border-color: rgba(0, 177, 79, 0.20);
}

.salary-summary-dark__big {
  font-family: var(--font-mono);
  font-size: var(--fs-2xl);
  font-weight: 700;
  letter-spacing: 0;
  color: var(--ink);
  line-height: 1.35;
  margin-bottom: 4px;
  position: relative;
}

.salary-summary-dark__mini {
  font-size: var(--fs-2xs);
  color: var(--ink-3);
  margin-bottom: 0;
  position: relative;
}

.salary-summary-dark__rows {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 11px;
  position: relative;
}

.salary-summary-dark__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--fs-xs);
  gap: 12px;
}

.salary-summary-dark__row-lbl {
  color: var(--ink-2);
  display: flex;
  align-items: center;
  gap: 7px;
}

.salary-summary-dark__row-lbl svg {
  opacity: 0.6;
  flex-shrink: 0;
}

.salary-summary-dark__row-val {
  font-family: var(--font-mono);
  font-weight: 600;
  color: var(--ink-2);
  font-size: var(--fs-xs);
  text-align: right;
  white-space: nowrap;
}

.salary-edit-link {
  color: var(--ink-3);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  border-radius: 10px;
  transition: color 0.15s ease;
}

.salary-edit-link:hover {
  background: var(--accent-soft);
  color: var(--accent);
}

.salary-summary-dark__row-val--neg {
  color: var(--danger);
}

.salary-summary-dark__row-val--pos {
  color: var(--accent);
}

.salary-summary-dark__row--total {
  margin-top: 4px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  border-bottom: 1px dashed var(--line);
  padding-bottom: 12px;
  font-size: var(--fs-sm);
}

.salary-summary-dark__row--total .salary-summary-dark__row-lbl {
  color: var(--ink);
  font-weight: 700;
}

.salary-summary-dark__row--total .salary-summary-dark__row-val {
  color: var(--accent);
  font-size: var(--fs-md);
  font-weight: 700;
}

.salary-summary-dark__section {
  font-size: var(--fs-xs);
  text-transform: uppercase;
  color: var(--ink-3);
  margin-top: 4px;
  font-weight: 700;
  letter-spacing: 0.08em;
  line-height: 1.35;
}

.salary-summary-dark__row--muted {
  opacity: 0.78;
}

.salary-confirm-status {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 10px;
  background: var(--success-soft);
  color: var(--success);
  border: 1px solid rgba(0, 177, 79, 0.16);
  font-size: 13px;
  font-weight: 600;
}

/* Standby callout inside summary card */
.payslip-callout {
  display: flex;
  gap: 10px;
  border-radius: 8px;
  padding: 10px 14px;
  margin-top: 14px;
  align-items: flex-start;
  background: var(--warning-soft, #FFFBEB);
  border: 1px solid color-mix(in srgb, var(--warning, #D97706) 25%, transparent);
}

.payslip-callout-icon {
  color: var(--warning, #D97706);
  flex-shrink: 0;
  margin-top: 1px;
  opacity: 0.9;
}

.payslip-callout-text {
  font-size: var(--fs-2xs);
  line-height: 1.5;
  color: var(--warning-text, #92400E);
}

/* ─── Mobile back button ─── */
.mobile-back-btn {
  display: none;
}

/* ─── Utility: Spin animation ─── */
@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.spin {
  animation: spin 0.8s linear infinite;
}

/* ─── Payslip (legacy, keep for other pages) ─── */
.payslip-container { display: flex; flex-direction: column; gap: 16px; }
.payslip-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid var(--border-1);
  font-size: var(--fs-sm);
}
.payslip-row:last-of-type { border-bottom: none; }
.payslip-label { color: var(--fg-2); font-weight: 500; }
.payslip-value { font-weight: 700; font-family: var(--font-mono); color: var(--fg-1); }
.payslip-value.is-negative { color: var(--danger); }
.payslip-value.is-positive { color: var(--success); }

/* ─── Period Config Widget ─── */
.period-config-container {
  margin-bottom: 20px;
  background: var(--surface);
  border: 1px solid var(--border-1);
  border-radius: 10px;
  padding: 12px 16px;
  transition: all 140ms ease;
}

.period-config-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}

.period-config-label {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--fg-2);
}

.period-config-value {
  color: var(--fg-1);
  font-weight: 600;
}

.period-config-edit-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: none;
  cursor: pointer;
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--accent);
  padding: 4px 8px;
  border-radius: 6px;
  transition: background 140ms ease;
}

.period-config-edit-btn:hover {
  background: var(--accent-soft);
}

.period-config-form {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--border-1);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.period-config-form__fields {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.period-config-checkbox-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-sm);
  color: var(--fg-2);
  cursor: pointer;
  user-select: none;
}

.period-config-checkbox-label input[type="checkbox"] {
  accent-color: var(--accent);
  width: 15px;
  height: 15px;
}

.period-config-form__selects {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  align-items: center;
}

.period-config-field {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-sm);
  color: var(--fg-3);
}
</file>

<file path="frontend/src/pages/trip-detail/bento-cards.css">
/* ── Two-column body layout (main + sticky rail) ────────────── */
.trip-body {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: 26px;
  align-items: start;
  margin-bottom: 20px;
}

.trip-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.trip-col--main { min-width: 0; }

.trip-col--rail {
  position: sticky;
  top: 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
  /* No internal scrollbar — the rail stretches to fit its content and the
     whole page scrolls naturally. Sticky keeps it pinned to the viewport
     top while the main column scrolls past. */
}

/* The right rail is rendered on top of a soft dot-grid background so it
   reads as a "secondary column" instead of just a list of cards. */
.trip-rail-bg {
  position: relative;
  background: transparent;
  padding: 0;
}

.trip-rail-bg::before {
  content: none;
}

.trip-rail-bg > * {
  position: relative;
  z-index: 1;
}

/* ── KPI rail (2×2 micro-grid inside one glass card) ──────────────────── */
.kpi-rail {
  background: var(--surface);
  border: 1px solid rgba(203, 211, 206, 0.82);
  border-radius: var(--r);
  padding: 14px 16px 12px;
}

.kpi-rail__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--line-2, #EFF2F0);
}

.kpi-rail__eyebrow {
  font-size: var(--fs-xs);
  line-height: 1.35;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-3);
}

.kpi-rail__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px 14px;
}

.kpi-rail__cell {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 0;
  min-width: 0;
}

/* Cells in column 2 (revenue row 1 col 2, profit row 2 col 2) — border-left */
.kpi-rail__cell:nth-of-type(2),
.kpi-rail__cell:nth-of-type(4) {
  border-left: 1px solid var(--line-2, #EFF2F0);
  padding-left: 14px;
}

/* Cells in row 2 (cost + margin) — border-top */
.kpi-rail__cell:nth-of-type(3),
.kpi-rail__cell:nth-of-type(4) {
  border-top: 1px solid var(--line-2, #EFF2F0);
  padding-top: 12px;
  margin-top: 2px;
}

.kpi-value--sm {
  font-size: var(--fs-md);
  margin-top: 4px;
}

.kpi-value--sm .u {
  font-size: var(--fs-xs);
}

.kpi {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-lg, 18px);
  padding: 18px 20px;
  position: relative;
  overflow: hidden;
}

.kpi-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--ink-3);
}

.kpi-label .dot {
  width: 22px;
  height: 22px;
  border-radius: 7px;
  display: grid;
  place-items: center;
  background: var(--line-2, #EFF2F0);
  color: var(--ink-3);
  flex: 0 0 auto;
}

.kpi-value {
  font-family: var(--font-mono);
  font-size: var(--fs-2xl);
  font-weight: 600;
  letter-spacing: 0;
  margin-top: 13px;
  color: var(--ink);
  font-feature-settings: "tnum" 1;
}

.kpi-value .u {
  font-size: var(--fs-md);
  font-weight: 500;
  color: var(--ink-3);
  margin-left: 3px;
}

.kpi-sub {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  margin-top: 6px;
  font-weight: 500;
}

.kpi.accent {
  background: #063D1E;
  border-color: #063D1E;
}

.kpi.accent .kpi-label {
  color: #8FE9B6;
}

.kpi.accent .kpi-label .dot {
  background: rgba(255, 255, 255, 0.12);
  color: #9DEFC0;
}

.kpi.accent .kpi-value {
  color: var(--fg-on-brand);
}

.kpi.accent .kpi-value .u {
  color: #7FDDA6;
}

.kpi.accent .kpi-sub {
  color: #86D9A8;
}

.kpi.accent::after {
  content: none;
}

/* ── Card ───────────────────────────────────────────────────────────────── */
.card {
  background: var(--surface);
  border: 1px solid rgba(203, 211, 206, 0.82);
  border-radius: var(--r);
  transition: border-color 0.15s ease, background 0.15s ease;
}

.card:hover {
  border-color: var(--line-strong, var(--line));
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 20px 12px;
  border-bottom: 1px solid var(--line-2, #EFF2F0);
  /* Mirrors the .tc-card-head gradient on TripEditPage — a faint surface-2
     fade at the top of the header to add depth without color noise. */
  background: var(--surface-2);
}

.card-head h2 {
  font-size: var(--fs-md);
  font-weight: 700;
  letter-spacing: 0;
  display: flex;
  align-items: center;
  gap: 9px;
}

.card-head h2 .hicon {
  width: 26px;
  height: 26px;
  border-radius: 8px;
  /* Mirrors the .tc-card-num gradient on TripEditPage so the two pages read
     as a unified family. The hue is forest-sage (--accent-2); the icon
     glyph stays in the soft accent tint for legibility on the gradient. */
  background: var(--accent-2);
  color: var(--fg-on-brand);
  display: grid;
  place-items: center;
  flex: 0 0 auto;
}

/* Smaller hicon variant — used by ServiceCostsCard and similar compact headers. */
.card-head h2 .hicon--sm {
  width: 24px;
  height: 24px;
}

.card-head .sub {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  margin-top: 3px;
  font-weight: 500;
}

/* Inline sub: sits next to the title (no top margin), with a small left gap.
   Use when the subtitle is rendered as a sibling of the title text. */
.card-head .sub--inline {
  margin-top: 0;
  margin-left: 4px;
}

.card-body {
  padding: 10px 20px 20px;
}

/* ── Info List (2-col grid inside BasicInfoCard / ExternalCarrierCard) ───
   Auto-fits 1–2 columns: a single row when the card is ≥ ~584px wide
   (260 + 24 + 260 + padding), otherwise collapses to one-per-row so long
   Vietnamese values like "CÔNG TY TNHH THƯƠNG MẠI VÀ DỊCH VỤ VẬN TẢI AN
   KHÁNH" don't get squeezed into a 150px column. */
.info-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  column-gap: 24px;
  row-gap: 0;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 11px 0;
  border-bottom: 1px solid var(--line-2, #EFF2F0);
  min-width: 0;
}

.info-row--full {
  grid-column: 1 / -1;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row .ri {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  background: var(--surface-3, #EFF1F5);
  color: var(--ink-2);
  display: grid;
  place-items: center;
  flex: 0 0 auto;
}

.info-meta {
  min-width: 0;
}

.info-meta .lbl {
  font-size: var(--fs-2xs);
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--ink-3);
}

.info-meta .val {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink);
  margin-top: 1px;
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
}

.info-meta .val.mono {
  font-family: var(--font-mono);
}

.info-meta .val.muted {
  color: var(--ink-4);
  font-weight: 500;
}

.info-meta .val.muted-pos {
  color: var(--accent);
  font-weight: 700;
}

.info-meta .val.muted-neg {
  color: var(--danger);
  font-weight: 700;
}

/* ── Containers & Seal card ─────────────────────────────────────────────── */
.cs-galleries {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(120px, 0.8fr);
  gap: 10px;
  padding: 8px 0 12px;
  border-bottom: 1px solid var(--line-2, #EFF2F0);
  margin-bottom: 2px;
}

.cs-gallery {
  display: flex;
  flex-direction: column;
  gap: 7px;
  min-width: 0;
  padding: 10px;
  border: 1px solid var(--line-2, #EFF2F0);
  border-radius: 12px;
  background: color-mix(in srgb, var(--surface) 74%, var(--surface-2));
}

.cs-gallery__label {
  font-size: var(--fs-2xs);
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--ink-3);
}

.cs-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.cs-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 3px;
  width: 82px;
  height: 58px;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: var(--r-md, 14px);
  overflow: hidden;
  background: var(--bg-3, #EFF1F5);
  cursor: pointer;
  transition: 0.15s ease;
  color: var(--ink-4);
  font-size: var(--fs-xs);
  font-weight: 500;
}

.cs-thumb:hover:not(:disabled) {
  border-color: var(--accent-2, #008B3E);
}

.cs-thumb:disabled {
  cursor: default;
}

.cs-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cs-thumb--empty,
.cs-thumb__broken {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  width: 100%;
  height: 100%;
  color: var(--ink-4);
}

.containers-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px 0 4px;
}

.container-row {
  display: grid;
  grid-template-columns: 30px minmax(0, 1fr);
  gap: 10px;
  align-items: start;
  padding: 11px 12px;
  border: 1px solid var(--line-2, #EFF2F0);
  border-radius: var(--r-md, 14px);
  background: var(--surface-2);
}

.container-no {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: var(--accent-soft);
  color: var(--accent-2, #008B3E);
  font-size: var(--fs-xs);
  font-weight: 700;
  display: grid;
  place-items: center;
}

.container-fields {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  column-gap: 14px;
  row-gap: 8px;
  min-width: 0;
}

.cf {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.cf--full {
  grid-column: 1 / -1;
}

.cf-label {
  font-size: var(--fs-xs);
  line-height: 1.35;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--ink-3);
}

.cf-value {
  font-size: 13px;
  line-height: 1.35;
  font-weight: 600;
  color: var(--ink);
  word-break: break-word;
}

.cf-value.mono {
  font-family: var(--font-mono);
}
</file>

<file path="frontend/src/pages/trip-detail/details.css">
/* ============================================================================
 * TripDetailPage — page-level inline-style extractions
 * Bridges the .card chrome from bento-cards.css with the .tc-card chrome from
 * TripEditPage.css. Page-level helpers that don't belong on a single card live
 * here: loading guard, error banner, notes card, action-panel buttons.
 * ========================================================================== */

/* ── Loading guard (matches TripEditPage.tsx loading state) ── */
.tdp-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80px 20px;
  gap: 10px;
  color: var(--fg-3);
  font-size: 14px;
}

/* ── Error banner (page-level, above KPI strip) ── */
.tdp-error-banner {
  padding: 10px 14px;
  background: var(--danger-soft);
  color: var(--danger-text);
  border-radius: var(--radius-md, 10px);
  font-size: 13px;
  margin-bottom: 16px;
  border: 1px solid rgba(220, 38, 38, 0.12);
  display: flex;
  align-items: center;
  gap: 8px;
}

/* ── Notes card (replaces inline <section class="card">) ── */
.tdp-notes-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-lg, 18px);
  padding: 20px;
}
.tdp-notes-title {
  font-size: 15px;
  font-weight: 700;
  margin: 0 0 8px;
  color: var(--ink);
}
.tdp-notes-body {
  white-space: pre-wrap;
  font-size: 14px;
  color: var(--fg-2);
  margin: 0;
  line-height: 1.55;
}

/* ── Instructions card (Liên hệ & hướng dẫn) ── */
.tdp-instructions-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.tdp-instructions-row {
  display: flex;
  gap: 10px;
  font-size: 14px;
  line-height: 1.5;
  align-items: baseline;
}
.tdp-instructions-label {
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  min-width: 60px;
  flex-shrink: 0;
}
.tdp-instructions-value {
  color: var(--ink);
  font-weight: 500;
}
a.tdp-instructions-value {
  color: var(--brand, #00B14F);
  text-decoration: none;
}
a.tdp-instructions-value:hover {
  text-decoration: underline;
}

/* ── Error & action-panel buttons (Modal + Drawer) ── */
.tdp-modal-error {
  padding: 8px 12px;
  margin-bottom: 12px;
  background: var(--danger-soft);
  color: var(--danger-text);
  border-radius: 6px;
  font-size: 13px;
}

.tdp-drawer-hint {
  font-size: 12px;
  color: var(--fg-3);
  margin: 0 0 16px;
  line-height: 1.5;
}

.tdp-drawer-textarea {
  resize: vertical;
}

.tdp-drawer-submit {
  width: 100%;
  margin-top: 4px;
}

/* ── Adjustment list (Drawer history) ── */
.tdp-adjustments-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--fg-2);
  margin: 20px 0 8px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.tdp-adjustment-row {
  display: flex;
  justify-content: space-between;
  padding: 6px 0;
  border-bottom: 1px solid var(--border-2, var(--line));
  font-size: 13px;
  align-items: baseline;
  gap: 12px;
}
.tdp-adjustment-row:last-child {
  border-bottom: none;
}
.tdp-adjustment-note {
  color: var(--fg-2);
  min-width: 0;
  overflow: visible;
  overflow-wrap: anywhere;
}
.tdp-adjustment-amount {
  font-weight: 600;
  font-family: var(--font-mono);
  white-space: nowrap;
}
.tdp-adjustment-amount--pos { color: var(--success, #00B14F); }
.tdp-adjustment-amount--neg { color: var(--danger, #E32434); }

/* ── Bridge the action buttons to the edit page's brass/amber palette ── */
/* Detail page header buttons (TripHeader) — same shape as edit page buttons,
   but lighter ghost style (no shadow) so they don't compete with the hero. */
.tdp-header-btn {
  background: var(--surface);
  color: var(--ink-2);
  border: 1px solid var(--line);
  box-shadow: none;
}
.tdp-header-btn:hover:not(:disabled) {
  background: var(--bg-2, #FAFBFC);
  border-color: var(--line-strong, #D4DAD7);
  color: var(--ink);
  box-shadow: none;
}

.tdp-header-btn--primary {
  background: var(--brass-3);
  color: var(--ink, #0A0A0A);
  border: none;
  box-shadow: none;
}
.tdp-header-btn--primary:hover:not(:disabled) {
  background: var(--brass-2);
  box-shadow: none;
}
.tdp-header-btn--primary:disabled {
  background: var(--brass-1);
  color: rgba(255, 255, 255, 0.75);
  cursor: not-allowed;
  box-shadow: none;
}

.tdp-header-btn--danger {
  background: var(--surface);
  color: var(--danger, #E32434);
  border: 1px solid var(--line);
  box-shadow: none;
}
.tdp-header-btn--danger:hover:not(:disabled) {
  background: var(--danger-soft, #FFEAEC);
  border-color: #F3C6C6;
  box-shadow: none;
}
</file>

<file path="frontend/src/pages/trip-detail/header.css">
/* ============================================================================
 * TripDetailPage — header chrome that complements the `tc-page-head` /
 * `tc-back-btn` / `tc-title-wrap` / `tc-page-title` / `tc-status-pill` classes
 * declared in TripEditPage.css. The .tc-* rules give us a shared hero header
 * across /trips/:id and /trips/:id/edit; this file only carries the parts
 * that are unique to the detail page (customer name row, action cluster,
 * route chips).
 *
 * The .tc-page-title / .tc-page-sub / .tc-status-pill rules below are
 * duplicated here from TripEditPage.css because TripDetailPage.css does not
 * import TripEditPage.css — without these the detail page's title collapses
 * to Tailwind's preflight (display: block) and the status pill renders as
 * plain text. Keep this block in sync with TripEditPage.css.
 * ========================================================================== */

/* Breadcrumb trail — sits above the trip header. Mirrors the pattern used on
   TripListPage so list → detail navigation reads as one hierarchy. Muted so
   it doesn't fight the trip code title below it. */
.trip-detail__crumbs {
  max-width: 1600px;
  margin: 0 auto;
  padding: 12px 28px 0;
  color: var(--ink-3);
  font-size: 12px;
}
.trip-detail__crumbs ul { gap: 4px; }
@media (max-width: 640px) {
  .trip-detail__crumbs { padding: 8px 16px 0; }
}

.td-page-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 24px 28px 20px;
  max-width: 1600px;
  margin: 0 auto;
  width: 100%;
}

.td-page-head .header-actions {
  justify-content: flex-end;
  flex-wrap: wrap;
  min-width: 0;
}

.tc-page-head::after {
  content: '';
  position: absolute;
  left: 28px;
  right: 28px;
  bottom: 0;
  height: 1px;
  background: var(--line);
}

.tc-back-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--fg-2);
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  flex-shrink: 0;
}

.tc-back-btn:hover {
  background: var(--surface-2, var(--surface));
  color: var(--fg-1, var(--fg-2));
}

.tc-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.tc-page-title {
  margin: 0;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: 0;
  color: var(--fg-1);
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.tc-page-sub {
  margin: 0;
  font-size: 13px;
  color: var(--fg-3);
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
}

.tc-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0;
  border-radius: 0;
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 0.02em;
  background: transparent;
  color: var(--fg-2);
  border: 0;
  line-height: 1.35;
  flex: 0 0 auto;
  white-space: nowrap;
}
.tc-status-pill::before {
  content: '';
  width: 3px;
  height: 20px;
  border-radius: 2px;
  background: var(--fg-3);
}
.tc-status-pill--draft::before { background: var(--slate-1); }
.tc-status-pill--in-transit::before { background: var(--slate-2); }
.tc-status-pill--completed::before { background: var(--slate-3); }
.tc-status-pill--locked::before { background: var(--slate-4); }
.tc-status-pill--canceled::before { background: var(--danger); }
.tc-status-pill--locked { color: var(--slate-4); }
.tc-status-pill--canceled { color: var(--danger); }


.header-left {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  flex: 1 1 auto;
  min-width: 0;
}

/* The .tc-page-sub class in TripEditPage gives us a single-line truncated
   label; this `.company` modifier just resets the bottom margin and keeps
   the icon on the same line. */
.company {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 0;
  color: var(--ink-2);
  font-size: var(--fs-sm);
  font-weight: 600;
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
  max-width: 560px;
}

.company svg {
  flex: 0 0 auto;
  color: var(--ink-3);
}

/* ── Route Chips (origin → destination pills) ────────────────────────────── */
.route-chips {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 11px;
  flex-wrap: nowrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 5px 12px;
  border-radius: 999px;
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
}

.chip .pin {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.chip .pin--go {
  background: var(--accent);
}

.chip .pin--end {
  background: var(--danger);
}

.route-arrow {
  color: var(--ink-4);
  display: grid;
  place-items: center;
}

/* ── Header Actions cluster (right side) ─────────────────────────────────── */
.header-actions {
  display: flex;
  gap: 9px;
  flex: 0 0 auto;
  align-items: center;
}

.header-overflow {
  position: relative;
}

.header-overflow > summary {
  list-style: none;
  width: 44px;
  min-width: 44px;
  padding: 0;
}

.header-overflow > summary::-webkit-details-marker {
  display: none;
}

.header-overflow__menu {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  z-index: var(--z-dropdown);
  width: 190px;
  padding: 6px;
  background: var(--surface);
  border: 1px solid var(--line-2);
  border-radius: var(--r-sm);
}

.header-overflow__menu button {
  width: 100%;
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  color: var(--ink-2);
  background: transparent;
  border: 0;
  border-radius: 8px;
  font: inherit;
  font-size: var(--fs-sm);
  cursor: pointer;
}

.header-overflow__menu button:hover {
  background: var(--surface-2);
  color: var(--ink);
}

.header-overflow__menu button.is-danger {
  color: var(--danger);
}

.header-overflow__menu button.is-danger:hover {
  background: var(--danger-soft);
}

.header-overflow__menu button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: -2px;
}

.tdp-edit-btn {
  background: var(--surface);
  color: var(--ink);
  border-color: var(--line-2);
  font-weight: 700;
  min-height: 44px;
}

.tdp-edit-btn:hover {
  background: color-mix(in srgb, var(--surface) 88%, var(--accent-soft));
  border-color: color-mix(in srgb, var(--accent) 28%, var(--line-2));
  color: var(--accent-ink, var(--accent));
}

.tdp-edit-btn svg {
  color: var(--accent);
}

/* ── Buttons ──
 *   Global .btn / .btn--primary / .btn--ghost / .btn--danger
 *   (components/Button.css) govern the header action cluster. The local
 *   overrides (including the unused .btn--soft) were removed during CTA
 *   unification so the detail page's lifecycle buttons match the single
 *   app-wide primary recipe (green gradient + --shadow-brand). */
</file>

<file path="frontend/src/pages/trip-detail/journey-legs.css">
/* ── Journey ────────────────────────────────────────────────────────────── */
.journey-pills {
  display: flex;
  gap: 8px;
}

.jp {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-xs);
  font-weight: 700;
  padding: 5px 11px;
  border-radius: 999px;
}

.jp--km {
  background: var(--bg-3, #EFF1F5);
  color: var(--ink-2);
}

.jp--km .mono {
  font-size: var(--fs-xs);
}

.journey-body {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 20px;
}

.map-wrap {
  position: relative;
  height: 280px;
  border-radius: var(--r-md, 14px);
  overflow: hidden;
  border: 1px solid var(--line-2, #EFF2F0);
}

.map-wrap .leaflet-container {
  width: 100%;
  height: 100%;
}

.map-zoom {
  position: absolute;
  top: 14px;
  left: 14px;
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 9px;
  overflow: hidden;
}

.map-zoom button {
  width: 44px;
  height: 44px;
  border: none;
  background: var(--surface);
  cursor: pointer;
  color: var(--ink-2);
  font-size: var(--fs-md);
  display: grid;
  place-items: center;
}

.map-zoom button:first-child {
  border-bottom: 1px solid var(--line-2, #EFF2F0);
}

.map-zoom button:hover {
  background: var(--bg-3, #EFF1F5);
  color: var(--accent-2, #008B3E);
}

.map-badge {
  position: absolute;
  top: 14px;
  right: 14px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 9px;
  padding: 6px 11px;
  font-size: var(--fs-xs);
  font-weight: 700;
  color: var(--ink-2);
  display: flex;
  align-items: center;
  gap: 6px;
}

/* ── Legs ──────────────────────────────────────────────────────────────── */
.legs {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.leg {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 14px;
  align-items: center;
  padding: 13px 14px;
  border: 1px solid var(--line);
  border-radius: var(--r-md, 14px);
  transition: 0.15s ease;
}

.leg:hover {
  border-color: #D4DAD7;
}

.leg-no {
  width: 26px;
  height: 26px;
  border-radius: 8px;
  background: var(--brand, #005A2D);
  color: var(--fg-on-brand);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 700;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
}

.leg-route {
  min-width: 0;
}

.leg-stops {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink);
}

.leg-stops .st {
  white-space: normal;
  overflow: visible;
  overflow-wrap: anywhere;
  max-width: 250px;
}

.leg-stops .ar {
  color: var(--ink-4);
  flex: 0 0 auto;
}

.leg-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 7px;
}

.leg-meta span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: var(--fs-xs);
  color: var(--ink-3);
  font-weight: 600;
}

.leg-meta .mono {
  font-size: var(--fs-xs);
  color: var(--ink-2);
}

.leg-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 7px;
}

.badge {
  font-size: var(--fs-2xs);
  font-weight: 800;
  letter-spacing: 0.04em;
  padding: 4px 9px;
  border-radius: 7px;
}

.badge--load {
  background: var(--accent-soft);
  color: var(--accent-2, #008B3E);
}

.badge--empty {
  background: var(--line-2, #EFF2F0);
  color: var(--ink-2);
}

.leg-fuel {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink);
}

/* ── Journey Foot ───────────────────────────────────────────────────────── */
.journey-foot {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 13px 20px;
  border-top: 1px solid var(--line-2, #EFF2F0);
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 500;
}

.journey-foot svg {
  color: var(--ink-4);
}

.journey-foot .add-note {
  margin-left: auto;
  color: var(--accent-2, #008B3E);
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.journey-foot .add-note:hover {
  text-decoration: underline;
}

/* ── Animation ─────────────────────────────────────────────────────────── */
.anim {
  opacity: 0;
  transform: translateY(8px);
  animation: rise 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
}

@keyframes rise {
  to {
    opacity: 1;
    transform: none;
  }
}

.d1 { animation-delay: 0.02s; }
.d2 { animation-delay: 0.08s; }
.d3 { animation-delay: 0.14s; }
.d4 { animation-delay: 0.2s; }
.d5 { animation-delay: 0.26s; }
.d6 { animation-delay: 0.32s; }
</file>

<file path="frontend/src/pages/trip-detail/pnl-fuel.css">
/* ── P&L Statement ──────────────────────────────────────────────────────── */
.pl {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding-top: 6px;
}

.pl-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
}

.pl-row .k {
  font-size: var(--fs-sm);
  color: var(--ink-2);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.pl-row .k .swatch {
  width: 8px;
  height: 8px;
  border-radius: 2px;
  flex: 0 0 auto;
}

/* Swatch color modifiers — replace inline style={{ background: '...' }} */
.swatch--commission { background: #E8A87C; }
.swatch--fuel       { background: var(--accent); }
.swatch--road       { background: #C2CAC6; }

.pl-row .v {
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink);
  font-feature-settings: "tnum" 1;
  text-align: right;
  min-width: 0;
  word-break: break-word;
}

.pl-row .v.neg {
  color: var(--ink-2);
}

.pl-row .v.zero {
  color: var(--ink-4);
  font-weight: 500;
}

/* Inline-currency unit suffix (e.g. "/lít" next to a Money value).
   Slightly muted and smaller so the digit+₫ remains the dominant signal. */
.pl-row .v .v-unit {
  font-family: var(--font-sans, inherit);
  font-size: var(--fs-xs);
  line-height: 1.35;
  font-weight: 500;
  color: var(--ink-3);
  margin-left: 2px;
}

/* FuelCard: supplier name + action row. Replaces inline styles. */
.fuel-supplier-name {
  font-weight: 600;
  color: var(--brand, #005A2D);
}

.fuel-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  flex-wrap: wrap;
}

.pl-divider {
  height: 1px;
  background: var(--line-2, #EFF2F0);
  margin: 4px 0;
}

.pl-divider.dashed {
  background: none;
  border-top: 1px dashed var(--line);
}

.pl-row.subtotal .k {
  font-weight: 700;
  color: var(--ink);
}

.pl-row.subtotal .v {
  font-weight: 700;
}

.pl-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  background: #E8F7EE;
  border: 1px solid #CFEBDD;
  border-radius: var(--r-md, 14px);
  padding: 14px 15px;
  margin-top: 8px;
}

.pl-total .k {
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--brand, #005A2D);
}

.pl-total .v {
  font-family: var(--font-mono);
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--accent-2, #00984A);
  letter-spacing: 0;
}

.pl-total .u {
  font-size: var(--fs-sm);
  font-weight: 500;
}

/* ── Fuel ──────────────────────────────────────────────────────────────── */
.fuel-list .pl-row {
  padding: 8px 0;
  border-bottom: 1px solid var(--line-2, #EFF2F0);
}

.fuel-list .pl-row:last-of-type {
  border-bottom: none;
}

.fuel-compare {
  margin-top: 14px;
  background: var(--surface-2);
  border-radius: var(--r-md, 14px);
  padding: 14px 15px;
  border: 1px solid var(--line);
}

.fc-title {
  font-size: var(--fs-2xs);
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: 12px;
}

.bullet {
  margin-bottom: 11px;
}

.bullet:last-of-type {
  margin-bottom: 0;
}

.bullet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 5px;
}

.bullet-head .bl {
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink-2);
}

.bullet-head .bv {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink);
}

.track {
  height: 8px;
  border-radius: 6px;
  background: #E4E9E6;
  overflow: hidden;
  position: relative;
}

.track .fill {
  height: 100%;
  border-radius: 6px;
}

.fill.actual {
  background: var(--accent-2);
}

.fill.norm {
  background: #C2CAC6;
}

.fc-flag {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 12px;
  padding: 8px 11px;
  background: var(--danger-soft, #FCEAEA);
  border-radius: 9px;
  color: var(--danger, #E32434);
  font-size: var(--fs-xs);
  font-weight: 700;
}

.fc-flag svg {
  flex: 0 0 auto;
}
</file>

<file path="frontend/src/pages/trip-detail/responsive.css">
/* ── Responsive (TripDetailPage 2-col body layout) ─────────────────────── */

@media (max-width: 1200px) {
  .trip-body {
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 20px;
  }
}

/* Tablet (≤ 1023px): Collapse to a single column. */
@media (max-width: 1023px) {
  .td-page-head {
    flex-direction: column;
    align-items: flex-start;
  }

  .td-page-head .header-actions {
    width: 100%;
    justify-content: flex-start;
  }

  .trip-body {
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .trip-col--rail {
    position: static;
  }

  .trip-rail-bg {
    background-image: none;
    padding: 0;
  }

  .trip-rail-bg::before {
    display: none;
  }

  .journey-body {
    grid-template-columns: 1fr;
  }

  .map-wrap {
    border-right: none;
    border-bottom: 1px solid var(--line-2, #EFF2F0);
    min-height: 280px;
  }

  .leaflet-touch .leaflet-control-zoom a,
  .leaflet-control-zoom a {
    width: 44px;
    height: 44px;
    line-height: 44px;
  }
}

/* Narrow tablet / small laptop (≤ 860px): gap tightens more, but the 2-col
   body still holds. KPI rail stays 2x2. */
@media (max-width: 860px) {
  .trip-body {
    gap: 14px;
  }
}

/* Mobile (≤ 640px): collapse to a single column with explicit source order
   so the financial summary leads and operational content follows. */
@media (max-width: 640px) {
  .tc-page-head,
  .td-page-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
  }

  .tc-page-head::after,
  .td-page-head::after {
    left: 14px;
    right: 14px;
  }

  /* The .company (customer name) is set to max-width: 560px + nowrap on
     desktop, which forces the entire title-block wider than the viewport
     on phones. Cap it to the available width and let it ellipsis. */
  .company {
    max-width: 100%;
  }

  /* Action buttons wrap onto their own row below the title. Right-aligned
     with top/bottom padding so they don't touch the title above or the
     content below. The desktop .header-actions is `flex` (single row) —
     on phones we keep the buttons at their natural size and let them
     flow into multiple rows if the viewport is narrow. */
  .td-page-head .header-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    width: 100%;
    gap: 8px;
    padding-top: 8px;
    padding-bottom: 6px;
  }

  .td-page-head .header-actions .btn {
    width: auto;
    min-width: 0;
    justify-content: center;
    min-height: 44px;
    padding: 8px 14px;
    font-size: var(--fs-xs);
    line-height: 1.35;
  }

  .td-page-head .header-actions .header-overflow {
    grid-column: 2;
    grid-row: 1;
    margin-left: 0;
  }

  .td-page-head .header-actions .header-overflow > summary.btn {
    width: 44px;
    min-width: 44px;
    padding: 0;
  }

  /* "Hủy chuyến" (btn--danger) is a rare / destructive action — on mobile
     it should be visually subordinate to the primary CTA, but it still needs
     the same comfortable tap target as the rest of the action cluster. */
  .td-page-head .header-actions .btn--danger {
    min-height: 44px;
    padding: 8px 14px;
    font-size: var(--fs-xs);
    line-height: 1.35;
  }

  .td-page-head .header-actions .btn--primary {
    grid-column: 1 / -1;
  }

  /* Tighter title on phones */
  .tc-page-title {
    font-size: var(--fs-xl);
  }

  /* 2-col body becomes a single column on phones. The two .trip-col
     wrappers flatten with `display: contents` so each card becomes a
     direct child of .trip-body and we can reorder with `order`. */
  .trip-body {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .trip-col {
    display: contents;
  }

  .trip-rail-bg,
  .trip-rail-bg::before {
    background: none;
    padding: 0;
  }

  .trip-rail-bg > * {
    z-index: auto;
  }

  /* Mobile source order follows the operational job before analysis:
       1  BasicInfoCard (main)
       2  JourneyCard (main)
       3  KpiStrip (rail)
       4  FinancialCard (rail)
       5  ServiceCostsCard (main)
       6  ContainersCard (main)
       7  FuelCard (rail)
       8  ExternalCarrierCard (rail, optional)
       9  PhotosCard (main, optional)
      10  Notes (main, optional) */
  .tdp-m3 { order: 1; }
  .tdp-m1 { order: 2; }
  .tdp-r1 { order: 3; }
  .tdp-r2 { order: 4; }
  .tdp-m2 { order: 5; }
  .tdp-m4 { order: 6; }
  .tdp-r3 { order: 7; }
  .tdp-r4 { order: 8; }
  .tdp-r5 { order: 9; }
  .tdp-m6 { order: 10; }

  /* On phones, BasicInfoCard fields stack to a single column too */
  .info-list {
    grid-template-columns: 1fr;
  }

  .cs-galleries {
    grid-template-columns: 1fr 92px;
    gap: 8px;
  }

  .cs-gallery {
    padding: 8px;
  }

  .cs-thumb {
    width: 72px;
    height: 52px;
  }

  .cs-gallery--seal .cs-thumb {
    width: 76px;
  }

  .container-row {
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 9px;
    padding: 10px;
  }

  .container-fields {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 8px 10px;
  }

  .container-fields .cf:nth-child(3),
  .container-fields .cf--full {
    grid-column: 1 / -1;
  }

  .cf-label {
    font-size: var(--fs-xs);
    line-height: 1.35;
  }

  .cf-value {
    font-size: 12.5px;
    line-height: 1.35;
  }

  /* KPI rail micro-grid stays 2x2 on mobile, but tighter */
  .kpi-rail {
    padding: 12px 14px 10px;
  }
  .kpi-rail__grid {
    gap: 8px 10px;
  }
}

/* Very narrow phones (≤ 420px) — three buttons per row get cramped, so
   drop to 2 per row by giving each button a slightly larger basis. */
@media (max-width: 420px) {
  .td-page-head .header-actions .btn {
    flex: 1 1 100%;
  }

  /* .btn--ghost has no background by default (it's designed for desktop
     where it sits next to filled buttons). On phones it ends up looking
     like a plain text link, not a button. Promote it to a filled card so
     the action cluster reads as a uniform list of tappable buttons. */
  .td-page-head .header-actions .btn--ghost {
    background: var(--surface);
    color: var(--ink);
    border-color: var(--line-2);
    /* Force centered content in case .btn--ghost's `padding: 9px 10px`
       rule from the base CSS file wins the cascade over the mobile
       `justify-content: center` rule (it doesn't normally, but be explicit
       so the button never reads as a left-aligned text link). */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .td-page-head .header-actions .btn--ghost:hover {
    background: var(--surface-2, var(--surface));
  }
}

/* ── Journey legs: stack origin / arrow / destination on phones ────────── */
@media (max-width: 640px) {
  .leg {
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    row-gap: 8px;
  }
  /* Push the loading-type badge to a second row spanning the full width */
  .leg-right {
    grid-column: 1 / -1;
    flex-direction: row;
    justify-content: flex-end;
  }
  /* Stack stops on two visual lines so the full stop name fits */
  .leg-stops {
    flex-wrap: wrap;
    row-gap: 4px;
    column-gap: 8px;
  }
  .leg-stops .st {
    max-width: 100%;
  }
  .leg-stops .ar {
    transform: rotate(90deg);
  }
  /* Compact meta line */
  .leg-meta {
    flex-wrap: wrap;
    gap: 6px 12px;
  }
}

/* ── Journey foot: let it wrap; keep the CTA on one line ───────────────── */
@media (max-width: 640px) {
  .journey-foot {
    flex-wrap: wrap;
    row-gap: 8px;
    padding: 12px 16px;
  }
  .journey-foot .add-note {
    margin-left: auto;
    white-space: nowrap;
  }
}

/* ── Responsive overrides (from responsive.css decomposition) ── */
@media (max-width: 640px) {
  .trip-detail-cols { flex-direction: column; }
} /* end 640px */
</file>

<file path="frontend/src/pages/trip-list/filters.css">
/* ── Filters card (wireframe: white card + pill tabs + pill filters) ──── */
.trip-list-page .filters-card {
  --fc-green: #005A2D;
  --fc-green-soft: #E8F1EC;
  --fc-field: #F7F8F8;
  --fc-line-2: #EFF1F0;
  --fc-radius-card: var(--r);
  --fc-radius-pill: var(--r-sm);

  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--fc-radius-card);
  padding: 18px;
  margin-bottom: 22px;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  container-type: inline-size;
}

/* ── Row 1: status tabs + search ──────────────────────────────────────── */
.trip-list-page .filters-row-top {
  display: flex;
  align-items: center;
  gap: 16px;
}

.trip-list-page .status-tabs {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  overflow-x: visible;
  scrollbar-width: none;
  flex: 1;
  min-width: 0;
}
.trip-list-page .status-tabs::-webkit-scrollbar { display: none; }

.trip-list-page .stab-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid var(--line);
  background: var(--surface);
  border-radius: var(--fc-radius-pill);
  cursor: pointer;
  white-space: nowrap;
  color: var(--ink-2);
  font-size: var(--fs-sm);
  font-weight: 600;
  font-family: var(--font-body);
  transition: background .16s ease, border-color .16s ease, color .16s ease;
}
.trip-list-page .stab-pill:hover { border-color: #D8DEDB; background: #FCFDFD; }
.trip-list-page .stab-pill .stab-dot {
  width: 7px; height: 7px; border-radius: 50%;
  flex: none;
  background: var(--dot, var(--ink-3));
}
.trip-list-page .stab-pill .stab-count {
  font-family: var(--font-mono); font-feature-settings: "tnum";
  font-size: var(--fs-xs); font-weight: 600;
  min-width: 20px; height: 20px;
  padding: 0 5px; border-radius: 6px;
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--fc-line-2);
  color: var(--ink-2);
  transition: background .16s ease, color .16s ease;
}
/* zero-count tabs read quieter */
.trip-list-page .stab-pill.zero { color: var(--ink-3); }
.trip-list-page .stab-pill.zero .stab-dot { opacity: .45; }
.trip-list-page .stab-pill.zero .stab-count { color: var(--ink-3); }
/* active tab */
.trip-list-page .stab-pill.active {
  background: var(--fc-green);
  border-color: var(--fc-green);
  color: var(--fg-on-brand);
}
.trip-list-page .stab-pill.active .stab-dot { background: rgba(255,255,255,.85); opacity: 1; }
.trip-list-page .stab-pill.active .stab-count { background: rgba(255,255,255,.20); color: var(--fg-on-brand); }

/* ── Search ───────────────────────────────────────────────────────────── */
.trip-list-page .filters-search {
  position: relative;
  flex: none;
  width: 340px;
}
.trip-list-page .filters-search svg {
  position: absolute;
  left: 14px; top: 50%;
  transform: translateY(-50%);
  color: var(--ink-3);
  pointer-events: none;
}
.trip-list-page .filters-search input {
  width: 100%;
  height: 44px;
  min-height: 44px;
  border: 1px solid var(--line);
  background: var(--fc-field);
  border-radius: var(--fc-radius-pill);
  padding: 0 14px 0 40px;
  font-family: var(--font-body);
  font-size: var(--fs-sm); font-weight: 500;
  line-height: 1.35;
  color: var(--ink);
  transition: background .16s ease, border-color .16s ease;
}
.trip-list-page .filters-search input::placeholder { color: var(--ink-3); font-weight: 500; }
.trip-list-page .filters-search input:focus {
  outline: 2px solid color-mix(in srgb, var(--fc-green) 30%, transparent);
  outline-offset: 2px;
  background: var(--surface);
  border-color: var(--fc-green);
}
.trip-list-page .filters-search-hint {
  display: inline-flex;
  align-items: center;
  height: 22px;
  font-family: var(--font-body);
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 0;
  color: var(--fc-green, #005a2d);
  background: rgba(0, 90, 45, .08);
  padding: 0 10px;
  border-radius: 999px;
  white-space: nowrap;
  cursor: help;
}

/* ── Divider ──────────────────────────────────────────────────────────── */
.trip-list-page .filters-divider { height: 1px; background: var(--fc-line-2); margin: 16px 0; }

/* ── Row 2: filter pills ──────────────────────────────────────────────── */
.trip-list-page .filters-row-bottom {
  display: grid;
  grid-template-columns: minmax(0, 1.65fr) minmax(0, .7fr) minmax(0, .95fr);
  align-items: center;
  gap: 10px;
  width: 100%;
  min-width: 0;
}

.trip-list-page .filters-row-bottom .filters-search {
  width: 100%;
  min-width: 0;
}

.trip-list-page .filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid var(--line);
  background: var(--fc-field);
  border-radius: var(--fc-radius-pill);
  cursor: pointer;
  font-size: var(--fs-sm); font-weight: 600;
  font-family: var(--font-body);
  color: var(--ink);
  white-space: nowrap;
  width: 100%;
  min-width: 0;
  transition: background .16s ease, border-color .16s ease;
}
.trip-list-page .filter-pill:hover { background: #FCFDFD; border-color: #D8DEDB; }
.trip-list-page .filter-pill:focus-within {
  background: var(--surface);
  border-color: var(--fc-green);
  outline: 2px solid color-mix(in srgb, var(--fc-green) 30%, transparent);
  outline-offset: 2px;
}
.trip-list-page .filter-pill .filter-lbl-wrap {
  display: flex; flex-direction: column;
  align-items: flex-start;
  line-height: 1.35;
  min-width: 0;
  flex: 1;
}
.trip-list-page .filter-pill .filter-lbl-cap {
  font-size: var(--fs-xs); font-weight: 600;
  line-height: 1.35;
  color: var(--ink-3); letter-spacing: .01em;
}
.trip-list-page .filter-pill select {
  background: transparent; border: none; outline: none;
  font: inherit; font-size: var(--fs-sm); font-weight: 600;
  color: inherit; cursor: pointer;
  appearance: none; padding: 0;
  line-height: 1.35;
  min-height: 44px;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  text-overflow: clip;
  overflow: visible;
  white-space: normal;
  overflow-wrap: anywhere;
}

@media (max-width: 1180px) {
  .trip-list-page .filters-row-bottom {
    grid-template-columns: minmax(0, 1fr) minmax(170px, 240px);
  }

  .trip-list-page .filters-row-bottom .filters-search,
  .trip-list-page .filters-search-hint {
    grid-column: 1 / -1;
  }
}

@container (max-width: 940px) {
  .trip-list-page .filters-row-bottom {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .trip-list-page .filters-row-bottom .filters-search,
  .trip-list-page .filters-search-hint {
    grid-column: 1 / -1;
  }
}

@container (max-width: 560px) {
  .trip-list-page .filters-row-bottom {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 640px) {
  .trip-list-page .filters-row-bottom {
    grid-template-columns: 1fr;
  }

  .trip-list-page .filter-pill {
    min-height: 44px;
    padding-top: 6px;
    padding-bottom: 6px;
  }

  .trip-list-page .filter-pill select {
    min-height: 44px;
  }
}
.trip-list-page .filter-pill .filter-chev {
  color: var(--ink-3);
  transition: transform .16s ease;
  flex: none;
}
/* active filter (has a value selected) */
.trip-list-page .filter-pill.has-value {
  border-color: var(--fc-green);
  background: var(--fc-green-soft);
  color: var(--fc-green);
}
.trip-list-page .filter-pill.has-value .filter-lbl-cap { color: rgba(0,90,45,.6); }
.trip-list-page .filter-pill.has-value .filter-chev { color: var(--fc-green); }

/* ── Section heading ──────────────────────────────────────────────────── */
.trip-list-page .section-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 14px; gap: 18px;
  flex-wrap: wrap;
}
.trip-list-page .section-title { display: flex; align-items: baseline; gap: 12px; }
.trip-list-page .section-title h2 {
  font-family: var(--font-display);
  font-size: var(--fs-lg); font-weight: 700;
  letter-spacing: 0;
  margin: 0;
}
.trip-list-page .section-title .count {
  font-size: var(--fs-xs); font-weight: 600;
  color: var(--ink-3);
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 2px 9px;
  border-radius: 99px;
}
</file>

<file path="frontend/src/pages/trip-list/hero-metrics.css">
/* ============================================================================
 * Trip list page (.trip-list-page wireframe)
 * Shares visual language with .dispatch-page — same charcoal hero, same metric
 * strip pattern, same scoped naming — but adds a data table with breakdown bar,
 * filter dropdowns, pagination, and mobile-card fallback.
 * ========================================================================== */

.trip-list-page {
  --d-charcoal-1: #14181A;
  --d-charcoal-2: #1A2220;
  --d-charcoal-3: #1F2D27;
  --d-green-50:   #F0FDF4;
  --d-green-100:  #DCFCE7;
  --d-green-500:  #16A34A;
  --d-green-700:  #007038;
  --d-green-800:  #005A2D;
  --d-amber:      #B45309;
  --d-amber-bg:   #FEF3C7;
  --d-amber-dot:  #F59E0B;
  --d-red:        #B91C1C;
  --d-red-bg:     #FEE2E2;
  --d-red-dot:    #DC2626;
  --d-blue:       #1D4ED8;
  --d-blue-bg:    #DBEAFE;
  --d-blue-dot:   #3B82F6;
  /* Wireframe table design tokens */
  --tbl-green-050: #F1F8F4;
  --tbl-line-strong: #D7DEDB;
  --tbl-slate-100: #EDF0EE;
  --tbl-slate-700: #4A5650;
  --tbl-green-100: #E3F2E9;
  --tbl-green-700: #005A2D;
  --tbl-green-600: #0A6E3A;
  --tbl-amber-100: #FBEFD3;
  --tbl-amber-700: #9A6400;
  --tbl-blue-100: #E0ECFA;
  --tbl-blue-700: #1F5FB0;
  --tbl-red-100: #FBE3E3;
  --tbl-red-700: #B23030;
}

/* ── Hero (same pattern as dispatch) ──────────────────────────────────── */
/* Breadcrumb trail — sits above the hero so users get a "you are here"
   cue. Muted color so it doesn't compete with the hero metrics below. */
.trip-list-page .trip-list-page__crumbs {
  margin: 2px 0 10px;
  color: var(--ink-3);
  font-size: 12px;
}
.trip-list-page .trip-list-page__crumbs ul {
  /* daisyUI ships breadcrumbs with default list styles; tighten the gap so
     it reads as one line on the dense list page. */
  gap: 4px;
}

.trip-list-page .hero {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: var(--r);
  padding: 22px 24px;
  margin-bottom: 18px;
  position: relative;
  overflow: hidden;
  container-type: inline-size;
}
.trip-list-page .hero.hero--route-network {
  background-image: url("/assets/illustrations/hero-route-network.svg");
  background-color: var(--surface);
  background-repeat: no-repeat;
  background-position: right 24px bottom 10px;
  background-size: min(260px, 24vw) auto;
}
.trip-list-page .hero::before {
  content: none;
}
.trip-list-page .hero::after {
  content: none;
}
.trip-list-page .hero-top {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: 24px; position: relative;
}
.trip-list-page .hero-title-block { min-width: 0; }
.trip-list-page .hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: var(--fs-xs); letter-spacing: 1.2px; font-weight: 700;
  color: var(--accent-ink);
  text-transform: uppercase;
  margin-bottom: 9px;
}
.trip-list-page .hero-eyebrow::before {
  content: ''; width: 6px; height: 6px;
  background: var(--accent); border-radius: 50%;
}
.trip-list-page .hero-h1 {
  font-family: var(--font-display);
  font-size: var(--fs-2xl); font-weight: 800;
  letter-spacing: 0;
  line-height: 1.25;
  margin: 0 0 6px;
}
.trip-list-page .hero-sub { font-size: var(--fs-sm); color: var(--ink-2); }
.trip-list-page .hero-actions { display: flex; gap: 10px; flex-shrink: 0; }
.trip-list-page .hero-actions .btn {
  min-width: 132px;
}

/* Hero action buttons use the Global .btn / .btn--primary / .btn--secondary
   system (components/Button.css). The page-scoped .btn-d* recipes were
   retired during CTA unification. */

/* ── Metric bento grid ─────────────────────────────────────────────────
   Layout: featured card spans 2 rows on the left, 4 tiles in 2×2 on the right.
   gap: 1px with rgba background creates hairline dividers (same pattern as before). */
.trip-list-page .metrics {
  margin-top: 18px;
  display: grid;
  grid-template-columns: minmax(260px, 1.35fr) repeat(4, minmax(0, 1fr));
  gap: 10px;
  background: transparent;
  border-radius: 0;
  overflow: visible;
  position: relative;
}
.trip-list-page .metric {
  min-width: 0;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  padding: 14px 16px;
  transition: background 160ms var(--ease), border-color 160ms var(--ease);
}
.trip-list-page .metric:hover {
  border-color: color-mix(in srgb, var(--accent) 18%, var(--line-2));
  background: var(--surface-2);
}
.trip-list-page .metric.featured {
  grid-row: auto;
  grid-column: auto;
  background: var(--brand-soft);
  border-color: rgba(0, 177, 79, 0.18);
}
.trip-list-page .metric.featured .metric-label { color: var(--accent-ink); }
.trip-list-page .metric-label {
  font-size: var(--fs-xs); letter-spacing: 1px;
  color: var(--ink-3);
  font-weight: 600;
  text-transform: uppercase;
  margin-bottom: 8px;
  overflow-wrap: anywhere;
}
.trip-list-page .metric-value {
  max-width: 100%;
  font-size: clamp(18px, 1.85vw, var(--fs-2xl)); font-weight: 700;
  line-height: 1.35; letter-spacing: 0;
  color: var(--ink);
}
.trip-list-page .metric-value.d-mono { font-family: var(--font-mono); font-feature-settings: "tnum"; }
.trip-list-page .metric-unit { font-size: var(--fs-sm); color: var(--ink-3); font-weight: 500; margin-left: 4px; line-height: 1.35; }
.trip-list-page .metric-delta {
  margin-top: 8px;
  font-size: var(--fs-xs); font-weight: 600;
  display: inline-flex; align-items: center; gap: 4px;
  line-height: 1.4;
  word-break: break-word;
}
.trip-list-page .delta-up { color: var(--accent-ink); }
/* Use the foreground --danger token, not the --danger-soft background tint
   (which rendered negative deltas near-invisible). Mirrors DispatchPage. */
.trip-list-page .delta-down { color: var(--danger); }
.trip-list-page .delta-flat { color: var(--ink-3); }
.trip-list-page .delta-warn { color: var(--warning-text); }

.trip-list-page .breakdown-bar {
  margin-top: 12px;
  height: 6px;
  background: var(--surface-3);
  border-radius: 99px;
  display: flex; overflow: hidden;
}
.trip-list-page .bb-seg { height: 100%; transition: width 200ms ease; }
.trip-list-page .bb-moi  { background: #6B7280; }
.trip-list-page .bb-dang { background: #3B82F6; }
.trip-list-page .bb-htth { background: #10B981; }
.trip-list-page .bb-chot { background: #1E293B; }
.trip-list-page .bb-huy  { background: #EF4444; }
.trip-list-page .breakdown-legend {
  margin-top: 8px;
  display: flex; flex-wrap: wrap; gap: 10px 14px;
  font-size: var(--fs-xs); color: var(--ink-2);
  line-height: 1.35;
}
.trip-list-page .legend-item { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
.trip-list-page .legend-dot { width: 7px; height: 7px; border-radius: 2px; }

@container (max-width: 1180px) {
  .trip-list-page .metrics {
    grid-template-columns: minmax(280px, 1.15fr) repeat(2, minmax(190px, 1fr));
  }

  .trip-list-page .metric.featured {
    grid-row: span 2;
  }
}

@container (max-width: 820px) {
  .trip-list-page .metrics {
    grid-template-columns: 1fr 1fr;
  }

  .trip-list-page .metric.featured {
    grid-column: 1 / -1;
    grid-row: auto;
  }
}
</file>

<file path="frontend/src/pages/trip-list/mobile-cards.css">
/* ── Mobile: cards instead of table ───────────────────────────────────── */
.trip-list-page .trip-mobile-list { display: none; }
.trip-list-page .trip-mcard {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 14px;
  margin-bottom: 10px;
  cursor: pointer;
  transition: background 120ms ease, border-color 120ms ease;
  position: relative;
}
.trip-list-page .trip-mcard::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: var(--status-strip-width);
  height: var(--status-strip-height);
  border-radius: var(--status-strip-radius);
  background: linear-gradient(to bottom, var(--strip-top) 50%, var(--strip-bottom) 50%);
}
.trip-list-page .trip-mcard:hover {
  background: var(--surface-2);
  border-color: var(--ink-2);
}
.trip-list-page .trip-mcard__main-link {
  color: inherit;
  display: block;
  text-decoration: none;
}
.trip-list-page .trip-copy-btn--mobile {
  width: fit-content;
  margin-top: 10px;
  min-height: 44px;
  align-self: flex-start;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-2px);
}
.trip-list-page .trip-mcard:hover .trip-copy-btn--mobile,
.trip-list-page .trip-mcard:focus-within .trip-copy-btn--mobile,
.trip-list-page .trip-copy-btn--mobile:focus-visible,
.trip-list-page .trip-copy-btn--mobile.is-copying {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}
@media (hover: none), (pointer: coarse) {
  .trip-list-page .trip-copy-btn--mobile {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
}
.trip-list-page .trip-mcard__top {
  display: flex; align-items: center; justify-content: space-between;
  gap: 10px; margin-bottom: 10px;
}
.trip-list-page .trip-mcard__top .left { min-width: 0; flex: 1; }
.trip-list-page .trip-mcard__name {
  font-size: var(--fs-sm); font-weight: 600; color: var(--ink);
  margin-bottom: 2px;
  overflow-wrap: anywhere;
}
.trip-list-page .trip-mcard__id {
  font-family: var(--font-mono);
  font-size: var(--fs-xs); font-weight: 600; color: var(--ink-3);
  display: inline-flex; align-items: center; gap: 6px;
  flex-wrap: wrap;
  max-width: 100%;
}

.trip-list-page .trip-mcard__id .plate {
  font-size: var(--fs-xs);
  padding: 4px 9px;
}
.trip-list-page .trip-mcard__route {
  display: flex; align-items: center; gap: 8px;
  font-size: var(--fs-sm); font-weight: 600; color: var(--ink);
  margin-bottom: 8px; flex-wrap: wrap;
  overflow-wrap: anywhere;
}
.trip-list-page .trip-mcard__route .arr { display: inline-flex; color: var(--ink-3); opacity: 0.6; }

.trip-list-page .trip-mcard__containers .container-tag {
  font-size: var(--fs-xs);
  line-height: 1.35;
}

.trip-list-page .trip-mcard__container-numbers {
  display: flex;
  flex-wrap: wrap;
  gap: 3px 8px;
  color: var(--ink-2);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  line-height: 1.35;
}
.trip-list-page .trip-mcard__meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding-top: 10px;
  border-top: 1px dashed var(--line);
}
.trip-list-page .trip-mcard__meta .mm {
  display: flex; flex-direction: column; gap: 2px;
}
.trip-list-page .trip-mcard__meta .lab {
  font-size: var(--fs-xs); letter-spacing: 0.8px;
  color: var(--ink-3); text-transform: uppercase; font-weight: 600;
}
.trip-list-page .trip-mcard__meta .val {
  font-family: var(--font-mono);
  font-size: var(--fs-sm); font-weight: 600; color: var(--ink);
}
.trip-list-page .trip-mcard__meta .val.warn { color: var(--d-amber); }
.trip-list-page .trip-mcard__meta .val.empty { color: var(--ink-3); opacity: 0.7; font-style: italic; font-family: var(--font-body); font-weight: 500; }

.trip-list-page .trip-mcard--quick {
  cursor: default;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.trip-list-page .trip-mcard--quick.selected {
  border-color: color-mix(in srgb, var(--tbl-green-600) 42%, var(--line));
  outline: 2px solid var(--tbl-green-100);
  outline-offset: 2px;
}
.trip-list-page .trip-mcard--quick.locked {
  opacity: 0.72;
}
.trip-list-page .trip-mcard__check {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 28px;
  color: var(--ink-2);
  font-size: var(--fs-xs);
  font-weight: 700;
}
.trip-list-page .trip-mcard__check input {
  width: 18px;
  height: 18px;
  margin: 0;
  accent-color: var(--tbl-green-700);
}
.trip-list-page .quick-card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  padding-top: 4px;
}
.trip-list-page .quick-card-field {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5px;
}
.trip-list-page .quick-card-field > span {
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}
.trip-list-page .quick-card-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  padding-top: 10px;
  border-top: 1px dashed var(--line);
}
.trip-list-page .quick-card-summary div {
  min-width: 0;
}
.trip-list-page .quick-card-summary span {
  display: block;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 700;
  text-transform: uppercase;
}
.trip-list-page .quick-card-summary b {
  display: block;
  margin-top: 2px;
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  font-weight: 700;
  overflow-wrap: anywhere;
}
.trip-list-page .quick-card-error {
  color: var(--danger);
  background: color-mix(in srgb, var(--danger) 9%, var(--surface));
  border: 1px solid color-mix(in srgb, var(--danger) 25%, transparent);
  border-radius: 8px;
  padding: 7px 9px;
  font-size: var(--fs-xs);
  font-weight: 700;
}

@media (max-width: 420px) {
  .trip-list-page .trip-mcard {
    padding: 12px;
  }
  .trip-list-page .trip-mcard__top {
    align-items: flex-start;
    flex-direction: column;
  }
  .trip-list-page .quick-card-grid,
  .trip-list-page .quick-card-summary {
    grid-template-columns: 1fr;
  }
}

/* ── Mobile card missing indicators ──────────────────────────────────── */
.trip-list-page .trip-mcard__missing {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 6px;
}

/* ── Data completeness row tinting ────────────────────────────────────── */
/* Pete (8/6): "nhận diện bằng màu sắc dòng nào đã nhập đủ số liệu"     */
/* Complete = all financials entered (revenue + fuel + road + salary)     */

/* Color legend in table hint bar */
.trip-list-page .table-legend {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  margin-left: auto;
  font-size: var(--fs-xs);
  font-weight: 500;
  color: var(--ink-3);
  white-space: nowrap;
}
.trip-list-page .legend-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 4px;
  vertical-align: middle;
}
.trip-list-page .legend-dot--ok { background: #10B981; }
.trip-list-page .legend-dot--warn { background: #F59E0B; }
/* Table row completeness uses edge strip now, removing old background tints */
/* Hover overrides completeness tint with standard hover */
.trip-list-page .table-row:hover {
  background: var(--tbl-green-050);
}
/* Mobile cards completeness uses edge strip now, removing old borders */
