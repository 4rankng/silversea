.penalty-month-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  background: var(--accent-soft);
  border: 1px solid rgba(0, 177, 79, 0.15);
  border-radius: 999px;
  color: var(--accent-ink);
  font-size: var(--fs-2xs);
  font-weight: 700;
  letter-spacing: 0.4px;
  text-transform: uppercase;
}

.penalty-month-pill .dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 3px rgba(0, 177, 79, 0.18);
}

/* ─── Segmented time filter ─── */

.penalty-seg {
  display: inline-flex;
  padding: 3px;
  background: var(--surface-3);
  border-radius: 8px;
  border: 1px solid var(--line);
}

.penalty-seg button {
  border: 0;
  background: transparent;
  min-height: 36px;
  padding: 7px 12px;
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink-3);
  border-radius: 6px;
  cursor: pointer;
  font-family: inherit;
  transition: background 120ms var(--ease), color 120ms var(--ease), box-shadow 120ms var(--ease);
}

.penalty-config-link {
  display: inline-flex;
  align-items: center;
  min-height: 36px;
  padding: 6px 0;
  color: var(--accent-2);
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
}

.penalty-seg button.active {
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
}

.penalty-seg button:hover:not(.active) {
  color: var(--ink-2);
}

/* ─── Card header (reuse fleet pattern) ─── */

.penalty-page .penalty-card-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  padding: 10px 12px;
  border-bottom: 1px solid var(--line);
}

.penalty-page .penalty-card-lead {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1 1 300px;
  min-width: 0;
}

.penalty-page .penalty-card-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: var(--accent-soft);
  color: var(--accent-2);
  display: grid;
  place-items: center;
  border: 1px solid rgba(0, 177, 79, 0.15);
  flex-shrink: 0;
}

.penalty-page .penalty-card-icon.alt {
  background: var(--surface-3);
  color: var(--ink-2);
  border-color: var(--line-2);
}

.penalty-page .penalty-card-title {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 8px;
}

.penalty-page .count-pill {
  font-family: var(--font-mono);
  font-size: var(--fs-2xs);
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--surface-3);
  color: var(--ink-2);
}

.penalty-page .penalty-card-sub {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  margin-top: 1px;
}

.penalty-page .penalty-head-tools {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* ─── Rank badge ─── */

.penalty-rank {
  display: inline-grid;
  place-items: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  font-family: var(--font-mono);
  font-size: var(--fs-2xs);
  font-weight: 700;
  background: var(--surface-3);
  color: var(--ink-3);
}

.penalty-rank.gold {
  background: #FEF3C7;
  color: #92400E;
}

.penalty-rank.silver {
  background: #F1F5F9;
  color: #475569;
}

.penalty-rank.bronze {
  background: #FED7AA;
  color: #9A3412;
}

/* ─── Driver cell ─── */

.penalty-driver-cell {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.penalty-driver-mini {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--accent-soft);
  color: var(--accent);
  border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
  flex-shrink: 0;
}

.penalty-driver-info .name {
  font-weight: 600;
  color: var(--ink);
  font-size: var(--fs-sm);
  line-height: 1.2;
}

.penalty-driver-info .role {
  font-size: var(--fs-2xs);
  color: var(--ink-3);
  margin-top: 1px;
}

/* ─── Streak bar ─── */

.penalty-streak {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.penalty-streak-num {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: var(--fs-sm);
  color: var(--ink);
}

.penalty-streak-num .unit {
  font-size: var(--fs-2xs);
  color: var(--ink-3);
  font-weight: 500;
  margin-left: 3px;
}

.penalty-streak-bar {
  width: 56px;
  height: 4px;
  border-radius: 2px;
  background: var(--surface-3);
  overflow: hidden;
  position: relative;
}

.penalty-streak-bar .fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: var(--accent);
  border-radius: 2px;
}

.penalty-streak-bar .fill.gold {
  background: linear-gradient(90deg, var(--accent), #FCD34D);
}

/* ─── Violation count indicator ─── */

.penalty-violation-count {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink-2);
}

.penalty-violation-count .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
}

.penalty-violation-count.zero {
  color: var(--accent-2);
}

.penalty-violation-count.warn {
  color: var(--warning-text);
}

.penalty-violation-count.warn .dot {
  background: var(--warning);
}

.penalty-violation-count.bad {
  color: var(--danger-text);
}

.penalty-violation-count.bad .dot {
  background: var(--danger);
}

/* ─── Money display ─── */

.penalty-money {
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink);
}

.penalty-money.zero {
  color: var(--ink-4);
  font-weight: 500;
}

.penalty-money .unit {
  font-size: var(--fs-2xs);
  color: var(--ink-3);
  font-weight: 500;
  margin-left: 3px;
}

/* ─── Grade pill ─── */

.penalty-grade {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: var(--fs-2xs);
  font-weight: 800;
  letter-spacing: 0.6px;
  font-family: var(--font-mono);
}

.penalty-grade.a-plus {
  background: var(--accent-soft);
  color: var(--accent-ink);
  border: 1px solid rgba(0, 177, 79, 0.15);
}

.penalty-grade.a {
  background: var(--info-soft);
  color: var(--info);
  border: 1px solid rgba(30, 91, 184, 0.15);
}

.penalty-grade.b {
  background: var(--warning-soft);
  color: var(--warning-text);
  border: 1px solid rgba(245, 166, 35, 0.2);
}

.penalty-grade.c {
  background: var(--danger-soft);
  color: var(--danger-text);
  border: 1px solid rgba(227, 36, 52, 0.15);
}

/* ─── Row action buttons ─── */

.penalty-row-act {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  border: 1px solid transparent;
  background: transparent;
  cursor: pointer;
  display: inline-grid;
  place-items: center;
  color: var(--ink-3);
  transition: background 120ms var(--ease), color 120ms var(--ease), border-color 120ms var(--ease);
}

.penalty-row-act:hover {
  background: var(--surface-3);
  color: var(--ink-2);
}

.penalty-row-act.primary:hover {
  background: var(--accent-soft);
  color: var(--accent-2);
  border-color: rgba(0, 177, 79, 0.15);
}

/* ─── Filter chips ─── */

.penalty-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 36px;
  padding: 7px 12px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--surface);
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--ink-3);
  cursor: pointer;
  transition: background 120ms var(--ease), color 120ms var(--ease), border-color 120ms var(--ease);
  font-family: inherit;
}

.penalty-chip:hover {
  background: var(--surface-2);
}

.penalty-chip.active {
  background: var(--ink);
  color: var(--fg-on-brand);
  border-color: var(--ink);
}

.penalty-chip .count {
  font-family: var(--font-mono);
  background: var(--surface-3);
  color: var(--ink-3);
  padding: 0 5px;
  border-radius: 4px;
  font-size: var(--fs-2xs);
  font-weight: 700;
}

.penalty-chip.active .count {
  background: rgba(255, 255, 255, 0.2);
  color: var(--fg-on-brand);
}
</file>

<file path="frontend/src/pages/penalty/violation-types.css">
/* ─── Empty state ─── */

.penalty-empty-log {
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16px;
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, var(--surface) 0%, rgba(248,250,252,0.5) 100%);
}

.penalty-empty-icon-wrap {
  width: 80px;
  height: 80px;
  border-radius: 24px;
  background: linear-gradient(135deg, rgba(0, 177, 79, 0.15), rgba(0, 177, 79, 0.05));
  border: 1px solid rgba(0, 177, 79, 0.2);
  display: grid;
  place-items: center;
  color: var(--accent);
  margin-bottom: 8px;
  box-shadow: 0 12px 24px rgba(0, 177, 79, 0.1), inset 0 2px 4px rgba(255, 255, 255, 0.5);
  position: relative;
}

.penalty-empty-icon-wrap::after {
  content: '';
  position: absolute;
  inset: -12px;
  border-radius: 32px;
  border: 1px dashed rgba(0, 177, 79, 0.25);
  animation: penalty-spin 10s linear infinite;
}

@keyframes penalty-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.penalty-empty-title {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0;
}

.penalty-empty-desc {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  max-width: 440px;
  line-height: 1.6;
}

.penalty-empty-stats {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 12px;
  padding: 10px 16px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(0,0,0,0.06);
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.03);
}

.penalty-empty-stat {
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: center;
}

.penalty-empty-stat .lbl {
  font-size: var(--fs-2xs);
  font-weight: 700;
  color: var(--ink-3);
  text-transform: uppercase;
  letter-spacing: 0.6px;
}

.penalty-empty-stat .val {
  font-family: var(--font-mono);
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--ink);
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 3px;
}

.penalty-empty-stat .val .u {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  font-weight: 500;
}

.penalty-empty-stat .val.pos {
  color: var(--accent);
}

.penalty-empty-divider {
  width: 1px;
  height: 32px;
  background: rgba(0,0,0,0.08);
}

.penalty-empty-actions {
  display: flex;
  gap: 12px;
  margin-top: 16px;
}

/* ─── Empty violation types ─── */

.penalty-empty-reasons {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
  padding: 28px 16px;
}

.penalty-empty-reasons__img {
  width: 160px;
  height: auto;
  margin-bottom: 4px;
}

.penalty-empty-reasons__title {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0;
}

.penalty-empty-reasons__desc {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  max-width: 320px;
  line-height: 1.6;
}

/* ─── Violation type rows ─── */

.penalty-vio-type-row {
  padding: 8px 12px;
  display: grid;
  grid-template-columns: 36px 1fr auto;
  gap: 12px;
  align-items: center;
  border-bottom: 1px solid var(--surface-3);
  cursor: pointer;
  transition: background 120ms var(--ease);
}

.penalty-vio-type-row:last-child {
  border-bottom: none;
}

.penalty-vio-type-row:hover {
  background: var(--surface-2);
}

.penalty-vio-type-icon {
  width: 36px;
  height: 36px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.penalty-vio-type-icon.light {
  background: var(--surface-3);
  color: var(--ink-2);
}

.penalty-vio-type-icon.med {
  background: var(--warning-soft);
  color: var(--warning-text);
}

.penalty-vio-type-icon.heavy {
  background: var(--danger-soft);
  color: var(--danger);
}

.penalty-vio-type-icon.critical {
  background: var(--ink);
  color: var(--fg-on-brand);
}

.penalty-vio-type-info {
  min-width: 0;
}

.penalty-vio-type-name {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink);
}

.penalty-vio-type-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 3px;
  font-size: var(--fs-2xs);
}

.penalty-sev-pill {
  padding: 1px 7px;
  border-radius: 4px;
  font-size: var(--fs-2xs);
  font-weight: 700;
  letter-spacing: 0.4px;
  text-transform: uppercase;
}

.penalty-sev-pill.light {
  background: var(--surface-3);
  color: var(--ink-3);
}

.penalty-sev-pill.med {
  background: var(--warning-soft);
  color: var(--warning-text);
}

.penalty-sev-pill.heavy {
  background: var(--danger-soft);
  color: var(--danger-text);
}

.penalty-sev-pill.critical {
  background: var(--ink);
  color: var(--fg-on-brand);
}

.penalty-vio-type-meta .code {
  font-family: var(--font-mono);
  color: var(--ink-3);
  font-size: var(--fs-2xs);
}

.penalty-vio-type-fine {
  text-align: right;
  flex-shrink: 0;
}

.penalty-vio-type-fine .amt {
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--ink);
}

.penalty-vio-type-fine .lbl {
  font-size: var(--fs-2xs);
  color: var(--ink-3);
  margin-top: 1px;
}
