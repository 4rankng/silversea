import { z } from 'zod';
import { getBootstrapData } from '../../config.service';
import { getStatementData } from '../../statement.service';
import {
  getReceivablesSummary,
  getTopOverdueCustomer,
  getCustomerAgingList,
} from '../../aging.service';
