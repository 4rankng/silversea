  }

  .expense-list-page .expense-mobile-card__summary .expense-amount {
    font-size: 18px;
    line-height: 1.35;
  }

  .expense-list-page .expense-status {
    padding: 5px 9px;
    font-size: var(--fs-xs);
    line-height: 1.35;
    letter-spacing: 0.035em;
  }

  .expense-list-page .expense-plate {
    font-size: 12px;
    padding: 3px 8px;
  }
}
