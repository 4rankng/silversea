      await lockBusinessUnitVersion(tx, id, expectedUpdatedAt, 'Không tìm thấy đơn vị phụ trách');
      return userService.updateBusinessUnitWithTx(id, data, tx);
    },
  });
  res.json({ ...result, replayed });
}));

