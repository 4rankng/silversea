    .where(and(inArray(businessUnits.id, businessUnitIds), eq(businessUnits.status, 'ACTIVE')))
    .for('share');
  if (rows.length !== businessUnitIds.length) {
    throw new ApiError(400, 'Đơn vị phụ trách liên kết không tồn tại hoặc đã ngưng dùng');
