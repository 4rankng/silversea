};

const ACTION_LABELS: Record<GovernanceAllowedAction, string> = {
  CHECK: 'Kiểm tra',
  APPROVE: 'Phê duyệt',
  REJECT: 'Từ chối',
  RETURN_FOR_EVIDENCE: 'Trả bổ sung',
  CANCEL: 'Hủy yêu cầu',
};

const ACTION_KIND_LABELS: Record<string, string> = {
