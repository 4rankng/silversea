/* ============================================================================
 * Modal — TingTing
 * Extracted from UI.css during architecture refactoring (Phase 4)
 * Enhanced with anime.js spring physics (Phase 5)
 * ========================================================================== */

.modal {
  position: fixed;
  inset: 0;
  z-index: var(--z-modal);
  background: rgba(10, 10, 10, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  /* anime.js handles opacity animation */
  opacity: 1;
}
.modal__content {
  background: var(--surface, #fff);
  border: 1px solid var(--line);
  border-radius: var(--r);
  width: 100%;
  max-width: var(--modal-max-w, 540px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  max-height: calc(100vh - 48px);
  /* anime.js handles opacity/scale animation */
  opacity: 1;
  transform: none;
}
.modal__head {
  padding: 20px 24px 16px;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
  background: var(--surface-2);
}
.modal__title {
  margin: 0;
  font-family: var(--font-display);
  font-size: var(--fs-lg);
  font-weight: 700;
  letter-spacing: 0;
  color: var(--ink);
  line-height: 1.3;
}
.modal__close {
  color: var(--ink-3);
  transition: background 150ms var(--ease), color 150ms var(--ease);
  border-radius: 8px;
}
.modal__close:hover {
  background: var(--surface-3);
  color: var(--ink);
}
.modal__body {
  padding: 20px 24px;
  overflow-y: auto;
  overflow-x: hidden;
  max-height: calc(100vh - 220px);
  overscroll-behavior: contain;
}
.modal__foot {
  padding: 16px 24px;
  border-top: 1px solid var(--line);
  background: var(--surface-2);
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  flex-shrink: 0;
}

@media (max-width: 640px) {
  .modal {
    align-items: flex-end;
    padding: 10px;
  }

  .modal__content {
    max-width: 100%;
    max-height: calc(100dvh - 20px);
    border-radius: 18px;
  }

  .modal__head {
    padding: 16px 18px 12px;
  }

  .modal__title {
    font-size: 22px;
    letter-spacing: 0;
  }

  .modal__body {
    padding: 16px 18px;
    max-height: calc(100dvh - 168px);
  }

  .modal__foot {
    padding: 12px 18px max(12px, env(safe-area-inset-bottom));
    gap: 8px;
  }

  .modal__foot .btn {
    min-height: 44px;
  }

  .modal__close {
    width: 44px;
    min-width: 44px;
    min-height: 44px;
  }
}
