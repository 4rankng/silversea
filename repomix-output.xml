    const secondSeed: TripAuthoritySeed = {
      plannedStartAt: '2026-07-29T13:30:00',
      plannedEndAt: '2026-07-29T17:30:00',
      canonicalOrigin: 'Binh Duong',
      canonicalDestination: 'Cat Lai',
