    type: 'DEBIT_NOTE',
    entityType: 'CUSTOMER',
    entityId: customerId,
    rangeFrom,
    rangeTo,
  });
  const input: SaveBillingDocumentInput = {
    ...draft,
    lines: draft.lines.map((line) => ({
      ...line,
