    storageKeys.add(key);
    await storageService.upload(Buffer.from('driver-photo'), key);
    const [row] = await db.insert(s.tripPhotos).values({
      tripId,
      tripContainerId,
      type: 'CONTAINER',
      storageKey: key,
      uploadedBy: driverUserId,
    }).returning();
    rows.push(row);
  }
  return rows;
}

