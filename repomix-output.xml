                {assignment.carrierType === 'OWN' ? <>
                  <TextField label="Tìm xe" value={truckSearch} onChange={(event) => setTruckSearch(event.target.value)} placeholder="Nhập biển số xe" disabled={issuing || fleetAccessDenied} />
                  <SelectField
                    label="Biển số xe"
