// ─── Helpers ────────────────────────────────────────────────────────────────
function vnd(n: number): string {
  return String(Math.round(n));
}

function dateStr(y: number, m: number, d: number): string {
  return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
}

