<file path="frontend/src/components/KpiCard.css">
/* ============================================================================
 * KpiCard — TingTing
 * Extracted from UI.css during architecture refactoring (Phase 4)
 * ========================================================================== */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 28px;
}
.kpi-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
.kpi-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }

.kpi {
  --stat-rail: var(--accent);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r);
  padding: 18px 20px;
  transition: background 150ms var(--ease), border-color 150ms var(--ease);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  min-width: 0;
}
.kpi::before,
.stat-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: var(--status-strip-width);
  height: var(--status-strip-height);
  border-radius: var(--status-strip-radius);
  background: var(--stat-rail, var(--accent));
  transform: translateY(-50%);
  pointer-events: none;
}
.kpi--warn { --stat-rail: var(--warning); }
.kpi--danger { --stat-rail: var(--danger); }
.kpi--success,
.kpi--accent { --stat-rail: var(--accent); }
.kpi--info { --stat-rail: var(--info); }
.kpi[role="button"], .kpi.kpi--clickable { cursor: pointer; }
.kpi[role="button"]:hover,
.kpi.kpi--clickable:hover {
  border-color: var(--line-strong);
  background: var(--surface-2);
}
.kpi__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  gap: 8px;
}
.kpi__label {
  font-size: var(--fs-xs);
  color: var(--ink-2);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  line-height: 1.35;
}
.kpi__icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  color: var(--ink-2);
  background: var(--surface-3);
  flex-shrink: 0;
}
.kpi--warn .kpi__icon { background: var(--warning-soft); color: var(--warning); }
.kpi--danger .kpi__icon { background: var(--danger-soft); color: var(--danger); }
.kpi--success .kpi__icon { background: var(--accent-soft); color: var(--accent); }
.kpi--accent .kpi__icon { background: var(--accent-soft); color: var(--accent); }
.kpi--info .kpi__icon { background: var(--info-soft); color: var(--info); }

.kpi__value {
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.35;
  margin-bottom: 6px;
  color: var(--ink);
  overflow-wrap: anywhere;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}
.kpi__value-unit {
  font-size: var(--fs-xs);
  line-height: 1.35;
  color: var(--ink-3);
  font-weight: 500;
  margin-left: 2px;
}
.kpi--compact .kpi__value {
  font-size: var(--fs-sm);
  letter-spacing: 0;
  line-height: 1.3;
  word-break: break-word;
}
.kpi--compact .kpi__value-unit {
  font-size: 13px;
  line-height: 1.35;
}
.kpi__meta {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px 8px;
  margin-top: auto;
  line-height: 1.4;
  min-width: 0;
}
.kpi__meta--up { color: var(--accent); font-weight: 600; }
.kpi__meta--down { color: var(--danger); font-weight: 600; }

.kpi__watermark {
  position: absolute;
  right: 10px;
  bottom: 6px;
  width: 76px;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  color: var(--ink-3);
  opacity: 0.13;
}
.kpi--compact .kpi__watermark {
  top: 50%;
  bottom: auto;
  transform: translateY(-50%);
  right: 12px;
  width: 48px;
  height: 48px;
}
.kpi--compact .kpi__watermark svg {
  width: 48px;
  height: 48px;
}
.kpi__watermark img {
  width: 72px;
  height: 72px;
  object-fit: contain;
}
.kpi--compact .kpi__watermark img {
  width: 48px;
  height: 48px;
}

/* Mobile: shrink the watermark further and add right padding to value/meta
   so the icon doesn't overlap the text on small viewports (~375px). */
@media (max-width: 640px) {
  .kpi--compact .kpi__watermark {
    width: 36px;
    height: 36px;
    right: 8px;
    opacity: 0.07;
  }
  .kpi--compact .kpi__watermark svg {
    width: 36px;
    height: 36px;
  }
  .kpi--compact .kpi__value,
  .kpi--compact .kpi__meta {
    padding-right: 40px;
  }
}
.kpi--warn .kpi__watermark    { color: var(--warning); opacity: 0.16; }
.kpi--danger .kpi__watermark  { color: var(--danger);  opacity: 0.15; }
.kpi--success .kpi__watermark { color: var(--accent);  opacity: 0.16; }
.kpi--accent .kpi__watermark  { color: var(--brand);   opacity: 0.15; }
.kpi--info .kpi__watermark    { color: var(--info);    opacity: 0.15; }


/* legacy stat-card for backward compat */
.stat-card {
  --stat-rail: var(--accent);
  position: relative;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 18px 20px;
  overflow: hidden;
  transition: background 150ms var(--ease), border-color 150ms var(--ease);
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.stat-card:hover {
  background: var(--surface-2);
  border-color: var(--line-strong);
}

/* metric-strip — horizontal row of label/big-number/unit blocks */
.metric-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 16px;
}
.metric-strip--cols-2 { grid-template-columns: repeat(2, 1fr); }
.metric-strip--cols-4 { grid-template-columns: repeat(4, 1fr); }
.metric-strip__cell {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 16px 20px;
  background: var(--surface);
  position: relative;
  min-width: 0;
}
.metric-strip__label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-2xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: var(--tracking-eyebrow);
  color: var(--ink-3);
}
.metric-strip__label svg { width: 13px; height: 13px; color: var(--ink-3); }
.metric-strip__value {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  font-size: var(--fs-2xl);
  font-weight: var(--fw-semibold);
  letter-spacing: 0;
  line-height: 1.25;
  color: var(--ink);
  overflow-wrap: anywhere;
}
.metric-strip__value--success { color: var(--accent); }
.metric-strip__value--danger  { color: var(--danger); }
.metric-strip__value--muted   { color: var(--ink-3); }
.metric-strip__sub {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  display: flex;
  flex-wrap: wrap;
  gap: 4px 8px;
}
.metric-strip__sub strong { color: var(--ink); font-weight: 600; }
.metric-strip__sub .ms-pos { color: var(--accent); font-weight: 600; }
.metric-strip__sub .ms-neg { color: var(--danger); font-weight: 600; }

/* ─── Trend variant (T2 — KPI sparkline, a-c-statistics-11 pattern) ──────
 * When `trend` is provided, the watermark icon is replaced by a sparkline
 * and a percentage badge appears in the top row. Tokens-only. */
.kpi--with-trend { padding-bottom: 8px; }

.kpi__trend-badge {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-size: var(--fs-2xs);
  font-weight: var(--fw-semibold);
  font-variant-numeric: tabular-nums;
  padding: 2px 6px;
  border-radius: var(--radius-full);
  line-height: 1;
}
.kpi__trend-badge--up {
  color: var(--accent-ink);
  background: var(--accent-soft);
}
.kpi__trend-badge--down {
  color: var(--danger-text);
  background: var(--danger-soft);
}
.kpi__trend-badge--neutral {
  color: var(--ink-3);
  background: var(--surface-3);
}

.kpi__sparkline {
  position: absolute;
  right: 14px;
  bottom: 10px;
  width: 96px;
  height: 32px;
  opacity: 0.95;
}
@media (max-width: 420px) {
  /* On narrow phones, the sparkline crowds the value. Hide rather than shrink. */
  .kpi__sparkline { display: none; }
  .kpi--with-trend { padding-bottom: 12px; }
}
