<file path="frontend/src/pages/AdvanceWorkspacePage.test.tsx">
import React from 'react';
import { render, screen } from '@testing-library/react';
import { MemoryRouter } from 'react-router-dom';
import { describe, expect, it, vi } from 'vitest';
import AdvanceWorkspacePage, {
  buildAdvanceWorkspaceSearch,
  resolveAdvanceWorkspaceView,
} from './AdvanceWorkspacePage';

vi.mock('./AdminAdvancesPage', () => ({
  default: ({ embedded }: { embedded?: boolean }) => (
    <div>Advance requests panel · {embedded ? 'embedded' : 'standalone'}</div>
  ),
}));

vi.mock('./AdminAdvanceSettlementsPage', () => ({
  default: ({ embedded }: { embedded?: boolean }) => (
    <div>Advance settlements panel · {embedded ? 'embedded' : 'standalone'}</div>
  ),
}));

function renderWorkspace(url: string) {
  return render(
    <MemoryRouter initialEntries={[url]}>
      <AdvanceWorkspacePage />
    </MemoryRouter>,
  );
}

describe('AdvanceWorkspacePage', () => {
  it('defaults invalid or missing view values to advance requests', () => {
    expect(resolveAdvanceWorkspaceView(null)).toBe('requests');
    expect(resolveAdvanceWorkspaceView('unknown')).toBe('requests');
    expect(resolveAdvanceWorkspaceView('settlements')).toBe('settlements');
  });

  it('switches views without carrying a stale focus target', () => {
    const search = buildAdvanceWorkspaceSearch(
      new URLSearchParams('view=requests&focus=17&fdur=900&source=agent'),
      'settlements',
    );
    expect(search).toBe('?view=settlements&source=agent');
  });

  it('renders the request workflow as the canonical default', () => {
    renderWorkspace('/advances');
    expect(screen.getByRole('heading', { level: 1, name: 'Tạm ứng & hoàn ứng' })).toBeTruthy();
    expect(screen.getByText('Advance requests panel · embedded')).toBeTruthy();
    expect(screen.getByRole('link', { name: /Yêu cầu tạm ứng/ }).getAttribute('aria-current')).toBe('page');
    expect(screen.getByRole('link', { name: /Mở Trung tâm phê duyệt/ }).getAttribute('href')).toBe('/governance-actions');
  });

  it('renders the settlement workflow from the durable query-backed view', () => {
    renderWorkspace('/advances?view=settlements');
    expect(screen.getByText('Advance settlements panel · embedded')).toBeTruthy();
    expect(screen.getByRole('link', { name: /Phiếu hoàn ứng/ }).getAttribute('aria-current')).toBe('page');
  });
});
</file>

<file path="frontend/src/pages/AdvanceWorkspacePage.tsx">
import { Link, useSearchParams } from 'react-router-dom';
import { ArrowUpRight, ClipboardCheck, WalletCards } from 'lucide-react';
import { PageHeader } from '../components/UI';
import { Breadcrumbs } from '../components/shared/Breadcrumbs';
import AdminAdvancesPage from './AdminAdvancesPage';
import AdminAdvanceSettlementsPage from './AdminAdvanceSettlementsPage';
import './AdvanceWorkspacePage.css';

export type AdvanceWorkspaceView = 'requests' | 'settlements';

export function resolveAdvanceWorkspaceView(value: string | null): AdvanceWorkspaceView {
  return value === 'settlements' ? 'settlements' : 'requests';
}

export function buildAdvanceWorkspaceSearch(
  current: URLSearchParams,
  view: AdvanceWorkspaceView,
): string {
  const next = new URLSearchParams(current);
  next.set('view', view);
  next.delete('focus');
  next.delete('fdur');
  return `?${next.toString()}`;
}

export default function AdvanceWorkspacePage() {
  const [searchParams] = useSearchParams();
  const activeView = resolveAdvanceWorkspaceView(searchParams.get('view'));

  return (
    <div className="advance-workspace">
      <Breadcrumbs
        className="advance-workspace__crumbs"
        items={[
          { label: 'Tổng quan', to: '/dashboard' },
          { label: 'Tạm ứng & hoàn ứng' },
        ]}
      />

      <div className="advance-workspace__heading">
        <PageHeader
          title="Tạm ứng & hoàn ứng"
          iconName="advances"
          description="Quản lý yêu cầu tạm ứng và phiếu hoàn ứng trong một nơi. Yêu cầu tạm ứng được gửi sang Trung tâm phê duyệt để ra quyết định cuối cùng."
        />
        <Link className="advance-workspace__governance-link" to="/governance-actions">
          Mở Trung tâm phê duyệt
          <ArrowUpRight size={16} aria-hidden="true" />
        </Link>
      </div>

      <nav className="advance-workspace__views" aria-label="Tạm ứng và hoàn ứng">
        <Link
          className={activeView === 'requests' ? 'is-active' : ''}
          aria-current={activeView === 'requests' ? 'page' : undefined}
          to={buildAdvanceWorkspaceSearch(searchParams, 'requests')}
        >
          <WalletCards size={18} aria-hidden="true" />
          <span>Yêu cầu tạm ứng</span>
        </Link>
        <Link
          className={activeView === 'settlements' ? 'is-active' : ''}
          aria-current={activeView === 'settlements' ? 'page' : undefined}
          to={buildAdvanceWorkspaceSearch(searchParams, 'settlements')}
        >
          <ClipboardCheck size={18} aria-hidden="true" />
          <span>Phiếu hoàn ứng</span>
        </Link>
      </nav>

      <section
        className="advance-workspace__content"
        aria-labelledby={`advance-workspace-${activeView}-heading`}
      >
        <div className="advance-workspace__section-heading">
          <h2 id={`advance-workspace-${activeView}-heading`}>
            {activeView === 'requests' ? 'Yêu cầu tạm ứng' : 'Phiếu hoàn ứng'}
          </h2>
          <p>
            {activeView === 'requests'
              ? 'Xem yêu cầu của giao nhận và gửi đề nghị duyệt hoặc từ chối.'
              : 'Đối chiếu chi phí, số tiền hoàn lại và xử lý phiếu theo thẩm quyền.'}
          </p>
        </div>

        {activeView === 'requests'
          ? <AdminAdvancesPage embedded />
          : <AdminAdvanceSettlementsPage embedded />}
      </section>
    </div>
  );
}
</file>

<file path="frontend/src/pages/ConfigPage.tsx">
import { useNavigate } from 'react-router-dom';
import { useQueries } from '@tanstack/react-query';
import { Search } from 'lucide-react';
import { PageHeader } from '../components/UI';
import { AssetIcon } from '../components/AssetIcon';
import { api } from '../lib/api';
import { useAuth } from '../hooks/useAuth';
import { useSearch } from '../context/SearchContext';
import { CONFIG_ITEMS } from '../data/searchRegistry';
import { usePageAnimations } from '../hooks/animations';
import { qk } from '../api/keys';
import { isCompanyInfoConfigured, Role } from '@tingting/shared';
import type { CompanyInfo } from '@tingting/shared';
import './ConfigPage.css';

const CHEVRON = <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="m9 18 6-6-6-6"/></svg>;

type ListResponse = { total: number };

function countLabel(n: number | undefined, unit: string): string {
  if (n === undefined) return '—';
  return `${n} ${unit}`;
}

function removeVietnameseTones(str: string): string {
  return str
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd')
    .replace(/Đ/g, 'D');
}

export default function ConfigPage() {
  const navigate = useNavigate();
  const { searchQuery } = useSearch();
  const { rootRef } = usePageAnimations({ ready: true });
  const { user } = useAuth();
  const isAdmin = user?.role === Role.ADMIN;

  const [
    penaltyReasons,
    roadAllowances,
    drivers,
    capTable,
    customers,
    routes,
    trucks,
    tirePositions,
    trailers,
    cargoTypes,
    pricingTables,
    salaryDefault,
    expenseCategories,
    fuelConfig,
    companyInfo,
    forwarderExpenseTypes,
    debitNoteTemplates,
  ] = useQueries({
    queries: [
      { queryKey: qk.configCounts.penaltyReasons,        queryFn: () => api.get<ListResponse>('/penalty-reasons?limit=1'),    staleTime: 60_000 },
      { queryKey: qk.configCounts.roadAllowances,        queryFn: () => api.get<ListResponse>('/road-allowances?limit=1'),    staleTime: 60_000 },
      { queryKey: qk.configCounts.drivers,               queryFn: () => api.get<ListResponse>('/drivers?limit=1'),            staleTime: 60_000 },
      { queryKey: qk.configCounts.capTable,              queryFn: () => api.get<ListResponse>('/cap-table?limit=1'),          staleTime: 60_000 },
      { queryKey: qk.configCounts.customers,             queryFn: () => api.get<ListResponse>('/customers?limit=1'),          staleTime: 60_000 },
      { queryKey: qk.configCounts.routes,                queryFn: () => api.get<ListResponse>('/routes?limit=1'),             staleTime: 60_000 },
      { queryKey: qk.configCounts.trucks,                queryFn: () => api.get<ListResponse>('/trucks?limit=1'),             staleTime: 60_000 },
      { queryKey: qk.configCounts.tirePositions,         queryFn: () => api.get<ListResponse>('/tire-positions?limit=1'),     staleTime: 60_000 },
      { queryKey: qk.configCounts.trailers,              queryFn: () => api.get<ListResponse>('/trailers?limit=1'),            staleTime: 60_000 },
      { queryKey: qk.configCounts.cargoTypes,            queryFn: () => api.get<ListResponse>('/cargo-types?limit=1'),        staleTime: 60_000 },
      { queryKey: qk.configCounts.pricingTables,         queryFn: () => api.get<ListResponse>('/pricing-tables?limit=1'),     staleTime: 60_000 },
      { queryKey: qk.configCounts.salaryDefault,         queryFn: () => api.get<{ defaultStartDay?: number; defaultEndDay?: number } | null>('/salary-periods/default'), staleTime: 60_000 },
      { queryKey: qk.configCounts.expenseCategories,     queryFn: () => api.get<ListResponse>('/expense-categories?limit=1'), staleTime: 60_000 },
      { queryKey: qk.configCounts.fuelConfig,            queryFn: () => api.get<{ id: number } | null>('/fuel-config'),       staleTime: 60_000 },
      { queryKey: qk.configCounts.companyInfo,           queryFn: () => api.get<CompanyInfo>('/company-info'),                staleTime: 60_000 },
      { queryKey: qk.configCounts.forwarderExpenseTypes, queryFn: () => api.get<ListResponse>('/forwarder-expense-types?limit=1'), staleTime: 60_000 },
      { queryKey: qk.configCounts.debitNoteTemplates,   queryFn: () => api.get<ListResponse>('/debit-note-templates?limit=1'),   staleTime: 60_000 },
    ],
  });

  function salaryStatus(): string {
    if (salaryDefault.isLoading) return '—';
    const d = salaryDefault.data;
    if (!d || d.defaultStartDay == null) return 'Chưa cấu hình';
    const s = d.defaultStartDay;
    const e = d.defaultEndDay;
    if (s != null && e != null && s <= e) {
      // Same-month mode
      const endLabel = e === 31 ? 'cuối tháng' : `ngày ${e}`;
      return `Ngày ${s} → ${endLabel}`;
    }
    return `Ngày ${s} tháng trước → Ngày ${e} tháng này`;
  }

  function fuelStatus(): string {
    if (fuelConfig.isLoading) return '—';
    return fuelConfig.data ? 'Đã cấu hình' : 'Chưa cấu hình';
  }

  function companyInfoStatus(): string {
    if (companyInfo.isLoading) return '—';
    return isCompanyInfoConfigured(companyInfo.data) ? 'Đã cấu hình' : 'Chưa cấu hình';
  }

  const statusInfo: Record<string, { status: string; statusColor?: string }> = {
    'fuel':                     { status: fuelStatus() },
    'company-info':             { status: companyInfoStatus() },
    'road-allowances':          { status: countLabel(roadAllowances.data?.total, 'tuyến') },
    'trip-expense':             { status: '5 mục', statusColor: '#10B981' },
    'penalty-reasons':          { status: countLabel(penaltyReasons.data?.total, 'quy tắc') },
    'drivers':                  { status: countLabel(drivers.data?.total, 'lái xe') },
    'cap-table':                { status: countLabel(capTable.data?.total, 'cổ đông') },
    'customers':                { status: countLabel(customers.data?.total, 'khách hàng') },
    'routes':                   { status: countLabel(routes.data?.total, 'tuyến chặng') },
    'trucks':                   { status: countLabel(trucks.data?.total, 'xe') },
    'tire-positions':           { status: countLabel(tirePositions.data?.total, 'vị trí') },
    'trailers':                 { status: countLabel(trailers.data?.total, 'rơ-moóc') },
    'cargo-types':              { status: countLabel(cargoTypes.data?.total, 'loại hàng') },
    'pricing-tables':           { status: countLabel(pricingTables.data?.total, 'đơn giá') },
    'salary-periods':           { status: salaryStatus() },
    'expense-categories':       { status: countLabel(expenseCategories.data?.total, 'hạng mục') },
    'forwarder-expense-types':  { status: countLabel(forwarderExpenseTypes.data?.total, 'loại') },
    'debit-note-templates':     { status: countLabel(debitNoteTemplates.data?.total, 'mẫu') },
  };

  const cards = CONFIG_ITEMS
    .filter(item => !item.adminOnly || isAdmin)
    .map(item => {
    return {
      title: item.label,
      desc: item.description ?? '',
      icon: <AssetIcon name={item.iconName} size={26} />,
      path: item.path,
      action: item.action ?? 'Sửa',
      ...(statusInfo[item.id] ?? { status: '—' }),
    };
  });

  const filteredCards = cards.filter(card => {
    const query = searchQuery.toLowerCase().trim();
    if (!query) return true;

    const queryNormalized = removeVietnameseTones(query);
    const titleNormalized = removeVietnameseTones(card.title.toLowerCase());
    const descNormalized = removeVietnameseTones(card.desc.toLowerCase());

    return (
      titleNormalized.includes(queryNormalized) ||
      descNormalized.includes(queryNormalized)
    );
  });

  return (
    <div ref={rootRef}>
      <PageHeader
        title="Cấu hình hệ thống"
        iconName="settings"
        description="Quản lý định mức, quy tắc tính toán, người dùng & tích hợp hệ thống"
      />

      {searchQuery.trim() && (
        <div style={{ marginBottom: 16, fontSize: 13, color: 'var(--fg-3)', display: 'flex', alignItems: 'center', gap: 6 }}>
          <Search size={14} />
          Tìm thấy <strong>{filteredCards.length}</strong> kết quả phù hợp cho từ khóa "{searchQuery}"
        </div>
      )}

      {filteredCards.length === 0 ? (
        <div style={{ textAlign: 'center', padding: '64px 32px', border: '1px dashed var(--line)', borderRadius: 12, background: 'var(--bg-2)', color: 'var(--fg-3)' }}>
          <Search size={32} style={{ margin: '0 auto 12px', display: 'block', opacity: 0.5 }} />
          <h3 style={{ fontSize: 15, fontWeight: 600, color: 'var(--fg-2)', marginBottom: 4 }}>Không tìm thấy cấu hình</h3>
          <p style={{ fontSize: 13 }}>Hãy thử tìm kiếm với từ khóa khác.</p>
        </div>
      ) : (
        <div className="settings-grid asset-route-grid" data-tour-id="config-grid">
          {filteredCards.map(card => (
            <button key={card.path} className="setting-card" onClick={() => navigate(card.path)}>
              <div className="setting-card__icon">{card.icon}</div>
              <h3 className="setting-card__title">{card.title}</h3>
              <p className="setting-card__desc">{card.desc}</p>
              <div className="setting-card__foot">
                <span className="setting-card__status">
                  <span className="dot" style={card.statusColor ? { background: card.statusColor } : undefined}></span>
                  {card.status}
                </span>
                <span className="setting-card__action">{card.action} {CHEVRON}</span>
              </div>
            </button>
          ))}
        </div>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/pages/DebtDetailPage.css">
/* ============================================================================
 * DebtDetailPage — Cong no phai thu (per-customer detail)
 * Scoped with dd- prefix to avoid global collisions.
 * ========================================================================== */

/* Breadcrumb trail — sits above the customer header. Mirrors TripDetailPage. */
.debt-detail__crumbs {
  margin: 0 auto 4px;
  padding: 12px 24px 0;
  color: var(--ink-3);
  font-size: 12px;
  max-width: 1600px;
}
.debt-detail__crumbs ul { gap: 4px; }
@media (max-width: 640px) {
  .debt-detail__crumbs { padding: 8px 16px 0; }
}

/* ─── Customer Header ─────────────────────────────────────────────────────── */

.dd-header {
  display: grid;
  grid-template-columns: auto auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px;
  margin-bottom: 16px;
  animation: fade-up .35s var(--ease) both;
  position: relative;
  z-index: 10;
}

.dd-back {
  width: 44px;
  height: 44px;
  border-radius: var(--r);
  border: 1px solid var(--line);
  background: var(--surface);
  display: grid;
  place-items: center;
  cursor: pointer;
  color: var(--ink-2);
  flex-shrink: 0;
  transition: var(--t-fast);
}
.dd-back:hover { border-color: var(--ink-2); color: var(--ink); }

.dd-avatar {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  flex-shrink: 0;
  background: #fff;
  border: 1px solid rgba(17, 24, 39, 0.08);
  display: grid;
  place-items: center;
  box-shadow: 0 10px 22px -16px rgba(15, 23, 42, 0.22);
}

.dd-avatar__icon {
  width: 28px;
  height: 28px;
}

.dd-meta { flex: 1; min-width: 0; }

.dd-meta h1 {
  font-size: 24px;
  font-weight: 850;
  letter-spacing: 0;
  line-height: 1.25;
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
}

.dd-sub {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 6px;
  flex-wrap: wrap;
}
.dd-sub span {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-sm);
  color: var(--ink-3);
  font-weight: 500;
}
.dd-sub .dd-mono {
  font-family: var(--font-mono);
  color: var(--ink-2);
  font-weight: 600;
}

.dd-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 11px;
  border-radius: var(--radius-full);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: .01em;
}
.dd-tag--warn {
  background: var(--danger-soft);
  color: var(--danger);
}
.dd-tag--ok {
  background: var(--accent-soft);
  color: var(--accent-2);
}
.dd-tag--dot::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
}

.dd-actions {
  display: flex;
  gap: 10px;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  flex-shrink: 0;
}

/* ─── Account Summary Strip ───────────────────────────────────────────────── */

.dd-account-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 12px;
  animation: fade-up .38s var(--ease) both;
  animation-delay: .03s;
}

.dd-account-card {
  min-width: 0;
  padding: 13px 15px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface);
  box-shadow: var(--sh-sm);
}

.dd-account-card span,
.dd-payment-panel__side span,
.dd-panel-eyebrow {
  display: block;
  color: var(--ink-3);
  font-size: var(--fs-2xs);
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.dd-account-card strong {
  display: block;
  min-width: 0;
  margin-top: 8px;
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: 20px;
  line-height: 1.2;
  font-weight: 850;
  overflow-wrap: anywhere;
}

.dd-account-card small {
  display: block;
  margin-top: 5px;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 650;
  line-height: 1.35;
}

.dd-account-card--debt {
  border-color: color-mix(in srgb, var(--danger) 22%, var(--line));
  background: color-mix(in srgb, var(--danger) 5%, var(--surface));
}

.dd-account-card--debt strong {
  color: var(--danger);
}

.dd-account-card--clear {
  border-color: color-mix(in srgb, var(--accent) 24%, var(--line));
  background: color-mix(in srgb, var(--accent) 6%, var(--surface));
}

.dd-account-card--clear strong {
  color: var(--accent-2);
}

/* ─── Summary Card ─────────────────────────────────────────────────────────── */

.dd-summary {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 8px;
  box-shadow: var(--sh);
  padding: 16px 18px;
  margin-bottom: 14px;
  animation: fade-up .4s var(--ease) both;
  animation-delay: .06s;
}

.dd-summary--aging {
  box-shadow: var(--sh-sm);
}

.dd-sum-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.dd-sum-label {
  font-size: var(--fs-2xs);
  font-weight: 700;
  letter-spacing: .16em;
  color: var(--ink-3);
}

.dd-sum-copy {
  max-width: 560px;
  margin: 6px 0 0;
  color: var(--ink-2);
  font-size: var(--fs-sm);
  font-weight: 600;
  line-height: 1.45;
}

.dd-sum-total {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: var(--fs-2xl);
  line-height: 1.35;
  color: var(--danger);
  letter-spacing: 0;
  margin-top: 12px;
}
.dd-sum-total .dd-cur {
  font-size: var(--fs-sm);
  font-weight: 600;
  margin-left: 6px;
  line-height: 1.35;
  color: var(--danger);
}
.dd-sum-total--clear {
  color: var(--accent);
}
.dd-sum-total--clear .dd-cur { color: var(--accent); }

.dd-sum-note {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
  font-size: var(--fs-sm);
  color: var(--ink-2);
  font-weight: 500;
}

.dd-sum-update {
  text-align: right;
  font-size: var(--fs-xs);
  color: var(--ink-3);
  font-weight: 500;
  line-height: 1.7;
  white-space: nowrap;
}
.dd-sum-update b {
  display: block;
  font-family: var(--font-mono);
  color: var(--ink-2);
  font-size: var(--fs-sm);
}

/* ─── Aging Bar ─────────────────────────────────────────────────────────────── */

.dd-aging-bar {
  display: flex;
  height: 8px;
  border-radius: var(--radius-full);
  overflow: hidden;
  margin: 16px 0 12px;
  background: var(--bg-3);
}
.dd-aging-bar i {
  display: block;
  height: 100%;
}
.dd-seg-0 { background: var(--accent); }
.dd-seg-1 { background: var(--warning); }
.dd-seg-2 { background: #D97706; }
.dd-seg-3 { background: var(--danger); }

/* ─── Aging Grid ────────────────────────────────────────────────────────────── */

.dd-aging-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
@media (max-width: 1023px) {
  .dd-aging-grid { grid-template-columns: repeat(2, 1fr); }
}

.dd-aging-cell {
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 12px 14px;
  transition: var(--t-normal);
}
.dd-aging-cell:hover { box-shadow: var(--sh-sm); }
.dd-aging-cell--active {
  background: var(--accent-soft);
  border-color: #BCE9CF;
}
.dd-aging-cell--active .dd-ac-val { color: var(--sidebar); }

.dd-ac-head {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-2xs);
  font-weight: 700;
  letter-spacing: .1em;
  color: var(--ink-3);
}
.dd-ac-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

/* Export dropdown menu items (shared by DebtDetail & PayableDetail) */
.dd-export-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 10px 14px;
  border: none;
  background: transparent;
  cursor: pointer;
  font-size: var(--fs-sm);
  color: var(--fg-1);
}
.dd-export-btn:hover {
  background: var(--bg-2);
}

.dd-ac-val {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: var(--fs-lg);
  margin-top: 12px;
  color: var(--ink);
}
.dd-ac-val--zero {
  color: var(--ink-3);
}

.dd-ac-share {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  font-weight: 600;
  margin-top: 6px;
}

/* ─── Customer Workspace ──────────────────────────────────────────────────── */

.dd-workspace {
  margin-bottom: 18px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface);
  box-shadow: var(--sh-sm);
  overflow: hidden;
  animation: fade-up .45s var(--ease) both;
  animation-delay: .1s;
}

.dd-workspace-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(520px, auto);
  align-items: center;
  gap: 18px;
  padding: 14px 16px;
  border-bottom: 1px solid var(--line);
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FAF9 100%);
}

.dd-workspace-head h2 {
  margin: 4px 0 0;
  color: var(--ink);
  font-size: 18px;
  font-weight: 850;
  line-height: 1.2;
}

.dd-workspace-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(118px, 1fr));
  gap: 6px;
}

.dd-workspace-tab {
  min-width: 0;
  min-height: 56px;
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: var(--ink-2);
  text-align: left;
  cursor: pointer;
  transition: var(--t-fast);
}

.dd-workspace-tab:hover {
  background: var(--surface);
  border-color: var(--line);
}

.dd-workspace-tab--active {
  background: var(--surface);
  border-color: color-mix(in srgb, var(--accent) 34%, var(--line));
  box-shadow: inset 0 -2px 0 var(--accent);
  color: var(--ink);
}

.dd-workspace-tab span {
  display: block;
  overflow: hidden;
  color: inherit;
  font-size: var(--fs-sm);
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dd-workspace-tab small {
  display: block;
  overflow: hidden;
  margin-top: 4px;
  color: var(--ink-3);
  font-size: var(--fs-2xs);
  font-weight: 650;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dd-workspace-body {
  padding: 14px;
}

.dd-workspace .billing-panel {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  animation: none;
}

.dd-workspace .billing-panel__head {
  margin-bottom: 0;
}

.dd-workspace .billing-panel__list,
.dd-workspace .billing-panel__empty {
  margin-top: 12px;
}

.dd-payment-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(240px, 340px);
  gap: 18px;
  align-items: stretch;
}

.dd-payment-panel__main,
.dd-payment-panel__side {
  min-width: 0;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface);
}

.dd-payment-panel__main {
  padding: 18px;
}

.dd-payment-panel__main h2 {
  margin: 6px 0 0;
  color: var(--ink);
  font-size: 18px;
  font-weight: 850;
}

.dd-payment-panel__main p {
  max-width: 620px;
  margin: 8px 0 16px;
  color: var(--ink-2);
  font-size: var(--fs-sm);
  font-weight: 600;
  line-height: 1.5;
}

.dd-payment-panel__side {
  display: grid;
  grid-template-columns: 1fr;
  overflow: hidden;
}

.dd-payment-panel__side div {
  min-width: 0;
  padding: 13px 15px;
  border-bottom: 1px solid var(--line);
}

.dd-payment-panel__side div:last-child {
  border-bottom: 0;
}

.dd-payment-panel__side strong {
  display: block;
  margin-top: 6px;
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: var(--fs-md);
  font-weight: 850;
  overflow-wrap: anywhere;
}

.dd-payment-panel__side small {
  display: block;
  margin-top: 4px;
  color: var(--ink-3);
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 700;
}

/* ─── Ledger Route Groups ───────────────────────────────────────────────────── */

.dd-ledger {
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
  animation: fade-up .45s var(--ease) both;
  animation-delay: .12s;
}

.dd-ledger-head {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 24px;
  border-bottom: 1px solid var(--line);
}
.dd-ledger-head h2 {
  font-size: 16px;
  font-weight: 800;
  flex-shrink: 0;
  line-height: 1.35;
}
.dd-ledger-heading {
  min-width: 0;
}
.dd-ledger-heading h2 {
  margin: 0;
}
.dd-ledger-heading p {
  margin: 4px 0 0;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 600;
  line-height: 1.45;
}
.dd-ledger-head--workspace {
  margin-bottom: 12px;
  padding: 0 0 12px;
}
.dd-ledger-head .dd-cnt {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  font-weight: 600;
  font-family: var(--font-mono);
}

.dd-ledger--standalone,
.dd-documents-section {
  margin-bottom: 16px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  box-shadow: var(--sh-sm);
}

.dd-documents-section {
  padding: 18px 20px;
}

.dd-documents-section__head {
  margin-bottom: 14px;
}

.dd-documents-section__head h2 {
  margin: 4px 0 0;
  color: var(--ink);
  font-size: 16px;
  font-weight: 800;
}

.dd-documents-section__head p {
  margin: 4px 0 0;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 600;
  line-height: 1.45;
}

.dd-documents-section .billing-panel {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.dd-ledger-toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding: 0 0 10px;
  border-bottom: 0;
  background: transparent;
}

.dd-filters {
  display: flex;
  gap: 6px;
  margin-left: auto;
}

.dd-filter-chip {
  min-height: 44px;
  padding: 8px 14px;
  border-radius: 9px;
  border: 1px solid var(--line);
  background: var(--surface);
  font-family: var(--font-display);
  font-size: var(--fs-xs);
  font-weight: 600;
  line-height: 1.35;
  color: var(--ink-2);
  cursor: pointer;
  transition: var(--t-fast);
  white-space: nowrap;
}
.dd-filter-chip:hover { border-color: var(--ink-2); }
.dd-filter-chip--on {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--fg-on-brand);
}

/* ─── Grouped Ledger Layout ───────────────────────────────────────────────── */

.dd-ledger-groups {
  display: grid;
  gap: 14px;
  padding: 0;
  background: transparent;
}

.dd-ledger-empty {
  padding: 32px;
  text-align: center;
  color: var(--ink-3);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
}

.dd-route-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
  box-shadow: var(--sh-sm);
}

.dd-route-card-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16px;
  align-items: start;
  padding: 18px 20px;
  border-bottom: 1px solid var(--line);
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FAF9 100%);
}

.dd-route-card-head h3 {
  font-size: 18px;
  line-height: 1.4;
  font-weight: 850;
  margin: 0;
  color: var(--ink);
}

.dd-route-title {
  min-width: 0;
}

.dd-route-endpoints {
  display: grid;
  gap: 5px;
}

.dd-route-endpoint {
  display: grid;
  grid-template-columns: 68px minmax(0, 1fr);
  gap: 10px;
  align-items: baseline;
}

.dd-route-endpoint span {
  font-size: var(--fs-xs);
  font-weight: 700;
  color: var(--ink-3);
  text-transform: uppercase;
}

.dd-route-endpoint strong {
  min-width: 0;
  font-size: var(--fs-sm);
  line-height: 1.35;
  font-weight: 650;
  color: var(--ink-2);
}

.dd-route-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 10px;
}

.dd-route-metrics span,
.dd-route-card-total span {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  padding: 3px 8px;
  border: 1px solid var(--line);
  border-radius: 7px;
  background: var(--surface);
  font-size: var(--fs-xs);
  color: var(--ink-3);
  font-family: var(--font-mono);
  font-weight: 700;
}

.dd-route-card-total {
  display: grid;
  justify-items: end;
  gap: 5px;
  white-space: nowrap;
}

.dd-route-card-total span {
  color: var(--danger);
  border-color: color-mix(in srgb, var(--danger) 18%, var(--line));
  background: color-mix(in srgb, var(--danger) 7%, var(--surface));
}

.dd-route-card-total b {
  font-family: var(--font-mono);
  font-size: 24px;
  line-height: 1.25;
  color: var(--ink);
}

.dd-route-card-total em {
  font-style: normal;
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 700;
  color: #00803a;
}

.dd-route-containers {
  padding: 10px;
}

.dd-accounting-ledger {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface);
}

.dd-accounting-row {
  display: grid;
  grid-template-columns: 96px minmax(220px, 1.7fr) minmax(120px, 0.7fr) minmax(120px, max-content) minmax(90px, max-content);
  gap: 12px;
  align-items: center;
  min-height: 38px;
  padding: 7px 12px;
  border-bottom: 1px solid var(--bg-3);
}

.dd-accounting-row:last-child {
  border-bottom: 0;
}

.dd-accounting-row--head {
  min-height: 34px;
  background: #F6F8F7;
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 850;
  text-transform: uppercase;
}

.dd-accounting-row--container {
  background: #F0FAF4;
  border-top: 1px solid var(--line);
  box-shadow: inset 3px 0 0 #12A150;
}

.dd-accounting-row--head + .dd-accounting-row--container {
  border-top: 0;
}

.dd-accounting-row--container b {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 750;
  color: var(--ink-2);
}

.dd-accounting-row--container em {
  margin-left: 8px;
  font-style: normal;
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  font-weight: 700;
  color: var(--ink-3);
}

.dd-accounting-row--container span:nth-child(3) {
  color: #087F3B;
  font-size: var(--fs-xs);
  font-weight: 800;
}

.dd-accounting-row--entry {
  min-height: 34px;
  background: var(--surface);
}

.dd-accounting-row--entry span:first-child,
.dd-accounting-row--container strong {
  font-family: var(--font-mono);
  font-weight: 900;
}

.dd-accounting-row--entry span:first-child {
  color: var(--ink-2);
  font-size: var(--fs-xs);
  font-weight: 500;
}

.dd-accounting-row--entry span:nth-child(2) {
  position: relative;
  padding-left: 16px;
  color: var(--ink);
  font-size: var(--fs-xs);
  font-weight: 500;
}

.dd-accounting-row--entry span:nth-child(2)::before {
  content: '';
  position: absolute;
  left: 2px;
  top: 50%;
  width: 7px;
  height: 1px;
  background: var(--line-strong);
}

.dd-accounting-row--entry span:nth-child(3) {
  color: var(--ink-3);
  font-size: var(--fs-xs);
  font-weight: 500;
}

.dd-accounting-row strong {
  justify-self: end;
  color: var(--ink);
  font-size: var(--fs-xs);
  font-weight: 500;
  white-space: nowrap;
}

.dd-accounting-row--container strong {
  color: #064E2A;
  font-weight: 900;
}

.dd-breakdown-section {
  border: 1px solid var(--line);
  border-radius: 8px;
  overflow: hidden;
  background: var(--surface);
}

.dd-breakdown-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
  align-items: start;
  padding: 10px 12px;
  background: #FCFDFD;
  border-bottom: 1px solid var(--line);
}

.dd-breakdown-head h4 {
  margin: 0;
  font-size: var(--fs-sm);
  line-height: 1.45;
  font-weight: 800;
  color: var(--ink);
}

.dd-breakdown-head span {
  display: inline-block;
  margin-top: 3px;
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: var(--ink-3);
  font-weight: 700;
}

.dd-breakdown-head strong {
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  color: var(--ink);
  white-space: nowrap;
}

.dd-breakdown-items {
  display: grid;
  gap: 0;
}

.dd-trip-card,
.dd-single-card {
  border-bottom: 1px solid var(--bg-3);
  background: var(--surface);
}

.dd-trip-card:last-child,
.dd-single-card:last-child {
  border-bottom: 0;
}

.dd-trip-card {
  padding: 12px;
}

.dd-trip-main {
  display: grid;
  grid-template-columns: 92px minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
}

.dd-trip-date,
.dd-single-date {
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--ink-2);
  white-space: nowrap;
}

.dd-trip-context {
  min-width: 0;
}

.dd-single-route {
  font-size: var(--fs-sm);
  font-weight: 750;
  color: var(--ink);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dd-trip-subline,
.dd-single-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: var(--ink-3);
  font-weight: 650;
}

.dd-trip-subline span,
.dd-single-meta span {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  padding: 3px 8px;
  border-radius: 7px;
  background: var(--surface-2);
  border: 1px solid var(--line);
}

.dd-trip-money {
  display: grid;
  justify-items: end;
  gap: 4px;
  font-family: var(--font-mono);
}

.dd-trip-money strong {
  font-size: var(--fs-sm);
  color: var(--ink);
}

.dd-fee-breakdown {
  display: grid;
  margin: 10px 0 0 104px;
  overflow: hidden;
  border: 1px solid #D7EBDD;
  border-radius: 8px;
  background: #FBFFFC;
}

.dd-fee-line {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
