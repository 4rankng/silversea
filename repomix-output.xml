<file path="frontend/src/styles/utilities.css">
/* ============================================================================
 * Layout utilities + animations
 * ========================================================================== */
.row-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; margin-bottom: 16px; }
.row-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 16px; margin-bottom: 16px; }
.stack { display: flex; flex-direction: column; gap: 16px; }
.section-gap { margin-bottom: 16px; }

/* ─── Shared breadcrumb trail ─────────────────────────────────────────────
 * Any page that mounts <Breadcrumbs className="<page>__crumbs"> picks up
 * this consistent "you are here" spacing without needing its own CSS rule.
 * Page-specific overrides (e.g. trip-detail, dispatch) live in their own CSS
 * and win by specificity since they're imported after utilities.css.
 * -------------------------------------------------------------------------- */
[class$="__crumbs"] {
  margin: 2px 0 10px;
  color: var(--ink-3);
  font-size: 12px;
}
[class$="__crumbs"] ul { gap: 4px; }


.fade-up { animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) both; }
.fade-up-1 { animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
.fade-up-2 { animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both; }
.fade-up-3 { animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }
.fade-up-4 { animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both; }
.fade-up-5 { animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes spin { to { transform: rotate(360deg); } }
.spin { animation: spin 0.8s linear infinite; }
@media (prefers-reduced-motion: reduce) {
  .fade-up, .fade-up-1, .fade-up-2, .fade-up-3, .fade-up-4, .fade-up-5 { animation: none; }
  .spin { animation: none !important; }
  .panel, .kpi, .kpi:hover, .panel:hover { transform: none !important; transition: none !important; }
  .drawer { transition: none !important; }
  .sidebar-overlay { transition: none !important; }
  .btn--primary::after { transition: none !important; }
  .kpi__watermark { animation: none !important; }
}

@media (max-width: 640px) {
  .kpi-grid { grid-template-columns: repeat(2, 1fr); }
  .topbar { padding: 0 12px; gap: 8px; }
  .topbar-search { display: none; }
  .topbar__search { display: none; }
  /* Topbar: hide date text and breadcrumb "NEPO >" prefix on tiny screens */
  .date-chip span { display: none; }
  .topbar__breadcrumb { font-size: var(--fs-sm); }
  .topbar__breadcrumb > span:first-child,
  .topbar__breadcrumb > svg { display: none; }
  /* Page title slightly smaller on phones */
  .page-title { font-size: 22px; }
  .page-subtitle { font-size: var(--fs-xs); }
  .app-body, .content { padding: 16px 12px 32px; }

  /* ── Page header: stack title above actions on mobile ── */
  .page-header { flex-direction: column; gap: 10px; }
  .page-header .page-actions { flex-wrap: wrap; width: 100%; }

  /* ── KPI cards: tighter layout so labels don't wrap to 3+ lines ── */
  .kpi { padding: 12px; }
  .kpi__top { margin-bottom: 8px; gap: 2px; }
  .kpi__label { font-size: var(--fs-xs); letter-spacing: 0.04em; line-height: 1.35; }
  .kpi__icon { width: 24px; height: 24px; border-radius: 7px; flex-shrink: 0; }
  .kpi__icon svg { width: 12px !important; height: 12px !important; }
  /* .kpi__value font-size handled by clamp() in UI.css */
  .kpi__meta { font-size: var(--fs-xs); gap: 4px; flex-wrap: wrap; }
}

/* ============================================================================
 * Scrollbar polish
 * ========================================================================== */
.app-body::-webkit-scrollbar,
.content::-webkit-scrollbar,
.sidebar-nav::-webkit-scrollbar,
.sidebar__nav::-webkit-scrollbar,
.drawer__body::-webkit-scrollbar,
.table-scroll::-webkit-scrollbar { width: 10px; height: 10px; }
.app-body::-webkit-scrollbar-thumb,
.content::-webkit-scrollbar-thumb,
.drawer__body::-webkit-scrollbar-thumb,
.table-scroll::-webkit-scrollbar-thumb {
  background: rgba(10, 10, 10, 0.15);
  border-radius: 999px;
  border: 2px solid transparent;
  background-clip: padding-box;
}
.app-body::-webkit-scrollbar-thumb:hover,
.content::-webkit-scrollbar-thumb:hover {
  background: rgba(10, 10, 10, 0.3);
  background-clip: padding-box;
}
.sidebar-nav::-webkit-scrollbar-thumb,
.sidebar__nav::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 999px;
  border: 2px solid transparent;
  background-clip: padding-box;
}

/* ============================================================================
 * Mobile responsive utilities
 * ========================================================================== */

/* Show/hide helpers */
.mobile-only  { display: none; }
.desktop-only { display: block; }
@media (max-width: 820px) {
  .mobile-only  { display: block; }
  .desktop-only { display: none !important; }
}

/* Mobile card list — generic pattern used by Trip/Debt/Customer/User lists */
.m-card-list { display: flex; flex-direction: column; gap: 0; }

/* Each card row */
.m-card {
  display: flex;
  flex-direction: column;
  padding: 12px 14px;
  border-bottom: 1px solid var(--line-3);
  cursor: pointer;
  background: var(--surface);
  transition: background 0.1s;
  -webkit-tap-highlight-color: transparent;
}
.m-card:active { background: var(--surface-2); }
.m-card:last-child { border-bottom: none; }

/* Card top row: primary info + right badge */
.m-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 4px;
}
.m-card__title {
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.35;
  flex: 1;
  min-width: 0;
}
.m-card__badge { flex-shrink: 0; }

/* Secondary meta line */
.m-card__meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-xs);
  color: var(--ink-3);
  flex-wrap: wrap;
  margin-bottom: 6px;
}
.m-card__meta-sep { color: var(--line-2); }

/* Bottom row: key value pairs */
.m-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 4px;
  font-size: var(--fs-xs);
}
.m-card__row-label { color: var(--ink-3); }
.m-card__row-value { font-weight: 600; color: var(--ink); font-family: var(--font-mono); font-size: var(--fs-xs); }
.m-card__row-value--danger { color: var(--danger); }
.m-card__row-value--success { color: var(--success); }

/* Aging bar inside mobile card */
.m-card .aging-bar { height: 5px; margin-top: 6px; border-radius: 3px; }

/* Fuel bar inside mobile card */
.m-card__fuel {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 4px;
  font-size: var(--fs-xs);
}
.m-card__fuel-bar {
  flex: 1;
  height: 4px;
  background: var(--line-2);
  border-radius: 2px;
  overflow: hidden;
}
.m-card__fuel-fill { height: 100%; border-radius: 2px; transition: width 0.3s; }
.m-card__fuel-fill--ok   { background: var(--success); }
.m-card__fuel-fill--warn { background: var(--warning); }
.m-card__fuel-fill--danger { background: var(--danger); }

/* Wrap table-wrap on mobile too */
@media (max-width: 820px) {
  .mobile-table-wrap {
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    overflow: hidden;
  }
  .mobile-table-wrap .table-foot {
    border-radius: 0 0 12px 12px;
  }
}

/* Shared action row used by CustomersPage + SupplierListPage mobile cards.
   Desktop: right-aligned button row. On mobile, callers can scope-hide it
   via a page-class selector (see responsive.css) when the whole card is
   made tappable as a shortcut to the edit form. */
.m-card-edit-row {
  display: flex;
  justify-content: flex-end;
  gap: 6px;
  margin-top: 8px;
}
