<file path="frontend/src/pages/PayableListPage.css">
/* ============================================================================
 * PayableListPage — Bento Grid Layout (Vantai Design System)
 *
 * Zone 1: Hero KPI Row (4-column grid: hero span-3 + mini-KPI stack span-1)
 * Zone 2: Aging Distribution (4 equal cards with progress bars)
 * Zone 3: Data Card (full-width card wrapping toolbar + table/mobile cards)
 * ========================================================================== */

/* ── Page wrapper ──────────────────────────────────────────────────────────── */
.payables-page {
  /* Ensures animation selectors are scoped */
}

/* ============================================================================
 * Zone 2 — Aging Distribution (4 equal cards)
 * ========================================================================== */
.payables-aging-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 16px;
}

.aging-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: var(--r-lg, 18px);
  padding: 16px 18px 14px;
  box-shadow: 0 1px 2px rgba(9, 9, 11, 0.04);
  transition: transform 0.2s var(--ease, cubic-bezier(0.4, 0, 0.2, 1)),
              box-shadow 0.2s var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
}

.aging-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(9, 9, 11, 0.07);
}

.aging-card__header {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}

.aging-card__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.aging-card__dot--ok     { background: var(--accent, #00B14F); }
.aging-card__dot--warn   { background: var(--warning, #F5A623); }
.aging-card__dot--deep   { background: var(--warning-deep, #DD5A1F); }
.aging-card__dot--danger { background: var(--danger, #E32434); }

.aging-card__label {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  line-height: 1.35;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-3, #8B919B);
}

.aging-card__value {
  display: flex;
  align-items: baseline;
  gap: 3px;
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.35;
  color: var(--ink, #0A0A0A);
  margin-bottom: 4px;
}

/* Currency unit / compact suffix rendered at subtitle size */
.aging-card__unit {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 500;
  color: var(--ink-3, #8B919B);
  white-space: nowrap;
}

.aging-card__count {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  line-height: 1.35;
  color: var(--ink-3, #8B919B);
  margin-bottom: 10px;
}

/* ── Progress bars ───────────────────────────────────────────────────────── */
.aging-card__bar-track {
  width: 100%;
  height: 4px;
  background: var(--line, #EAECEF);
  border-radius: 2px;
  overflow: hidden;
}

.aging-card__bar {
  height: 100%;
  border-radius: 2px;
  transition: width 0.6s var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
}

.aging-card__bar--ok     { background: var(--accent, #00B14F); }
.aging-card__bar--warn   { background: var(--warning, #F5A623); }
.aging-card__bar--deep   { background: var(--warning-deep, #DD5A1F); }
.aging-card__bar--danger { background: var(--danger, #E32434); }

/* ============================================================================
 * Zone 3 — Data Card
 * ========================================================================== */
.payables-data-card {
  background: var(--surface, #FFFFFF);
  border: 1px solid var(--line, #EAECEF);
  border-radius: var(--r-lg, 18px);
  padding: 20px 24px;
  box-shadow: 0 1px 2px rgba(9, 9, 11, 0.04);
}

/* ── Toolbar inside data card ────────────────────────────────────────────── */
.payables-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.payables-toolbar__spacer {
  flex: 1;
}

.payables-toolbar__search {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--bg-1, #F7F8FA);
  border: 1px solid var(--line, #EAECEF);
  border-radius: var(--r-sm, 8px);
  padding: 8px 14px;
  min-height: 42px;
  width: 300px;
  transition: border-color 0.15s var(--ease, cubic-bezier(0.4, 0, 0.2, 1)),
              box-shadow 0.15s var(--ease, cubic-bezier(0.4, 0, 0.2, 1));
}

.payables-toolbar__search:focus-within {
  border-color: var(--accent, #00B14F);
  box-shadow: 0 0 0 3px rgba(0, 177, 79, 0.1);
}

.payables-toolbar__search input {
  border: none;
  background: transparent;
  outline: none;
  font-size: var(--fs-sm, 14px);
  line-height: 1.35;
  min-height: 32px;
  color: var(--ink, #0A0A0A);
  width: 100%;
  font-family: inherit;
}

.payables-toolbar__search input::placeholder {
  color: var(--ink-3, #8B919B);
}

/* ============================================================================
 * Responsive — Tablet (<=1023px)
 * ========================================================================== */
@media (max-width: 1023px) {
  .payables-page .hero-kpi-row {
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .payables-aging-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .payables-data-card {
    padding: 16px;
  }

  .payables-toolbar__search {
    width: 240px;
  }
}

/* ============================================================================
 * Responsive — Phone (<=640px)
 * ========================================================================== */
@media (max-width: 640px) {
  .payables-page .page-header {
    margin-bottom: 14px;
  }

  .payables-page .page-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
