  .credit-override-queue__summary-card.is-value {
    grid-column: 1 / -1;
    border-left: 0;
  }

  .credit-override-queue__summary-card.is-value .credit-override-queue__summary-icon {
    display: grid;
  }

  .credit-override-queue__facts,
  .credit-override-queue__money-grid {
    grid-template-columns: 1fr;
  }
}
