                const svgH = topTrucks.length * 32;
                const plateW = 65;
                const valW = 75;
                const barTrackW = 280 - plateW - valW - 10;
                const zeroX = minProfit < 0 ? (plateW + 5) + (Math.abs(minProfit) / totalRange) * barTrackW : (plateW + 5);
