  check(
    'salesperson_assignments_effective_range_check',
    sql`${table.effectiveTo} is null or ${table.effectiveTo} > ${table.effectiveFrom}`,
  ),
]);

export const shipmentChangeRequests = pgTable('shipment_change_requests', {
