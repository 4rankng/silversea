<file path="docker-compose.dev.yml">
services:
  db:
    # pgvector/pgvector:pg16 = upstream postgres:16 + the `vector` extension
    # preinstalled. Required for the FAQ fast lane (vector(1536) cosine index).
    # Switched from postgres:16-alpine — the stock alpine image lacks the extension.
    image: pgvector/pgvector:pg16
    # Namespaced silversea-* (not tingting-*) so this stack runs alongside the
    # nepocorp project without Docker container-name collisions.
    container_name: silversea-db
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: silversea
    ports:
      - "5441:5432"
    volumes:
      - silversea-pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 10

  redis:
    image: redis:7-alpine
    container_name: silversea-redis
    ports:
      - "6391:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 2s
      timeout: 3s
      retries: 5

  adminer:
    image: adminer
    container_name: silversea-adminer
    ports:
      - "8083:8080"
    depends_on:
      db:
        condition: service_healthy

volumes:
  silversea-pgdata:
</file>

