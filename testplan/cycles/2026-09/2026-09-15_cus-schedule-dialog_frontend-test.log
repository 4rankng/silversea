  color: var(--text-secondary, #475467);
  font-size: var(--text-label-size);
  font-weight: 600;
}

.dispatch-assignment-dialog__schedule-section {
  display: flex;
  align-items: center;
  gap: 4px;
  color: var(--ink-3, #667085);
  font-size: var(--text-caption-size);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  margin-top: 10px;
  margin-bottom: 6px;
}

.dispatch-assignment-dialog__schedule-section > svg {
  flex-shrink: 0;
  color: var(--brand, #047857);
}

.dispatch-assignment-dialog__schedule-pills,
.dispatch-assignment-dialog__schedule-times {
  display: flex;
  gap: 6px;
  margin-bottom: 10px;
}

.dispatch-assignment-dialog__schedule-pill {
  flex: 1;
  padding: 6px 8px;
  border: 1px solid var(--line, #e4e7ec);
  border-radius: 6px;
  background: var(--surface-2, #f8f9fa);
  color: var(--ink-2, #344054);
  font-family: inherit;
  font-size: var(--text-caption-size);
  font-weight: 500;
  text-align: center;
  cursor: pointer;
  transition: all 120ms ease;
}

.dispatch-assignment-dialog__schedule-pill:hover {
  background: var(--surface, #ffffff);
  border-color: var(--brand, #047857);
  color: var(--brand, #047857);
}

.dispatch-assignment-dialog__schedule-pill.is-active {
  background: var(--brand, #047857);
  border-color: var(--brand, #047857);
  color: #fff;
  font-weight: 600;
}

.dispatch-assignment-dialog__schedule-pill:focus-visible,
.dispatch-assignment-dialog__schedule-time-pill:focus-visible {
  outline: 2px solid var(--accent, #0284c7);
  outline-offset: 1px;
}

.dispatch-assignment-dialog__issue-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.85fr) minmax(0, 0.85fr) minmax(0, 1.3fr);
  gap: 8px;
  margin-bottom: 10px;
}

.dispatch-assignment-dialog__issue-grid > label {
  display: grid;
  min-width: 0;
  gap: 5px;
}

.dispatch-assignment-dialog__issue-grid > label > span {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: var(--text-label-size);
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--ink-3, #667085);
  font-weight: var(--fw-bold, 700);
  line-height: 1.3;
}

.dispatch-assignment-dialog__next-day-badge {
  display: inline-block;
  font-size: var(--text-caption-size);
  font-weight: 600;
  color: var(--brand, #047857);
  background: rgba(4, 120, 87, 0.1);
  padding: 1px 4px;
  border-radius: 3px;
  text-transform: none;
}

.dispatch-assignment-dialog__schedule-time-pill {
  flex: 1;
  padding: 5px 4px;
  border: 1px solid var(--line, #e4e7ec);
  border-radius: 5px;
  background: transparent;
  color: var(--ink-2, #344054);
  font-family: inherit;
  font-size: var(--text-caption-size);
  text-align: center;
  cursor: pointer;
  transition: all 120ms ease;
}

.dispatch-assignment-dialog__schedule-time-pill:hover {
  background: var(--surface-2, #f8f9fa);
  color: var(--brand, #047857);
}

.dispatch-assignment-dialog__schedule-time-pill.is-active {
  background: var(--surface-2, #f8f9fa);
  border-color: var(--brand, #047857);
  color: var(--brand, #047857);
  font-weight: 600;
}

.dispatch-assignment-dialog__issue-times {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px 12px;
}

.dispatch-assignment-dialog__issue-times > label {
  display: grid;
  /* Explicit minmax(0,1fr) track: datetime-local inputs keep a hard intrinsic
     width, so the default auto track would size to the input and overflow the
     cell (inputs merging + spilling past the fieldset) on narrow viewports. */
  grid-template-columns: minmax(0, 1fr);
  min-width: 0;
  gap: 6px;
  color: var(--text-secondary, #475467);
  font-size: var(--text-label-size);
  font-weight: 600;
}

.dispatch-assignment-dialog__issue input[type='datetime-local'],
.dispatch-assignment-dialog__issue input[type='date'],
.dispatch-assignment-dialog__issue input[type='time'] {
  width: 100%;
  min-width: 0;
  min-height: var(--control-compact-h, 34px);
  padding: 0 8px;
  font-size: var(--text-caption-size);
}

@media (max-width: 520px) {
  .dispatch-assignment-dialog__issue-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .dispatch-assignment-dialog__issue-grid > label:last-child {
    grid-column: 1 / -1;
  }
}

/* Phone/narrow widths render .input at the 16px touch font, which makes the
   datetime control's intrinsic width exceed the two-column split — stack the
   pair so each input gets the full row instead of clipping its value. */
@media (max-width: 640px) {
  .dispatch-assignment-dialog__issue-times {
    grid-template-columns: minmax(0, 1fr);
  }
}

@container (max-width: 900px) {
  .detailed-plan-grid td.detailed-plan-grid__cell--editable {
    position: static;
  }

  .detailed-plan-grid td.detailed-plan-grid__cell--editable::after {
    display: none;
  }

  .dispatch-assignment-cell {
    position: static;
  }

  .dispatch-assignment-cell__trigger {
    position: relative;
    inset: auto;
    height: auto;
    min-height: 0;
  }

  /* `td` keeps this above the grid's `.detailed-plan-grid__cell::before`
     label rule (equal class specificity would lose on bundle order). */
  td.detailed-plan-grid__cell--editable::before {
    display: none;
  }

  .dispatch-assignment-cell__trigger::before {
    display: block;
    grid-column: 1 / -1;
    margin-bottom: 3px;
    color: var(--text-secondary, #64748b);
    content: attr(data-cell-label);
    font-size: var(--text-label-size);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
  }
}

@media (max-width: 640px) {
  .dispatch-assignment-dialog__fields {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'carrier'
      'vehicle'
      'classification'
      'combined'
      'revenue'
      'cost';
  }

  .dispatch-assignment-dialog__money .ds-field__input,
  .dispatch-assignment-dialog__money .ds-field__affix,
  .dispatch-assignment-dialog .searchable-select__trigger {
    min-height: var(--control-mobile-h);
  }

  .dispatch-assignment-dialog__classification {
    width: min(180px, 100%);
  }
}

/* Atomic editor additions: classification select + Đóng kết hợp toggle. */
.dispatch-assignment-dialog__fields > .dispatch-assignment-dialog__check {
  grid-area: combined;
  display: flex;
  align-items: center;
  align-self: end;
  min-height: var(--control-compact-h, 34px);
  gap: 8px;
  padding-bottom: 1px;
  color: var(--text-primary, #101828);
  font-weight: 500;
  white-space: nowrap;
}

.dispatch-assignment-dialog__fields > .dispatch-assignment-dialog__check input[type='checkbox'] {
  width: 16px;
  height: 16px;
  flex: 0 0 auto;
  margin: 0;
  accent-color: var(--accent, #005a2d);
}

.dispatch-assignment-dialog__fields > .dispatch-assignment-dialog__check--disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.dispatch-assignment-dialog__fields > .dispatch-assignment-dialog__check input[type='checkbox']:disabled {
  cursor: not-allowed;
}

@media (max-width: 640px) {
  .dispatch-assignment-dialog__fields > .dispatch-assignment-dialog__check {
    min-height: var(--control-mobile-h);
    white-space: normal;
  }
}

/* ─── Note composer (Ghi chú tác vụ) ─────────────────────────────────────── */

.dispatch-assignment-dialog__notes {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 4px;
}

.dispatch-assignment-dialog__notes-label {
  font-size: var(--ops-table-supporting-size, 12px);
  font-weight: 500;
  color: var(--text-secondary, #475467);
}

.dispatch-assignment-dialog__notes-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}

.dispatch-assignment-dialog__notes-tag {
  appearance: none;
  border: 1px solid var(--border, #d0d5dd);
  background: var(--surface, #fff);
  color: var(--text-primary, #101828);
  border-radius: 999px;
  padding: 4px 12px;
  font-size: var(--ops-table-supporting-size, 12px);
  line-height: 1.4;
  cursor: pointer;
}

.dispatch-assignment-dialog__notes-tag:not(.is-selected):hover:not(:disabled) {
  border-color: var(--accent, #005a2d);
  color: var(--accent, #005a2d);
}

.dispatch-assignment-dialog__notes-tag.is-selected {
  background: var(--accent, #005a2d);
  border-color: var(--accent, #005a2d);
  color: #fff;
}

.dispatch-assignment-dialog__notes-tag--add {
  border-style: dashed;
  color: var(--text-secondary, #475467);
}

.dispatch-assignment-dialog__notes-add-row {
  display: inline-flex;
  gap: 6px;
  align-items: center;
}

.dispatch-assignment-dialog__notes-add-row input {
  border: 1px solid var(--border, #d0d5dd);
  border-radius: 8px;
  padding: 4px 10px;
  font-size: var(--ops-table-supporting-size, 12px);
  width: 160px;
}

.dispatch-assignment-dialog__notes-add-row button {
  appearance: none;
  border: 1px solid var(--accent, #005a2d);
  background: var(--accent, #005a2d);
  color: #fff;
  border-radius: 8px;
  padding: 4px 10px;
  font-size: var(--ops-table-supporting-size, 12px);
  cursor: pointer;
}

/* The typed note (\"Ghi chú thêm\") gets its own labeled section below the tag
   chips so operators never mistake typed text for a task tag. */
.dispatch-assignment-dialog__notes-manual {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 4px;
}

.dispatch-assignment-dialog__notes-text {
  border: 1px solid var(--border, #d0d5dd);
  border-radius: 8px;
  padding: 8px 10px;
  font-size: var(--ops-table-supporting-size, 12px);
  min-height: 56px;
  resize: vertical;
  font-family: inherit;
}

.dispatch-assignment-dialog__notes-text:focus,
.dispatch-assignment-dialog__notes-add-row input:focus {
  outline: 2px solid var(--accent, #005a2d);
  outline-offset: 1px;
}

.dispatch-assignment-dialog__notes-preview {
  margin: 0;
  font-size: var(--ops-table-meta-size, 11px);
  color: var(--text-secondary, #475467);
  word-break: break-word;
}

/* ─── Tag manager popover (\"Quản lý tag\") ─────────────────────────────────
   Body-portal + backdrop + fixed viewport-aware coords, mirroring the
   cus-appointment popover pattern (ShipmentsPage.css) so the panel never
   clips inside the assignment dialog. */

.dispatch-assignment-dialog__notes-header {
  display: flex;
  align-items: center;
  gap: 6px;
}

.dispatch-assignment-dialog__notes-manage-btn {
  appearance: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  padding: 0;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
  color: var(--text-secondary, #475467);
  cursor: pointer;
}

.dispatch-assignment-dialog__notes-manage-btn:hover:not(:disabled) {
  border-color: var(--border, #d0d5dd);
  color: var(--accent, #005a2d);
  background: var(--surface-hover, #f8fafc);
}

.dispatch-tag-manager__backdrop {
  position: fixed;
  inset: 0;
  z-index: 1040;
  background: transparent;
}

.dispatch-tag-manager {
  position: fixed;
  z-index: 1050;
  width: 280px;
  max-width: calc(100vw - 24px);
  padding: 12px;
  border: 1px solid var(--line-strong, #cbd5e1);
  border-radius: var(--app-radius-sm, 8px);
  background: var(--surface, #ffffff);
  box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.16), 0 4px 10px -2px rgba(15, 23, 42, 0.08);
  animation: dispatchTagManagerPopIn 130ms cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes dispatchTagManagerPopIn {
  from {
    opacity: 0;
    transform: translateY(-4px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.dispatch-tag-manager__header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.dispatch-tag-manager__header strong {
  font-size: var(--text-caption-size);
  color: var(--text-primary, #101828);
}

.dispatch-tag-manager__count {
  min-width: 20px;
  padding: 1px 6px;
  border-radius: 999px;
  background: var(--surface-muted, #f2f4f7);
  color: var(--text-secondary, #475467);
  font-size: var(--text-caption-size);
  text-align: center;
}

.dispatch-tag-manager__close {
  appearance: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  margin-left: auto;
  padding: 0;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: var(--text-secondary, #475467);
  cursor: pointer;
}

.dispatch-tag-manager__close:hover {
  background: var(--surface-muted, #f2f4f7);
  color: var(--text-primary, #101828);
}

.dispatch-tag-manager__list {
  display: flex;
  flex-direction: column;
  max-height: 264px;
  overflow-y: auto;
  border: 1px solid var(--border, #d0d5dd);
  border-radius: 8px;
}

.dispatch-tag-manager__row {
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 34px;
  padding: 3px 8px;
}

.dispatch-tag-manager__row + .dispatch-tag-manager__row {
  border-top: 1px solid var(--border-light, #eaecf0);
}

.dispatch-tag-manager__label {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--ops-table-supporting-size, 12px);
  color: var(--text-primary, #101828);
}

.dispatch-tag-manager__row-actions {
  display: inline-flex;
  gap: 2px;
  opacity: 1;
}

.dispatch-tag-manager__icon-btn {
  appearance: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  padding: 0;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: var(--text-secondary, #475467);
  cursor: pointer;
}

.dispatch-tag-manager__icon-btn:hover {
  background: var(--surface-muted, #f2f4f7);
  color: var(--accent, #005a2d);
}

.dispatch-tag-manager__icon-btn--danger:hover {
  background: var(--danger-soft, #fdf0f1);
  color: var(--danger, #A0444E);
}

.dispatch-tag-manager__edit-row,
.dispatch-tag-manager__confirm {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 6px;
  min-width: 0;
}

.dispatch-tag-manager__edit-row input {
  flex: 1;
  min-width: 0;
  border: 1px solid var(--border, #d0d5dd);
  border-radius: 8px;
  padding: 4px 10px;
  font-size: var(--ops-table-supporting-size, 12px);
}

.dispatch-tag-manager__edit-row input:focus {
  outline: 2px solid var(--accent, #005a2d);
  outline-offset: 1px;
}

.dispatch-tag-manager__edit-row button,
.dispatch-tag-manager__confirm button {
  appearance: none;
  flex-shrink: 0;
  border: 1px solid var(--border, #d0d5dd);
  border-radius: 8px;
  padding: 4px 10px;
  background: var(--surface, #fff);
  color: var(--text-primary, #101828);
  font-size: var(--ops-table-supporting-size, 12px);
  cursor: pointer;
}

.dispatch-tag-manager__edit-row button:first-of-type,
.dispatch-tag-manager__confirm .dispatch-tag-manager__confirm-yes {
  border-color: var(--accent, #005a2d);
  background: var(--accent, #005a2d);
  color: #fff;
}

.dispatch-tag-manager__confirm span {
  flex: 1;
  font-size: var(--ops-table-supporting-size, 12px);
  color: var(--danger, #A0444E);
  font-weight: 500;
  min-width: 0;
}

.dispatch-tag-manager__notice {
  margin: 8px 0 0;
  font-size: var(--ops-table-meta-size, 11px);
  color: var(--danger, #A0444E);
}

.dispatch-tag-manager__empty {
  margin: 0;
  font-size: var(--ops-table-supporting-size, 12px);
  color: var(--text-secondary, #475467);
}

.dispatch-tag-manager__footer {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-top: 8px;
  font-size: var(--ops-table-meta-size, 11px);
  color: var(--text-secondary, #475467);
}

@media (max-width: 480px) {
  .dispatch-tag-manager {
    width: calc(100vw - 24px);
  }
}

.dispatch-tag-manager { max-height: calc(100dvh - 24px); overflow-y: auto; overscroll-behavior: contain; }
.dispatch-tag-manager__list { border-inline: 0; border-radius: 0; }
@media (prefers-reduced-motion: reduce) {
  .dispatch-tag-manager { animation: none; }
}
