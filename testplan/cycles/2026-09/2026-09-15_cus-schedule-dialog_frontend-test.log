/* The FCL cargo step owns an editable view of the lot route. It shares the
   same routeId as section 02, so the choice is immediate and never forks
   shipment route authority. */
.csc-cargo-route-picker {
  display: grid;
  gap: 6px;
  width: min(100%, 420px);
  margin-bottom: 8px;
}

.csc-cargo-route-picker__label {
  color: var(--fg-1);
  font-size: var(--text-label-size);
  font-weight: 600;
}

.csc-cargo-route-picker__label span {
  color: var(--danger, #dc2626);
}

@media (max-width: 640px) {
  .csc-cargo-route-picker {
    width: 100%;
  }
}

/* ── Lệnh chạy ngoài toggle (MasterDataNhaMay §4.1) ───────────────────────── */
.csc-adhoc-toggle {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border: 1px dashed var(--line, #d8d3cb);
  border-radius: 10px;
  background: var(--bg-2, #f7f4ee);
  font-size: var(--text-body-size);
  font-weight: 600;
  color: var(--fg-1, #222);
  margin-bottom: 4px;
}

.csc-adhoc-toggle input[type='checkbox'] {
  width: 18px;
  height: 18px;
  accent-color: var(--ink, #1c1c1c);
}

/* Duplicate-reference soft warning (customer feedback 2026-09-07 — Bill/Booking
 * already entered). Renders BELOW the input hint so the field stays valid;
 * orange tone to distinguish from a hard `error` (red). The link inside is
 * focusable and the whole block is in the a11y tree via `role=\"status\"`. */
.csc-text-field-with-warning { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.csc-field-warning {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  font-size: var(--text-caption-size);
  line-height: 1.4;
