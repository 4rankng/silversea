.csc-back { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 8px 4px; border: 0; background: none; color: var(--fg-2); font: inherit; font-weight: 650; cursor: pointer; }
.csc-workspace { display: grid; gap: 12px; min-width: 0; }
.csc-form { display: grid; gap: 12px; min-width: 0; }
.csc-section { padding: 18px !important; gap: 14px !important; border: 0 !important; border-radius: 14px !important; background: var(--surface) !important; scroll-margin-top: 16px; }
.csc-section:focus { outline: none; }
.csc-section:focus-visible { outline: 3px solid var(--brand-subtle); outline-offset: 2px; }
.csc-section__heading { display: flex; gap: 10px; align-items: center; margin: -18px -18px 0; padding: 16px 18px; border-bottom: 1px solid var(--line); border-radius: 14px 14px 0 0; background: var(--surface-2); }
.csc-section__heading h2 { margin: 0; color: var(--fg-1); font-size: var(--text-section-size); font-weight: 700; line-height: 1.3; }
.csc-section__heading p { margin: 2px 0 0; color: var(--fg-3); font-size: var(--text-data-size); line-height: 1.4; }
/* Single visible boundary per control: the `csc-control-boundary` class on
   each field adapter owns the wrapper border/focus ring (and gives headless
   QA a solid, screenshot-visible control edge). Inputs nested inside an
   adapter — the ComboBox's transparent overlay input, the InputField inner
   input — stay transparent and borderless so no control ever renders two
   nested boxes. */
.csc-searchable-field { display: grid; gap: 8px; align-content: start; min-width: 0; }
/* Field-label parity: combobox and text/date labels join the select family's
   dense 12px/18px semibold label (the UUI defaults differ per component). */
.csc-searchable-field label,
.csc-uui-field label { color: var(--fg-1); font-size: var(--text-label-size); line-height: 18px; font-weight: 600; }
/* Selects migrated to the shared adapter: `ds-uui-*` classes
 * (design-system/forms/UuiSelectField.css, global) own the visuals. The
 * `csc-select-field` / `csc-select-popover` names survive as test markers. */
.csc-identity-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 12px; min-width: 0; }
.csc-identity-grid > * { min-width: 0; }
.csc-identity-grid__customer { grid-column: span 6; }
.csc-identity-grid__booking, .csc-identity-grid__trade-direction { grid-column: span 3; }
.csc-identity-grid__shipping-line, .csc-identity-grid__declaration { grid-column: span 6; }
.csc-shipping-line-picker { display: grid; gap: 8px; align-content: start; min-width: 0; }
.csc-shipping-line-picker__add { width: fit-content; white-space: nowrap; }
.csc-shipping-line-dialog { display: grid; gap: 12px; }
.csc-shipping-line-dialog > p { margin: 0; color: var(--fg-3); font-size: var(--text-data-size); line-height: 1.5; }
.csc-shipping-line-dialog__error { padding: 9px 11px; border-radius: 8px; background: var(--danger-bg, rgb(220 38 38 / 8%)); color: var(--danger); font-size: var(--text-caption-size); line-height: 1.4; }
.csc-shipping-line-dialog__name-action { display: flex; align-items: end; justify-content: flex-end; gap: 12px; min-width: 0; }
.csc-shipping-line-dialog__name-field { flex: 1 1 240px; min-width: 0; }
.csc-shipping-line-dialog__submit { flex: 0 0 auto; min-height: 38px; }
.csc-route-picker { display: grid; gap: 8px; align-content: start; min-width: 0; }
.csc-route-picker__add { width: fit-content; }
.csc-route-dialog { display: grid; gap: 12px; }
.csc-route-dialog > p { margin: 0; color: var(--fg-3); font-size: var(--text-data-size); line-height: 1.5; }
.csc-route-dialog__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; min-width: 0; }
.csc-route-dialog__error { padding: 9px 11px; border-radius: 8px; background: var(--danger-bg, rgb(220 38 38 / 8%)); color: var(--danger); font-size: var(--text-caption-size); line-height: 1.4; }
.csc-route-dialog__distance-action { display: flex; align-items: end; justify-content: flex-end; gap: 12px; min-width: 0; }
.csc-route-dialog__distance-field { flex: 0 1 184px; width: min(100%, 184px); min-width: 0; }
.csc-route-dialog__submit { flex: 0 0 auto; min-height: 38px; }
.csc-customer-popover { z-index: 50; min-width: min(32rem, calc(100vw - 32px)); max-width: calc(100vw - 32px); border: 1px solid var(--border-1); background: var(--surface, #fff); box-shadow: 0 12px 28px rgb(15 23 42 / 14%); }
.csc-customer-popover .csc-customer-option [slot='label'] { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; line-height: 1.35; }
.csc-customer-picker { display: grid; gap: 8px; align-content: start; min-width: 0; }
.csc-customer-picker__add { width: fit-content; white-space: nowrap; }
.csc-customer-picker > .csc-searchable-field { min-width: 0; }
.csc-customer-dialog { display: grid; gap: 12px; }
.csc-customer-dialog > p { margin: 0; color: var(--fg-3); font-size: var(--text-data-size); line-height: 1.5; }
.csc-customer-dialog__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; min-width: 0; }
.csc-customer-dialog__error { padding: 9px 11px; border-radius: 8px; background: var(--danger-bg, rgb(220 38 38 / 8%)); color: var(--danger); font-size: var(--text-caption-size); line-height: 1.4; }
.csc-customer-dialog__submit { justify-self: end; min-height: var(--control-default-h); }
.csc-field-hint, .csc-field-error { font-size: var(--text-caption-size); font-weight: 400; line-height: 1.45; }
.csc-field-hint { color: var(--fg-3); }.csc-field-error { color: var(--danger); }
.csc-site-guidance { position: relative; display: grid; gap: 4px; margin: -4px 0 0; padding: 11px 13px; border-radius: 7px; background: var(--warning-bg, #fff7ed); color: var(--fg-1); }
.csc-site-guidance::before { position: absolute; top: 50%; left: 0; width: var(--status-strip-width); height: var(--status-strip-height); border-radius: var(--status-strip-radius); background: var(--warning, #d97706); transform: translateY(-50%); content: ''; pointer-events: none; }
.csc-site-guidance strong { font-size: var(--text-data-size); }.csc-site-guidance p { margin: 0; line-height: 1.5; }
.csc-mode { margin: 0; padding: 0; border: 0; min-width: 0; }
.csc-mode legend { margin-bottom: 6px; font-size: var(--control-compact-font-size); font-weight: 700; line-height: var(--control-compact-line-height); }
.csc-mode > div { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.csc-mode label { cursor: pointer; }.csc-mode input { position: absolute; opacity: 0; pointer-events: none; }
.csc-mode__option { display: flex; align-items: center; gap: 8px; min-height: 38px; padding: 7px 10px; border: 1px solid var(--line-2); border-radius: 8px; background: var(--surface); color: var(--fg-2); font-size: var(--control-compact-font-size); font-weight: 700; line-height: var(--control-compact-line-height); transition: border-color 120ms ease, background-color 120ms ease, box-shadow 120ms ease; }
.csc-mode__option::before { width: 16px; height: 16px; flex: 0 0 auto; border: 1.5px solid var(--line-2); border-radius: 50%; background: var(--surface); content: ''; }
.csc-mode label:hover .csc-mode__option { border-color: var(--line-2); background: var(--surface-2); }
.csc-mode input:checked + span { border-color: var(--ink); background: var(--surface); color: var(--fg-1); box-shadow: inset 3px 0 0 var(--ink); }
.csc-mode input:checked + span::before { border-color: var(--ink); background: var(--ink); box-shadow: inset 0 0 0 4px var(--surface); }
.csc-mode input:focus-visible + span { outline: 3px solid color-mix(in srgb, var(--accent-2) 18%, transparent); outline-offset: 2px; }
.csc-cargo-choice-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr); align-items: end; gap: 12px; min-width: 0; }
.csc-fcl-factory-action { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--fg-2); font-size: var(--text-caption-size); line-height: 1.4; }
.csc-container-editor { display: grid; container-type: inline-size; width: 100%; min-width: 0; gap: 12px; }
.csc-container-table-scroll { width: 100%; min-width: 0; overflow-x: auto; border: 1px solid var(--line-2); border-radius: 9px; background: var(--surface); scrollbar-color: color-mix(in srgb, var(--accent-2) 28%, transparent) transparent; scrollbar-width: thin; }
.csc-container-table { width: 100%; min-width: 1038px; border-collapse: collapse; table-layout: fixed; background: var(--surface); }
.csc-container-col__index { width: 40px; }
.csc-container-col__number { width: 128px; }
.csc-container-col__type { width: 104px; }
.csc-container-col__route { width: 180px; }
.csc-container-col__pickup-port, .csc-container-col__dropoff-port, .csc-container-col__factory, .csc-container-col__appointment { width: auto; }
.csc-container-col__weight { width: 96px; }
.csc-container-col__actions { width: 44px; }
.csc-container-table th, .csc-container-table td { min-width: 0; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.csc-container-table th:last-child, .csc-container-table td:last-child { border-right: 0; }
.csc-container-table tbody tr:last-child > * { border-bottom: 0; }
.csc-container-table thead th { padding: 8px 6px; background: var(--surface-2); color: var(--fg-2); font-size: var(--text-caption-size); font-weight: 700; line-height: 1.35; text-align: left; white-space: normal; }
.csc-container-table thead th:first-child, .csc-container-table thead th:last-child { text-align: center; }
.csc-container-table tbody th, .csc-container-table tbody td { padding: 8px 6px; background: var(--surface); vertical-align: top; }
.csc-container-table tbody th { color: var(--fg-3); font-size: var(--text-caption-size); text-align: center; }
.csc-container-table tbody .csc-container-cell { padding: 0; vertical-align: middle; }
.csc-container-table td:not(.csc-container-row__actions) > * { min-width: 0; }
.csc-container-table select { width: 100%; min-width: 0; max-width: 100%; }
.csc-container-row__mobile-index { display: none; }
.csc-container-row__actions { text-align: center; }
.csc-combined-toggle { display: flex; align-items: center; gap: 10px; min-width: 0; min-height: 38px; padding: 7px 10px; border: 1px solid var(--line-2); border-radius: 8px; background: var(--surface-2); cursor: pointer; }
.csc-combined-toggle input { width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--accent-2); }
.csc-combined-toggle span { display: grid; gap: 2px; color: var(--fg-2); font-size: var(--control-compact-font-size); line-height: var(--control-compact-line-height); }
.csc-combined-toggle strong { color: var(--fg-1); }
.csc-container-editor__allocation { display: flex; width: 100%; min-width: 0; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.csc-allocation-summary { display: grid; gap: 8px; min-width: 0; flex: 1 1 320px; }
.csc-container-actions { display: flex; width: 100%; align-items: center; justify-content: flex-end; }
.csc-container-add-control { display: inline-flex; align-items: center; gap: 6px; }
.csc-container-add-control input { width: 68px; min-height: 38px; padding: 7px 8px; border: 1px solid var(--line-2); border-radius: 8px; background: var(--surface); color: var(--fg-1); font: inherit; font-size: var(--control-field-font-size); text-align: center; }
.csc-container-add-control input:focus-visible { border-color: var(--accent-2); outline: 3px solid color-mix(in srgb, var(--accent-2) 18%, transparent); outline-offset: 1px; }
.csc-container-add-control input[aria-invalid='true'] { border-color: var(--danger); }
.csc-add-container { display: inline-flex; width: fit-content; justify-self: end; align-items: center; justify-content: center; gap: 6px; min-height: 38px; padding: 7px 12px; border: 1px solid color-mix(in srgb, var(--accent-2) 36%, var(--line-2)); border-radius: 8px; background: color-mix(in srgb, var(--accent-soft) 52%, var(--surface)); color: var(--accent-2); font: inherit; font-size: var(--text-control-size); font-weight: 700; cursor: pointer; }
.csc-add-container svg { flex: 0 0 auto; }
.csc-add-container:not(:disabled):hover { border-color: color-mix(in srgb, var(--accent-2) 58%, var(--line-2)); background: color-mix(in srgb, var(--accent-soft) 78%, var(--surface)); }
.csc-add-container:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent-2) 18%, transparent); outline-offset: 2px; }
.csc-add-container:disabled { cursor: not-allowed; opacity: .65; }
.csc-site-picker { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; min-width: 0; }
.csc-site-picker__actions { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 8px; }
.csc-utility-button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: var(--control-compact-h, 34px); padding: 5px 12px; border: 1px solid var(--border-2); border-radius: 8px; background: var(--surface); color: var(--fg-2); font: inherit; font-size: var(--text-control-size); font-weight: 650; cursor: pointer; }
/* The `--dashed` name survives as the JSX/test marker, but the accent action
   is borderless — plus icon + label only (user request 2026-08-30). */
.csc-utility-button--dashed { border: 0; background: transparent; color: var(--accent, #2563eb); font-weight: 700; }
.csc-utility-button:disabled { cursor: not-allowed; opacity: .65; }
.csc-icon-button { display: inline-grid; place-items: center; min-width: 38px; min-height: 38px; border: 0; border-radius: 8px; background: transparent; cursor: pointer; }
.csc-icon-button--danger { color: var(--danger); }
.csc-section textarea { width: 100%; min-height: 76px; resize: vertical; border: 1px solid var(--border-2); border-radius: 9px; padding: 8px 10px; color: var(--fg-1); background: var(--surface-2); }
/* Retired with the shared adapter promotion: control boundary + popover skin
 * now live in design-system/forms/UuiSelectField.css (`ds-uui-boundary`). The
 * csc-control-boundary rules below remain for the clerk page's input/textarea
 * fields (UTextField/UDateField), which still use the marker. */

.csc-control-boundary > [role='presentation'],
.csc-control-boundary [data-input-wrapper='true'],
.csc-control-boundary [role='group'],
.csc-control-boundary select,
.csc-control-boundary textarea {
  border: 1px solid color-mix(in srgb, var(--fg-1) 22%, transparent);
  border-radius: 8px;
  background: var(--surface, #fff);
  box-shadow: none;
  transition: border-color 120ms ease, box-shadow 120ms ease, background-color 120ms ease;
}
.csc-control-boundary :where(input, select, textarea):focus-visible {
  outline: none;
  outline-offset: 0;
}
.csc-control-boundary:not(:focus-within):hover > [role='presentation'],
.csc-control-boundary:not(:focus-within):hover [data-input-wrapper='true'],
.csc-control-boundary:not(:focus-within):hover [role='group'],
.csc-control-boundary:not(:focus-within):hover select,
.csc-control-boundary:not(:focus-within):hover textarea {
  border-color: color-mix(in srgb, var(--fg-1) 38%, transparent);
}
.csc-control-boundary:focus-within > [role='presentation'],
.csc-control-boundary:focus-within [data-input-wrapper='true'],
.csc-control-boundary:focus-within [role='group'],
.csc-control-boundary:focus-within select,
.csc-control-boundary:focus-within textarea {
  border-color: var(--accent, #2563eb);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent, #2563eb) 18%, transparent);
}
.csc-control-boundary:has([aria-invalid='true']) > [role='presentation'],
.csc-control-boundary:has([aria-invalid='true']) [data-input-wrapper='true'],
.csc-control-boundary:has([aria-invalid='true']) [role='group'],
.csc-control-boundary:has([aria-invalid='true']) select,
.csc-control-boundary:has([aria-invalid='true']) textarea {
  border-color: var(--danger, #dc2626);
}
.csc-control-boundary:has(:disabled) > [role='presentation'],
.csc-control-boundary:has(:disabled) [data-input-wrapper='true'],
.csc-control-boundary:has(:disabled) [role='group'],
.csc-control-boundary:has(:disabled) select,
.csc-control-boundary:has(:disabled) textarea {
  border-color: color-mix(in srgb, var(--fg-1) 12%, transparent);
  background: var(--surface-2, #f8fafc);
}
.csc-summary { display: grid; gap: 12px; min-width: 0; }
.csc-validation-summary, .csc-submit-error { padding: 16px; border: 1px solid var(--line-2); border-radius: 12px; background: var(--surface); }
.csc-pricing { display: grid; gap: 10px; min-width: 0; }.csc-pricing > p, .csc-summary__muted, .csc-summary__error { margin: 0; font-size: var(--text-caption-size); line-height: 1.5; }.csc-summary__muted { color: var(--fg-3); }.csc-summary__error { color: var(--danger); }.csc-summary__warning { color: var(--warn, #b45309); }
.csc-pricing dl { display: grid; gap: 8px; margin: 0; }.csc-pricing dl > div { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }.csc-pricing dt { color: var(--fg-3); font-size: var(--text-label-size); }.csc-pricing dd { margin: 0; color: var(--fg-1); font-size: var(--text-body-size); font-weight: 800; text-align: right; }
.csc-pricing__explain { padding-top: 8px; border-top: 1px solid var(--border-1); color: var(--fg-3); font-size: var(--text-caption-size); overflow-wrap: anywhere; }.csc-pricing__explain p { margin: 3px 0; }
.csc-pricing__breakdown { display: grid; }.csc-pricing__breakdown > div { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-top: 1px solid var(--border-1); font-size: var(--text-caption-size); overflow-wrap: anywhere; }.csc-pricing__breakdown span, .csc-pricing__breakdown small { display: block; min-width: 0; }.csc-pricing__breakdown small { margin-top: 2px; color: var(--fg-3); }
.csc-validation-summary { border-color: color-mix(in srgb, var(--danger) 32%, var(--border-1)); background: var(--danger-bg, #fff7f7); }.csc-validation-summary__title { display: flex; gap: 8px; align-items: center; color: var(--danger); }.csc-validation-summary p { margin: 7px 0; font-size: var(--text-caption-size); }.csc-validation-summary ol { display: grid; gap: 3px; margin: 0; padding-left: 20px; }.csc-validation-summary button { min-height: 44px; border: 0; padding: 8px 0; background: none; color: var(--danger); font: inherit; font-size: var(--text-caption-size); text-align: left; text-decoration: underline; cursor: pointer; }
.csc-submit-error { color: var(--danger); background: var(--danger-bg, #fff7f7); font-size: var(--text-data-size); line-height: 1.5; }
.csc-summary__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; padding-top: 4px; }
@media (min-width: 1101px) and (min-height: 721px) {
  .csc-section__heading > div { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .csc-section__heading p { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .csc-validation-summary ol {
    max-height: min(24vh, 168px);
    padding-right: 6px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }
}
@container (max-width: 1037px) {
  .csc-container-table-scroll { width: 100%; overflow: visible; border: 0; border-radius: 0; background: transparent; }
  .csc-container-table, .csc-container-table tbody { display: block; width: 100%; min-width: 0; background: transparent; }
  .csc-container-table thead, .csc-container-table colgroup { display: none; }
  .csc-container-table tbody { display: grid; gap: 10px; }
  .csc-container-row { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px 10px; padding: 10px; border: 1px solid var(--line-2); border-radius: 9px; background: var(--surface); }
  .csc-container-table .csc-container-row > * { display: block; min-width: 0; padding: 0; border: 0; background: transparent; text-align: left; }
  .csc-container-table .csc-container-row__index { grid-column: 1 / -1; min-height: 26px; padding: 0 44px 5px 0; border-bottom: 1px solid var(--line); color: var(--fg-1); font-size: var(--text-data-size); font-weight: 750; }
  .csc-container-row__desktop-index { display: none; }
  .csc-container-row__mobile-index { display: inline; }
  .csc-container-row td[data-label]::before { display: block; margin-bottom: 3px; color: var(--fg-2); content: attr(data-label); font-size: var(--text-label-size); font-weight: 700; line-height: 1.35; }
  .csc-container-table .csc-container-row__actions { position: absolute; top: 6px; right: 6px; }
  .csc-container-row__actions .csc-icon-button { min-width: 44px; min-height: 44px; }
}
@media (max-width: 1100px) {
  /* The app shell owns the tablet/phone canvas gutter. The continuous CUS
     form should spend its own padding inside sections, not duplicate it. */
  .csc-page { padding-inline: 0; }
  .csc-identity-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .csc-identity-grid > * { grid-column: auto; }
  .csc-identity-grid__customer { grid-column: 1 / -1; }
}
@media (max-width: 900px) { .csc-cargo-choice-grid { grid-template-columns: minmax(0, 1fr); } }
