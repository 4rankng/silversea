/* Retired with the shared adapter promotion: control boundary + popover skin
 * now live in design-system/forms/UuiSelectField.css (`ds-uui-boundary`). The
 * csc-control-boundary rules below remain for the clerk page's input/textarea
 * fields (UTextField/UDateField), which still use the marker. */

.csc-control-boundary > [role='presentation'],
.csc-control-boundary [data-input-wrapper='true'],
.csc-control-boundary [role='group'],
.csc-control-boundary select,
.csc-control-boundary textarea {
  border: 1px solid color-mix(in srgb, var(--fg-1) 22%, transparent);
  border-radius: 8px;
  background: var(--surface, #fff);
  box-shadow: none;
  transition: border-color 120ms ease, box-shadow 120ms ease, background-color 120ms ease;
}
.csc-control-boundary :where(input, select, textarea):focus-visible {
  outline: none;
  outline-offset: 0;
}
.csc-control-boundary:not(:focus-within):hover > [role='presentation'],
.csc-control-boundary:not(:focus-within):hover [data-input-wrapper='true'],
.csc-control-boundary:not(:focus-within):hover [role='group'],
.csc-control-boundary:not(:focus-within):hover select,
.csc-control-boundary:not(:focus-within):hover textarea {
  border-color: color-mix(in srgb, var(--fg-1) 38%, transparent);
}
.csc-control-boundary:focus-within > [role='presentation'],
.csc-control-boundary:focus-within [data-input-wrapper='true'],
.csc-control-boundary:focus-within [role='group'],
.csc-control-boundary:focus-within select,
.csc-control-boundary:focus-within textarea {
  border-color: var(--accent, #2563eb);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent, #2563eb) 18%, transparent);
}
.csc-control-boundary:has([aria-invalid='true']) > [role='presentation'],
.csc-control-boundary:has([aria-invalid='true']) [data-input-wrapper='true'],
.csc-control-boundary:has([aria-invalid='true']) [role='group'],
.csc-control-boundary:has([aria-invalid='true']) select,
.csc-control-boundary:has([aria-invalid='true']) textarea {
  border-color: var(--danger, #dc2626);
}
.csc-control-boundary:has(:disabled) > [role='presentation'],
.csc-control-boundary:has(:disabled) [data-input-wrapper='true'],
.csc-control-boundary:has(:disabled) [role='group'],
.csc-control-boundary:has(:disabled) select,
.csc-control-boundary:has(:disabled) textarea {
  border-color: color-mix(in srgb, var(--fg-1) 12%, transparent);
  background: var(--surface-2, #f8fafc);
}
.csc-summary { display: grid; gap: 12px; min-width: 0; }
.csc-validation-summary, .csc-submit-error { padding: 16px; border: 1px solid var(--line-2); border-radius: 12px; background: var(--surface); }
.csc-pricing { display: grid; gap: 10px; min-width: 0; }.csc-pricing > p, .csc-summary__muted, .csc-summary__error { margin: 0; font-size: var(--text-caption-size); line-height: 1.5; }.csc-summary__muted { color: var(--fg-3); }.csc-summary__error { color: var(--danger); }.csc-summary__warning { color: var(--warn, #b45309); }
.csc-pricing dl { display: grid; gap: 8px; margin: 0; }.csc-pricing dl > div { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }.csc-pricing dt { color: var(--fg-3); font-size: var(--text-label-size); }.csc-pricing dd { margin: 0; color: var(--fg-1); font-size: var(--text-body-size); font-weight: 800; text-align: right; }
.csc-pricing__explain { padding-top: 8px; border-top: 1px solid var(--border-1); color: var(--fg-3); font-size: var(--text-caption-size); overflow-wrap: anywhere; }.csc-pricing__explain p { margin: 3px 0; }
.csc-pricing__breakdown { display: grid; }.csc-pricing__breakdown > div { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-top: 1px solid var(--border-1); font-size: var(--text-caption-size); overflow-wrap: anywhere; }.csc-pricing__breakdown span, .csc-pricing__breakdown small { display: block; min-width: 0; }.csc-pricing__breakdown small { margin-top: 2px; color: var(--fg-3); }
.csc-validation-summary { border-color: color-mix(in srgb, var(--danger) 32%, var(--border-1)); background: var(--danger-bg, #fff7f7); }.csc-validation-summary__title { display: flex; gap: 8px; align-items: center; color: var(--danger); }.csc-validation-summary p { margin: 7px 0; font-size: var(--text-caption-size); }.csc-validation-summary ol { display: grid; gap: 3px; margin: 0; padding-left: 20px; }.csc-validation-summary button { min-height: 44px; border: 0; padding: 8px 0; background: none; color: var(--danger); font: inherit; font-size: var(--text-caption-size); text-align: left; text-decoration: underline; cursor: pointer; }
.csc-submit-error { color: var(--danger); background: var(--danger-bg, #fff7f7); font-size: var(--text-data-size); line-height: 1.5; }
.csc-summary__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; padding-top: 4px; }
@media (min-width: 1101px) and (min-height: 721px) {
  .csc-section__heading > div { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .csc-section__heading p { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .csc-validation-summary ol {
    max-height: min(24vh, 168px);
    padding-right: 6px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }
}
@container (max-width: 1037px) {
  .csc-container-table-scroll { width: 100%; overflow: visible; border: 0; border-radius: 0; background: transparent; }
  .csc-container-table, .csc-container-table tbody { display: block; width: 100%; min-width: 0; background: transparent; }
  .csc-container-table thead, .csc-container-table colgroup { display: none; }
  .csc-container-table tbody { display: grid; gap: 10px; }
  .csc-container-row { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px 10px; padding: 10px; border: 1px solid var(--line-2); border-radius: 9px; background: var(--surface); }
  .csc-container-table .csc-container-row > * { display: block; min-width: 0; padding: 0; border: 0; background: transparent; text-align: left; }
  .csc-container-table .csc-container-row__index { grid-column: 1 / -1; min-height: 26px; padding: 0 44px 5px 0; border-bottom: 1px solid var(--line); color: var(--fg-1); font-size: var(--text-data-size); font-weight: 750; }
  .csc-container-row__desktop-index { display: none; }
  .csc-container-row__mobile-index { display: inline; }
  .csc-container-row td[data-label]::before { display: block; margin-bottom: 3px; color: var(--fg-2); content: attr(data-label); font-size: var(--text-label-size); font-weight: 700; line-height: 1.35; }
  .csc-container-table .csc-container-row__actions { position: absolute; top: 6px; right: 6px; }
  .csc-container-row__actions .csc-icon-button { min-width: 44px; min-height: 44px; }
}
@media (max-width: 1100px) {
  /* The app shell owns the tablet/phone canvas gutter. The continuous CUS
     form should spend its own padding inside sections, not duplicate it. */
  .csc-page { padding-inline: 0; }
  .csc-identity-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .csc-identity-grid > * { grid-column: auto; }
  .csc-identity-grid__customer { grid-column: 1 / -1; }
}
@media (max-width: 900px) { .csc-cargo-choice-grid { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 640px) { .csc-page { padding: 12px 0 26px; }.csc-section { padding: 8px !important; gap: 10px !important; border-radius: 8px !important; }.csc-section__heading { gap: 9px; margin: -8px -8px 0; padding: 10px 8px; border-radius: 7px 7px 0 0; }.csc-mode legend, .csc-mode__option, .csc-combined-toggle span { font-size: var(--control-compact-touch-font-size); line-height: var(--control-compact-touch-line-height); }.csc-mode__option, .csc-combined-toggle, .csc-add-container, .csc-container-add-control input, .csc-utility-button { min-height: 44px; }.csc-container-actions { align-items: stretch; }.csc-container-add-control { display: grid; width: 100%; grid-template-columns: 72px minmax(0, 1fr); }.csc-add-container { width: 100%; justify-self: stretch; }.csc-customer-picker, .csc-shipping-line-picker { grid-template-columns: minmax(0, 1fr); }.csc-shipping-line-picker__add { width: 100%; justify-self: stretch; }.csc-customer-picker__add { width: 100%; justify-self: stretch; }.csc-icon-button { min-width: 44px; min-height: 44px; }.csc-section textarea { min-height: 88px; }.csc-identity-grid { grid-template-columns: minmax(0, 1fr); }.csc-identity-grid__customer { grid-column: auto; }.csc-mode > div { grid-template-columns: 1fr; }.csc-site-picker { grid-template-columns: 1fr; }.csc-site-picker__actions { justify-content: stretch; }.csc-site-picker__actions .csc-utility-button { flex: 1 1 140px; }.csc-container-editor__allocation { align-items: stretch; flex-direction: column; }.csc-container-editor__allocation > .csc-utility-button { width: 100%; }.csc-container-row { grid-template-columns: minmax(0, 1fr); padding: 8px 0; border: 0; border-radius: 0; }.csc-pricing dl > div, .csc-pricing__breakdown > div { align-items: flex-start; flex-direction: column; }.csc-pricing dd { text-align: left; } }

/* Keep the normal-flow action row above the iPhone home indicator at the end
   of the long create form. It is deliberately not sticky. */
@media (max-width: 640px) {
  .csc-container-row { grid-template-columns: minmax(0, 112px) minmax(0, 1fr); }
  .csc-container-row > * { grid-column: 1 / -1; }
  .csc-container-row > .csc-container-cell--weight { grid-column: 1; }
  .csc-container-row > .csc-container-cell--appointment { grid-column: 2; }
  .csc-page {
    padding-bottom: calc(44px + env(safe-area-inset-bottom, 0px));
  }
}

@media (max-width: 640px) { .csc-route-picker__add { width: 100%; justify-self: stretch; }.csc-route-dialog__grid { grid-template-columns: minmax(0, 1fr); }.csc-route-dialog__submit, .csc-shipping-line-dialog__submit { min-height: 44px; } }
@media (max-width: 340px) { .csc-page { padding-inline: 0; }.csc-validation-summary, .csc-submit-error { padding: 8px !important; } }
@media (prefers-reduced-motion: reduce) { .csc-page *, .csc-page *::before, .csc-page *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }

/* The FCL cargo step owns an editable view of the lot route. It shares the
   same routeId as section 02, so the choice is immediate and never forks
   shipment route authority. */
.csc-cargo-route-picker {
  display: grid;
  gap: 6px;
  width: min(100%, 420px);
  margin-bottom: 8px;
}

.csc-cargo-route-picker__label {
  color: var(--fg-1);
  font-size: var(--text-label-size);
  font-weight: 600;
}

.csc-cargo-route-picker__label span {
  color: var(--danger, #dc2626);
}

@media (max-width: 640px) {
  .csc-cargo-route-picker {
    width: 100%;
  }
}

/* ── Lệnh chạy ngoài toggle (MasterDataNhaMay §4.1) ───────────────────────── */
.csc-adhoc-toggle {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border: 1px dashed var(--line, #d8d3cb);
  border-radius: 10px;
  background: var(--bg-2, #f7f4ee);
  font-size: var(--text-body-size);
  font-weight: 600;
  color: var(--fg-1, #222);
  margin-bottom: 4px;
}

.csc-adhoc-toggle input[type='checkbox'] {
  width: 18px;
  height: 18px;
  accent-color: var(--ink, #1c1c1c);
}

/* Duplicate-reference soft warning (customer feedback 2026-09-07 — Bill/Booking
 * already entered). Renders BELOW the input hint so the field stays valid;
 * orange tone to distinguish from a hard `error` (red). The link inside is
 * focusable and the whole block is in the a11y tree via `role=\"status\"`. */
.csc-text-field-with-warning { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.csc-field-warning {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  font-size: var(--text-caption-size);
  line-height: 1.4;
  color: #b45309;
  background: #fff7ed;
  border: 1px solid #fed7aa;
  border-radius: 6px;
  padding: 6px 10px;
}
.csc-field-warning__link {
  color: #b45309;
  font-weight: 600;
  text-decoration: underline;
}
.csc-field-warning__link:hover { color: #92400e; }

/* Separate time/date controls remain usable in the repeatable desktop grid. */
.csc-container-col__appointment { width: 170px; }

/* Stacked records are forms, not spreadsheet previews. Show their controls
 * continuously and keep catalog creation beside its selector so invisible
 * editor/add rows do not reserve a second line of phone screen space. */
@container (max-width: 1037px) {
  .csc-container-cell .csc-container-cell__display { display: none; }
  .csc-container-cell .csc-container-cell__editor > * { opacity: 1; }
  .csc-container-cell .csc-route-picker { grid-template-columns: minmax(0, 1fr) auto; gap: 6px; align-items: start; }
  .csc-container-cell .csc-route-picker__add { width: auto; min-height: 44px; padding-inline: 8px; }
}
