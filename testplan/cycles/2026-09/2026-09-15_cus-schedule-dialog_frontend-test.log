.cus-worksheet-meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin: 0 16px;
  padding: 10px 0 0;
  border-bottom: 0;
  color: var(--ink-2, #53615a);
  font-size: var(--text-caption-size);
}

/* The summary is a decision rail, not another card: it gives the dispatcher a
   quiet count of the work that needs attention before scanning every row. */
.cus-workspace-summary {
  margin: 8px 0 0;
  border-block: 1px solid var(--line);
}

.cus-workspace-summary dl {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) repeat(3, minmax(0, 1fr));
  margin: 0;
}

.cus-workspace-summary__item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  min-width: 0;
  padding: 10px 14px;
  border-right: 1px solid var(--line);
}

.cus-workspace-summary__item:first-child { padding-left: 0; }
.cus-workspace-summary__item:last-child {
  padding-right: 0;
  border-right: 0;
}

.cus-workspace-summary dt {
  min-width: 0;
  color: var(--ink-2);
  font-size: var(--text-label-size);
  font-weight: var(--fw-semibold);
  line-height: 1.35;
}

.cus-workspace-summary dd {
  flex: 0 0 auto;
  margin: 0;
  color: var(--ink);
  font-family: var(--font-data);
  font-size: var(--text-title-size);
  font-weight: var(--fw-bold);
  letter-spacing: var(--tracking-tight);
  line-height: 1;
}

.cus-workspace-summary__item--warning dd { color: var(--warning-text); }
.cus-workspace-summary__item--info dd { color: var(--info-text); }

.cus-drawer-workflow {
  display: grid;
  gap: 8px;
  padding: 12px 20px 10px;
  border-bottom: 1px solid var(--line);
  background: var(--surface);
}

.cus-drawer-workflow__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.cus-drawer-workflow__heading h3,
.cus-drawer-workflow__action p {
  margin: 0;
}

.cus-drawer-workflow__heading h3 {
  color: var(--ink);
  font-family: var(--font-display);
  font-size: var(--text-section-size);
  font-weight: var(--fw-semibold);
  line-height: 1.25;
}

.cus-drawer-workflow__action p {
  color: var(--ink-2, #53615a);
  font-size: var(--text-caption-size);
  line-height: 1.4;
}

.cus-drawer-decision-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 0.88fr) minmax(240px, 1.15fr);
  border-block: 1px solid var(--line);
  background: var(--surface-2);
}

.cus-drawer-decision {
  display: grid;
  align-content: start;
  gap: 5px;
  min-width: 0;
  padding: 8px 12px;
  border-right: 1px solid var(--line);
}

.cus-drawer-decision:first-child { padding-left: 14px; }
.cus-drawer-decision:last-child {
  padding-right: 14px;
  border-right: 0;
}

.cus-drawer-decision__label,
.cus-drawer-decision--custody [data-label] {
  color: var(--ink-2);
  font-size: var(--text-label-size);
  font-weight: var(--fw-semibold);
  line-height: 1.3;
}

.cus-drawer-decision > strong,
.cus-drawer-decision__appointments {
  color: var(--ink);
  font-size: var(--text-body-size);
  font-weight: var(--fw-medium);
  line-height: 1.4;
}

.cus-drawer-decision__appointments {
  display: grid;
  gap: 2px;
}

.cus-drawer-inline-control {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
}

.cus-drawer-uui-field {
  min-width: 0;
}

.cus-drawer-uui-control,
.cus-drawer-uui-select {
  border-radius: var(--app-radius-md);
  background: var(--surface);
  box-shadow: none;
}

.cus-drawer-uui-input,
.cus-drawer-uui-select {
  min-width: 0;
}

.cus-drawer-save-date {
  width: auto;
  border-radius: var(--app-radius-md);
  box-shadow: none;
}

.cus-drawer-workflow__action {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 12px;
  border-block: 1px solid var(--line);
  background: var(--surface-2);
}

.cus-drawer-workflow__action::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: var(--status-strip-width);
  height: var(--status-strip-height);
  border-radius: var(--status-strip-radius);
  background: var(--accent-2);
  transform: translateY(-50%);
  content: '';
  pointer-events: none;
}

.cus-drawer-workflow__action--blocked::before {
  background: var(--warning);
}

.cus-drawer-workflow__action--idle::before {
  background: var(--ink-3);
}

.cus-drawer-workflow__action > div {
  display: grid;
  gap: 3px;
  min-width: 0;
}

.cus-drawer-workflow__action > div > strong {
  color: var(--ink);
  font-size: var(--text-body-size);
  font-weight: var(--fw-semibold);
  line-height: 1.35;
}

.cus-drawer-primary-action {
  min-width: max-content;
  min-height: 34px;
  border-radius: var(--app-radius-md);
  box-shadow: none;
}

@media (max-width: 480px) {
  .cus-workspace-summary dl { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cus-workspace-summary__item {
    flex-direction: column-reverse;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 4px;
    padding: 7px 8px;
  }
}

@media (max-width: 700px) {
  .cus-worksheet-toolbar__actions { flex-wrap: wrap; gap: 6px; }
  .cus-worksheet-toolbar__action-group--utility { margin-left: auto; }
  .cus-worksheet-meta { margin-inline: 0; }
}


.cus-dashboard-viewport {
  overflow-x: clip;
  border-top: 0;
  border-bottom: 0;
  outline: none;
}

.cus-dashboard-viewport:focus-visible {
  box-shadow: inset 0 0 0 3px var(--brand-subtle);
}

/* A bounded workboard owns both its records and its navigation. Keeping this
   footer in the same scroll region prevents the app shell from hiding it below
   the fold after an operator reaches the final row. */
.cus-dashboard-viewport > .ds-pagination {
  position: sticky;
  bottom: 0;
  z-index: 4;
  margin: 0;
  padding: 12px;
  border-top: 1px solid var(--line);
  background: var(--surface);
}

@media (max-width: 1100px) {
  .cus-dashboard-viewport > .ds-pagination {
    position: static;
  }
}

.cus-dashboard-table {
  width: 100%;
  min-width: 0;
  border-collapse: separate;
  border-spacing: 0;
  table-layout: fixed;
  color: var(--ink);
  font-size: var(--ops-table-supporting-size);
}

/* All seven columns pin an explicit share (sums to 100%) sized from real
   production-shaped data, not the flat/auto split this table shipped with:
   `classification` and `cargo` were `width: auto`, which table-layout: fixed
   only measures from the first rendered row, so real customer/carrier names
   and cargo weights (e.g. \"38.000 kg\") clipped on later rows even though the
   first row looked fine. `schedule` was pinned to 24% to compensate for a
   separate bug — its appointment-group text had no wrap rule anywhere, so it
   silently rendered as one clipped line (see the tbody th/td rule above);
   now that it wraps, it needs less width than the workaround assumed.
   `documents` is sized for 16-char mono Bill/Booking codes (e.g.
   \"EGLV149607019409\") to render un-ellipsized at common desktop widths. */
.cus-dashboard-table col.cus-dashboard-col--customer { width: 16%; }
.cus-dashboard-table col.cus-dashboard-col--documents { width: 15%; }
.cus-dashboard-table col.cus-dashboard-col--classification { width: 9%; }
.cus-dashboard-table col.cus-dashboard-col--cargo { width: 11%; }
.cus-dashboard-table col.cus-dashboard-col--schedule { width: 20%; }
.cus-dashboard-table col.cus-dashboard-col--notes { width: 14%; }
.cus-dashboard-table col.cus-dashboard-col--status { width: 15%; }

.cus-dashboard-table thead th {
  position: sticky;
  /* Negating the scrollport's top padding keeps the header flush with the
     app-body edge so scrolled rows never peek through the gap between the
     topbar and this pinned header. */
  top: var(--sticky-thead-top, -24px);
  z-index: 3;
  padding: 10px 12px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line-strong);
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: var(--ops-table-header-size);
  font-weight: var(--ops-table-header-weight);
  line-height: var(--ops-table-header-line-height);
  text-align: left;
  white-space: normal;
  overflow-wrap: anywhere;
}

.cus-dashboard-table thead th:last-child,
.cus-dashboard-table tbody > tr > :last-child { border-right: 0; }

.cus-dashboard-table tbody > tr > th,
.cus-dashboard-table tbody > tr > td {
  position: relative;
  /* Table-cell height is a floor, not a cap: rows grow with dense schedule
     columns. 72px keeps sparse rows from reading as mostly empty space while
     the 44px inline triggers preserve their touch targets. */
  height: 72px;
  padding: 10px;
  overflow: hidden;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: var(--surface);
  vertical-align: top;
  text-align: left;
  /* The shared Table.css base sets an unscoped `tbody td { white-space:
     nowrap }` that beats inheritance from this table's own cells — without
     this override, columns that never re-declare wrapping on themselves
     (the schedule column's appointment lines had no wrap rule anywhere)
     silently render as one clipped line instead of the multi-line content
     the row height and column width are sized for. */
  white-space: normal;
  transition: background 120ms ease;
}

.cus-dashboard-row:hover > th,
.cus-dashboard-row:hover > td { background: var(--surface-2); }

/* A full-row cream fill stops being a signal once waiting rows dominate a
   page (the unfiltered view is often all-waiting). Tint only the schedule
   cell — the one that needs the dispatcher's action — so the highlight lands
   where \"Chưa chốt ngày\" already explains it. Identity keeps its per-bucket
   status strip; the rest of the row stays neutral. */
.cus-dashboard-table tbody > tr.cus-dashboard-row--waiting > td[data-label='Lịch trình & điều xe'] { background: var(--warning-bg, #fff8e8); }

.cus-dashboard-table tbody > tr.cus-dashboard-row--waiting:hover > td[data-label='Lịch trình & điều xe'] { background: color-mix(in srgb, var(--warning-bg, #fff8e8) 78%, var(--warning) 8%); }

/* The cell trigger's surface-2 hover would erase the tint from the only cell
   that carries it; blend that hover toward the warning tone instead. The
   trigger hover border still signals clickability. */
.cus-dashboard-table tbody > tr.cus-dashboard-row--waiting > td[data-label='Lịch trình & điều xe'] .cus-inline-trigger:not(:disabled):hover {
  background: color-mix(in srgb, var(--warning-bg, #fff8e8) 78%, var(--warning) 8%);
}

.cus-dashboard-row .status-strip { top: 0; bottom: 0; left: 0; pointer-events: none; }

.cus-dashboard-cell--editable { padding: 0 !important; }
.cus-dashboard-cell--readonly { padding: 0 !important; }
.cus-dashboard-cell--readonly > .cus-inline-trigger {
  cursor: default;
  /* FCL schedules are display-only here. The trigger-hover and td:hover rules
     below would still paint a chip on this div (a div never matches :disabled),
     so lock the resting transparent state to keep the cell from advertising
     clicks it does not have. */
  background: transparent !important;
  border-color: transparent !important;
}
.cus-dashboard-cell--editable > .cus-inline-trigger,
.cus-dashboard-cell--readonly > .cus-inline-trigger {
  height: 100%;
  min-height: 100%;
  padding: 10px;
  border-radius: 0;
}
.cus-dashboard-cell--identity > .cus-inline-trigger { padding-left: 14px; }

.cus-multiline-cell {
  display: grid;
  align-content: start;
  gap: 3px;
  min-width: 0;
  line-height: 1.35;
}

.cus-multiline-cell strong,
.cus-multiline-cell span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Document identifiers must remain readable at desktop column widths too. */
.cus-multiline-cell--mono strong,
.cus-multiline-cell--mono span {
  white-space: normal;
  overflow-wrap: anywhere;
  overflow: visible;
  text-overflow: clip;
}

.cus-multiline-cell strong { color: var(--ink); font-size: var(--ops-table-primary-size); font-weight: var(--ops-table-primary-weight); line-height: var(--ops-table-primary-line-height); }
.cus-multiline-cell span { color: var(--ink-3); font-size: var(--ops-table-meta-size); line-height: var(--ops-table-meta-line-height); }
/* Empty-value placeholders recede below populated metadata so \"no data yet\"
   stays distinguishable from short data when scanning a dense grid. */
.cus-multiline-cell .cus-empty { color: var(--ink-4); }
.cus-multiline-cell .cus-customer-name {
  font-size: var(--ops-table-supporting-size);
  line-height: var(--ops-table-supporting-line-height);
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  overflow-wrap: anywhere;
  /* Line 1 contract: bold + UPPERCASE, done visually so the DOM text (and
     every text-based query/label) keeps the customer's real casing. */
  text-transform: uppercase;
}
.cus-dashboard-cell--identity .cus-multiline-cell span {
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  overflow-wrap: anywhere;
}
.cus-multiline-cell--mono { font-family: var(--font-data); }
.cus-multiline-cell--mono strong { font-size: var(--ops-table-primary-size); letter-spacing: .01em; }
.cus-multiline-cell--numeric strong { }

/* Cargo is compact supporting data: show every container type, then keep its
   two measurements together on one quiet line instead of clipping either. */
.cus-multiline-cell.cus-cargo-summary { gap: 2px; }
.cus-multiline-cell .cus-cargo-summary__containers {
  overflow: visible;
  color: var(--ink-2);
  font-size: var(--ops-table-supporting-size);
  font-weight: var(--ops-table-primary-weight);
  line-height: var(--ops-table-supporting-line-height);
  text-overflow: clip;
  white-space: normal;
  overflow-wrap: anywhere;
}
.cus-multiline-cell .cus-cargo-summary__metrics {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  overflow: visible;
  font-size: var(--ops-table-meta-size);
  line-height: var(--ops-table-meta-line-height);
  text-overflow: clip;
  white-space: normal;
  overflow-wrap: anywhere;
}
/* white-space:normal on the flex row above does not inherit past the more
   specific `.cus-multiline-cell span` rule, which still targets these two
   children directly and forces nowrap+ellipsis on them — clipping \"38.000
   kg\" and \"Cont\"/\"Lẻ\" even though the row exists specifically to avoid that
   (see comment above). Override each child explicitly. */
.cus-multiline-cell .cus-cargo-summary__weight,
.cus-multiline-cell .cus-classification__shipping-line {
  grid-area: shipping-line;
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  overflow-wrap: anywhere;
}

.cus-multiline-cell.cus-classification {
  grid-template-areas:
    \"shipping-line shipping-line\"
    \"combined direction\";
  grid-template-columns: minmax(0, 1fr) auto;
  /* Content-sized rows keep the direction badge hugging the carrier line;
     a stretched 1fr row stranded it at the bottom of tall cells. */
  grid-template-rows: auto auto;
  align-content: start;
  min-height: 44px;
}

.cus-classification .cus-direction-badge {
  grid-area: direction;
  align-self: end;
  justify-self: end;
}

.cus-classification .cus-combined-tag {
  grid-area: combined;
  align-self: end;
}

.cus-direction-badge,
.cus-combined-tag {
  display: inline-flex;
  align-self: start;
  align-items: center;
  justify-self: start;
  width: fit-content;
  min-height: 22px;
  max-width: 100%;
  padding: 2px 7px;
  border-radius: 999px;
  font-size: var(--text-caption-size)!important;
  font-weight: var(--fw-bold);
  line-height: 1.35;
}

/* Direction badge modifiers emitted dynamically:
   `cus-direction-badge--${item.direction?.toLowerCase() || 'unknown'}` */
.cus-direction-badge--import,
.cus-direction-badge--export { background: var(--surface-3); color: var(--ink-2) !important; }
.cus-direction-badge--unknown { background: var(--surface-3); color: var(--ink-3) !important; }
.cus-combined-tag { background: var(--warning-bg, #fff8e8); color: var(--warn, #a15c00) !important; }

/* Cargo-mode category tag (`Cont`/`Lẻ`) in the cargo-summary cell. Neutral
   structural edge like the direction badge — never an accent fill. Squared
   corners distinguish mode (structural) from direction's full pill. */
.cus-inline-trigger {
  display: grid;
  align-content: start;
  gap: 3px;
  width: 100%;
  min-height: 44px;
  padding: 10px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--ink-3);
  font: inherit;
  font-size: var(--text-caption-size);
  line-height: 1.35;
  text-align: left;
  cursor: cell;
  touch-action: manipulation;
  border-radius: 6px;
  transition: background-color 120ms ease, border-color 120ms ease, box-shadow 120ms ease;
}

.cus-inline-trigger strong { color: var(--ink); font-size: var(--ops-table-primary-size); line-height: var(--ops-table-primary-line-height); }
.cus-inline-trigger:not(:disabled):hover {
  background: var(--surface-2);
  border-color: var(--line-strong);
}
.cus-dashboard-table td:has(> .cus-inline-trigger:not(:disabled)) { cursor: cell; }
.cus-dashboard-table td:hover > .cus-inline-trigger:not(:disabled) {
  background: var(--surface-2);
  border-color: var(--line-strong);
}
.cus-inline-trigger:disabled { cursor: default; }
.cus-inline-trigger:focus-visible {
  outline: none;
  border-color: var(--brand);
  background: var(--surface);
  box-shadow: inset 0 0 0 2px var(--brand-subtle);
}
.cus-schedule-missing { color: var(--warn, #a15c00) !important; }

.cus-quick-edit-modal { display: grid; gap: 14px; }
.cus-quick-edit-modal__context { margin: 0; color: var(--ink-3); font-family: var(--font-data); font-size: var(--text-caption-size); line-height: 1.35; }
.cus-quick-edit-modal__fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.cus-quick-edit-modal__fields > label { display: grid; gap: 5px; min-width: 0; color: var(--ink-2); font-size: var(--text-label-size); font-weight: var(--fw-semibold); }
.cus-quick-edit-modal__field--full { grid-column: 1 / -1; }
.cus-quick-edit-modal__readonly {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 38px;
  padding: 7px 9px;
  border: 1px solid var(--line);
  border-radius: 7px;
  background: var(--surface-2, #f7f9f8);
  color: var(--ink);
  font-size: var(--text-data-size);
  line-height: 1.45;
  word-break: break-word;
  white-space: normal;
  overflow-wrap: anywhere;
}
.cus-quick-edit-modal__fields input,
.cus-quick-edit-modal__fields select,
.cus-quick-edit-modal__fields textarea {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 38px;
  padding: 7px 9px;
  border: 1px solid var(--line-strong);
  border-radius: 7px;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
  font-size: var(--control-field-font-size);
  line-height: 1.35;
}
.cus-quick-edit-modal__fields textarea { min-height: 84px; resize: vertical; }
.cus-quick-edit-modal__fields input:focus-visible,
.cus-quick-edit-modal__fields select:focus-visible,
.cus-quick-edit-modal__fields textarea:focus-visible { border-color: var(--brand); outline: 2px solid var(--brand-subtle); outline-offset: 1px; }
.cus-quick-edit-modal__help,
.cus-quick-edit-modal__fields > .cus-inline-edit-error { grid-column: 1 / -1; margin: 0; }
.cus-quick-edit-modal__help { color: var(--ink-3); font-size: var(--text-caption-size); line-height: 1.4; }

/* Classification is the modal's only shared-adapter control. The vendored UUI
   trigger keeps its own Tailwind skin (`rounded-lg`, `border-primary`,
   `min-h-[34px]`, `text-xs`) because UuiSelectField.css's boundary selectors
   target `[data-input-wrapper]`/`[role='presentation']` — markup this Select
   version never renders — so the shared skin cannot be relied on here. Conform
   the label and trigger to this modal's approved field metrics instead of
   restyling the shared adapter. */
.cus-quick-edit-modal__fields .ds-uui-select__control { gap: 5px; }
.cus-quick-edit-modal__fields .ds-uui-select label {
  color: var(--ink-2);
  font-size: var(--text-label-size);
  font-weight: var(--fw-semibold);
}
.cus-quick-edit-modal__fields .ds-uui-select button {
  min-height: 38px;
  border-color: var(--line-strong);
  border-radius: 7px;
  background: var(--surface);
  color: var(--ink);
  font-size: var(--control-field-font-size);
}
.cus-quick-edit-modal__fields .ds-uui-select button p {
  color: var(--ink);
  font-size: var(--control-field-font-size);
  font-weight: var(--fw-regular);
}
.cus-quick-edit-modal__fields .ds-uui-select button:focus-visible {
  border-color: var(--brand);
  outline: 2px solid var(--brand-subtle);
  outline-offset: 1px;
}

.cus-note-preview {
  align-content: stretch;
  gap: 4px;
  grid-template-rows: minmax(0, 1fr) auto;
}

.cus-note-preview > span {
  display: -webkit-box;
  min-width: 0;
  overflow: hidden;
  word-break: break-word;
  -webkit-box-orient: vertical;
  text-overflow: ellipsis;
  white-space: normal;
}

.cus-note-preview__customer {
  -webkit-line-clamp: 2;
}

.cus-note-internal {
  color: var(--ink-3);
  font-style: italic;
  opacity: 0.85;
  -webkit-line-clamp: 1;
}
.cus-note-preview > .cus-note-preview__customer {
  color: var(--ink-2);
  font-size: var(--ops-table-note-size);
  font-weight: var(--ops-table-note-weight);
  line-height: var(--ops-table-note-line-height);
}
.cus-note-preview > .cus-note-preview__customer--empty {
  color: var(--ink-3);
  font-weight: var(--fw-regular);
}
.cus-inline-edit-error { grid-column: 1 / -1; color: var(--danger); font-size: var(--text-caption-size); font-weight: var(--fw-semibold); line-height: 1.35; }

.cus-row-actions { display: grid; gap: 7px; min-width: 0; justify-items: stretch; }
.cus-row-actions__summary { display: grid; gap: 6px; min-width: 0; justify-items: start; }
.cus-row-actions .cus-workflow-badge { max-width: 100%; }
.cus-row-actions__edit { display: flex; flex-wrap: wrap; gap: 5px; }
.cus-attention-label { display: inline-flex; align-items: center; gap: 4px; color: var(--warn, #a15c00); font-size: var(--text-label-size); font-weight: var(--fw-semibold); }
.cus-attention-label--danger { color: var(--danger); }
.cus-attention-label--info { color: var(--info, #2563eb); }
.cus-dashboard-detail {
  min-height: 34px;
  color: var(--accent-ink) !important;
  font-size: var(--text-caption-size);
  font-weight: var(--fw-semibold);
  white-space: nowrap;
}
.cus-dashboard-detail:hover {
  background: transparent !important;
  color: var(--accent-2) !important;
}
.cus-dashboard-detail:focus-visible {
  outline-offset: 3px;
}
.cus-create-shipment { white-space: nowrap; }

/* Records share one reading order below the table breakpoint. Labels sit
   above values instead of consuming a second grid inside each narrow cell. */
@media (max-width: 999px) {
  .cus-dashboard-table,
  .cus-dashboard-table tbody { display: block; width: 100%; }
  .cus-dashboard-table colgroup,
  .cus-dashboard-table thead { display: none; }
  .cus-dashboard-table tbody > tr {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
    margin-bottom: 10px;
    border-block: 1px solid var(--line-strong);
    background: var(--surface);
  }
  .cus-dashboard-table tbody > tr > th,
  .cus-dashboard-table tbody > tr > td {
    display: block;
    grid-column: 1 / -1;
    min-width: 0;
    height: auto;
    min-height: 0;
    padding: 6px 8px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
  }
  .cus-dashboard-table tbody > tr > td[data-label='Phân loại & hãng tàu'],
  .cus-dashboard-table tbody > tr > td[data-label='Tổng quan hàng hóa'] {
    grid-column: auto;
  }
  .cus-dashboard-table tbody > tr > th::before,
  .cus-dashboard-table tbody > tr > td::before { display: none; }
  .cus-dashboard-table .cus-inline-trigger {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 3px;
    height: 100%;
    min-height: 44px;
    padding: 7px 8px;
  }
  .cus-dashboard-table .cus-inline-trigger::before {
    position: static;
    width: auto;
    color: var(--ink-3);
    content: attr(data-cell-label);
    font-size: var(--text-label-size);
    font-weight: var(--fw-medium);
    line-height: 1.3;
    white-space: normal;
  }
  .cus-dashboard-table .cus-multiline-cell strong,
  .cus-dashboard-table .cus-multiline-cell span {
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .cus-dashboard-table .cus-classification {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: start;
    gap: 4px 6px;
    min-height: 0;
  }
  .cus-dashboard-table .cus-classification__shipping-line { flex-basis: 100%; }
  .cus-dashboard-table .cus-classification .cus-direction-badge { margin: 0; }
  .cus-dashboard-table tbody > tr.cus-dashboard-row--waiting > td[data-label='Lịch trình & điều xe'] {
    background: transparent;
  }
  .cus-dashboard-table .cus-dashboard-cell--empty-notes .cus-inline-trigger {
    min-height: 32px;
    align-content: center;
  }
  .cus-dashboard-cell--empty-notes .cus-inline-trigger::before { display: none; }
  .cus-dashboard-table tbody > tr > td:last-child { border-bottom: 0; }
  .cus-dashboard-table .cus-row-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }
  .cus-dashboard-table .cus-row-actions__summary { display: flex; flex-wrap: wrap; gap: 4px 8px; }
  .cus-dashboard-table .cus-row-actions__buttons { margin: 0 0 0 auto; padding: 0; border: 0; }
}

@media (max-width: 620px) {
  .cus-quick-edit-modal__fields { grid-template-columns: 1fr; }
  .cus-quick-edit-modal__fields input,
  .cus-quick-edit-modal__fields select { min-height: 44px; }
  .cus-quick-edit-modal__fields .ds-uui-select button { min-height: 44px; }
  .cus-quick-edit-modal__action { min-height: 44px; }
}

/* This is an operational ledger, not a reading page. Keep the title close to
   the workspace so the first row stays useful on a normal desktop viewport. */
.shipments-page > .page-header {
  margin-bottom: 0;
  padding-bottom: 0;
}

/* Operational ledgers need a broad canvas, but an unlimited canvas makes the
   columns feel detached on ultrawide displays. Keep one shared measure with
   the detail workboard while retaining the complete available width below it. */
.app-main:not(.driver-mode) .app-body > .shipments-page {
  width: min(100%, 1800px);
  max-width: 1800px;
  margin-inline: auto;
}

.cus-workspace {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--app-radius-md);
  background: var(--surface);
}

/* This worksheet owns a data grid, not a card. Keep the modifier adjacent to
   the base rule and more specific so later base declarations cannot recreate
   the rounded container around filters, actions, and the table. */
.cus-workspace.cus-workspace--worksheet {
  min-width: 0;
  container-type: inline-size;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  /* No card chrome to clip: undo the base overflow so the table's sticky
     thead can pin against the app-body scrollport. */
  overflow: visible;
}

.cus-search-field,
.cus-action-reason {
  display: grid;
  gap: 6px;
  min-width: 0;
}

.cus-search-field > label,
.cus-action-reason > span {
  color: var(--ink-2);
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
}

.cus-search-field__control {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 0 10px;
  border: 1px solid var(--line-strong);
  border-radius: var(--app-radius-sm);
  background: var(--surface);
  color: var(--ink-3);
}

.cus-search-field__control:focus-within {
  border-color: var(--accent);
  outline: 2px solid color-mix(in srgb, var(--accent) 20%, transparent);
  outline-offset: 1px;
}

.cus-search-field__control input {
  flex: 1;
  min-width: 0;
  height: 42px;
  padding: 0 9px;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--ink);
  font: inherit;
}

.cus-action-reason textarea {
  width: 100%;
  min-height: 44px;
  padding: 9px 11px;
  border: 1px solid var(--line-strong);
  border-radius: var(--app-radius-sm);
  background: var(--surface);
  color: var(--ink);
  font: inherit;
}

.cus-action-reason textarea:focus-visible {
  border-color: var(--accent);
  outline: 2px solid color-mix(in srgb, var(--accent) 24%, transparent);
  outline-offset: 1px;
}

.cus-icon-button {
  display: inline-grid;
  place-items: center;
  width: 36px;
  height: 36px;
  flex: 0 0 36px;
  border: 0;
  border-radius: var(--app-radius-sm);
  background: transparent;
  color: var(--ink-2);
  cursor: pointer;
}

.cus-icon-button:hover {
  background: var(--surface-3);
  color: var(--accent-2);
}

.cus-icon-button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.cus-field-error {
  color: var(--danger-text);
  font-size: var(--fs-xs);
}

.cus-notice {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 6px 0 0;
  padding: 8px 12px;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: var(--fs-sm);
}

.cus-notice::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: var(--status-strip-width);
  height: var(--status-strip-height);
  border-radius: var(--status-strip-radius);
  background: var(--line);
  transform: translateY(-50%);
  content: '';
  pointer-events: none;
}

.cus-notice--success {
  background: transparent;
  color: var(--success-text);
}

.cus-notice--success::before {
  background: var(--success);
}

.cus-notice--error {
  background: transparent;
  color: var(--danger-text);
}

.cus-notice--error::before {
  background: var(--danger);
}

.cus-loading,
.cus-detail-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 180px;
  color: var(--ink-3);
}

.cus-finance-evidence {
  display: grid;
  gap: 10px;
  color: var(--ink-2);

}

.cus-finance-loss,
.cus-finance-quiet,
.cus-finance-confirmation {
  display: grid;
  grid-template-columns: 18px minmax(0, 1fr);
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.cus-finance-loss {
  color: var(--danger-text);
}

.cus-finance-quiet {
  color: var(--ink-3);
}

.cus-finance-evidence span {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.cus-finance-evidence small {
  color: var(--ink-3);
  font-size: var(--text-caption-size);
  font-weight: var(--fw-semibold);
  line-height: 1.3;
}

.cus-finance-evidence strong {
  color: currentColor;
  font-size: var(--text-caption-size);
  font-weight: var(--fw-semibold);
  line-height: 1.35;
  overflow-wrap: anywhere;
}

/* Confirmation modifier emitted dynamically:
   `cus-finance-confirmation--${confirmationIsCurrent ? 'confirmed' : 'attention'}` */
.cus-finance-confirmation--confirmed {
  color: var(--success-text);
}

.cus-finance-confirmation--attention {
  color: var(--warning-deep);
}

.cus-finance-evidence strong { }

.cus-workflow-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  width: max-content;
  max-width: 100%;
  padding: 3px 7px;
  /* Transparent on all badges so a bordered variant keeps sibling metrics.
     Must stay above the bucket modifiers: the border shorthand's
     border-color would otherwise override their border-color by order. */
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: var(--text-caption-size);
  font-weight: var(--fw-semibold);
}

/* Workflow badge modifiers emitted dynamically:
   `cus-workflow-badge--${item.bucket.toLowerCase()}` */
/* The neutral NEW fill is barely distinguishable as a pill on plain surface
   cells; a hairline edge defines it without turning it into an alarm color. */
.cus-workflow-badge--new {
  border-color: var(--line-2);
  background: var(--surface-3);
  color: var(--ink-2);
}

.cus-workflow-badge--running {
  background: var(--info-soft);
  color: var(--info-text);
}

.cus-workflow-badge--pending_lock {
  background: var(--warning-soft);
  color: var(--warning-text);
}

.cus-workflow-badge--locked {
  background: var(--slate-5);
  color: var(--slate-4);
}

.cus-row-actions__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  align-items: center;
  justify-content: space-between;
  margin-top: 1px;
  padding-top: 8px;
  border-top: 1px solid var(--line);
}

.cus-dashboard-delete {
  min-height: 34px;
  padding-inline: 8px;
  font-size: var(--text-caption-size);
  font-weight: var(--fw-semibold);
  white-space: nowrap;
  flex-shrink: 0;
}

/* The Trạng thái column (fixed table-layout, ~150-170px of usable width at
   every breakpoint down to the mobile card view) never has room for \"Xóa\" +
   \"Chi tiết\" as full-text buttons side by side. Drop the \"Xóa\" label and
   keep the icon so the pair never wraps onto two lines — the aria-label
   still names the action for assistive tech. */
.cus-dashboard-delete[data-text],
.cus-dashboard-delete [data-text] {
  display: none !important;
}

.cus-signals {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 5px;
}

/* Signal modifiers emitted dynamically: `cus-signal--${signal.tone}` */
.cus-signal {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  width: max-content;
  padding: 3px 7px;
  border-radius: 999px;
  font-size: var(--text-caption-size);
  font-style: normal;
  font-weight: var(--fw-semibold);
  line-height: 1.3;
  max-width: 100%;
  white-space: normal;
  overflow-wrap: anywhere;
}

.cus-signal--danger {
  background: var(--danger-soft);
  color: var(--danger-text);
}

.cus-signal--warning {
  background: var(--warning-soft);
  color: var(--warning-text);
}

.cus-signal--info {
  background: var(--info-soft);
  color: var(--info-text);
}

.cus-action-reason {
  margin-top: 16px;
}

.cus-action-reason textarea {
  resize: vertical;
}

.cus-action-reason small {
  color: var(--ink-3);
  text-align: right;
}

.cus-shipment-drawer {
  width: min(1180px, 100vw);
  max-width: min(1180px, 100vw);
  background: var(--surface);
  container-name: shipment-drawer;
  container-type: inline-size;
}

.cus-shipment-drawer .drawer__head {
  min-height: 76px;
  padding: 16px 28px;
  background: var(--surface);
}

.cus-shipment-drawer .drawer__heading {
  gap: 10px;
}

.cus-shipment-drawer .drawer__title {
  margin-bottom: 2px;
  font-size: var(--text-dialog-title-size);
  line-height: 1.2;
}

.cus-shipment-drawer .drawer__subtitle {
  font-family: var(--font-data);
  font-size: var(--text-caption-size);
  line-height: 1.35;
}

.cus-shipment-drawer .drawer__body {
  padding: 0 0 72px;
}

.cus-container-ledger {
  display: grid;
  gap: 0;
  padding: 12px 20px 20px;
  background: var(--surface);
}

.cus-container-ledger__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 36px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--line);
}

.cus-container-ledger__head > div {
  display: flex;
  align-items: baseline;
  gap: 8px;
  min-width: 0;
}

.cus-container-ledger__actions {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}

.cus-container-edit-action {
  border-radius: var(--app-radius-md);
  box-shadow: none;
}

.cus-container-ledger__head strong {
  color: var(--ink);
  font-family: var(--font-display);
  font-size: var(--text-body-size);
}

.cus-container-ledger__head span {
  color: var(--ink-3);
  font-family: var(--font-data);
  font-size: var(--fs-xs);

}

.cus-container-table-scroll {
  width: 100%;
  min-width: 0;
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--surface);
  scrollbar-color: color-mix(in srgb, var(--accent-2) 28%, transparent) transparent;
  scrollbar-width: thin;
}

.cus-container-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  background: var(--surface);
}

/* Percentage columns sum to 100% so the fixed-layout table always fits its
 * container — no horizontal scroll at any drawer width. */
.cus-container-col__identity { width: 11%; }
.cus-container-col__type { width: 7%; }
.cus-container-col__route { width: 17%; }
.cus-container-col__dispatch { width: 9%; }
.cus-container-col__carrier { width: 15%; }
.cus-container-col__plate { width: 9%; }
.cus-container-col__site { width: 10%; }
.cus-container-col__appointment { width: 12%; }

.cus-container-table th,
.cus-container-table td {
  min-width: 0;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.cus-container-table th:last-child,
.cus-container-table td:last-child { border-right: 0; }
.cus-container-table tbody tr:last-child > * { border-bottom: 0; }

.cus-container-table thead th {
  padding: 8px 6px;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: var(--text-caption-size);
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.3;
  text-align: left;
  text-transform: uppercase;
}

.cus-container-table tbody th,
.cus-container-table tbody td {
  padding: 8px 6px;
  background: var(--surface);
  color: var(--ink);
  font-size: var(--text-caption-size);
  font-weight: var(--fw-medium);
  line-height: 1.35;
  vertical-align: middle;
  overflow-wrap: anywhere;
  /* The legacy global table rule makes body cells nowrap. Reset it here so
     long site and carrier names stay within their own fixed columns. */
  white-space: normal;
}

.cus-container-table tbody .csc-container-cell {
  padding: 0;
  vertical-align: middle;
}

.cus-container-cell > strong { font: inherit; }

/* Drawer ledger cells must share one typography scale. The base
 * `.csc-container-cell__display` rule hard-codes 13px for the create-form
 * spreadsheet, which leaves the Biển số / Nâng / Hạ / Giờ hẹn rows in the
 * read-only CuS container ledger visually offset from the same column on
 * rows that are still editable. Inherit the parent td's 12px / medium so
 * both branches render at the same size — only the placeholder tone (and
 * any hover/focus ring) should differ. */
.cus-container-cell .csc-container-cell__display {
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
}

.cus-container-cell--identity {
  font-family: var(--font-data);
  font-weight: var(--fw-semibold) !important;
  vertical-align: middle;
}

.cus-container-cell__identity-inner {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: baseline;
  gap: 8px;
}

.cus-container-row__ordinal {
  color: var(--ink-3);
  font-size: var(--text-caption-size);
  line-height: 1;
  text-align: right;
  min-width: 14px;
}

/* Dispatch modifier emitted dynamically:
   `cus-container-dispatch--${line.dispatchStatus.toLowerCase()}` */
.cus-container-dispatch {
  display: inline-flex;
  max-width: 100%;
  padding: 2px 6px;
  border-radius: 999px;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: var(--text-caption-size);
  font-weight: var(--fw-semibold);
  line-height: 1.3;
  overflow-wrap: anywhere;
}

/* Text-only dispatch chips (2026-09-08): the tinted blob backgrounds were
 * visual noise in the ledger — tone now survives via text color alone.
 * AWAITING_VEHICLE (\"Chờ phân xe\") keeps the warning tone: it is the state
 * that needs dispatch action. PLANNED (\"Đã phân xe\") reads as info: the
 * vehicle is on the line, dispatch is done until the trip runs. */
.cus-container-dispatch--awaiting-vehicle { color: var(--warning-text); background: transparent; }
.cus-container-dispatch--planned { color: var(--info-text); background: transparent; }
.cus-container-dispatch--created { color: var(--accent-strong); background: transparent; }
.cus-container-dispatch--in_transit { color: var(--info-text); background: transparent; }
.cus-container-dispatch--completed { color: var(--success-text); background: transparent; }

.cus-container-cell input,
.cus-container-cell .searchable-select__trigger {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 28px;
  padding-inline: 6px;
  border-radius: var(--app-radius-sm);
  font-size: var(--text-caption-size);
  line-height: 1.35;
}

.cus-container-cell :is(.searchable-select__value, .searchable-select__placeholder) {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cus-container-cell input:focus-visible {
  border-color: var(--accent);
  outline: 2px solid color-mix(in srgb, var(--accent) 24%, transparent);
  outline-offset: 1px;
}

.cus-detail-collapse {
  position: sticky;
  right: 10px;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 36px;
  padding: 7px 9px;
  border: 1px solid var(--line-strong);
  border-radius: var(--app-radius-sm);
  background: var(--surface);
  color: var(--ink-2);
  font: inherit;
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
  cursor: pointer;
}

.cus-detail-collapse:hover {
  border-color: var(--accent-2);
  color: var(--accent-2);
}

.cus-detail-collapse:disabled {
  cursor: wait;
  opacity: 0.62;
}

.cus-detail-collapse:disabled:hover {
  border-color: var(--line-strong);
  color: var(--ink-2);
}

.cus-detail-collapse:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.cus-carrier-editor {
  display: grid;
  gap: 3px;
}

.cus-carrier-editor__switch {
  width: fit-content;
  min-height: 20px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--accent-2);
  font: inherit;
  font-size: var(--text-caption-size);
  font-weight: var(--fw-semibold);
  text-align: left;
  cursor: pointer;
}

.cus-container-row__error {
  display: block;
  margin-top: 4px;
  color: var(--danger-text);
  font-size: var(--text-caption-size);
  line-height: 1.3;
}

.cus-discard-confirmation {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px 10px;
  border: 1px solid color-mix(in srgb, var(--warning) 36%, var(--line));
  border-radius: var(--app-radius-sm);
  background: var(--warning-soft);
  color: var(--warning-text);
  font-size: var(--fs-xs);
}

.cus-discard-confirmation > span { margin-right: auto; }

.cus-detail-empty {
  margin: 0;
  padding: 16px;
  color: var(--ink-3);
  text-align: center;
}

.cus-inline-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 120px;
  padding: 20px;
  color: var(--danger-text);
}

.cus-inline-error button {
  border: 0;
  background: transparent;
  color: inherit;
  font-weight: var(--fw-semibold);
  text-decoration: underline;
  cursor: pointer;
}

.cus-detail-content {
  overflow: visible;
  border-top: 0;
}

@container shipment-drawer (max-width: 700px) {
  .cus-drawer-decision-grid { grid-template-columns: 1fr 1fr; }
  .cus-drawer-decision,
  .cus-drawer-decision:first-child,
  .cus-drawer-decision:last-child {
    padding-inline: 14px;
  }
  .cus-drawer-decision:nth-child(2) { border-right: 0; }
  .cus-drawer-decision--finance {
    grid-column: 1 / -1;
    border-top: 1px solid var(--line);
  }
  .cus-drawer-decision--finance .cus-finance-evidence {
    grid-template-columns: 1fr 1fr;
  }
}

@container shipment-drawer (max-width: 760px) {
  .cus-container-table-scroll {
    overflow: visible;
    border: 0;
    background: transparent;
  }

  .cus-container-table,
  .cus-container-table tbody {
    display: block;
    width: 100%;
    min-width: 0;
    background: transparent;
  }

  .cus-container-table colgroup,
  .cus-container-table thead { display: none; }
  .cus-container-table tbody { display: grid; gap: 8px; }

  .cus-container-table .cus-container-row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 10px;
    padding: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .cus-container-table .cus-container-row > * {
    display: grid;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
  }

  .cus-container-table .cus-container-cell::before {
    margin-bottom: 4px;
    color: var(--ink-3);
    content: attr(data-label);
    font-size: var(--text-label-size);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .cus-container-table .cus-container-cell--identity {
    grid-column: 1 / -1;
    min-height: 28px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line);
  }

  .cus-container-table .cus-container-cell--identity .cus-container-cell__identity-inner {
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
  }

  .cus-container-row-error {
    display: block;
    width: 100%;
  }

  .cus-container-row-error__cell {
    display: block;
    padding: 0 !important;
    border: 0;
  }

  .cus-container-table .cus-container-row__ordinal {
    position: absolute;
    top: 10px;
    right: 12px;
  }
}

@media (max-width: 1039px) {
  .cus-shipment-drawer {
    width: min(100vw, 620px);
    max-width: min(100vw, 620px);
  }
}

@media (max-width: 560px) {
  .shipments-page {
    gap: 14px;
  }

  .cus-workspace {
    margin-inline: 0;
    border: 0;
    border-radius: 0;
  }

  .cus-notice {
    align-items: flex-start;
    margin-inline: 0;
  }

  .shipments-page .ds-pagination__controls {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .cus-shipment-drawer .drawer__head {
    gap: 10px;
    padding: calc(16px + env(safe-area-inset-top, 0px)) 18px 12px;
  }

  .cus-shipment-drawer .drawer__title {
    font-size: var(--text-dialog-title-size);
    line-height: 1.2;
  }

  .cus-shipment-drawer .drawer__body {
    padding: 0 0 56px;
  }

  .cus-drawer-workflow {
    gap: 10px;
    padding: 14px 18px;
  }

  .cus-drawer-workflow__heading {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .cus-drawer-decision-grid {
    grid-template-columns: 1fr;
  }

  .cus-drawer-decision,
  .cus-drawer-decision:first-child,
  .cus-drawer-decision:last-child {
    grid-column: auto;
    padding: 13px 0;
    border-right: 0;
    border-top: 1px solid var(--line);
  }

  .cus-drawer-decision:first-child { border-top: 0; }

  .cus-drawer-decision--finance .cus-finance-evidence {
    grid-template-columns: 1fr;
  }

  .cus-drawer-workflow__action {
    align-items: stretch;
    flex-direction: column;
    padding: 13px 14px;
  }

  .cus-drawer-primary-action {
    width: 100%;
    min-height: 44px;
  }

  .cus-shipment-drawer .cus-container-ledger {
    padding: 16px 18px 24px;
  }

  .cus-container-table .cus-container-cell input,
  .cus-container-table .cus-container-cell .searchable-select__trigger {
    min-height: 44px;
    font-size: var(--control-field-font-size);
  }

  .cus-container-edit-action {
    min-width: 96px;
    min-height: 44px;
    border-radius: var(--app-radius-md);
    box-shadow: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .shipments-page *,
  .shipments-page *::before,
  .shipments-page *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* Dirty-row confirm pair floats over the rows below the Giờ hẹn đóng/trả
 * input (customer feedback 2026-09-08: an in-flow pair stretched the row —
 * the pair must overlay like the native calendar picker, not take part in
 * the cell layout). Text-only compact buttons keep the popover unobtrusive. */
.cus-container-table .cus-container-cell {
  /* Anchor for the floating confirm popover; also lets the editing cell's
   * stacking context rise above later rows while it owns focus. */
  position: relative;
}

.cus-container-table .cus-container-cell:focus-within {
  z-index: 6;
}

/* Appointment compact cell and bounded popover */
.cus-appointment-cell {
  position: relative;
}

.cus-appointment-trigger {
  display: flex;
  align-items: center;
  gap: 5px;
  width: 100%;
  min-height: 28px;
  padding: 2px 6px;
  border: 1px solid var(--line, #e2e8f0);
  border-radius: var(--app-radius-sm, 6px);
  background: var(--surface, #ffffff);
  color: var(--ink-1, #0f172a);
  font-family: inherit;
  font-size: var(--text-caption-size);
  line-height: 1.3;
  text-align: left;
  cursor: pointer;
  transition: all 120ms ease;
  box-sizing: border-box;
}

.cus-appointment-trigger:hover {
  border-color: var(--brand-600, #005a2d);
  background: var(--surface-2, #f8fafc);
}

.cus-appointment-trigger:focus-visible {
  outline: 2px solid var(--brand-600, #005a2d);
  outline-offset: 1px;
}

.cus-appointment-trigger--active {
  border-color: var(--brand-600, #005a2d);
  background: var(--surface-2, #f1f5f9);
  box-shadow: 0 0 0 1px var(--brand-600, #005a2d);
}

.cus-appointment-trigger__icon {
  flex-shrink: 0;
  color: var(--brand-600, #005a2d);
}

.cus-appointment-trigger__text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.cus-appointment-trigger__text--empty {
  color: var(--ink-3, #94a3b8);
  font-weight: 400;
}

/* Fixed backdrop to catch outside clicks and close popover cleanly */
.cus-appointment-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1040;
  background: transparent;
}

/* In-app Bounded Appointment Popover */
.cus-appointment-popover {
  position: absolute;
  top: calc(100% + 4px);
  right: 0;
  z-index: 1050;
  width: 275px;
  max-width: calc(100vw - 32px);
  padding: 12px;
  border: 1px solid var(--line-strong, #cbd5e1);
  border-radius: var(--app-radius-sm, 8px);
  background: var(--surface, #ffffff);
  box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.16), 0 4px 10px -2px rgba(15, 23, 42, 0.08);
  animation: cusAppointmentPopIn 130ms cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes cusAppointmentPopIn {
  from {
    opacity: 0;
    transform: translateY(-4px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.cus-appointment-popover__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--line, #e2e8f0);
}

.cus-appointment-popover__title {
  display: flex;
  align-items: center;
  gap: 5px;
  color: var(--ink-1, #0f172a);
  font-size: var(--text-section-size);
  font-weight: 600;
}

.cus-appointment-popover__title svg {
  color: var(--brand-600, #005a2d);
}

.cus-appointment-popover__badge {
  font-size: var(--text-caption-size);
  font-weight: 500;
  color: var(--ink-3, #64748b);
  background: var(--surface-2, #f1f5f9);
  padding: 1px 6px;
  border-radius: 4px;
}

.cus-appointment-popover__close {
  display: inline-grid;
  place-items: center;
  width: 22px;
  height: 22px;
  padding: 0;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: var(--ink-3, #64748b);
  cursor: pointer;
}

.cus-appointment-popover__close:hover {
  background: var(--surface-2, #f1f5f9);
  color: var(--ink-1, #0f172a);
}

.cus-appointment-popover__section-label {
  margin-bottom: 4px;
  color: var(--ink-3, #64748b);
  font-size: var(--text-label-size);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.cus-appointment-popover__pills {
  display: flex;
  gap: 4px;
  margin-bottom: 10px;
}

.cus-quick-pill {
  flex: 1;
  padding: 4px 6px;
  border: 1px solid var(--line, #e2e8f0);
  border-radius: 5px;
  background: var(--surface-2, #f8fafc);
  color: var(--ink-2, #334155);
  font-family: inherit;
  font-size: var(--text-control-compact-size);
  font-weight: 500;
  text-align: center;
  cursor: pointer;
  transition: all 100ms;
}

.cus-quick-pill:hover {
  background: var(--surface, #ffffff);
  border-color: var(--brand-600, #005a2d);
  color: var(--brand-600, #005a2d);
}

.cus-quick-pill.is-active {
  background: var(--brand-600, #005a2d);
  border-color: var(--brand-600, #005a2d);
  color: #ffffff;
  font-weight: 600;
}

.cus-appointment-popover__inputs {
  display: grid;
  /* Một trường \"Ngày giờ\" 24h duy nhất (\"HH:mm DD/MM/YYYY\") — input văn bản
     theo hợp đồng ngày+giờ kết hợp, pill nhanh bên dưới vẫn là đường tắt. */
  grid-template-columns: 1fr;
  gap: 8px;
  margin-bottom: 8px;
}

.cus-appointment-input-wrap {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.cus-appointment-input-wrap label {
  color: var(--ink-3, #64748b);
  font-size: var(--text-label-size);
  font-weight: 600;
  text-transform: uppercase;
}

.cus-appointment-input {
  width: 100%;
  height: 30px;
  padding: 2px 6px;
  border: 1px solid var(--line-strong, #cbd5e1);
  border-radius: 5px;
  background: var(--surface, #ffffff);
  color: var(--ink-1, #0f172a);
  font-family: inherit;
  font-size: var(--control-field-font-size);
  box-sizing: border-box;
}

.cus-appointment-input:focus {
  outline: 2px solid var(--brand-600, #005a2d);
  outline-offset: -1px;
}

/* Calendar affordance: the visible button opens the browser picker through a
   clipped (not display:none) native input — display:none pickers are refused
   by some engines. The 24h text entry beside it stays the typed path. */
.cus-appointment-input-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.cus-appointment-picker-input {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.cus-appointment-picker-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 30px;
  flex: 0 0 28px;
  border: 1px solid var(--line-strong, #cbd5e1);
  border-radius: 5px;
  background: var(--surface, #ffffff);
  color: var(--ink-2, #334155);
  cursor: pointer;
}

.cus-appointment-picker-btn:hover {
  background: var(--surface-2, #f1f5f9);
  color: var(--brand-600, #005a2d);
}

.cus-appointment-popover__times {
  display: flex;
  gap: 4px;
  margin-bottom: 12px;
}

.cus-time-pill {
  flex: 1;
  padding: 3px 2px;
  border: 1px solid var(--line, #e2e8f0);
  border-radius: 4px;
  background: transparent;
  color: var(--ink-2, #475569);
  font-family: inherit;
  font-size: var(--text-control-compact-size);
  text-align: center;
  cursor: pointer;
  transition: all 100ms;
}

.cus-time-pill:hover {
  background: var(--surface-2, #f1f5f9);
  color: var(--brand-600, #005a2d);
}

.cus-time-pill.is-active {
  background: var(--surface-2, #f1f5f9);
  border-color: var(--brand-600, #005a2d);
  color: var(--brand-600, #005a2d);
  font-weight: 600;
}

.cus-appointment-popover__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding-top: 10px;
  border-top: 1px solid var(--line, #e2e8f0);
}

.cus-appointment-popover__clear {
  padding: 2px 4px;
  border: 0;
  background: transparent;
  color: var(--danger, #dc2626);
  font-family: inherit;
  font-size: var(--text-control-compact-size);
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.cus-appointment-popover__clear:hover {
  color: #b91c1c;
}

.cus-appointment-popover__hint {
  font-size: var(--text-caption-size);
  color: var(--ink-3, #94a3b8);
}

.cus-container-row--dirty {
  background-color: rgba(0, 90, 45, 0.04) !important;
}

/* Consolidated Drawer Footer */
.cus-drawer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 12px;
}

.cus-drawer-footer__status {
  font-size: var(--text-data-size);
  color: var(--ink-2, #475569);
}

.cus-drawer-footer__dirty-note {
  color: var(--brand-700, #005a2d);
  font-weight: 500;
}

.cus-drawer-footer__clean-note {
  color: var(--ink-3, #94a3b8);
}

.cus-drawer-footer__actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cus-drawer-footer__actions .btn {
  min-height: 34px;
  padding: 4px 16px;
  font-size: var(--text-caption-size);
  font-weight: 600;
  border-radius: var(--app-radius-sm, 6px);
}

.cus-container-ledger__sticky-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  margin-top: 8px;
  background: var(--surface-2, #f8fafc);
  border: 1px solid var(--line, #e2e8f0);
  border-radius: var(--app-radius-sm, 6px);
}

.cus-container-ledger__sticky-note {
  font-size: var(--text-caption-size);
  color: var(--brand-700, #005a2d);
  font-weight: 500;
}

.cus-container-cell .cus-container-confirm-group--floating,
.cus-container-ledger__sticky-bar .cus-container-confirm-group--floating {
  display: flex;
  gap: 6px;
  width: max-content;
}

/* Text-only compact pair: matches the ledger's 11px cell scale instead of
 * the default .btn--sm chrome. */
.cus-container-confirm-group--floating .btn {
  min-height: 26px;
  padding: 2px 10px;
  font-size: var(--text-caption-size);
  white-space: nowrap;
}
.cus-container-confirm--floating {
  background-color: var(--brand-600, #005a2d) !important;
  color: #fff !important;
}

.cus-container-row-error {
  background: var(--surface);
}
.cus-container-row-error__cell {
  padding: 6px 12px !important;
  background: var(--surface-2, #f8fafc);
  border-bottom: 1px solid var(--line);
}
.cus-container-row-error__banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 12px;
  border-radius: var(--app-radius-sm, 6px);
  background: var(--danger-soft, #fef2f2);
  border: 1px solid var(--danger-line, #fecaca);
  color: var(--danger-text, #991b1b);
  font-size: var(--text-caption-size);
  line-height: 1.4;
  position: sticky;
  left: 0;
  max-width: calc(100vw - 48px);
}
.cus-container-row-error__text {
  flex: 1;
  word-break: break-word;
}
.cus-container-row-error__dismiss {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  margin: -4px;
  border: 0;
  background: transparent;
  color: inherit;
  opacity: 0.7;
  cursor: pointer;
  border-radius: 4px;
}
.cus-container-row-error__dismiss:hover {
  opacity: 1;
  background: rgba(0, 0, 0, 0.05);
}
.cus-container-confirm:focus-visible,
.cus-container-revert:focus-visible {
  outline: 2px solid var(--accent, #2563eb);
  outline-offset: 2px;
}

/* Secondary filters use the shared button and a full-width disclosure. */
.cus-advanced-toggle,
.cus-active-filter-summary { display: none; }
.cus-worksheet-advanced {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px 12px;
  min-width: 0;
  align-items: end;
}
@media (max-width: 1279px) and (min-width: 1024px) {
  .cus-worksheet-toolbar__filters { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 1023px) {
  .cus-worksheet-toolbar__filters { grid-template-columns: minmax(0, 1fr) auto; gap: 6px 8px; }
  .cus-worksheet-toolbar__filters .cus-advanced-toggle { display: inline-flex; }
  .cus-active-filter-summary {
    display: block;
    grid-column: 1 / -1;
    color: var(--ink-2);
    font-size: var(--text-caption-size);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .cus-worksheet-advanced {
    display: none;
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }
  .cus-worksheet-advanced[data-open] { display: grid; }
}
/* Anchored editors must remain reachable with the keyboard open or in landscape. */
.cus-appointment-popover {
  max-height: calc(100dvh - 24px);
  overflow-y: auto;
  overscroll-behavior: contain;
}
.cus-appointment-popover__error {
  margin: 8px 0;
  color: var(--danger-text);
  font-size: var(--text-caption-size);
  line-height: 1.4;
}
.cus-appointment-popover__footer { gap: 8px; flex-wrap: wrap; }
@media (prefers-reduced-motion: reduce) {
  .cus-appointment-popover { animation: none; }
}

/* _35: multiline note previews keep their typed line breaks (user-ruled).
   2-line clamp + ellipsis; the drawer/detail surfaces show the full note. */
.cus-note-clamp {
  white-space: pre-wrap;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
/* _35 specificity override: .cus-note-preview > span (0,1,1) was stomping
   .cus-note-clamp (0,1,0). Scoped child selector wins. */
.cus-note-preview > .cus-note-clamp {
  white-space: pre-wrap;
}
