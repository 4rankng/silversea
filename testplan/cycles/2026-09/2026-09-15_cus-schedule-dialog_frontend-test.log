  border-radius: 6px;
  padding: 6px 10px;
}
.csc-field-warning__link {
  color: #b45309;
  font-weight: 600;
  text-decoration: underline;
}
.csc-field-warning__link:hover { color: #92400e; }

/* Separate time/date controls remain usable in the repeatable desktop grid. */
.csc-container-col__appointment { width: 170px; }

/* Stacked records are forms, not spreadsheet previews. Show their controls
 * continuously and keep catalog creation beside its selector so invisible
 * editor/add rows do not reserve a second line of phone screen space. */
@container (max-width: 1037px) {
  .csc-container-cell .csc-container-cell__display { display: none; }
  .csc-container-cell .csc-container-cell__editor > * { opacity: 1; }
  .csc-container-cell .csc-route-picker { grid-template-columns: minmax(0, 1fr) auto; gap: 6px; align-items: start; }
  .csc-container-cell .csc-route-picker__add { width: auto; min-height: 44px; padding-inline: 8px; }
}
