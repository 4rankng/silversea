{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "{ ts=$(jq -r '.tool_input.status // empty'); if [ \"$ts\" = \"completed\" ]; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"Task marked completed. Update HANDOFF.md now with goal, files changed, what worked, gotchas, next steps. Run git status && git diff --stat to gather state.\"}}'; fi; }"
          }
        ]
      },
      {
        "matcher": "Bash|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "repowise-augment --client codex",
            "timeout": 10,
            "statusMessage": "Checking repowise freshness..."
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "repowise-augment --client codex",
            "timeout": 10,
            "statusMessage": "Checking repowise freshness..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "repowise-augment --client codex",
            "timeout": 10,
            "statusMessage": "Loading repowise context..."
          }
        ]
      }
    ]
  }
}
